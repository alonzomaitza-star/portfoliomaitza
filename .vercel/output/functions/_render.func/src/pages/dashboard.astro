---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Dashboard">
  <main class="dashboard-container">
    <h1>Bienvenido a tu Dashboard</h1>
    <p id="user-info">Cargando información del usuario...</p>
    <p>Esta es una página protegida. Solo los usuarios autenticados pueden verla.</p>
    <a href="/" id="logout-button" class="logout-button" style="display: none;">Cerrar Sesión</a>
  </main>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  const userInfo = document.getElementById('user-info');
  const logoutButton = document.getElementById('logout-button');

  // Escucha los cambios en el estado de autenticación.
  supabase.auth.onAuthStateChange((event, session) => {
    if (event === 'SIGNED_IN' && session) {
      // El usuario ha iniciado sesión.
      const user = session.user;
      if (userInfo) {
        userInfo.innerHTML = `Has iniciado sesión como: <strong>${user.email}</strong>`;
      }
      if (logoutButton) {
        logoutButton.style.display = 'inline-block';
      }
    } else if (event === 'SIGNED_OUT') {
      // El usuario ha cerrado sesión, redirigir a la página de inicio.
      window.location.href = '/';
    }
  });

  // Comprueba el estado inicial al cargar la página.
  async function checkSession() {
    const { data, error } = await supabase.auth.getSession();
    if (data.session) {
      const user = data.session.user;
      if (userInfo) {
        userInfo.innerHTML = `Has iniciado sesión como: <strong>${user.email}</strong>`;
      }
      if (logoutButton) {
        logoutButton.style.display = 'inline-block';
      }
    } else {
      // Si no hay sesión, muestra un mensaje y no el botón de logout.
      if (userInfo) {
        userInfo.textContent = 'No has iniciado sesión. Por favor, ve a la página de inicio para autenticarte.';
      }
    }
  }

  checkSession();

  // Maneja el clic en el botón de cerrar sesión.
  if (logoutButton) {
    logoutButton.addEventListener('click', async (e) => {
      e.preventDefault();
      const { error } = await supabase.auth.signOut();
      if (error) {
        console.error('Error al cerrar sesión:', error.message);
      }
    });
  }
</script>

<style>
  .dashboard-container {
    padding: 2rem;
    max-width: 800px;
    margin: 2rem auto;
    background-color: #f4f4f9;
    border-radius: 8px;
    text-align: center;
  }
  .logout-button {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 500;
    background-color: #f44336;
    color: white;
    transition: background-color 0.2s ease;
  }
  .logout-button:hover {
    background-color: #d32f2f;
  }
</style>

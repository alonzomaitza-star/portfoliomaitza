---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Mi Dashboard" noindex={true}>
  <main class="dashboard-main">
    <!-- Loading State -->
    <div id="dashboard-loading" class="dashboard-loading">
      <div class="loading-spinner"></div>
      <p>Cargando tu dashboard...</p>
    </div>

    <!-- Not Authenticated State -->
    <div
      id="dashboard-not-auth"
      class="dashboard-not-auth"
      style="display: none;"
    >
      <div class="not-auth-content">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="80"
          height="80"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="lock-icon"
        >
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        <h1>Acceso Restringido</h1>
        <p>Necesitas iniciar sesión para acceder al dashboard.</p>
        <button id="dashboard-login-btn" class="dashboard-login-btn">
          <svg class="google-icon" viewBox="0 0 24 24" width="20" height="20">
            <path
              d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
              fill="#4285F4"></path>
            <path
              d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
              fill="#34A853"></path>
            <path
              d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
              fill="#FBBC05"></path>
            <path
              d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
              fill="#EA4335"></path>
          </svg>
          Iniciar sesión con Google
        </button>
      </div>
    </div>

    <!-- Authenticated Dashboard -->
    <div
      id="dashboard-content"
      class="dashboard-content"
      style="display: none;"
    >
      <!-- User Header Section -->
      <section class="user-header-section">
        <div class="user-header-bg"></div>
        <div class="user-header-content">
          <div class="user-avatar-large-container">
            <img
              id="dashboard-user-avatar"
              src=""
              alt="Avatar"
              class="user-avatar-large"
            />
            <div class="user-status-indicator"></div>
          </div>
          <div class="user-info-main">
            <h1 id="dashboard-user-name" class="user-name-large">Bienvenido</h1>
            <p id="dashboard-user-email" class="user-email-large"></p>
            <span class="user-badge">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="currentColor"
                ><path
                  d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"
                ></path></svg
              >
              Usuario Activo
            </span>
          </div>
        </div>
      </section>

      <!-- Dashboard Options Grid -->
      <section class="dashboard-options-section">
        <h2 class="section-title">
          <span class="title-icon">📋</span>
          Panel de Control
        </h2>
        <div class="options-grid">
          <!-- Option 1: Perfil -->
          <div class="option-card" data-option="perfil">
            <div class="card-icon-wrapper gradient-1">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
            </div>
            <h3 class="card-title">Mi Perfil</h3>
            <p class="card-description">
              Gestiona tu información personal y preferencias de cuenta.
            </p>
            <span class="card-action">Ver Perfil →</span>
          </div>

          <!-- Option 2: Configuración -->
          <div class="option-card" data-option="configuracion">
            <div class="card-icon-wrapper gradient-2">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="3"></circle>
                <path
                  d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"
                ></path>
              </svg>
            </div>
            <h3 class="card-title">Configuración</h3>
            <p class="card-description">
              Ajusta las opciones de tu cuenta y notificaciones.
            </p>
            <span class="card-action">Configurar →</span>
          </div>

          <!-- Option 3: Historial -->
          <div class="option-card" data-option="historial">
            <div class="card-icon-wrapper gradient-3">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <h3 class="card-title">Historial</h3>
            <p class="card-description">
              Revisa tu actividad reciente y transacciones.
            </p>
            <span class="card-action">Ver Historial →</span>
          </div>

          <!-- Option 4: Soporte -->
          <div class="option-card" data-option="soporte">
            <div class="card-icon-wrapper gradient-4">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
                ></path>
              </svg>
            </div>
            <h3 class="card-title">Soporte</h3>
            <p class="card-description">
              ¿Necesitas ayuda? Contacta con nuestro equipo.
            </p>
            <span class="card-action">Obtener Ayuda →</span>
          </div>

          <!-- Option 5: Notificaciones -->
          <div class="option-card" data-option="notificaciones">
            <div class="card-icon-wrapper gradient-5">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
              </svg>
            </div>
            <h3 class="card-title">Notificaciones</h3>
            <p class="card-description">
              Gestiona tus alertas y preferencias de comunicación.
            </p>
            <span class="card-action">Ver Notificaciones →</span>
          </div>

          <div
            id="admin-panel-card"
            class="option-card"
            data-option="admin"
            style="display: none;"
          >
            <div class="card-icon-wrapper gradient-1">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
            </div>
            <h3 class="card-title">Admin</h3>
            <p class="card-description">
              Herramientas administrativas disponibles para tu cuenta.
            </p>
            <span class="card-action">Abrir Panel →</span>
          </div>
        </div>
      </section>

      <!-- Quick Stats Section -->
      <section class="quick-stats-section">
        <h2 class="section-title">
          <span class="title-icon">📊</span>
          Resumen
        </h2>
        <div class="stats-grid">
          <div class="stat-card">
            <span class="stat-value">0</span>
            <span class="stat-label">Proyectos</span>
          </div>
          <div class="stat-card">
            <span class="stat-value">0</span>
            <span class="stat-label">Pedidos</span>
          </div>
          <div class="stat-card">
            <span class="stat-value">--</span>
            <span class="stat-label">Nivel</span>
          </div>
        </div>
      </section>
    </div>

    <div id="window-admin-overlay" class="window-admin-overlay">
      <div class="window-admin-container">
        <button id="window-admin-close" class="window-admin-close" aria-label="Cerrar">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
        <iframe
          id="window-admin-iframe"
          class="window-admin-iframe"
          src=""
          title="Admin Insano Network"
          allow="payment; clipboard-write"
          loading="lazy"></iframe>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { auth } from "../lib/firebase";
  import {
    GoogleAuthProvider,
    signInWithPopup,
    onAuthStateChanged,
  } from "firebase/auth";

  // DOM Elements
  const loadingEl = document.getElementById("dashboard-loading");
  const notAuthEl = document.getElementById("dashboard-not-auth");
  const contentEl = document.getElementById("dashboard-content");
  const loginBtn = document.getElementById("dashboard-login-btn");

  // User info elements
  const userAvatar = document.getElementById(
    "dashboard-user-avatar",
  ) as HTMLImageElement | null;
  const userName = document.getElementById("dashboard-user-name");
  const userEmail = document.getElementById("dashboard-user-email");

  const adminCard = document.getElementById("admin-panel-card");
  const adminOverlay = document.getElementById("window-admin-overlay");
  const adminCloseBtn = document.getElementById("window-admin-close");
  const adminIframe = document.getElementById(
    "window-admin-iframe",
  ) as HTMLIFrameElement | null;

  const ADMIN_URL = "https://admin.insano.work/app";

  const defaultAvatar =
    "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%23ffd600'%3E%3Cpath d='M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z'/%3E%3C/svg%3E";

  function showState(state: "loading" | "not-auth" | "content") {
    if (loadingEl)
      loadingEl.style.display = state === "loading" ? "flex" : "none";
    if (notAuthEl)
      notAuthEl.style.display = state === "not-auth" ? "flex" : "none";
    if (contentEl)
      contentEl.style.display = state === "content" ? "block" : "none";
  }

  function updateUserInfo(user: any) {
    const photoURL = user.photoURL || defaultAvatar;
    const displayName = user.displayName || "Usuario";
    const email = user.email || "";

    if (userAvatar) userAvatar.src = photoURL;
    if (userName) userName.textContent = `¡Hola, ${displayName}!`;
    if (userEmail) userEmail.textContent = email;
  }

  async function updateAdminVisibility(user: any) {
    if (!adminCard) return;

    const email = (user?.email || "").toString();
    if (!email) {
      adminCard.style.display = "none";
      return;
    }

    try {
      const res = await fetch(
        `/api/permissions/admin?email=${encodeURIComponent(email)}`,
        {
          method: "GET",
          headers: {
            Accept: "application/json",
          },
        },
      );

      if (!res.ok) {
        adminCard.style.display = "none";
        return;
      }

      const data = await res.json();
      adminCard.style.display = data?.allowed ? "block" : "none";
    } catch {
      adminCard.style.display = "none";
    }
  }

  function closeAdminOverlay() {
    if (!adminOverlay || !adminIframe) return;
    adminOverlay.classList.remove("active");
    adminIframe.src = "";
    document.body.style.overflow = "";
  }

  function openAdminOverlay() {
    if (!adminOverlay || !adminIframe) return;
    adminIframe.src = ADMIN_URL;
    adminOverlay.classList.add("active");
    document.body.style.overflow = "hidden";
  }

  // Auth state listener
  onAuthStateChanged(auth, (user) => {
    if (user) {
      updateUserInfo(user);
      updateAdminVisibility(user);
      showState("content");
    } else {
      if (adminCard) adminCard.style.display = "none";
      closeAdminOverlay();
      showState("not-auth");
    }
  });

  // Login button handler
  if (loginBtn) {
    loginBtn.addEventListener("click", async () => {
      const provider = new GoogleAuthProvider();
      try {
        showState("loading");
        await signInWithPopup(auth, provider);
      } catch (error: any) {
        console.error("Login error:", error);
        showState("not-auth");
        if (error.code !== "auth/popup-closed-by-user") {
          alert("Error al iniciar sesión. Por favor intenta de nuevo.");
        }
      }
    });
  }

  // Card click handlers
  const optionCards = document.querySelectorAll(".option-card");
  optionCards.forEach((card) => {
    card.addEventListener("click", () => {
      const option = card.getAttribute("data-option");
      if (option === "admin") {
        openAdminOverlay();
        return;
      }
      // For now, just show an alert - this can be expanded later
      alert(`Funcionalidad "${option}" próximamente disponible.`);
    });
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && adminOverlay?.classList.contains("active")) {
      closeAdminOverlay();
    }
  });

  if (adminCloseBtn) {
    adminCloseBtn.addEventListener("click", closeAdminOverlay);
  }

  if (adminOverlay) {
    adminOverlay.addEventListener("click", (e) => {
      if (e.target === adminOverlay) closeAdminOverlay();
    });
  }
</script>

<style>
  .dashboard-main {
    min-height: calc(100vh - 200px);
    padding: 2rem 1rem;
    margin-top: 2rem;
  }

  /* Loading State */
  .dashboard-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 400px;
    color: #fff;
    gap: 1rem;
  }

  .loading-spinner {
    width: 50px;
    height: 50px;
    border: 4px solid rgba(255, 214, 0, 0.2);
    border-top-color: #ffd600;
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* Not Auth State */
  .dashboard-not-auth {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 400px;
  }

  .not-auth-content {
    text-align: center;
    color: #fff;
    padding: 3rem;
    background: rgba(22, 50, 51, 0.6);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: 24px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    max-width: 400px;
  }

  .lock-icon {
    color: #ffd600;
    margin-bottom: 1.5rem;
    opacity: 0.9;
  }

  .not-auth-content h1 {
    font-size: 1.8rem;
    margin: 0 0 0.5rem;
  }

  .not-auth-content p {
    color: #b0bfc0;
    margin: 0 0 2rem;
  }

  .dashboard-login-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: #fff;
    color: #333;
    border: none;
    border-radius: 12px;
    padding: 0.875rem 1.5rem;
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
  }

  .dashboard-login-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }

  /* Dashboard Content */
  .dashboard-content {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* User Header Section */
  .user-header-section {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    margin-bottom: 2rem;
  }

  .user-header-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(22, 50, 51, 0.9) 0%,
      rgba(255, 214, 0, 0.2) 100%
    );
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .user-header-content {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 2rem;
    color: #fff;
  }

  .user-avatar-large-container {
    position: relative;
  }

  .user-avatar-large {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid #ffd600;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }

  .user-status-indicator {
    position: absolute;
    bottom: 8px;
    right: 8px;
    width: 20px;
    height: 20px;
    background: #4caf50;
    border-radius: 50%;
    border: 3px solid #163233;
  }

  .user-info-main {
    flex: 1;
  }

  .user-name-large {
    font-size: 2rem;
    font-weight: 700;
    margin: 0 0 0.25rem;
  }

  .user-email-large {
    color: #b0bfc0;
    font-size: 1rem;
    margin: 0 0 0.75rem;
  }

  .user-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(255, 214, 0, 0.2);
    color: #ffd600;
    padding: 0.4rem 0.8rem;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 500;
  }

  /* Section Titles */
  .section-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: #fff;
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0 0 1.5rem;
  }

  .title-icon {
    font-size: 1.25rem;
  }

  /* Options Grid */
  .dashboard-options-section {
    margin-bottom: 2.5rem;
  }

  .options-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
  }

  .option-card {
    background: rgba(22, 50, 51, 0.7);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    padding: 1.5rem;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
  }

  .option-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #ffd600, #ff6b35);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }

  .option-card:hover {
    transform: translateY(-8px);
    border-color: rgba(255, 214, 0, 0.3);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
  }

  .option-card:hover::before {
    transform: scaleX(1);
  }

  .card-icon-wrapper {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
    color: #fff;
  }

  .gradient-1 {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  }
  .gradient-2 {
    background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  }
  .gradient-3 {
    background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  }
  .gradient-4 {
    background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
  }
  .gradient-5 {
    background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
  }

  .window-admin-overlay {
    position: fixed;
    inset: 0;
    z-index: 30;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    display: none;
    opacity: 0;
    transition: opacity 0.3s ease;

---
import "../styles/global.css";
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Contacto | Insano Network - Conecta con Nuestro Equipo</title>
  <meta name="description" content="Contacta con Insano Network para proyectos tecnológicos, consultoría o apoyo social. Estamos listos para transformar tu idea en realidad." />
  <meta name="keywords" content="contacto, Insano Network, consulta, proyectos, tecnología, desarrollo web" />
  <meta name="robots" content="index, follow" />
  <link href="https://fonts.googleapis.com" rel="preconnect" />
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
  <link
    href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;800&display=swap"
    rel="stylesheet"
  />
</head>
<body class="min-h-screen bg-slate-950 text-slate-100 py-12 px-4 relative overflow-x-hidden font-sans">
  <!-- Decorative Background Glows -->
  <div class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none z-0">
    <div class="absolute -top-[20%] -left-[10%] w-[50%] h-[50%] bg-blue-600/10 rounded-full blur-[120px]"></div>
    <div class="absolute bottom-[20%] -right-[10%] w-[40%] h-[50%] bg-indigo-600/10 rounded-full blur-[120px]"></div>
  </div>

  <main class="relative z-10">
    <div class="max-w-2xl mx-auto">
      <!-- Back Button -->
      <div id="back-button-container" class="mb-6">
        <a
          href="/"
          id="back-button"
          class="inline-flex items-center gap-2 text-sm font-semibold text-slate-400 hover:text-blue-400 transition-colors duration-200"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Regresar al inicio
        </a>
      </div>

      <!-- Header -->
      <div class="text-center mb-8">
        <h1 class="text-3xl md:text-4xl font-extrabold text-white mb-4 font-outfit tracking-tight">
          Contacta con <span class="bg-gradient-to-r from-blue-400 via-indigo-400 to-purple-400 bg-clip-text text-transparent">Insano Network</span>
        </h1>
        <p class="text-slate-400 text-sm md:text-base max-w-md mx-auto leading-relaxed">
          Estamos listos para escuchar tu proyecto y ayudarte a hacerlo realidad.
        </p>
      </div>

      <!-- Contact Form -->
      <div class="bg-slate-900/40 backdrop-blur-md border border-slate-800 rounded-2xl p-6 md:p-8 shadow-2xl">
        <form
          id="contact-form"
          name="contact"
          data-netlify="true"
          data-netlify-honeypot="bot-field"
          class="space-y-6"
        >
          <!-- Netlify Forms Hidden Inputs -->
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden">
            <label>Don't fill this out if you're human: <input name="bot-field" /></label>
          </p>

          <!-- Name Field -->
          <div>
            <label
              for="name"
              class="block text-sm font-semibold text-slate-300 mb-2"
            >
              Nombre Completo *
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full px-4 py-3 bg-slate-950 border border-slate-800 rounded-lg text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent focus:outline-none transition-all duration-200 placeholder-slate-600"
              placeholder="Tu nombre completo"
            />
          </div>

          <!-- Email Field -->
          <div>
            <label
              for="email"
              class="block text-sm font-semibold text-slate-300 mb-2"
            >
              Correo Electrónico *
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full px-4 py-3 bg-slate-950 border border-slate-800 rounded-lg text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent focus:outline-none transition-all duration-200 placeholder-slate-600"
              placeholder="tu@email.com"
            />
          </div>

          <!-- Phone Field -->
          <div>
            <label
              for="phone"
              class="block text-sm font-semibold text-slate-300 mb-2"
            >
              Teléfono
            </label>
            <input
              type="tel"
              id="phone"
              name="phone"
              class="w-full px-4 py-3 bg-slate-950 border border-slate-800 rounded-lg text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent focus:outline-none transition-all duration-200 placeholder-slate-600"
              placeholder="+52 55 1234 5678"
            />
          </div>

          <!-- Company/Organization -->
          <div>
            <label
              for="company"
              class="block text-sm font-semibold text-slate-300 mb-2"
            >
              Empresa / Organización
            </label>
            <input
              type="text"
              id="company"
              name="company"
              class="w-full px-4 py-3 bg-slate-950 border border-slate-800 rounded-lg text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent focus:outline-none transition-all duration-200 placeholder-slate-600"
              placeholder="Nombre de tu empresa (opcional)"
            />
          </div>

          <!-- Project Type -->
          <div>
            <label
              for="project-type"
              class="block text-sm font-semibold text-slate-300 mb-2"
            >
              Tipo de Proyecto *
            </label>
            <select
              id="project-type"
              name="project-type"
              required
              class="w-full px-4 py-3 bg-slate-950 border border-slate-800 rounded-lg text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent focus:outline-none transition-all duration-200"
            >
              <option value="">Selecciona una opción</option>
              <option value="emprendimiento">Emprendimiento</option>
              <option value="desarrollo-web">Desarrollo Web</option>
              <option value="software">Software a Medida</option>
              <option value="marketing">Marketing Digital</option>
              <option value="diseno">Diseño Gráfico</option>
              <option value="consultoria">Consultoría TI</option>
              <option value="fundacion">Fundación / Proyecto Social</option>
              <option value="otro">Otro</option>
            </select>
          </div>

          <!-- Budget -->
          <div>
            <label
              for="budget"
              class="block text-sm font-semibold text-slate-300 mb-2"
            >
              Presupuesto Estimado
            </label>
            <select
              id="budget"
              name="budget"
              class="w-full px-4 py-3 bg-slate-950 border border-slate-800 rounded-lg text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent focus:outline-none transition-all duration-200"
            >
              <option value="">Selecciona una opción</option>
              <option value="menos-10k">Menos de $10,000</option>
              <option value="10k-25k">$10,000 - $25,000</option>
              <option value="25k-50k">$25,000 - $50,000</option>
              <option value="50k-100k">$50,000 - $100,000</option>
              <option value="mas-100k">Más de $100,000</option>
              <option value="por-definir">Por definir</option>
            </select>
          </div>

          <!-- Message -->
          <div>
            <label
              for="message"
              class="block text-sm font-semibold text-slate-300 mb-2"
            >
              Describe tu proyecto *
            </label>
            <textarea
              id="message"
              name="message"
              required
              rows="5"
              class="w-full px-4 py-3 bg-slate-950 border border-slate-800 rounded-lg text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent focus:outline-none transition-all duration-200 placeholder-slate-650"
              placeholder="Cuéntanos sobre tu proyecto, objetivos y qué necesitas..."
            ></textarea>
          </div>

          <!-- How did you hear about us -->
          <div>
            <label
              for="source"
              class="block text-sm font-semibold text-slate-300 mb-2"
            >
              ¿Cómo nos conociste?
            </label>
            <select
              id="source"
              name="source"
              class="w-full px-4 py-3 bg-slate-950 border border-slate-800 rounded-lg text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent focus:outline-none transition-all duration-200"
            >
              <option value="">Selecciona una opción</option>
              <option value="google">Google / Búsqueda</option>
              <option value="redes-sociales">Redes Sociales</option>
              <option value="recomendacion">Recomendación</option>
              <option value="web">Nuestra página web</option>
              <option value="evento">Evento o conferencia</option>
              <option value="otro">Otro</option>
            </select>
          </div>

          <!-- Terms and Privacy -->
          <div class="space-y-4">
            <label class="flex items-start cursor-pointer select-none">
              <input
                type="checkbox"
                name="terms"
                required
                class="mt-1 w-4 h-4 text-blue-600 border-slate-800 bg-slate-950 rounded focus:ring-blue-500 focus:ring-offset-slate-950"
              />
              <span class="ml-2 text-sm text-slate-400">
                Acepto los <a
                  href="/terminos"
                  class="text-blue-400 hover:text-blue-300 hover:underline">términos y condiciones</a
                >
                y la <a href="/privacidad" class="text-blue-400 hover:text-blue-300 hover:underline"
                  >política de privacidad</a
                > *
              </span>
            </label>

            <label class="flex items-start cursor-pointer select-none">
              <input
                type="checkbox"
                name="newsletter"
                class="mt-1 w-4 h-4 text-blue-600 border-slate-800 bg-slate-950 rounded focus:ring-blue-500 focus:ring-offset-slate-950"
              />
              <span class="ml-2 text-sm text-slate-400">
                Deseo recibir información sobre proyectos, servicios y novedades
                de Insano Network
              </span>
            </label>
          </div>

          <!-- Submit Button -->
          <div>
            <button
              type="submit"
              class="w-full bg-blue-600 hover:bg-blue-500 text-white font-bold py-4 px-6 rounded-lg transition-all duration-300 transform hover:scale-[1.01] focus:outline-none focus:ring-2 focus:ring-blue-500"
            >
              Enviar Mensaje
            </button>
          </div>
        </form>

        <!-- Alternative Contact Methods -->
        <div class="mt-8 pt-8 border-t border-slate-800/80">
          <p class="text-center text-slate-450 mb-4 text-sm font-semibold">
            ¿Prefieres contactarnos directamente?
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="mailto:contacto@insanonetwork.com"
              class="inline-flex items-center justify-center px-6 py-3 border border-slate-800 text-slate-300 rounded-lg hover:bg-slate-950 transition-colors duration-200 font-semibold"
            >
              📧 contacto@insanonetwork.com
            </a>
            <a
              href="tel:+525542965463"
              class="inline-flex items-center justify-center px-6 py-3 border border-slate-800 text-slate-300 rounded-lg hover:bg-slate-950 transition-colors duration-200 font-semibold"
            >
              📞 +52 55 4296 5463
            </a>
          </div>
        </div>
      </div>

      <!-- Info Section -->
      <div class="mt-12 text-center">
        <div class="bg-slate-900/30 border border-slate-850 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-white mb-3 font-outfit">
            🚀 ¿Qué sucede después de contactarnos?
          </h3>
          <div
            class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs text-slate-400"
          >
            <div class="p-3 bg-slate-950/40 rounded-xl border border-slate-900">
              <span class="block font-bold text-blue-400 mb-1 text-sm"
                >1. Revisión</span
              >
              Analizamos tu proyecto en 24-48 horas
            </div>
            <div class="p-3 bg-slate-950/40 rounded-xl border border-slate-900">
              <span class="block font-bold text-blue-400 mb-1 text-sm"
                >2. Contacto</span
              >
              Te respondemos con propuestas y preguntas
            </div>
            <div class="p-3 bg-slate-950/40 rounded-xl border border-slate-900">
              <span class="block font-bold text-blue-400 mb-1 text-sm">3. Inicio</span
              >
              Comenzamos a trabajar juntos en tu proyecto
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script>
    // Detectar si está en un iframe o si se pasa un parámetro de query modal/iframe
    const isIframe = window.self !== window.top ||
                    window.location.search.includes("iframe=true") ||
                    window.location.search.includes("modal=true");

    if (isIframe) {
      const backButtonContainer = document.getElementById("back-button-container");
      if (backButtonContainer) {
        backButtonContainer.classList.add("hidden");
      }
    }

    document
      .getElementById("contact-form")
      .addEventListener("submit", async function (e) {
        e.preventDefault();

        const formData = new FormData(this);
        const body = new URLSearchParams(formData).toString();

        // Mostrar estado de carga
        const submitButton = this.querySelector('button[type="submit"]');
        const originalText = submitButton.textContent;
        submitButton.textContent = "Enviando...";
        submitButton.disabled = true;

        try {
          // Envío vía AJAX compatible con Netlify Forms
          const response = await fetch("/", {
            method: "POST",
            headers: { "Content-Type": "application/x-www-form-urlencoded" },
            body: body,
          });

          if (response.ok) {
            // Mostrar mensaje de éxito
            alert(
              "¡Mensaje enviado correctamente! Nos pondremos en contacto contigo pronto.",
            );
            this.reset();

            // Si está en un modal, enviar un mensaje al padre para cerrarlo
            if (window.location.search.includes("modal=true")) {
              window.parent.postMessage("close-modal", "*");
            }
          } else {
            throw new Error("Error en la respuesta de Netlify");
          }
        } catch (error) {
          alert(
            "Hubo un error al enviar el mensaje. Por favor, inténtalo de nuevo.",
          );
          console.error("Error:", error);
        } finally {
          submitButton.textContent = originalText;
          submitButton.disabled = false;
        }
      });
  </script>
</body>
</html>

---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contacto | Insano Network - Conecta con Nuestro Equipo"
  description="Contacta con Insano Network para proyectos tecnológicos, consultoría o apoyo social. Estamos listos para transformar tu idea en realidad."
  keywords="contacto, Insano Network, consulta, proyectos, tecnología, desarrollo web"
>
  <main class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 py-12 px-4">
    <div class="max-w-2xl mx-auto">
      <!-- Header -->
      <div class="text-center mb-8">
        <h1 class="text-3xl font-bold text-gray-900 mb-4">
          Contacta con <span class="text-blue-600">Insano Network</span>
        </h1>
        <p class="text-lg text-gray-600">
          Estamos listos para escuchar tu proyecto y ayudarte a hacerlo realidad
        </p>
      </div>

      <!-- Contact Form -->
      <div class="bg-white rounded-xl shadow-lg p-8">
        <form id="contact-form" class="space-y-6">
          <!-- Name Field -->
          <div>
            <label for="name" class="block text-sm font-medium text-gray-700 mb-2">
              Nombre Completo *
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
              placeholder="Tu nombre completo"
            />
          </div>

          <!-- Email Field -->
          <div>
            <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
              Correo Electrónico *
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
              placeholder="tu@email.com"
            />
          </div>

          <!-- Phone Field -->
          <div>
            <label for="phone" class="block text-sm font-medium text-gray-700 mb-2">
              Teléfono
            </label>
            <input
              type="tel"
              id="phone"
              name="phone"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
              placeholder="+52 55 1234 5678"
            />
          </div>

          <!-- Company/Organization -->
          <div>
            <label for="company" class="block text-sm font-medium text-gray-700 mb-2">
              Empresa / Organización
            </label>
            <input
              type="text"
              id="company"
              name="company"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
              placeholder="Nombre de tu empresa (opcional)"
            />
          </div>

          <!-- Project Type -->
          <div>
            <label for="project-type" class="block text-sm font-medium text-gray-700 mb-2">
              Tipo de Proyecto *
            </label>
            <select
              id="project-type"
              name="project-type"
              required
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
            >
              <option value="">Selecciona una opción</option>
              <option value="emprendimiento">Emprendimiento</option>
              <option value="desarrollo-web">Desarrollo Web</option>
              <option value="software">Software a Medida</option>
              <option value="marketing">Marketing Digital</option>
              <option value="diseno">Diseño Gráfico</option>
              <option value="consultoria">Consultoría TI</option>
              <option value="fundacion">Fundación / Proyecto Social</option>
              <option value="otro">Otro</option>
            </select>
          </div>

          <!-- Budget -->
          <div>
            <label for="budget" class="block text-sm font-medium text-gray-700 mb-2">
              Presupuesto Estimado
            </label>
            <select
              id="budget"
              name="budget"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
            >
              <option value="">Selecciona una opción</option>
              <option value="menos-10k">Menos de $10,000</option>
              <option value="10k-25k">$10,000 - $25,000</option>
              <option value="25k-50k">$25,000 - $50,000</option>
              <option value="50k-100k">$50,000 - $100,000</option>
              <option value="mas-100k">Más de $100,000</option>
              <option value="por-definir">Por definir</option>
            </select>
          </div>

          <!-- Message -->
          <div>
            <label for="message" class="block text-sm font-medium text-gray-700 mb-2">
              Describe tu proyecto *
            </label>
            <textarea
              id="message"
              name="message"
              required
              rows="5"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
              placeholder="Cuéntanos sobre tu proyecto, objetivos y qué necesitas..."
            ></textarea>
          </div>

          <!-- How did you hear about us -->
          <div>
            <label for="source" class="block text-sm font-medium text-gray-700 mb-2">
              ¿Cómo nos conociste?
            </label>
            <select
              id="source"
              name="source"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
            >
              <option value="">Selecciona una opción</option>
              <option value="google">Google / Búsqueda</option>
              <option value="redes-sociales">Redes Sociales</option>
              <option value="recomendacion">Recomendación</option>
              <option value="web">Nuestra página web</option>
              <option value="evento">Evento o conferencia</option>
              <option value="otro">Otro</option>
            </select>
          </div>

          <!-- Terms and Privacy -->
          <div class="space-y-4">
            <label class="flex items-start">
              <input
                type="checkbox"
                name="terms"
                required
                class="mt-1 w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
              />
              <span class="ml-2 text-sm text-gray-600">
                Acepto los <a href="/terminos" class="text-blue-600 hover:underline">términos y condiciones</a> 
                y la <a href="/privacidad" class="text-blue-600 hover:underline">política de privacidad</a> *
              </span>
            </label>

            <label class="flex items-start">
              <input
                type="checkbox"
                name="newsletter"
                class="mt-1 w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
              />
              <span class="ml-2 text-sm text-gray-600">
                Deseo recibir información sobre proyectos, servicios y novedades de Insano Network
              </span>
            </label>
          </div>

          <!-- Submit Button -->
          <div>
            <button
              type="submit"
              class="w-full bg-blue-600 text-white font-semibold py-4 px-6 rounded-lg hover:bg-blue-700 transition-all duration-300 transform hover:scale-[1.02] focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
            >
              Enviar Mensaje
            </button>
          </div>
        </form>

        <!-- Alternative Contact Methods -->
        <div class="mt-8 pt-8 border-t border-gray-200">
          <p class="text-center text-gray-600 mb-4">
            ¿Prefieres contactarnos directamente?
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="mailto:contacto@insanonetwork.com"
              class="inline-flex items-center justify-center px-6 py-3 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors duration-200"
            >
              📧 contacto@insanonetwork.com
            </a>
            <a
              href="tel:+525542965463"
              class="inline-flex items-center justify-center px-6 py-3 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors duration-200"
            >
              📞 +52 55 4296 5463
            </a>
          </div>
        </div>
      </div>

      <!-- Info Section -->
      <div class="mt-12 text-center">
        <div class="bg-blue-50 rounded-xl p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-3">
            🚀 ¿Qué sucede después de contactarnos?
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm text-gray-600">
            <div>
              <span class="block font-semibold text-blue-600 mb-1">1. Revisión</span>
              Analizamos tu proyecto en 24-48 horas
            </div>
            <div>
              <span class="block font-semibold text-blue-600 mb-1">2. Contacto</span>
              Te respondemos con propuestas y preguntas
            </div>
            <div>
              <span class="block font-semibold text-blue-600 mb-1">3. Inicio</span>
              Comenzamos a trabajar juntos en tu proyecto
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script>
    document.getElementById('contact-form').addEventListener('submit', async function(e) {
      e.preventDefault();
      
      const formData = new FormData(this);
      const data = Object.fromEntries(formData);
      
      // Mostrar estado de carga
      const submitButton = this.querySelector('button[type="submit"]');
      const originalText = submitButton.textContent;
      submitButton.textContent = 'Enviando...';
      submitButton.disabled = true;
      
      try {
        // Aquí puedes integrar con tu servicio de backend
        // Por ahora, simulamos el envío
        await new Promise(resolve => setTimeout(resolve, 2000));
        
        // Mostrar mensaje de éxito
        alert('¡Mensaje enviado correctamente! Nos pondremos en contacto contigo pronto.');
        this.reset();
        
        // Si está en un modal, cerrarlo
        if (window.location.search.includes('modal=true')) {
          window.parent.postMessage('close-modal', '*');
        }
        
      } catch (error) {
        alert('Hubo un error al enviar el mensaje. Por favor, inténtalo de nuevo.');
        console.error('Error:', error);
      } finally {
        submitButton.textContent = originalText;
        submitButton.disabled = false;
      }
    });
  </script>
</Layout>

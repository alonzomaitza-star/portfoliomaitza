---
import Layout from '../layouts/Layout.astro';
import "../styles/global.css";
import CardShop from "../components/CardShop.astro";
import SEO from "../components/SEO.astro";

import ImgSlider from '../assets/SlideImages/Insano Network-Slider 1.jpg';
import ImgSlider2 from '../assets/SlideImages/Insano Network-Slider 2.jpg';
import ImgSlider3 from '../assets/SlideImages/Insano Network-Slider 3.png';

const capacitacionEmpresarial = [
  { id: 1, titulo: "Python Empresarial", descripcion: "Capacitación en Python para equipos de desarrollo y análisis de datos.", imagen: ImgSlider.src, precio: 9999, etiqueta: "Tecnología" },
  { id: 2, titulo: "Excel para Equipos", descripcion: "Capacitación a medida en Excel para equipos corporativos y escolares.", imagen: ImgSlider2.src, precio: 7999, etiqueta: "Popular" },
  { id: 3, titulo: "Desarrollo Web Corporativo", descripcion: "Formación en desarrollo web para equipos de proyectos empresariales.", imagen: ImgSlider3.src, precio: 12999, etiqueta: "Desarrollo" },
  { id: 4, titulo: "Informática Básica", descripcion: "Capacitación fundamental en informática para equipos escolares y empresariales.", imagen: ImgSlider.src, precio: 4999, etiqueta: "Básico" },
  { id: 5, titulo: "Soft Skills para Teams", descripcion: "Habilidades blandas y comunicación efectiva para equipos de trabajo.", imagen: ImgSlider2.src, precio: 6999, etiqueta: "Soft Skills" },
  { id: 6, titulo: "Programas Híbridos", descripcion: "Capacitación mixta (presencial/virtual) personalizada para tu organización.", imagen: ImgSlider3.src, precio: 8999, etiqueta: "Flexible" }
];
---

<Layout>
  <main>
    <!-- Hero Section -->
    <section class="py-14">
      <div class="container mx-auto px-4">
        <h1 class="text-3xl md:text-4xl font-extrabold text-white text-center">Capacitación de Equipos y Empresarial</h1>
        <p class="text-base md:text-lg text-gray-200 text-center mt-2 max-w-3xl mx-auto">Capacita a tu equipo o grupo escolar con programas a medida. Desde informática básica hasta desarrollo de software, Python y habilidades blandas. Formación para equipos reducidos o grandes grupos.</p>

        <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-white/90 rounded-xl p-6 shadow border border-gray-200">
            <h3 class="text-xl font-bold">Diagnóstico</h3>
            <p class="text-gray-700 mt-2">Evaluamos las necesidades específicas de tu organización para diseñar programas efectivos.</p>
          </div>
          <div class="bg-white/90 rounded-xl p-6 shadow border border-gray-200">
            <h3 class="text-xl font-bold">Ejecución</h3>
            <p class="text-gray-700 mt-2">Implementamos programas interactivos con metodologías de aprendizaje moderno.</p>
          </div>
          <div class="bg-white/90 rounded-xl p-6 shadow border border-gray-200">
            <h3 class="text-xl font-bold">Seguimiento</h3>
            <p class="text-gray-700 mt-2">Medimos el impacto y aseguramos la aplicación práctica de lo aprendido.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Programas Destacados -->
    <section class="py-14 bg-gray-100">
      <div class="container mx-auto px-4">
        <h2 class="text-2xl md:text-3xl font-bold text-center mb-8">Programas Corporativos</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {capacitacionEmpresarial.map(programa => (
            <CardShop 
              key={programa.id}
              titulo={programa.titulo}
              descripcion={programa.descripcion}
              imagen={programa.imagen}
              precio={programa.precio}
              etiqueta={programa.etiqueta}
            />
          ))}
        </div>
      </div>
    </section>

    <!-- Modalidades de Capacitación -->
    <section class="py-14">
      <div class="container mx-auto px-4">
        <h2 class="text-2xl md:text-3xl font-bold text-center mb-8 text-white">Modalidades de Capacitación</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="bg-white/90 rounded-xl p-8 shadow border border-gray-200">
            <h3 class="text-xl font-bold mb-4">In Company</h3>
            <ul class="space-y-2 text-gray-700">
              <li>• Programas personalizados</li>
              <li>• En tus instalaciones</li>
              <li>• Horarios flexibles</li>
              <li>• Contenido adaptado</li>
            </ul>
          </div>
          
          <div class="bg-white/90 rounded-xl p-8 shadow border border-gray-200">
            <h3 class="text-xl font-bold mb-4">Virtual</h3>
            <ul class="space-y-2 text-gray-700">
              <li>• Plataforma interactiva</li>
              <li>• Acceso remoto</li>
              <li>• Grabaciones disponibles</li>
              <li>• Material digital</li>
            </ul>
          </div>
          
          <div class="bg-white/90 rounded-xl p-8 shadow border border-gray-200">
            <h3 class="text-xl font-bold mb-4">Híbrido</h3>
            <ul class="space-y-2 text-gray-700">
              <li>• Combinación de modalidades</li>
              <li>• Flexibilidad máxima</li>
              <li>• Sesiones presenciales</li>
              <li>• Refuerzo online</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Áreas de Especialización -->
    <section class="py-14 bg-gray-100">
      <div class="container mx-auto px-4">
        <h2 class="text-2xl md:text-3xl font-bold text-center mb-8">Áreas de Especialización</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="bg-white rounded-xl p-6 shadow border border-gray-200 text-center">
            <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A9.002 9.002 0 0112 21c-4.476 0-8.268-3.12-9.255-7.255M12 3a9.002 9.002 0 019.255 7.255M12 3v6m0 6v6"></path>
              </svg>
            </div>
            <h3 class="font-bold mb-2">Liderazgo</h3>
            <p class="text-sm text-gray-600">Desarrollo de habilidades directivas</p>
          </div>
          
          <div class="bg-white rounded-xl p-6 shadow border border-gray-200 text-center">
            <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
              </svg>
            </div>
            <h3 class="font-bold mb-2">Trabajo en Equipo</h3>
            <p class="text-sm text-gray-600">Colaboración y sinergia</p>
          </div>
          
          <div class="bg-white rounded-xl p-6 shadow border border-gray-200 text-center">
            <div class="w-16 h-16 bg-purple-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
              </svg>
            </div>
            <h3 class="font-bold mb-2">Innovación</h3>
            <p class="text-sm text-gray-600">Creatividad y pensamiento disruptivo</p>
          </div>
          
          <div class="bg-white rounded-xl p-6 shadow border border-gray-200 text-center">
            <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <h3 class="font-bold mb-2">Productividad</h3>
            <p class="text-sm text-gray-600">Optimización de procesos</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Llamada a la Acción -->
    <section class="py-14">
      <div class="container mx-auto px-4 text-center">
        <h2 class="text-2xl md:text-3xl font-bold mb-4 text-white">Transforma tu Equipo Hoy</h2>
        <p class="text-gray-200 max-w-2xl mx-auto mb-8">Contáctanos para diseñar un programa de capacitación a medida para las necesidades específicas de tu organización.</p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="#chat-assistant" class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
            Solicitar Cotización
          </a>
          <a href="/nosotros" class="px-6 py-3 bg-gray-600 text-white rounded-lg hover:bg-gray-700 transition-colors">
            Conocer Más
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

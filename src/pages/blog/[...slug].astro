---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

import ImgBalon from "../../assets/publicidad/balon.png";
import ImgFrazadas from "../../assets/publicidad/frazadas.png";
import ImgLonas from "../../assets/publicidad/lonas.png";
import ImgTarros from "../../assets/publicidad/tarros.png";
import ImgTazas from "../../assets/publicidad/tazas.png";

const adImages = [ImgBalon, ImgFrazadas, ImgLonas, ImgTarros, ImgTazas];
// Rotar la imagen según el slug del post para que cada post tenga una diferente
function getAdIndex(slug: string, offset: number) {
  let hash = 0;
  for (const c of slug) hash = (hash * 31 + c.charCodeAt(0)) | 0;
  return Math.abs(hash + offset) % adImages.length;
}

export const prerender = true;
export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const slug = post.slug;

const readingTime = post.data.readingTime || 5;
const formattedDate = new Date(post.data.pubDate).toLocaleDateString("es-ES", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const heroImg = post.data.heroImage || post.data.image || null;
const adMobile = adImages[getAdIndex(slug, 0)];
const adLeft1 = adImages[getAdIndex(slug, 1)];
const adLeft2 = adImages[getAdIndex(slug, 2)];
const adRight1 = adImages[getAdIndex(slug, 3)];
---

<Layout
  title={`${post.data.title} | Blog`}
  description={post.data.description}
  ogImage={heroImg}
>
  <div class="relative flex min-h-screen justify-center py-12 px-4 sm:px-6 lg:px-8 gap-6">

    <!-- ── Aside izquierdo — solo desktop ── -->
    <aside class="hidden lg:flex flex-col w-56 shrink-0 gap-6 sticky top-24 self-start">
      <div class="rounded-xl overflow-hidden border border-white/10">
        <img src={adLeft1.src} alt="Publicidad" class="w-full h-auto object-contain" loading="lazy" />
      </div>
      <div class="rounded-xl overflow-hidden border border-white/10">
        <img src={adLeft2.src} alt="Publicidad" class="w-full h-auto object-contain" loading="lazy" />
      </div>
    </aside>

    <!-- ── Artículo principal ── -->
    <article class="w-full max-w-3xl min-w-0">

      <!-- Breadcrumb -->
      <nav class="mb-6 flex items-center gap-2 text-sm text-white/40">
        <a href="/" class="hover:text-white/70 transition-colors">Inicio</a>
        <span>/</span>
        <a href="/blog" class="hover:text-white/70 transition-colors">Blog</a>
        <span>/</span>
        <span class="text-white/60 truncate max-w-xs">{post.data.title}</span>
      </nav>

      <header class="mb-8">

        <!-- Categoría y tiempo de lectura -->
        <div class="flex items-center gap-3 mb-4 flex-wrap">
          {post.data.category && (
            <span class="inline-flex items-center rounded-full bg-blue-500/20 border border-blue-400/30 px-3 py-1 text-xs font-semibold text-blue-300 uppercase tracking-wider">
              {post.data.category}
            </span>
          )}
          <span class="flex items-center gap-1.5 text-xs text-white/40">
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            {readingTime} min de lectura
          </span>
        </div>

        <!-- Título -->
        <h1 class="mb-4 text-3xl sm:text-4xl font-extrabold tracking-tight text-white leading-tight">
          {post.data.title}
        </h1>

        <!-- Descripción / Bajada -->
        <p class="text-lg text-white/60 leading-relaxed mb-5">
          {post.data.description}
        </p>

        <!-- Metadatos: fecha y autor -->
        <div class="flex items-center gap-3 text-sm text-white/40 border-t border-white/10 pt-4">
          <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
          {post.data.author && (
            <>
              <span class="text-white/20">•</span>
              <span>{post.data.author}</span>
            </>
          )}
        </div>

        <!-- Imagen hero -->
        {heroImg && (
          <img
            src={heroImg}
            alt={post.data.title}
            class="mt-6 w-full rounded-2xl object-cover shadow-2xl shadow-black/40 max-h-96"
            loading="lazy"
          />
        )}

      </header>

      <!-- Contenido Markdown -->
      <div class="blog-content" id="blog-content">
        <Content />
      </div>

      <!-- Publicidad mobile: se inserta a la mitad del contenido por JS -->
      <template id="mobile-ad-template">
        <div class="mobile-ad-inline block lg:hidden" style="margin: 2rem auto; max-width: 320px;">
          <div style="border-radius: 0.75rem; overflow: hidden; border: 1px solid rgba(255,255,255,0.1);">
            <img src={adMobile.src} alt="Publicidad" style="width: 100%; height: auto; display: block;" loading="lazy" />
          </div>
        </div>
      </template>

      <script>
        // Insertar publicidad a la mitad del contenido para dispositivos móviles
        const content = document.getElementById('blog-content');
        const template = document.getElementById('mobile-ad-template') as HTMLTemplateElement | null;
        
        if (content && template) {
          // Buscar todos los párrafos de primer nivel dentro de .blog-content
          const paragraphs = Array.from(content.children).filter(
            (el) => el.tagName.toLowerCase() === 'p'
          );
          
          if (paragraphs.length >= 2) {
            const middleIndex = Math.floor(paragraphs.length / 2);
            const targetParagraph = paragraphs[middleIndex - 1];
            
            const adContent = template.content.cloneNode(true);
            // Insertar después del párrafo seleccionado
            targetParagraph.parentNode?.insertBefore(adContent, targetParagraph.nextSibling);
          } else if (paragraphs.length === 1) {
            const adContent = template.content.cloneNode(true);
            content.appendChild(adContent);
          }
        }
      </script>

      <!-- Tags -->
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="mt-10 pt-6 border-t border-white/10">
          <p class="text-xs font-semibold uppercase tracking-widest text-white/30 mb-3">Etiquetas</p>
          <div class="flex flex-wrap gap-2">
            {post.data.tags.map((tag) => (
              <span class="inline-flex items-center rounded-full bg-white/8 border border-white/15 px-3 py-1 text-sm text-white/60">
                #{tag}
              </span>
            ))}
          </div>
        </div>
      )}

      <!-- Volver al blog -->
      <div class="mt-10">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 text-sm text-white/50 hover:text-white transition-colors"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          Volver al Blog
        </a>
      </div>

    </article>

    <!-- ── Aside derecho — solo desktop ── -->
    <aside class="hidden lg:flex flex-col w-56 shrink-0 gap-6 sticky top-24 self-start">
      <div class="rounded-xl overflow-hidden border border-white/10">
        <img src={adRight1.src} alt="Publicidad" class="w-full h-auto object-contain" loading="lazy" />
      </div>
      <div class="rounded-xl border border-white/10 bg-white/5 backdrop-blur-sm p-5 flex flex-col gap-4">
        <p class="text-xs font-semibold uppercase tracking-widest text-white/30">¿Te podemos ayudar?</p>
        <p class="text-sm text-white/60 leading-relaxed">Diseño, impresión y entrega de productos personalizados para tu negocio.</p>
        <a
          href="/contact-form"
          class="block text-center rounded-lg bg-blue-600 hover:bg-blue-500 text-white text-sm font-semibold py-2.5 px-4 transition-colors"
        >
          Cotizar ahora
        </a>
      </div>
    </aside>

  </div>
</Layout>

<style>
  /* ── Blog content — Colores legibles sobre fondo oscuro ── */
  .blog-content {
    max-width: none;
    font-size: 1.125rem;
    line-height: 1.8;
  }

  /* Párrafos */
  .blog-content :global(p) {
    color: rgba(255, 255, 255, 0.78);
    margin-bottom: 1.25rem;
    line-height: 1.8;
  }

  /* Headings */
  .blog-content :global(h1),
  .blog-content :global(h2),
  .blog-content :global(h3),
  .blog-content :global(h4) {
    color: #ffffff;
    font-weight: 700;
  }

  .blog-content :global(h2) {
    font-size: 1.5rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .blog-content :global(h3) {
    font-size: 1.25rem;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
  }

  /* Listas */
  .blog-content :global(ul),
  .blog-content :global(ol) {
    color: rgba(255, 255, 255, 0.75);
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .blog-content :global(li) {
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: 0.5rem;
  }

  .blog-content :global(li)::marker {
    color: rgba(255, 255, 255, 0.35);
  }

  /* Negritas */
  .blog-content :global(strong) {
    color: #ffffff;
    font-weight: 600;
  }

  /* Links */
  .blog-content :global(a) {
    color: #60a5fa;
    text-decoration: none;
    transition: color 0.2s;
  }

  .blog-content :global(a:hover) {
    color: #93c5fd;
  }

  /* Blockquotes */
  .blog-content :global(blockquote) {
    border-left: 3px solid #3b82f6;
    padding-left: 1rem;
    color: rgba(255, 255, 255, 0.55);
    font-style: italic;
    margin: 1.5rem 0;
  }

  /* Tablas */
  .blog-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
  }

  .blog-content :global(th) {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
    padding: 0.75rem 1rem;
    text-align: left;
    font-weight: 600;
    font-size: 0.875rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .blog-content :global(td) {
    color: rgba(255, 255, 255, 0.75);
    padding: 0.625rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    font-size: 0.9375rem;
  }

  .blog-content :global(tr:hover td) {
    background: rgba(255, 255, 255, 0.03);
  }

  /* Código inline */
  .blog-content :global(code) {
    color: #93c5fd;
    background: rgba(255, 255, 255, 0.08);
    padding: 0.15rem 0.4rem;
    border-radius: 0.25rem;
    font-size: 0.875em;
  }

  /* Separadores */
  .blog-content :global(hr) {
    border-color: rgba(255, 255, 255, 0.1);
    margin: 2rem 0;
  }

  /* Imágenes dentro del contenido */
  .blog-content :global(img) {
    border-radius: 0.75rem;
    margin: 1.5rem 0;
  }
</style>

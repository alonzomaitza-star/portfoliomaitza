---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
export const prerender = true;
export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const readingTime = post.data.readingTime || 5;
const formattedDate = new Date(post.data.pubDate).toLocaleDateString("es-ES", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Layout
  title={`${post.data.title} | Blog`}
  description={post.data.description}
  ogImage={post.data.heroImage || post.data.image}
>
  <div
    class="relative flex min-h-screen justify-center py-12 px-4 sm:px-6 lg:px-8"
  >
    <!-- Left Aside Bar (Publicidad) -->
    <aside class="hidden lg:block w-1/5 pr-8 sticky top-20 h-full">
      <div
        class="bg-blue-200 p-4 rounded-lg shadow-md mb-8 h-64 flex items-center justify-center text-blue-800 font-bold"
      >
        Publicidad Izquierda 1
      </div>
      <div
        class="bg-blue-300 p-4 rounded-lg shadow-md h-48 flex items-center justify-center text-blue-900 font-bold"
      >
        Publicidad Izquierda 2
      </div>
    </aside>

    <article class="text-white mx-auto max-w-3xl flex-grow">
      <header class="mb-8">
        <h1
          class="mb-4 text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl"
        >
          {post.data.title}
        </h1>

        <div class="mt-6 flex items-center text-sm text-gray-500">
          <time
            datetime={post.data.pubDate.toISOString()}
            class="flex items-center"
          >
            <svg
              class="mr-1.5 h-5 w-5 flex-shrink-0 text-gray-400"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
              ></path>
            </svg>
            {formattedDate}
          </time>
          <span class="mx-2"> • </span>
          <span class="flex items-center">
            <svg
              class="mr-1.5 h-5 w-5 flex-shrink-0 text-gray-400"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            {readingTime} min de lectura
          </span>
        </div>

        {
          post.data.image && (
            <img
              src={post.data.image}
              alt={post.data.title}
              class="mt-6 w-full rounded-lg object-cover shadow-lg"
              loading="lazy"
            />
          )
        }
      </header>

      <div class="prose prose-lg max-w-none text-gray-600">
        <Content />
      </div>

      {
        post.data.tags && post.data.tags.length > 0 && (
          <div class="mt-8 pt-6 border-t border-gray-200">
            <div class="flex flex-wrap gap-2">
              {post.data.tags.map((tag) => (
                <a
                  href={`/blog/tags/${tag.toLowerCase()}`}
                  class="inline-flex items-center rounded-full bg-gray-100 px-3 py-1 text-sm font-medium text-gray-600 hover:bg-gray-200"
                >
                  #{tag}
                </a>
              ))}
            </div>
          </div>
        )
      }
    </article>

    <!-- Right Aside Bar (Publicidad) -->
    <aside class="hidden lg:block w-1/5 pl-8 sticky top-20 h-full">
      <div
        class="bg-green-200 p-4 rounded-lg shadow-md mb-8 h-64 flex items-center justify-center text-green-800 font-bold"
      >
        Publicidad Derecha 1
      </div>
      <div
        class="bg-green-300 p-4 rounded-lg shadow-md h-48 flex items-center justify-center text-green-900 font-bold"
      >
        Publicidad Derecha 2
      </div>
    </aside>
  </div>
</Layout>

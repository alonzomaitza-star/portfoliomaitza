---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostList from '../../components/blog/PostList.astro';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const pageTitle = 'Blog — Insano Network';
const pageDescription = 'Casos de éxito, guías de marketing, branding, productos personalizados y recursos para hacer crecer tu negocio.';

const categories = ['Todos', ...new Set(posts.map(p => p.data.category).filter(Boolean))];
---

<Layout title={pageTitle} description={pageDescription}>

  <!-- Hero del Blog -->
  <section class="relative pt-20 pb-14 px-4 sm:px-6 text-center overflow-hidden">
    <!-- Glow decorativo -->
    <div class="pointer-events-none absolute inset-x-0 top-0 -z-0 flex justify-center">
      <div class="h-64 w-96 rounded-full bg-blue-600/20 blur-3xl"></div>
    </div>

    <div class="relative z-10 mx-auto max-w-3xl">
      <span class="inline-flex items-center rounded-full border border-blue-400/30 bg-blue-500/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-blue-300 mb-6">
        Blog Insano Network
      </span>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-white mb-4 leading-tight">
        Ideas, casos y recursos<br class="hidden sm:block" /> para tu negocio
      </h1>
      <p class="text-lg text-white/55 max-w-2xl mx-auto leading-relaxed">
        {pageDescription}
      </p>
    </div>
  </section>

  <!-- Filtros de categoría -->
  <section class="px-4 sm:px-6 pb-8">
    <div class="mx-auto max-w-7xl flex flex-wrap gap-2 justify-center">
      {categories.map((cat) => (
        <button
          data-category={cat}
          class="category-filter inline-flex items-center rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-sm text-white/60 transition-all hover:border-white/30 hover:text-white cursor-pointer"
        >
          {cat}
        </button>
      ))}
    </div>
  </section>

  <!-- Grid de posts -->
  <section class="px-4 sm:px-6 pb-20">
    <div class="mx-auto max-w-7xl">
      {posts.length > 0 ? (
        <PostList posts={posts} />
      ) : (
        <div class="text-center py-20">
          <div class="mx-auto mb-4 h-16 w-16 rounded-full bg-white/5 flex items-center justify-center">
            <svg class="h-8 w-8 text-white/20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
            </svg>
          </div>
          <p class="text-white/40 text-sm">Pronto publicaremos el primer artículo.</p>
        </div>
      )}
    </div>
  </section>

</Layout>

<script>
  // Filtro de categorías en cliente
  const filters = document.querySelectorAll<HTMLButtonElement>('.category-filter');
  const articles = document.querySelectorAll<HTMLElement>('article');

  filters.forEach((btn) => {
    btn.addEventListener('click', () => {
      const cat = btn.dataset.category;

      // Estilo activo
      filters.forEach(f => {
        f.classList.remove('border-blue-400/60', 'bg-blue-500/15', 'text-blue-200');
      });
      btn.classList.add('border-blue-400/60', 'bg-blue-500/15', 'text-blue-200');

      // Filtrar
      articles.forEach((art) => {
        const badge = art.querySelector('[class*="rounded-full"]');
        const artCat = badge?.textContent?.trim() ?? '';
        if (cat === 'Todos' || artCat === cat) {
          art.style.display = '';
        } else {
          art.style.display = 'none';
        }
      });
    });
  });

  // Activar "Todos" por defecto
  const first = document.querySelector<HTMLButtonElement>('.category-filter');
  first?.classList.add('border-blue-400/60', 'bg-blue-500/15', 'text-blue-200');
</script>

---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostList from '../../components/blog/PostList.astro';

// Obtener todos los posts del blog
const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft) // Filtrar borradores
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()); // Ordenar por fecha

const pageTitle = 'Blog';
const pageDescription = 'Artículos y tutoriales sobre desarrollo web, tecnología y más.';
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="text-center">
      <h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl md:text-6xl">
        Nuestro Blog
      </h1>
      <p class="mx-auto mt-3 max-w-md text-base text-gray-500 sm:text-lg md:mt-5 md:max-w-3xl md:text-xl">
        {pageDescription}
      </p>
    </div>

    <div class="mt-12">
      {posts.length > 0 ? (
        <PostList posts={posts} />
      ) : (
        <div class="text-center py-12">
          <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
          </svg>
          <h3 class="mt-2 text-sm font-medium text-gray-900">No hay publicaciones aún</h3>
          <p class="mt-1 text-sm text-gray-500">Pronto publicaremos contenido interesante.</p>
        </div>
      )}
    </div>
  </div>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import "../styles/global.css";
import CardShop from "../components/CardShop.astro";
import SEO from "../components/SEO.astro";

import ImgSlider from '../assets/SlideImages/elemento 3d.jpg';
import ImgSlider2 from '../assets/SlideImages/Florero.jpg';
import ImgSlider3 from '../assets/SlideImages/shellby.png';

const tiendaEcommerce = [
  { id: 1, titulo: "Tienda Básica", descripcion: "E-commerce completo con carrito y pasarela de pago", imagen: ImgSlider2.src, precio: 599, etiqueta: "Starter" },
  { id: 2, titulo: "Tienda Premium", descripcion: "E-commerce avanzado con inventario y CRM integrado", imagen: ImgSlider.src, precio: 1499, etiqueta: "Premium" },
  { id: 3, titulo: "Marketplace", descripcion: "Plataforma multi-vendedor con comisiones y pagos", imagen: ImgSlider3.src, precio: 2999, etiqueta: "Enterprise" }
];
---

<Layout
  title="Soluciones E-commerce y Tiendas Online"
  description="Desarrollo de tiendas online profesionales, plataformas e-commerce, pasarelas de pago, gestión de inventario y analítica de ventas. Vende más con tecnología de punta."
  keywords="e-commerce, tienda online, comercio electrónico, pasarela de pago, carrito de compras, Shopify, WooCommerce, Medusa.js"
>
  <SEO 
    schemaType="Service"
    serviceName="Soluciones E-commerce"
    serviceDescription="Desarrollo de tiendas online, plataformas de comercio electrónico y soluciones de venta digital"
  />

  <main>
    <!-- Hero / Filosofía de e-commerce -->
    <section class="py-14">
      <div class="container mx-auto px-4">
        <h1 class="text-3xl md:text-4xl font-extrabold text-white text-center">E-commerce: convierte visitantes en clientes</h1>
        <p class="text-base md:text-lg text-gray-200 text-center mt-2 max-w-3xl mx-auto">
          El comercio electrónico es el futuro de las ventas. Creamos tiendas online que no solo se ven bien, sino que convierten. 
          Desde pequeños emprendimientos hasta grandes marketplaces, tenemos la solución perfecta para tu negocio.
        </p>

        <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-white/90 rounded-xl p-6 shadow border border-gray-200">
            <h2 class="text-xl font-bold">Diseñar</h2>
            <p class="text-gray-700 mt-2">Creamos experiencias de compra intuitivas que guían al usuario desde el descubrimiento hasta la conversión.</p>
          </div>
          <div class="bg-white/90 rounded-xl p-6 shadow border border-gray-200">
            <h2 class="text-xl font-bold">Vender</h2>
            <p class="text-gray-700 mt-2">Implementamos estrategias de conversión, upselling, cross-selling y recuperación de carritos abandonados.</p>
          </div>
          <div class="bg-white/90 rounded-xl p-6 shadow border border-gray-200">
            <h2 class="text-xl font-bold">Escalar</h2>
            <p class="text-gray-700 mt-2">Optimizamos rendimiento, automatizamos procesos y preparamos tu tienda para crecer sin límites.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Tipos de E-commerce -->
    <section class="py-12 bg-gradient-to-r from-green-500/20 via-emerald-500/20 to-teal-500/20">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl md:text-4xl font-extrabold text-white text-center mb-4">Soluciones E-commerce a Medida</h2>
        <p class="text-base md:text-lg text-gray-200 text-center max-w-3xl mx-auto mb-8">
          Desarrollamos tiendas online con las mejores plataformas: Medusa.js, Shopify, WooCommerce o soluciones custom.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="bg-gray-900/80 backdrop-blur-sm rounded-xl p-6 border border-green-500/30">
            <div class="text-4xl mb-3">🛍️</div>
            <h3 class="text-xl font-bold text-white mb-2">Tienda Online Básica</h3>
            <p class="text-gray-300 text-sm mb-3">Perfecta para emprendedores y pequeños negocios que quieren vender online.</p>
            <ul class="text-gray-400 text-xs space-y-1">
              <li>✓ Catálogo de productos ilimitado</li>
              <li>✓ Carrito de compras</li>
              <li>✓ Pasarela de pago integrada</li>
              <li>✓ Panel de administración</li>
              <li>✓ Responsive y optimizado SEO</li>
            </ul>
          </div>

          <div class="bg-gray-900/80 backdrop-blur-sm rounded-xl p-6 border border-emerald-500/30">
            <div class="text-4xl mb-3">🏪</div>
            <h3 class="text-xl font-bold text-white mb-2">E-commerce Avanzado</h3>
            <p class="text-gray-300 text-sm mb-3">Para negocios establecidos que necesitan funcionalidades completas.</p>
            <ul class="text-gray-400 text-xs space-y-1">
              <li>✓ Gestión de inventario en tiempo real</li>
              <li>✓ Múltiples métodos de pago</li>
              <li>✓ Sistema de envíos y tracking</li>
              <li>✓ CRM y email marketing</li>
              <li>✓ Analytics y reportes avanzados</li>
            </ul>
          </div>

          <div class="bg-gray-900/80 backdrop-blur-sm rounded-xl p-6 border border-teal-500/30">
            <div class="text-4xl mb-3">🏢</div>
            <h3 class="text-xl font-bold text-white mb-2">Marketplace Multi-vendedor</h3>
            <p class="text-gray-300 text-sm mb-3">Plataforma completa para conectar múltiples vendedores con compradores.</p>
            <ul class="text-gray-400 text-xs space-y-1">
              <li>✓ Registro de vendedores</li>
              <li>✓ Sistema de comisiones</li>
              <li>✓ Pagos divididos automáticos</li>
              <li>✓ Reviews y calificaciones</li>
              <li>✓ Panel admin y vendedor</li>
            </ul>
          </div>

          <div class="bg-gray-900/80 backdrop-blur-sm rounded-xl p-6 border border-cyan-500/30">
            <div class="text-4xl mb-3">📦</div>
            <h3 class="text-xl font-bold text-white mb-2">Dropshipping</h3>
            <p class="text-gray-300 text-sm mb-3">Vende sin inventario con integración automática a proveedores.</p>
            <ul class="text-gray-400 text-xs space-y-1">
              <li>✓ Sincronización con proveedores</li>
              <li>✓ Actualización automática de stock</li>
              <li>✓ Procesamiento de pedidos</li>
              <li>✓ Márgenes de ganancia configurables</li>
              <li>✓ Múltiples proveedores</li>
            </ul>
          </div>

          <div class="bg-gray-900/80 backdrop-blur-sm rounded-xl p-6 border border-blue-500/30">
            <div class="text-4xl mb-3">🎫</div>
            <h3 class="text-xl font-bold text-white mb-2">Productos Digitales</h3>
            <p class="text-gray-300 text-sm mb-3">Vende cursos, ebooks, software y contenido descargable.</p>
            <ul class="text-gray-400 text-xs space-y-1">
              <li>✓ Entrega automática de archivos</li>
              <li>✓ Licencias y claves de activación</li>
              <li>✓ Protección anti-piratería</li>
              <li>✓ Suscripciones y membresías</li>
              <li>✓ Área de miembros</li>
            </ul>
          </div>

          <div class="bg-gray-900/80 backdrop-blur-sm rounded-xl p-6 border border-purple-500/30">
            <div class="text-4xl mb-3">🔄</div>
            <h3 class="text-xl font-bold text-white mb-2">Suscripciones</h3>
            <p class="text-gray-300 text-sm mb-3">Modelo de negocio recurrente con cobros automáticos.</p>
            <ul class="text-gray-400 text-xs space-y-1">
              <li>✓ Planes mensuales/anuales</li>
              <li>✓ Cobros automáticos recurrentes</li>
              <li>✓ Gestión de cancelaciones</li>
              <li>✓ Períodos de prueba gratuitos</li>
              <li>✓ Upgrades y downgrades</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Funcionalidades Clave -->
    <section class="py-12">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl md:text-4xl font-extrabold text-white text-center mb-4">Funcionalidades que Impulsan Ventas</h2>
        <p class="text-base md:text-lg text-gray-200 text-center max-w-3xl mx-auto mb-8">
          Cada tienda incluye herramientas probadas para maximizar conversiones y mejorar la experiencia del cliente.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-white/90 rounded-xl p-6 shadow">
            <h3 class="text-2xl font-bold mb-3 flex items-center">
              <span class="text-3xl mr-3">💳</span>
              Pasarelas de Pago
            </h3>
            <ul class="space-y-2 text-gray-700">
              <li>✓ Stripe, PayPal, MercadoPago</li>
              <li>✓ Tarjetas de crédito y débito</li>
              <li>✓ Transferencias bancarias</li>
              <li>✓ Pagos en efectivo (OXXO, 7-Eleven)</li>
              <li>✓ Criptomonedas (opcional)</li>
              <li>✓ Meses sin intereses</li>
            </ul>
          </div>

          <div class="bg-white/90 rounded-xl p-6 shadow">
            <h3 class="text-2xl font-bold mb-3 flex items-center">
              <span class="text-3xl mr-3">📦</span>
              Gestión de Envíos
            </h3>
            <ul class="space-y-2 text-gray-700">
              <li>✓ Integración con paqueterías (FedEx, DHL, Estafeta)</li>
              <li>✓ Cálculo automático de costos</li>
              <li>✓ Generación de guías de envío</li>
              <li>✓ Tracking en tiempo real</li>
              <li>✓ Múltiples direcciones de entrega</li>
              <li>✓ Retiro en tienda (Click & Collect)</li>
            </ul>
          </div>

          <div class="bg-white/90 rounded-xl p-6 shadow">
            <h3 class="text-2xl font-bold mb-3 flex items-center">
              <span class="text-3xl mr-3">📊</span>
              Analytics y Reportes
            </h3>
            <ul class="space-y-2 text-gray-700">
              <li>✓ Dashboard de ventas en tiempo real</li>
              <li>✓ Productos más vendidos</li>
              <li>✓ Análisis de comportamiento de usuarios</li>
              <li>✓ Tasa de conversión y abandono</li>
              <li>✓ Reportes de ingresos y ganancias</li>
              <li>✓ Integración con Google Analytics</li>
            </ul>
          </div>

          <div class="bg-white/90 rounded-xl p-6 shadow">
            <h3 class="text-2xl font-bold mb-3 flex items-center">
              <span class="text-3xl mr-3">🎯</span>
              Marketing Integrado
            </h3>
            <ul class="space-y-2 text-gray-700">
              <li>✓ Cupones y códigos de descuento</li>
              <li>✓ Programas de lealtad y puntos</li>
              <li>✓ Email marketing automatizado</li>
              <li>✓ Recuperación de carritos abandonados</li>
              <li>✓ Recomendaciones de productos</li>
              <li>✓ Reviews y testimonios</li>
            </ul>
          </div>

          <div class="bg-white/90 rounded-xl p-6 shadow">
            <h3 class="text-2xl font-bold mb-3 flex items-center">
              <span class="text-3xl mr-3">📱</span>
              Experiencia Mobile</h3>
            <ul class="space-y-2 text-gray-700">
              <li>✓ Diseño 100% responsive</li>
              <li>✓ Checkout optimizado para móvil</li>
              <li>✓ PWA (funciona como app)</li>
              <li>✓ Pagos con Apple Pay / Google Pay</li>
              <li>✓ Notificaciones push</li>
              <li>✓ Instalable en home screen</li>
            </ul>
          </div>

          <div class="bg-white/90 rounded-xl p-6 shadow">
            <h3 class="text-2xl font-bold mb-3 flex items-center">
              <span class="text-3xl mr-3">🔐</span>
              Seguridad y Confianza
            </h3>
            <ul class="space-y-2 text-gray-700">
              <li>✓ Certificado SSL incluido</li>
              <li>✓ Cumplimiento PCI-DSS</li>
              <li>✓ Protección contra fraudes</li>
              <li>✓ Backups automáticos diarios</li>
              <li>✓ Autenticación de dos factores</li>
              <li>✓ Políticas de privacidad y términos</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Plataformas -->
    <section class="py-12 bg-gradient-to-r from-purple-500/20 via-pink-500/20 to-red-500/20">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl md:text-4xl font-extrabold text-white text-center mb-4">Plataformas que Utilizamos</h2>
        <p class="text-base md:text-lg text-gray-200 text-center max-w-3xl mx-auto mb-8">
          Seleccionamos la mejor tecnología según tus necesidades y presupuesto.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-gray-900/80 backdrop-blur-sm rounded-xl p-6 border border-purple-500/30">
            <h3 class="text-2xl font-bold text-white mb-3">Medusa.js</h3>
            <p class="text-gray-300 text-sm mb-3">E-commerce headless de código abierto. Máxima flexibilidad y personalización.</p>
            <div class="flex flex-wrap gap-2">
              <span class="px-2 py-1 bg-purple-500/20 text-purple-300 rounded text-xs">Open Source</span>
              <span class="px-2 py-1 bg-purple-500/20 text-purple-300 rounded text-xs">Headless</span>
              <span class="px-2 py-1 bg-purple-500/20 text-purple-300 rounded text-xs">Escalable</span>
            </div>
          </div>

          <div class="bg-gray-900/80 backdrop-blur-sm rounded-xl p-6 border border-pink-500/30">
            <h3 class="text-2xl font-bold text-white mb-3">Shopify</h3>
            <p class="text-gray-300 text-sm mb-3">Plataforma todo-en-uno. Ideal para lanzar rápido sin complicaciones técnicas.</p>
            <div class="flex flex-wrap gap-2">
              <span class="px-2 py-1 bg-pink-500/20 text-pink-300 rounded text-xs">Fácil de usar</span>
              <span class="px-2 py-1 bg-pink-500/20 text-pink-300 rounded text-xs">Hosting incluido</span>
              <span class="px-2 py-1 bg-pink-500/20 text-pink-300 rounded text-xs">Apps</span>
            </div>
          </div>

          <div class="bg-gray-900/80 backdrop-blur-sm rounded-xl p-6 border border-red-500/30">
            <h3 class="text-2xl font-bold text-white mb-3">Custom / Headless</h3>
            <p class="text-gray-300 text-sm mb-3">Solución 100% personalizada. Para proyectos únicos con requisitos específicos.</p>
            <div class="flex flex-wrap gap-2">
              <span class="px-2 py-1 bg-red-500/20 text-red-300 rounded text-xs">A medida</span>
              <span class="px-2 py-1 bg-red-500/20 text-red-300 rounded text-xs">Sin límites</span>
              <span class="px-2 py-1 bg-red-500/20 text-red-300 rounded text-xs">Premium</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Proceso -->
    <section class="py-12">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl md:text-4xl font-extrabold text-white text-center mb-8">Nuestro Proceso de Desarrollo</h2>
        
        <div class="max-w-4xl mx-auto">
          <div class="space-y-6">
            <div class="flex gap-4 items-start">
              <div class="flex-shrink-0 w-12 h-12 bg-blue-600 rounded-full flex items-center justify-center text-white font-bold text-xl">1</div>
              <div class="bg-white/90 rounded-lg p-4 flex-1">
                <h3 class="font-bold text-lg mb-1">Consultoría Inicial</h3>
                <p class="text-gray-700 text-sm">Analizamos tu modelo de negocio, productos, competencia y objetivos para diseñar la estrategia perfecta.</p>
              </div>
            </div>

            <div class="flex gap-4 items-start">
              <div class="flex-shrink-0 w-12 h-12 bg-green-600 rounded-full flex items-center justify-center text-white font-bold text-xl">2</div>
              <div class="bg-white/90 rounded-lg p-4 flex-1">
                <h3 class="font-bold text-lg mb-1">Diseño UX/UI</h3>
                <p class="text-gray-700 text-sm">Creamos wireframes y diseños enfocados en conversión, con flujos de compra optimizados.</p>
              </div>
            </div>

            <div class="flex gap-4 items-start">
              <div class="flex-shrink-0 w-12 h-12 bg-purple-600 rounded-full flex items-center justify-center text-white font-bold text-xl">3</div>
              <div class="bg-white/90 rounded-lg p-4 flex-1">
                <h3 class="font-bold text-lg mb-1">Desarrollo e Integración</h3>
                <p class="text-gray-700 text-sm">Construimos tu tienda con las mejores prácticas, integramos pasarelas de pago, envíos y herramientas necesarias.</p>
              </div>
            </div>

            <div class="flex gap-4 items-start">
              <div class="flex-shrink-0 w-12 h-12 bg-orange-600 rounded-full flex items-center justify-center text-white font-bold text-xl">4</div>
              <div class="bg-white/90 rounded-lg p-4 flex-1">
                <h3 class="font-bold text-lg mb-1">Testing y Optimización</h3>
                <p class="text-gray-700 text-sm">Probamos cada funcionalidad, optimizamos velocidad y aseguramos una experiencia perfecta en todos los dispositivos.</p>
              </div>
            </div>

            <div class="flex gap-4 items-start">
              <div class="flex-shrink-0 w-12 h-12 bg-red-600 rounded-full flex items-center justify-center text-white font-bold text-xl">5</div>
              <div class="bg-white/90 rounded-lg p-4 flex-1">
                <h3 class="font-bold text-lg mb-1">Lanzamiento y Soporte</h3>
                <p class="text-gray-700 text-sm">Lanzamos tu tienda al mundo y te acompañamos con soporte continuo, actualizaciones y mejoras.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Tienda (paquetes) -->
    <section class="py-12 bg-gradient-to-r from-yellow-400/20 via-orange-500/20 to-red-400/20">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl md:text-4xl font-extrabold text-white text-center">Paquetes E-commerce</h2>
        <p class="text-base md:text-lg text-gray-200 text-center mt-2 max-w-3xl mx-auto">Soluciones listas para vender desde el primer día.</p>
        <ul class="mt-8 grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-6">
          {tiendaEcommerce.map((p, i) => (
            <CardShop producto={p} key={i} />
          ))}
        </ul>
      </div>
    </section>

    <!-- CTA Final -->
    <section class="py-16">
      <div class="container mx-auto px-4 text-center">
        <h2 class="text-3xl md:text-4xl font-extrabold text-white mb-4">¿Listo para vender online?</h2>
        <p class="text-lg text-gray-200 max-w-2xl mx-auto mb-8">
          Transforma tu negocio con una tienda online profesional que genera ventas 24/7.
        </p>
        <a 
          href="#contacto" 
          class="inline-block bg-green-600 hover:bg-green-700 text-white font-bold py-4 px-8 rounded-lg shadow-lg transition-colors duration-300"
        >
          Comenzar mi Tienda
        </a>
      </div>
    </section>
  </main>
</Layout>


---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Herramientas | Insano Network"
  description="Las tecnologías y herramientas que dominamos para crear soluciones excepcionales. Desde desarrollo web hasta automatización y marketing digital."
>
  <main class="container mx-auto px-6 py-16">
    <!-- Hero Section -->
    <section class="text-center mb-16">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-6">
        Nuestras Herramientas
      </h1>
      <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
        El conjunto de tecnologías y herramientas que dominamos para transformar tus ideas en soluciones digitales robustas y escalables
      </p>
    </section>

    <!-- Development Tools Section -->
    <section class="mb-20">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">
          🛠️ Desarrollo y Programación
        </h2>
        <p class="text-lg text-gray-600 dark:text-gray-300">
          Lenguajes, frameworks y herramientas para crear software de alta calidad
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Frontend -->
        <div class="bg-gradient-to-br from-blue-50 to-indigo-100 dark:from-blue-900/20 dark:to-indigo-800/20 rounded-lg p-6">
          <div class="w-12 h-12 bg-blue-600 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2L2 7v10c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-10-5z"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">Frontend</h3>
          <ul class="space-y-2 text-gray-700 dark:text-gray-300">
            <li>• React / Vue / Svelte</li>
            <li>• Astro (Next-gen)</li>
            <li>• TypeScript / JavaScript</li>
            <li>• Tailwind CSS</li>
            <li>• Figma (Prototipado)</li>
          </ul>
        </div>

        <!-- Backend -->
        <div class="bg-gradient-to-br from-green-50 to-emerald-100 dark:from-green-900/20 dark:to-emerald-800/20 rounded-lg p-6">
          <div class="w-12 h-12 bg-green-600 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.11 0 2-.9 2-2V5c0-1.1-.89-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">Backend</h3>
          <ul class="space-y-2 text-gray-700 dark:text-gray-300">
            <li>• .NET / C#</li>
            <li>• Node.js / Express</li>
            <li>• Python / Django</li>
            <li>• SQL Server / PostgreSQL</li>
            <li>• REST APIs / GraphQL</li>
          </ul>
        </div>

        <!-- DevOps -->
        <div class="bg-gradient-to-br from-purple-50 to-pink-100 dark:from-purple-900/20 dark:to-pink-800/20 rounded-lg p-6">
          <div class="w-12 h-12 bg-purple-600 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">DevOps</h3>
          <ul class="space-y-2 text-gray-700 dark:text-gray-300">
            <li>• Docker / Kubernetes</li>
            <li>• AWS / Azure</li>
            <li>• GitHub Actions</li>
            <li>• CI/CD Pipelines</li>
            <li>• Monitoring / Logging</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Marketing Tools Section -->
    <section class="mb-20">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">
          📈 Marketing Digital
        </h2>
        <p class="text-lg text-gray-600 dark:text-gray-300">
          Plataformas y herramientas para estrategias de marketing efectivas
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Automation -->
        <div class="bg-gradient-to-br from-orange-50 to-red-100 dark:from-orange-900/20 dark:to-red-800/20 rounded-lg p-6">
          <div class="w-12 h-12 bg-orange-600 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M13 2.05v3.03c3.39.49 6 3.39 6 6.92 0 .9-.18 1.75-.48 2.54l2.6 1.53c.56-1.24.88-2.62.88-4.07 0-5.18-3.95-9.45-9-9.95z"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">Automatización</h3>
          <ul class="space-y-2 text-gray-700 dark:text-gray-300">
            <li>• Zapier / Make (Integromat)</li>
            <li>• HubSpot</li>
            <li>• Mailchimp</li>
            <li>• ActiveCampaign</li>
            <li>• Webhooks / APIs</li>
          </ul>
        </div>

        <!-- Analytics -->
        <div class="bg-gradient-to-br from-cyan-50 to-blue-100 dark:from-cyan-900/20 dark:to-blue-800/20 rounded-lg p-6">
          <div class="w-12 h-12 bg-cyan-600 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">Análisis</h3>
          <ul class="space-y-2 text-gray-700 dark:text-gray-300">
            <li>• Google Analytics 4</li>
            <li>• Hotjar / Clarity</li>
            <li>• SEMrush / Ahrefs</li>
            <li>• Google Search Console</li>
            <li>• Facebook Insights</li>
          </ul>
        </div>

        <!-- Social Media -->
        <div class="bg-gradient-to-br from-pink-50 to-purple-100 dark:from-pink-900/20 dark:to-purple-800/20 rounded-lg p-6">
          <div class="w-12 h-12 bg-pink-600 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">Social Media</h3>
          <ul class="space-y-2 text-gray-700 dark:text-gray-300">
            <li>• Buffer / Hootsuite</li>
            <li>• Meta Business Suite</li>
            <li>• LinkedIn Campaign Manager</li>
            <li>• TikTok Ads Manager</li>
            <li>• Content Calendars</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Design Tools Section -->
    <section class="mb-20">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">
          🎨 Diseño y Creatividad
        </h2>
        <p class="text-lg text-gray-600 dark:text-gray-300">
          Herramientas para diseño visual, modelado 3D y producción multimedia
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Design -->
        <div class="bg-gradient-to-br from-yellow-50 to-orange-100 dark:from-yellow-900/20 dark:to-orange-800/20 rounded-lg p-6">
          <div class="w-12 h-12 bg-yellow-600 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">Diseño Digital</h3>
          <ul class="space-y-2 text-gray-700 dark:text-gray-300">
            <li>• Figma / Sketch</li>
            <li>• Adobe Creative Suite</li>
            <li>• Canva Pro</li>
            <li>• Blender (3D)</li>
            <li>• Framer (Prototipos)</li>
          </ul>
        </div>

        <!-- Video -->
        <div class="bg-gradient-to-br from-red-50 to-pink-100 dark:from-red-900/20 dark:to-pink-800/20 rounded-lg p-6">
          <div class="w-12 h-12 bg-red-600 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11l-4 4z"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">Producción Video</h3>
          <ul class="space-y-2 text-gray-700 dark:text-gray-300">
            <li>• Adobe Premiere Pro</li>
            <li>• DaVinci Resolve</li>
            <li>• Final Cut Pro</li>
            <li>• After Effects</li>
            <li>• Drone Footage</li>
          </ul>
        </div>

        <!-- Photography -->
        <div class="bg-gradient-to-br from-indigo-50 to-blue-100 dark:from-indigo-900/20 dark:to-blue-800/20 rounded-lg p-6">
          <div class="w-12 h-12 bg-indigo-600 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">Fotografía</h3>
          <ul class="space-y-2 text-gray-700 dark:text-gray-300">
            <li>• Adobe Lightroom</li>
            <li>• Photoshop</li>
            <li>• Capture One</li>
            <li>• Cámaras Profesionales</li>
            <li>• Studio Lighting</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Business Tools Section -->
    <section class="mb-20">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">
          📊 Negocios y Productividad
        </h2>
        <p class="text-lg text-gray-600 dark:text-gray-300">
          Herramientas para gestión empresarial y optimización de procesos
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Management -->
        <div class="bg-gradient-to-br from-gray-50 to-slate-100 dark:from-gray-800/20 dark:to-slate-800/20 rounded-lg p-6">
          <div class="w-12 h-12 bg-gray-600 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.11 0 2-.9 2-2V5c0-1.1-.89-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">Gestión</h3>
          <ul class="space-y-2 text-gray-700 dark:text-gray-300">
            <li>• Notion / Airtable</li>
            <li>• Trello / Asana</li>
            <li>• Slack / Microsoft Teams</li>
            <li>• Google Workspace</li>
            <li>• Monday.com</li>
          </ul>
        </div>

        <!-- Accounting -->
        <div class="bg-gradient-to-br from-emerald-50 to-green-100 dark:from-emerald-900/20 dark:to-green-800/20 rounded-lg p-6">
          <div class="w-12 h-12 bg-emerald-600 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.11 0 2-.9 2-2V5c0-1.1-.89-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">Contabilidad</h3>
          <ul class="space-y-2 text-gray-700 dark:text-gray-300">
            <li>• QuickBooks</li>
            <li>• SAP Business One</li>
            <li>• Facturación CFDI</li>
            <li>• Excel Avanzado</li>
            <li>• Power BI</li>
          </ul>
        </div>

        <!-- Security -->
        <div class="bg-gradient-to-br from-red-50 to-rose-100 dark:from-red-900/20 dark:to-rose-800/20 rounded-lg p-6">
          <div class="w-12 h-12 bg-red-600 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2L2 7v10c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-10-5z"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">Seguridad</h3>
          <ul class="space-y-2 text-gray-700 dark:text-gray-300">
            <li>• SSL/TLS Certificates</li>
            <li>• OAuth 2.0 / JWT</li>
            <li>• Firewall Configuration</li>
            <li>• VPN Solutions</li>
            <li>• Backup Systems</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="bg-gradient-to-r from-blue-600 to-purple-600 rounded-lg p-12 text-center">
      <h2 class="text-3xl font-bold text-white mb-4">
        ¿Listo para transformar tu proyecto?
      </h2>
      <p class="text-xl text-blue-100 mb-8 max-w-2xl mx-auto">
        Domina estas herramientas con nuestro equipo de expertos y lleva tus ideas al siguiente nivel
      </p>
      <div class="flex justify-center gap-4">
        <a
          href="/nosotros"
          class="bg-white text-blue-600 font-semibold py-3 px-6 rounded-lg shadow-md hover:bg-gray-100 transition-colors duration-300"
        >
          Conoce al Equipo
        </a>
        <a
          href="mailto:contacto@insanonetwork.com"
          class="bg-blue-800 text-white font-semibold py-3 px-6 rounded-lg shadow-md hover:bg-blue-900 transition-colors duration-300"
        >
          Consultoría Gratuita
        </a>
      </div>
    </section>
  </main>
</Layout>

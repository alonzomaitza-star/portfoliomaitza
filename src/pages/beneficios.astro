---
import Layout from '../layouts/Layout.astro';
import WorkSection from '../components/benefits/WorkSection.astro';
import BenefitPlans from '../components/benefits/BenefitPlans.astro';
import DiscordBenefits from '../components/benefits/DiscordBenefits.astro';
---

<Layout
  title="Beneficios | Insano Network - Ventajas de Nuestra Network"
  description="Descubre los beneficios exclusivos de unirte a Insano Network. Ahorra tiempo y dinero con nuestras soluciones integrales de TI, diseño y desarrollo."
  keywords="beneficios, ventajas, network TI, soluciones digitales, ahorro, eficiencia, Insano Network"
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-green-600 via-teal-600 to-blue-600 text-white">
    <div class="absolute inset-0 bg-black/20"></div>
    <div class="relative container mx-auto px-6 py-20">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-6 leading-tight">
          Beneficios Exclusivos de Nuestra
          <span class="block text-yellow-300">Network Digital</span>
        </h1>
        <p class="text-xl md:text-2xl mb-8 text-green-100 max-w-3xl mx-auto">
          Únete a un ecosistema donde proyectos y profesionales se conectan para 
          crear soluciones innovadoras. Ahorra tiempo, reduce costos y acelera tu crecimiento.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#planes"
            class="bg-white text-green-600 font-bold py-4 px-8 rounded-lg shadow-xl hover:bg-gray-100 transition-all duration-300 transform hover:scale-105"
          >
            Ver Planes
          </a>
          <a
            href="#comunidad"
            class="bg-transparent border-2 border-white text-white font-bold py-4 px-8 rounded-lg hover:bg-white hover:text-green-600 transition-all duration-300"
          >
            Unir a Comunidad
          </a>
        </div>
      </div>
    </div>
    
    <!-- Decorative Elements -->
    <div class="absolute bottom-0 left-0 right-0">
      <svg viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0 120L60 110C120 100 180 80 240 70C300 60 360 50 420 45C480 40 540 35 600 40C660 45 720 55 780 60C840 65 900 65 960 60C1020 55 1080 45 1140 40C1200 35 1260 30 1320 35C1380 40 1410 50 1440 60V120H0V120Z" fill="white"/>
      </svg>
    </div>
  </section>

  <!-- Core Benefits -->
  <section class="py-20 bg-gray-50">
    <div class="container mx-auto px-6">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-center mb-16 text-gray-900">
          ¿Qué obtienes al ser parte de <span class="text-green-600">Insano Network</span>?
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          <div class="bg-white rounded-xl shadow-lg p-6 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
            <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mb-6 mx-auto">
              <span class="text-2xl">💰</span>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-4 text-center">Ahorro Económico</h3>
            <p class="text-gray-600 text-center">
              Reduce costos hasta un 60% comparado con agencias tradicionales
            </p>
          </div>
          
          <div class="bg-white rounded-xl shadow-lg p-6 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
            <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mb-6 mx-auto">
              <span class="text-2xl">⚡</span>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-4 text-center">Velocidad</h3>
            <p class="text-gray-600 text-center">
              Proyectos 3x más rápidos con nuestra metodología ágil
            </p>
          </div>
          
          <div class="bg-white rounded-xl shadow-lg p-6 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
            <div class="w-16 h-16 bg-purple-100 rounded-full flex items-center justify-center mb-6 mx-auto">
              <span class="text-2xl">🎯</span>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-4 text-center">Calidad Garantizada</h3>
            <p class="text-gray-600 text-center">
              Profesionales verificados con más de 5 años de experiencia
            </p>
          </div>
          
          <div class="bg-white rounded-xl shadow-lg p-6 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
            <div class="w-16 h-16 bg-orange-100 rounded-full flex items-center justify-center mb-6 mx-auto">
              <span class="text-2xl">🔄</span>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-4 text-center">Flexibilidad</h3>
            <p class="text-gray-600 text-center">
              Soluciones adaptables que crecen con tu negocio
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Detailed Benefits -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-6">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-center mb-16 text-gray-900">
          Beneficios Detallados por <span class="text-green-600">Categoría</span>
        </h2>
        
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
          <!-- Para Emprendedores -->
          <div class="bg-gradient-to-br from-blue-50 to-indigo-100 rounded-2xl p-8">
            <div class="flex items-center mb-6">
              <div class="w-12 h-12 bg-blue-600 rounded-lg flex items-center justify-center mr-4">
                <span class="text-white text-xl">🚀</span>
              </div>
              <h3 class="text-2xl font-bold text-gray-900">Para Emprendedores</h3>
            </div>
            <ul class="space-y-4">
              <li class="flex items-start">
                <span class="text-green-500 mr-3 mt-1">✓</span>
                <div>
                  <strong class="text-gray-900">Acceso a Talentos:</strong>
                  <p class="text-gray-600">Conecta con profesionales verificados en minutos</p>
                </div>
              </li>
              <li class="flex items-start">
                <span class="text-green-500 mr-3 mt-1">✓</span>
                <div>
                  <strong class="text-gray-900">Reducción de Costos:</strong>
                  <p class="text-gray-600">Ahorra hasta el 70% en costos de desarrollo</p>
                </div>
              </li>
              <li class="flex items-start">
                <span class="text-green-500 mr-3 mt-1">✓</span>
                <div>
                  <strong class="text-gray-900">Lanzamiento Rápido:</strong>
                  <p class="text-gray-600">Tu proyecto operativo en semanas, no meses</p>
                </div>
              </li>
            </ul>
          </div>
          
          <!-- Para Profesionales -->
          <div class="bg-gradient-to-br from-green-50 to-emerald-100 rounded-2xl p-8">
            <div class="flex items-center mb-6">
              <div class="w-12 h-12 bg-green-600 rounded-lg flex items-center justify-center mr-4">
                <span class="text-white text-xl">💼</span>
              </div>
              <h3 class="text-2xl font-bold text-gray-900">Para Profesionales</h3>
            </div>
            <ul class="space-y-4">
              <li class="flex items-start">
                <span class="text-green-500 mr-3 mt-1">✓</span>
                <div>
                  <strong class="text-gray-900">Más Proyectos:</strong>
                  <p class="text-gray-600">Acceso a proyectos calificados constantemente</p>
                </div>
              </li>
              <li class="flex items-start">
                <span class="text-green-500 mr-3 mt-1">✓</span>
                <div>
                  <strong class="text-gray-900">Pagos Seguros:</strong>
                  <p class="text-gray-600">Sistema de pagos garantizado y transparente</p>
                </div>
              </li>
              <li class="flex items-start">
                <span class="text-green-500 mr-3 mt-1">✓</span>
                <div>
                  <strong class="text-gray-900">Networking:</strong>
                  <p class="text-gray-600">Conecta con otros profesionales del sector</p>
                </div>
              </li>
            </ul>
          </div>
          
          <!-- Para Empresas -->
          <div class="bg-gradient-to-br from-purple-50 to-pink-100 rounded-2xl p-8">
            <div class="flex items-center mb-6">
              <div class="w-12 h-12 bg-purple-600 rounded-lg flex items-center justify-center mr-4">
                <span class="text-white text-xl">🏢</span>
              </div>
              <h3 class="text-2xl font-bold text-gray-900">Para Empresas</h3>
            </div>
            <ul class="space-y-4">
              <li class="flex items-start">
                <span class="text-green-500 mr-3 mt-1">✓</span>
                <div>
                  <strong class="text-gray-900">Talento Bajo Demanda:</strong>
                  <p class="text-gray-600">Escala tu equipo según tus necesidades</p>
                </div>
              </li>
              <li class="flex items-start">
                <span class="text-green-500 mr-3 mt-1">✓</span>
                <div>
                  <strong class="text-gray-900">Optimización de Procesos:</strong>
                  <p class="text-gray-600">Automatización y eficiencia garantizada</p>
                </div>
              </li>
              <li class="flex items-start">
                <span class="text-green-500 mr-3 mt-1">✓</span>
                <div>
                  <strong class="text-gray-900">Innovación Continua:</strong>
                  <p class="text-gray-600">Acceso a las últimas tecnologías</p>
                </div>
              </li>
            </ul>
          </div>
          
          <!-- Para Estudiantes -->
          <div class="bg-gradient-to-br from-orange-50 to-yellow-100 rounded-2xl p-8">
            <div class="flex items-center mb-6">
              <div class="w-12 h-12 bg-orange-600 rounded-lg flex items-center justify-center mr-4">
                <span class="text-white text-xl">🎓</span>
              </div>
              <h3 class="text-2xl font-bold text-gray-900">Para Estudiantes</h3>
            </div>
            <ul class="space-y-4">
              <li class="flex items-start">
                <span class="text-green-500 mr-3 mt-1">✓</span>
                <div>
                  <strong class="text-gray-900">Experiencia Real:</strong>
                  <p class="text-gray-600">Trabaja en proyectos reales mientras estudias</p>
                </div>
              </li>
              <li class="flex items-start">
                <span class="text-green-500 mr-3 mt-1">✓</span>
                <div>
                  <strong class="text-gray-900">Mentoría:</strong>
                  <p class="text-gray-600">Aprende de profesionales experimentados</p>
                </div>
              </li>
              <li class="flex items-start">
                <span class="text-green-500 mr-3 mt-1">✓</span>
                <div>
                  <strong class="text-gray-900">Portafolio Construido:</strong>
                  <p class="text-gray-600">Genera un portafolio sólido para tu futuro</p>
                </div>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <WorkSection />

  <!-- Plans Section -->
  <BenefitPlans />

  <!-- Community Section -->
  <DiscordBenefits />

  <!-- Final CTA -->
  <section class="py-20 bg-gradient-to-r from-gray-900 to-gray-800 text-white">
    <div class="container mx-auto px-6 text-center">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">
          Comienza a Disfrutar de estos Beneficios Hoy
        </h2>
        <p class="text-xl mb-8 text-gray-300">
          Únete a miles de profesionales y empresas que ya están transformando 
          sus proyectos con Insano Network.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/emprender"
            class="bg-green-600 text-white font-bold py-4 px-8 rounded-lg shadow-xl hover:bg-green-700 transition-all duration-300 transform hover:scale-105"
          >
            🚀 Emprender Ahora
          </a>
          <a
            href="mailto:contacto@insanonetwork.com"
            class="bg-transparent border-2 border-green-400 text-white font-bold py-4 px-8 rounded-lg hover:bg-green-600 transition-all duration-300"
          >
            📧 Consultar Beneficios
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

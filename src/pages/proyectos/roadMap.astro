---
import Layout from "../../layouts/Layout.astro";
import AsideProyectos from "../../components/proyectos/roadmap/AsideProyectos.astro";
---

<Layout title="Proyectos - Insano Network" description="Galería de proyectos de Insano Network">
  <!-- Fonts -->
  <link href="https://fonts.googleapis.com" rel="preconnect" />
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap"
    rel="stylesheet"
  />

  <!-- Icons -->
  <link
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
    rel="stylesheet"
  />

  <style>
    .material-symbols-outlined {
      font-variation-settings:
        "FILL" 0,
        "wght" 400,
        "GRAD" 0,
        "opsz" 24;
      vertical-align: middle;
    }
    .blueprint-grid {
      background-image: radial-gradient(
        circle at 2px 2px,
        rgba(255, 255, 255, 0.05) 1px,
        transparent 0
      );
      background-size: 24px 24px;
    }
    .glass-nav {
      backdrop-filter: blur(12px);
    }
  </style>

  <div
    class="bg-slate-950 font-body text-slate-100 antialiased blueprint-grid min-h-screen relative pt-32 pb-20"
  >
    <div class="max-w-7xl mx-auto px-4 md:px-8 flex flex-col lg:flex-row gap-8">
      <!-- SideNavBar Component -->
      <AsideProyectos activeId="roadmap" />

    <!-- Main Content Area -->
    <main class="flex-1 min-w-0 pb-12">
      <!-- Simplified Header -->
      <header class="flex justify-between items-center mb-12">
        <div>
          <h1
            class="font-manrope font-extrabold text-3xl text-white tracking-tighter"
          >
            Insano Proyectos
          </h1>
          <nav class="flex gap-6 mt-2">
            <span
              class="font-manrope font-semibold tracking-tight text-white border-b-2 border-white pb-1 cursor-default"
              >Vista Principal</span
            >
            <span
              class="font-manrope font-semibold tracking-tight text-slate-400 hover:text-white transition-colors cursor-pointer"
              >Desglose de Fases</span
            >
            <span
              class="font-manrope font-semibold tracking-tight text-slate-400 hover:text-white transition-colors cursor-pointer"
              >Especificaciones</span
            >
          </nav>
        </div>
        <div class="flex items-center gap-3">
          <button
            class="bg-slate-900 border border-slate-850 text-white px-4 py-2 rounded-lg font-manrope font-bold text-sm flex items-center gap-2 hover:bg-slate-800 transition-all"
          >
            <span class="material-symbols-outlined text-sm">download</span>
            Export PDF
          </button>
        </div>
      </header>

      <!-- Roadmap Content -->
      <section class="max-w-6xl mx-auto">
        <div
          class="flex flex-col md:flex-row justify-between items-end gap-6 mb-12"
        >
          <div>
            <span
              class="font-inter text-xs font-bold uppercase tracking-widest text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-3 py-1 rounded-full"
              >Catálogo Activo</span
            >
            <h2
              class="font-manrope font-extrabold text-5xl mt-2 tracking-tight text-white"
            >
              Galería de Proyectos
            </h2>
            <p class="text-slate-300 mt-2 font-inter max-w-xl">
              Explora los desarrollos a medida, sistemas web interactivos y herramientas de automatización que estamos construyendo.
            </p>
          </div>
        </div>

        <!-- Visual Flowchart Diagram -->
        <div
          class="relative py-12 px-6 bg-slate-900/50 backdrop-blur rounded-xl mb-12 overflow-hidden border border-slate-800"
        >
          <!-- Connective Lines Background (SVG) -->
          <div class="absolute inset-0 z-0 pointer-events-none opacity-40">
            <svg class="stroke-slate-850" height="100%" width="100%">
              <path
                d="M100 200 Q 300 200 500 150 T 900 250"
                fill="none"
                stroke-dasharray="8 8"
                stroke-width="4"></path>
            </svg>
          </div>

          <div class="relative z-10 grid grid-cols-1 md:grid-cols-4 gap-8">
            <!-- Phase 1: Consolidacion -->
            <div class="flex flex-col gap-4">
              <div
                class="p-6 bg-slate-900/80 backdrop-blur rounded-xl shadow-sm border border-slate-800 hover:shadow-lg transition-all border-l-4 border-l-blue-500 group"
              >
                <div
                  class="w-12 h-12 rounded-lg bg-blue-500/10 text-blue-400 border border-blue-500/20 flex items-center justify-center mb-4"
                >
                  <span class="material-symbols-outlined">layers</span>
                </div>
                <div
                  class="inline-flex items-center gap-2 bg-blue-500/15 text-blue-400 px-2 py-0.5 rounded-full text-[10px] font-bold uppercase mb-2 border border-blue-500/20"
                >
                  <span
                    class="w-1.5 h-1.5 rounded-full bg-blue-450 animate-pulse"
                  ></span>
                  En Progreso
                </div>
                <h3 class="font-manrope font-bold text-lg mb-2 text-white">
                  Fase 01: Consolidación
                </h3>
                <p class="text-sm text-slate-300 font-inter leading-relaxed">
                  Documentación de la infraestructura central y componentes UI
                  base para la integración.
                </p>
              </div>
            </div>

            <!-- Phase 2: Nuevos Sistemas -->
            <div class="flex flex-col gap-4 mt-8 md:mt-16">
              <div
                class="p-6 bg-slate-900/80 backdrop-blur rounded-xl border border-slate-800 hover:shadow-lg transition-all group"
              >
                <div
                  class="w-12 h-12 rounded-lg bg-purple-500/10 text-purple-400 border border-purple-500/20 flex items-center justify-center mb-4"
                >
                  <span class="material-symbols-outlined"
                    >dashboard_customize</span
                  >
                </div>
                <div
                  class="inline-flex items-center gap-2 bg-purple-500/15 text-purple-400 px-2 py-0.5 rounded-full text-[10px] font-bold uppercase mb-2 border border-purple-500/20"
                >
                  Próximamente
                </div>
                <h3 class="font-manrope font-bold text-lg mb-2 text-white">
                  Fase 02: Sistemas
                </h3>
                <p
                  class="text-sm text-slate-300 font-inter leading-relaxed mb-4"
                >
                  Despliegue de plantillas funcionales y sistemas: Invitaciones Digitales, Gestor de Citas, Control Escolar y Portales LMS.
                </p>
                <div
                  class="flex flex-col gap-2 mt-3 pt-3 border-t border-slate-800"
                >
                  <a
                    href="/proyectos/proy?proyecto=invitaciones"
                    class="flex items-center justify-between text-xs font-semibold text-slate-300 hover:text-white transition-colors group/link"
                  >
                    <span>💌 Invitaciones Digitales</span>
                    <span
                      class="material-symbols-outlined text-sm transform group-hover/link:translate-x-1 transition-transform"
                      >arrow_forward</span
                    >
                  </a>
                  <a
                    href="/proyectos/proy?proyecto=citas"
                    class="flex items-center justify-between text-xs font-semibold text-slate-300 hover:text-white transition-colors group/link"
                  >
                    <span>📅 Gestor de Citas & WhatsApp</span>
                    <span
                      class="material-symbols-outlined text-sm transform group-hover/link:translate-x-1 transition-transform"
                      >arrow_forward</span
                    >
                  </a>
                  <a
                    href="/proyectos/escolar"
                    class="flex items-center justify-between text-xs font-semibold text-slate-300 hover:text-white transition-colors group/link"
                  >
                    <span>🏫 Control Escolar & App</span>
                    <span
                      class="material-symbols-outlined text-sm transform group-hover/link:translate-x-1 transition-transform"
                      >arrow_forward</span
                    >
                  </a>
                  <a
                    href="/proyectos/proy?proyecto=lms"
                    class="flex items-center justify-between text-xs font-semibold text-slate-300 hover:text-white transition-colors group/link"
                  >
                    <span>🎓 Portal LMS</span>
                    <span
                      class="material-symbols-outlined text-sm transform group-hover/link:translate-x-1 transition-transform"
                      >arrow_forward</span
                    >
                  </a>
                </div>
              </div>
            </div>

            <!-- Phase 3: IA & Bots -->
            <div class="flex flex-col gap-4">
              <div
                class="p-6 bg-slate-900/80 backdrop-blur rounded-xl border border-slate-800 hover:shadow-lg transition-all group"
              >
                <div
                  class="w-12 h-12 rounded-lg bg-amber-500/10 text-amber-400 border border-amber-500/20 flex items-center justify-center mb-4 opacity-75"
                >
                  <span class="material-symbols-outlined">smart_toy</span>
                </div>
                <div
                  class="inline-flex items-center gap-2 bg-amber-500/15 text-amber-400 px-2 py-0.5 rounded-full text-[10px] font-bold uppercase mb-2 border border-amber-500/20"
                >
                  Planificado
                </div>
                <h3 class="font-manrope font-bold text-lg mb-2 text-white">
                  Fase 03: Inteligencia
                </h3>
                <p
                  class="text-sm text-slate-300 font-inter leading-relaxed mb-4"
                >
                  Agentes virtuales autónomos y microservicios cloud eficientes
                  e impulsados por IA.
                </p>
                <div
                  class="flex flex-col gap-2 mt-3 pt-3 border-t border-slate-800"
                >
                  <a
                    href="/proyectos/proy?proyecto=ia"
                    class="flex items-center justify-between text-xs font-semibold text-slate-300 hover:text-white transition-colors group/link"
                  >
                    <span>🤖 Agentes Virtuales & IA</span>
                    <span
                      class="material-symbols-outlined text-sm transform group-hover/link:translate-x-1 transition-transform"
                      >arrow_forward</span
                    >
                  </a>
                </div>
              </div>
            </div>

            <!-- Phase 4: Launch -->
            <div class="flex flex-col gap-4 mt-8 md:mt-24">
              <div
                class="p-6 bg-slate-900/50 backdrop-blur rounded-xl border border-dashed border-slate-800"
              >
                <div
                  class="w-12 h-12 rounded-lg bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 flex items-center justify-center mb-4 opacity-50"
                >
                  <span class="material-symbols-outlined">rocket_launch</span>
                </div>
                <div
                  class="inline-flex items-center gap-2 bg-emerald-500/15 text-emerald-400 px-2 py-0.5 rounded-full text-[10px] font-bold uppercase mb-2 border border-emerald-500/20"
                >
                  Futuro
                </div>
                <h3 class="font-manrope font-bold text-lg mb-2 text-white/90">
                  Fase 04: Infraestructura
                </h3>
                <p
                  class="text-sm text-slate-400 font-inter leading-relaxed mb-4"
                >
                  Despliegue a medida, aseguramiento de calidad (QA), automatización DevOps y hosting administrado.
                </p>
                <div
                  class="flex flex-col gap-2 mt-3 pt-3 border-t border-slate-800"
                >
                  <a
                    href="/proyectos/proy?proyecto=saas"
                    class="flex items-center justify-between text-xs font-semibold text-slate-350 hover:text-white transition-colors group/link"
                  >
                    <span>🛠️ Desarrollos, DevOps & QA</span>
                    <span
                      class="material-symbols-outlined text-sm transform group-hover/link:translate-x-1 transition-transform"
                      >arrow_forward</span
                    >
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Detailed Phase Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <!-- Detailed Card 1 -->
          <div
            class="lg:col-span-2 bg-slate-900/80 backdrop-blur rounded-xl p-8 border border-slate-800 shadow-sm"
          >
            <div class="flex justify-between items-start mb-6">
              <h4 class="font-manrope font-bold text-2xl text-white">
                Detalles Técnicos: Fase 01
              </h4>
              <span class="text-slate-400 font-inter text-sm"
                >Target: Diciembre</span
              >
            </div>

            <div class="space-y-6">
              <div class="flex gap-4">
                <div
                  class="w-8 h-8 rounded-full bg-blue-500/10 text-blue-400 border border-blue-500/20 flex items-center justify-center shrink-0"
                >
                  <span class="text-xs font-bold">01</span>
                </div>
                <div>
                  <h5 class="font-manrope font-semibold text-sm text-white">
                    Documentación Core en Frontend
                  </h5>
                  <p class="text-sm text-slate-300 mt-1">
                    Estructuración y explicación de componentes base, sliders y
                    diseños responsivos actuales.
                  </p>
                </div>
              </div>

              <div class="flex gap-4">
                <div
                  class="w-8 h-8 rounded-full bg-blue-500/10 text-blue-400 border border-blue-500/20 flex items-center justify-center shrink-0"
                >
                  <span class="text-xs font-bold">02</span>
                </div>
                <div>
                  <h5 class="font-manrope font-semibold text-sm text-white">
                    Componentes UI y Mockups
                  </h5>
                  <p class="text-sm text-slate-300 mt-1">
                    Mapeo de elementos dummy y galerías que preparan el camino
                    para la integración de APIs.
                  </p>
                </div>
              </div>

              <div class="flex gap-4">
                <div
                  class="w-8 h-8 rounded-full bg-slate-800 text-slate-400 flex items-center justify-center shrink-0"
                >
                  <span class="text-xs font-bold">03</span>
                </div>
                <div>
                  <h5 class="font-manrope font-semibold text-sm text-white">
                    Saneamiento y Optimización
                  </h5>
                  <p class="text-sm text-slate-300 mt-1">
                    Revisión de rendimiento en Landing Pages para mejorar Core
                    Web Vitals en producción.
                  </p>
                </div>
              </div>
            </div>

            <div class="mt-8 pt-8 border-t border-slate-850">
              <div class="flex items-center justify-between mb-2">
                <span class="font-inter text-sm font-bold text-slate-200"
                  >Progreso de la Fase</span
                >
                <span class="font-manrope font-bold text-blue-400">64%</span>
              </div>
              <div class="w-full h-3 bg-slate-850 rounded-full overflow-hidden">
                <div
                  class="h-full bg-gradient-to-r from-blue-400 to-indigo-600 w-[64%]"
                >
                </div>
              </div>
            </div>
          </div>

          <!-- Secondary Data Card -->
          <div class="space-y-6">
            <div
              class="bg-slate-900 text-white rounded-xl p-8 border border-slate-800 shadow-xl relative overflow-hidden"
            >
              <div class="relative z-10">
                <h4 class="font-manrope font-bold text-lg mb-4 text-white">
                  Esfuerzo Estimado
                </h4>
                <div class="space-y-4">
                  <div class="flex justify-between items-center">
                    <span class="text-sm text-slate-400">Arquitectura</span>
                    <span class="font-manrope font-bold text-white"
                      >120 hrs</span
                    >
                  </div>
                  <div class="flex justify-between items-center">
                    <span class="text-sm text-slate-400">Diseño UI/UX</span>
                    <span class="font-manrope font-bold text-white">45 hrs</span
                    >
                  </div>
                  <div class="flex justify-between items-center">
                    <span class="text-sm text-slate-400">Desarrollo</span>
                    <span class="font-manrope font-bold text-white"
                      >380 hrs</span
                    >
                  </div>
                </div>
              </div>
              <!-- Background graphic -->
              <div class="absolute -bottom-4 -right-4 opacity-5">
                <span
                  class="material-symbols-outlined text-[120px]"
                  style="font-variation-settings: 'FILL' 1;">analytics</span
                >
              </div>
            </div>

            <div class="bg-slate-900 rounded-xl p-6 border border-slate-800">
              <h4
                class="font-manrope font-bold text-sm mb-4 uppercase tracking-wider text-slate-400"
              >
                Equipo Insano
              </h4>
              <div class="flex -space-x-3 mb-4">
                <img
                  alt="Team member"
                  class="w-10 h-10 rounded-full border-2 border-slate-900 object-cover"
                  src="https://ui-avatars.com/api/?name=Fer+J&background=0D8ABC&color=fff"
                />
                <img
                  alt="Team member"
                  class="w-10 h-10 rounded-full border-2 border-slate-900 object-cover"
                  src="https://ui-avatars.com/api/?name=Mai+Al&background=8A2BE2&color=fff"
                />
                <img
                  alt="Team member"
                  class="w-10 h-10 rounded-full border-2 border-slate-900 object-cover"
                  src="https://ui-avatars.com/api/?name=In+Sano&background=FF8C00&color=fff"
                />
                <div
                  class="w-10 h-10 rounded-full bg-slate-800 border-2 border-slate-900 flex items-center justify-center text-[10px] font-bold text-slate-300"
                >
                  +2
                </div>
              </div>
              <p class="text-xs text-slate-400 leading-relaxed font-inter">
                Liderado por el equipo central de ingeniería para Insano
                Network.
              </p>
            </div>
          </div>
        </div>
      </section>
      </main>
    </div>
  </div>
</Layout>

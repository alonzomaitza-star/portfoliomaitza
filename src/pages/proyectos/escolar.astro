<!-- JavaScript to control the simulated smartphone interactive tab changes and checkbox list -->
<script is:inline>
  function changeTab(tabName) {
    // Hide all views
    document.getElementById('view-credencial').classList.add('hidden');
    document.getElementById('view-tareas').classList.add('hidden');
    document.getElementById('view-progreso').classList.add('hidden');

    // Remove active style from tabs
    document.getElementById('btn-tab-credencial').className = "flex flex-col items-center gap-1 text-slate-500 focus:outline-none hover:text-slate-300 transition-colors";
    document.getElementById('btn-tab-tareas').className = "flex flex-col items-center gap-1 text-slate-500 focus:outline-none hover:text-slate-300 transition-colors";
    document.getElementById('btn-tab-progreso').className = "flex flex-col items-center gap-1 text-slate-500 focus:outline-none hover:text-slate-300 transition-colors";

    // Show selected view
    document.getElementById('view-' + tabName).classList.remove('hidden');

    // Add active style to selected tab
    document.getElementById('btn-tab-' + tabName).className = "flex flex-col items-center gap-1 text-violet-400 focus:outline-none";
  }

  // Interactive task checkboxes
  function toggleTask(element) {
    const checkbox = element.querySelector('.task-checkbox');
    const title = element.querySelector('h5');
    
    if (checkbox.classList.contains('text-transparent')) {
      // Mark as done
      checkbox.classList.remove('text-transparent');
      checkbox.classList.add('bg-violet-600', 'border-violet-600', 'text-white');
      title.classList.add('line-through', 'text-slate-500');
    } else {
      // Mark as pending
      checkbox.classList.remove('bg-violet-600', 'border-violet-600', 'text-white');
      checkbox.classList.add('text-transparent');
      title.classList.remove('line-through', 'text-slate-500');
    }

    updateTaskCounter();
  }

  function updateTaskCounter() {
    const list = document.getElementById('task-list-container');
    const items = list.querySelectorAll('.task-item');
    let pending = 0;
    
    items.forEach(item => {
      const checkbox = item.querySelector('.task-checkbox');
      if (checkbox.classList.contains('text-transparent')) {
        pending++;
      }
    });

    const counter = document.getElementById('pending-counter');
    if (pending === 0) {
      counter.textContent = "¡Todo al día!";
      counter.className = "text-[9px] bg-emerald-600/30 text-emerald-400 px-2 py-0.5 rounded-full border border-emerald-500/20 font-bold";
    } else {
      counter.textContent = pending + " Pendiente" + (pending > 1 ? "s" : "");
      counter.className = "text-[9px] bg-violet-600/30 text-violet-400 px-2 py-0.5 rounded-full border border-violet-500/20 font-bold";
    }
  }
</script>

---
import DemoLayout from "../../../layouts/DemoLayout.astro";
import { SERVICES } from "./lib/store.js";
import "./styles/global.css";
---

<DemoLayout title="Reservar Cita — BarberShop">
    <main class="booking">
        <div class="container">
            <a href="/proyectos/barberia" class="booking__back">
                <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    ><polyline points="15 18 9 12 15 6"></polyline></svg
                >
                Inicio
            </a>

            <h1 class="booking__title">Reservar Cita</h1>
            <p class="booking__subtitle">
                Rápido, sin cuentas. Solo tu teléfono.
            </p>

            <!-- Closed overlay -->
            <div
                class="booking__closed-overlay"
                id="closedOverlay"
                style="display:none;"
            >
                <div class="booking__closed-card glass-card">
                    <span class="booking__closed-icon">🔒</span>
                    <h3>Barbería Cerrada</h3>
                    <p>
                        No es posible reservar en este momento. Vuelve cuando
                        estemos abiertos.
                    </p>
                    <a href="/proyectos/barberia" class="btn-secondary">Volver al Inicio</a>
                </div>
            </div>

            <!-- Step indicators -->
            <div class="booking__steps" id="stepsWrap">
                <div class="booking__step active" data-step="1">
                    <span class="booking__step-num">1</span>
                    <span class="booking__step-label">Teléfono</span>
                </div>
                <div class="booking__step-line"></div>
                <div class="booking__step" data-step="2">
                    <span class="booking__step-num">2</span>
                    <span class="booking__step-label">Servicio</span>
                </div>
                <div class="booking__step-line"></div>
                <div class="booking__step" data-step="3">
                    <span class="booking__step-num">3</span>
                    <span class="booking__step-label">Horario</span>
                </div>
            </div>

            <!-- Step 1: Phone -->
            <div class="booking__panel" id="step1">
                <div class="glass-card booking__card">
                    <label class="booking__label">Tu número de teléfono</label>
                    <div class="booking__input-wrap">
                        <svg
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            ><path
                                d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"
                            ></path></svg
                        >
                        <input
                            type="tel"
                            id="phoneInput"
                            class="booking__input"
                            placeholder="10 dígitos"
                            maxlength="10"
                            autocomplete="tel"
                        />
                    </div>
                    <p class="booking__hint">
                        Usaremos este número para tu confirmación y consulta de
                        cita.
                    </p>
                    <button
                        class="btn-primary booking__next"
                        id="btnStep1"
                        disabled>Continuar</button
                    >
                </div>
            </div>

            <!-- Step 2: Service -->
            <div class="booking__panel" id="step2" style="display:none;">
                <div class="booking__services-grid">
                    {
                        SERVICES.map((s) => (
                            <button
                                class="glass-card booking__service-card"
                                data-service-id={s.id}
                                data-service-name={s.name}
                                data-service-price={s.price}
                                data-service-duration={s.duration}
                            >
                                <span class="booking__service-icon">
                                    {s.icon}
                                </span>
                                <span class="booking__service-name">
                                    {s.name}
                                </span>
                                <div class="booking__service-meta">
                                    <span class="booking__service-price">
                                        ${s.price}
                                    </span>
                                    <span class="booking__service-duration">
                                        {s.duration} min
                                    </span>
                                </div>
                            </button>
                        ))
                    }
                </div>
            </div>

            <!-- Step 3: Time -->
            <div class="booking__panel" id="step3" style="display:none;">
                <div class="glass-card booking__card">
                    <h3 class="booking__card-title" id="selectedServiceTitle">
                        --
                    </h3>
                    <p class="booking__card-sub" id="selectedServiceMeta">--</p>
                    <label class="booking__label" style="margin-top:1rem;"
                        >Elige tu horario</label
                    >
                    <div class="booking__slots" id="slotsGrid">
                        <p class="booking__hint">Cargando horarios...</p>
                    </div>

                    <div class="booking__photo-upload">
                        <label class="booking__label"
                            >Foto de Referencia (Opcional)</label
                        >
                        <div class="booking__file-wrap">
                            <input
                                type="file"
                                id="photoInput"
                                accept="image/*"
                                class="booking__file-input"
                            />
                            <div
                                class="booking__file-preview"
                                id="photoPreview"
                            >
                                <span>+ Subir foto</span>
                            </div>
                        </div>
                    </div>

                    <button
                        class="btn-primary booking__next"
                        id="btnConfirm"
                        disabled>Confirmar Cita</button
                    >
                </div>
            </div>

            <!-- Success -->
            <div class="booking__panel" id="stepSuccess" style="display:none;">
                <div class="glass-card booking__card booking__success-card">
                    <div class="booking__success-icon">✅</div>
                    <h2 class="booking__success-title">¡Cita Confirmada!</h2>
                    <div class="booking__success-details" id="successDetails">
                    </div>
                    <!-- Nota de la Demo / WhatsApp integration -->
                    <div class="booking__demo-notice" style="margin-top: 1.5rem; margin-bottom: 1.5rem; padding: 1.5rem; border-radius: 8px; background: rgba(0, 107, 255, 0.08); border: 1px solid rgba(0, 107, 255, 0.2); text-align: left; line-height: 1.6;">
                        <span style="font-weight: 700; color: #ffffff; display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem; font-family: var(--font-heading); font-size: 0.95rem;">
                            <span>💬</span> Vincular con WhatsApp (Prueba Real)
                        </span>
                        <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 1rem;">
                            ¡Vincular tu WhatsApp activa la gestión automática para <strong>Barbería Kalifa</strong>! Al hacer clic en el botón de abajo, se abrirá WhatsApp para enviar un mensaje a nuestro bot oficial en el número <strong>+52 55 1684 9340</strong>. El bot procesará tu solicitud y te enviará un mensaje de confirmación de vuelta, mientras nuestro sistema guarda tus citas y métricas en tu panel de control para que puedas consultarlas después.
                        </p>
                        <p style="font-size: 0.78rem; color: rgba(255, 255, 255, 0.5); margin-bottom: 1.25rem; padding-left: 0.75rem; border-left: 2px solid rgba(0, 107, 255, 0.4);">
                            ℹ️ <strong>Planes de Servicio:</strong> El uso de nuestro número central compartido (+52 55 1684 9340) forma parte de nuestro plan más básico. Si deseas tener un número telefónico exclusivo para tu negocio o un bot 100% personalizado con el tono y marca de tu establecimiento, también está disponible en nuestros planes avanzados.
                        </p>
                        
                        <a id="waLinkBtn" href="https://wa.me/525516849340" target="_blank" class="btn-primary" style="display: inline-flex; align-items: center; justify-content: center; gap: 0.6rem; width: 100%; font-size: 0.9rem; padding: 0.75rem 1.5rem; background-color: #25d366; border-color: #25d366; color: white; font-weight: 700; border-radius: 4px; transition: background-color 0.2s;">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="display: inline-block; vertical-align: middle;"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.5-5.739-1.453L0 24zm6.59-4.846c1.6.95 3.188 1.449 4.825 1.451 5.436 0 9.86-4.37 9.864-9.799.002-2.63-1.023-5.101-2.885-6.97C16.379 1.966 13.904.94 11.997.94c-5.442 0-9.87 4.372-9.874 9.802-.001 1.733.46 3.424 1.332 4.925l-.974 3.56 3.652-.958zm12.19-5.111c-.333-.167-1.972-.974-2.278-1.087-.306-.112-.529-.167-.751.167-.222.334-.861 1.087-1.055 1.309-.195.223-.389.25-.722.083-1.428-.716-2.39-1.229-3.33-2.853-.25-.427.25-.397.716-1.32.074-.153.037-.287-.019-.399-.055-.112-.53-1.278-.725-1.747-.19-.459-.382-.397-.529-.404-.136-.006-.292-.007-.449-.007-.157 0-.411.059-.626.294-.216.235-.824.805-.824 1.964 0 1.159.842 2.278.96 2.436.118.158 1.658 2.532 4.016 3.548.56.242 1.002.387 1.344.496.564.18 1.077.155 1.482.094.453-.068 1.972-.806 2.25-1.584.278-.78.278-1.448.195-1.583-.083-.135-.306-.217-.639-.383z"/></svg>
                            Activar Gestión en WhatsApp
                        </a>
                    </div>
                    <div class="booking__success-actions">
                        <a href="/proyectos/barberia/estado" class="btn-primary">Ver Estado</a>
                        <a href="/proyectos/barberia/panel" class="btn-secondary" style="border-color: rgba(0, 107, 255, 0.4); color: var(--color-signal-blue);">Ver todas las citas (Admin)</a>
                        <a href="/proyectos/barberia" class="btn-secondary">Inicio</a>
                    </div>
                </div>
            </div>
        </div>
    </main>
</DemoLayout>

<style>
    .booking {
        padding: 5.5rem 1.5rem 3rem;
        min-height: 100vh;
    }

    .booking__back {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        font-size: 0.85rem;
        color: var(--text-secondary);
        margin-bottom: 1.5rem;
        transition: color var(--transition-fast);
    }

    .booking__back:hover {
        color: var(--color-signal-blue);
    }

    .booking__title {
        font-family: var(--font-heading);
        font-size: 2rem;
        font-weight: 800;
        margin-bottom: 0.3rem;
    }

    .booking__subtitle {
        color: var(--text-secondary);
        font-size: 0.95rem;
        margin-bottom: 2rem;
    }

    /* Closed overlay */
    .booking__closed-overlay {
        position: fixed;
        inset: 0;
        z-index: 50;
        background: rgba(5, 12, 20, 0.95);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
    }

    .booking__closed-card {
        text-align: center;
        padding: 3rem 2rem;
        max-width: 360px;
    }

    .booking__closed-icon {
        font-size: 3rem;
        display: block;
        margin-bottom: 1rem;
    }
    .booking__closed-card h3 {
        font-family: var(--font-heading);
        font-size: 1.4rem;
        margin-bottom: 0.5rem;
    }
    .booking__closed-card p {
        color: var(--text-secondary);
        font-size: 0.9rem;
        margin-bottom: 1.5rem;
    }

    /* Steps */
    .booking__steps {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0;
        margin-bottom: 2rem;
    }

    .booking__step {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        opacity: 0.35;
        transition: opacity var(--transition-fast);
    }

    .booking__step.active {
        opacity: 1;
    }
    .booking__step.done {
        opacity: 0.7;
    }

    .booking__step-num {
        width: 28px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: var(--bg-card);
        border: 1.5px solid var(--color-mist-border);
        font-family: var(--font-heading);
        font-weight: 700;
        font-size: 0.8rem;
        transition: all var(--transition-fast);
        color: var(--text-secondary);
    }

    .booking__step.active .booking__step-num {
        background: var(--color-signal-blue);
        color: #ffffff;
        border-color: transparent;
        box-shadow: var(--gold-glow);
    }

    .booking__step.done .booking__step-num {
        background: var(--accent-green);
        color: #ffffff;
        border-color: transparent;
    }

    .booking__step-label {
        font-size: 0.75rem;
        font-weight: 500;
        color: var(--text-secondary);
        display: none;
    }

    .booking__step-line {
        width: 40px;
        height: 2px;
        background: var(--color-mist-border);
        margin: 0 0.5rem;
    }

    /* Cards */
    .booking__card {
        padding: 2rem;
        border-radius: var(--radius-lg);
    }

    .booking__card-title {
        font-family: var(--font-heading);
        font-size: 1.2rem;
        font-weight: 700;
    }

    .booking__card-sub {
        color: var(--text-secondary);
        font-size: 0.85rem;
    }

    .booking__label {
        display: block;
        font-family: var(--font-heading);
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-secondary);
        margin-bottom: 0.6rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    .booking__input-wrap {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.8rem 1rem;
        background: var(--bg-surface);
        border: 1.5px solid var(--color-mist-border);
        border-radius: var(--radius-md);
        transition: border-color var(--transition-fast);
    }

    .booking__input-wrap:focus-within {
        border-color: var(--color-signal-blue);
    }

    .booking__input {
        flex: 1;
        background: transparent;
        border: none;
        outline: none;
        color: var(--text-primary);
        font-size: 1.1rem;
        font-family: var(--font-body);
        letter-spacing: 0.08em;
    }

    .booking__input::placeholder {
        color: var(--text-muted);
    }

    .booking__hint {
        margin-top: 0.5rem;
        font-size: 0.78rem;
        color: var(--text-muted);
    }

    .booking__next {
        width: 100%;
        justify-content: center;
    }

    .booking__next:disabled {
        opacity: 0.4;
        pointer-events: none;
    }

    /* Services grid */
    .booking__services-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(155px, 1fr));
        gap: 0.8rem;
    }

    .booking__service-card {
        padding: 1.2rem;
        text-align: center;
        cursor: pointer;
        border: 1.5px solid var(--color-mist-border);
        transition: all var(--transition-fast);
    }

    .booking__service-card:hover {
        border-color: rgba(0, 107, 255, 0.4);
    }

    .booking__service-card.selected {
        border-color: var(--color-signal-blue);
        background: rgba(0, 107, 255, 0.08);
        box-shadow: var(--gold-glow);
    }

    .booking__service-icon {
        font-size: 1.8rem;
        display: block;
        margin-bottom: 0.5rem;
    }

    .booking__service-name {
        font-family: var(--font-heading);
        font-size: 0.85rem;
        font-weight: 700;
        display: block;
        margin-bottom: 0.5rem;
    }

    .booking__service-meta {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        font-size: 0.75rem;
    }

    .booking__service-price {
        font-weight: 700;
        color: var(--color-signal-blue);
    }

    .booking__service-duration {
        color: var(--text-muted);
    }

    /* Slots */
    .booking__slots {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
        gap: 0.5rem;
        max-height: 260px;
        overflow-y: auto;
        padding-right: 0.3rem;
    }

    .booking__slot {
        padding: 0.6rem 0.4rem;
        text-align: center;
        font-family: var(--font-heading);
        font-weight: 600;
        font-size: 0.85rem;
        border-radius: var(--radius-sm);
        border: 1.5px solid var(--color-mist-border);
        background: var(--bg-surface);
        cursor: pointer;
        transition: all var(--transition-fast);
        color: var(--text-primary);
    }

    .booking__slot:hover:not(.unavailable) {
        border-color: rgba(0, 107, 255, 0.4);
    }

    .booking__slot.selected {
        background: var(--color-signal-blue);
        color: #ffffff;
        border-color: transparent;
        box-shadow: var(--gold-glow);
    }

    .booking__slot.unavailable {
        opacity: 0.2;
        cursor: not-allowed;
        text-decoration: line-through;
    }

    /* Photo Upload */
    .booking__photo-upload {
        margin-top: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .booking__file-wrap {
        position: relative;
        width: 100%;
        height: 120px;
        border: 2px dashed var(--color-mist-border);
        border-radius: var(--radius-md);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        cursor: pointer;
        transition: border-color var(--transition-fast);
        background: var(--bg-surface);
    }

    .booking__file-wrap:hover {
        border-color: var(--color-signal-blue);
    }

    .booking__file-input {
        position: absolute;
        inset: 0;
        opacity: 0;
        cursor: pointer;
        z-index: 2;
    }

    .booking__file-preview {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background-size: cover;
        background-position: center;
        color: var(--text-muted);
        font-size: 0.9rem;
    }

    /* Success */
    .booking__success-card {
        text-align: center;
    }

    .booking__success-icon {
        font-size: 3rem;
        margin-bottom: 0.8rem;
    }

    .booking__success-title {
        font-family: var(--font-heading);
        font-size: 1.6rem;
        font-weight: 800;
        margin-bottom: 1.5rem;
        color: var(--color-signal-blue);
    }

    .booking__success-details {
        text-align: left;
        background: var(--bg-surface);
        border-radius: var(--radius-md);
        padding: 1.2rem;
        margin-bottom: 1.5rem;
        font-size: 0.9rem;
        line-height: 2;
        border: 1px solid var(--color-mist-border);
    }

    .booking__success-details strong {
        color: #ffffff;
    }

    .booking__success-actions {
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
        width: 100%;
    }

    .booking__success-actions a {
        width: 100%;
        justify-content: center;
    }

    @media (min-width: 550px) {
        .booking__success-actions {
            flex-direction: row;
        }
        .booking__success-actions a {
            flex: 1;
            width: auto;
        }
    }

    @media (min-width: 520px) {
        .booking__step-label {
            display: inline;
        }
    }
</style>

<script>
    import {
        getConfig,
        getAvailableSlots,
        createAppointment,
        SERVICES,
    } from "./lib/store.js";

    // State
    let phone = "";
    let selectedService: {
        id: string;
        name: string;
        price: number;
        duration: number;
    } | null = null;
    let selectedTime = "";
    let referencePhotoBase64: string | null = null;

    const config = getConfig();

    // If closed, show overlay
    if (!config.isOpen) {
        document.getElementById("closedOverlay")!.style.display = "flex";
        document.getElementById("stepsWrap")!.style.display = "none";
        document.getElementById("step1")!.style.display = "none";
    }

    // Photo Upload handling
    const photoInput = document.getElementById("photoInput");
    const photoPreview = document.getElementById("photoPreview");

    photoInput?.addEventListener("change", (e) => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (!file) {
            referencePhotoBase64 = null;
            if (photoPreview) {
                photoPreview.innerHTML = "<span>+ Subir foto</span>";
                photoPreview.style.backgroundImage = "none";
            }
            return;
        }

        const reader = new FileReader();
        reader.onload = (ev) => {
            const img = new Image();
            img.onload = () => {
                const canvas = document.createElement("canvas");
                const MAX_WIDTH = 500;
                let scaleSize = 1;
                if (img.width > MAX_WIDTH) {
                    scaleSize = MAX_WIDTH / img.width;
                }
                canvas.width = img.width * scaleSize;
                canvas.height = img.height * scaleSize;
                const ctx = canvas.getContext("2d");
                ctx?.drawImage(img, 0, 0, canvas.width, canvas.height);
                referencePhotoBase64 = canvas.toDataURL("image/jpeg", 0.7);

                if (photoPreview) {
                    photoPreview.innerHTML = "";
                    photoPreview.style.backgroundImage = `url(${referencePhotoBase64})`;
                }
            };
            img.src = ev.target?.result as string;
        };
        reader.readAsDataURL(file);
    });

    // Step 1: Phone
    const phoneInputEl = document.getElementById("phoneInput");
    const btnStep1 = document.getElementById("btnStep1");

    phoneInputEl?.addEventListener("input", (e) => {
        const val = (e.target as HTMLInputElement).value.replace(/\D/g, "");
        (e.target as HTMLInputElement).value = val;
        phone = val;
        if (btnStep1)
            (btnStep1 as HTMLButtonElement).disabled = val.length < 10;
    });

    btnStep1?.addEventListener("click", () => {
        if (phone.length < 10) return;
        showStep(2);
    });

    // Step 2: Service Selection
    document.querySelectorAll(".booking__service-card").forEach((card) => {
        card.addEventListener("click", () => {
            document
                .querySelectorAll(".booking__service-card")
                .forEach((c) => c.classList.remove("selected"));
            card.classList.add("selected");

            selectedService = {
                id: (card as HTMLElement).dataset.serviceId as string,
                name: (card as HTMLElement).dataset.serviceName as string,
                price: Number((card as HTMLElement).dataset.servicePrice),
                duration: Number((card as HTMLElement).dataset.serviceDuration),
            };

            // Go to step 3
            showStep(3);
            loadSlots();
        });
    });

    // Step 3: Time Slots
    function loadSlots() {
        if (!selectedService) return;

        const titleEl = document.getElementById("selectedServiceTitle");
        const metaEl = document.getElementById("selectedServiceMeta");
        if (titleEl) titleEl.textContent = selectedService.name;
        if (metaEl)
            metaEl.textContent = `$${selectedService.price} · ${selectedService.duration} min`;

        const slots = getAvailableSlots(selectedService.id);
        const grid = document.getElementById("slotsGrid");
        if (!grid) return;

        if (slots.length === 0) {
            grid.innerHTML =
                '<p class="booking__hint">No hay horarios disponibles hoy.</p>';
            return;
        }

        grid.innerHTML = slots
            .map(
                (s: any) => `
      <button class="booking__slot ${s.available ? "" : "unavailable"}"
              data-time="${s.time}" ${s.available ? "" : "disabled"}>
        ${s.time}
      </button>
    `,
            )
            .join("");

        // Slot click
        grid.querySelectorAll(".booking__slot:not(.unavailable)").forEach(
            (btn) => {
                btn.addEventListener("click", () => {
                    grid.querySelectorAll(".booking__slot").forEach((b) =>
                        b.classList.remove("selected"),
                    );
                    btn.classList.add("selected");
                    selectedTime = (btn as HTMLElement).dataset.time as string;
                    const confirmBtn = document.getElementById("btnConfirm");
                    if (confirmBtn)
                        (confirmBtn as HTMLButtonElement).disabled = false;
                });
            },
        );
    }

    // Confirm
    document.getElementById("btnConfirm")?.addEventListener("click", () => {
        if (!selectedService || !selectedTime || !phone) return;

        try {
            const appt = createAppointment({
                phone,
                serviceId: selectedService.id,
                time: selectedTime,
                referencePhoto: referencePhotoBase64 as any,
            });

            // Show success
            const details = document.getElementById("successDetails");
            if (details) {
                details.innerHTML = `
          <div><strong>📞 Teléfono:</strong> ${appt.phone}</div>
          <div><strong>✂️ Servicio:</strong> ${appt.serviceName}</div>
          <div><strong>🕐 Hora:</strong> ${appt.time}</div>
          <div><strong>💰 Precio:</strong> $${appt.price}</div>
          <div><strong>📅 Fecha:</strong> ${appt.date}</div>
        `;
            }

            // Generar enlace dinámico de WhatsApp para activar gestión
            const waLinkBtn = document.getElementById("waLinkBtn");
            if (waLinkBtn) {
                const messageText = `Hola, acabo de registrar una cita para ${appt.serviceName} a las ${appt.time} con el número ${appt.phone} en Barbería Kalifa. Deseo activar la gestión automática y recibir las confirmaciones en mi celular.`;
                waLinkBtn.setAttribute("href", `https://wa.me/525516849340?text=${encodeURIComponent(messageText)}`);
            }

            const stepsWrap = document.getElementById("stepsWrap");
            if (stepsWrap) stepsWrap.style.display = "none";
            showPanel("stepSuccess");
        } catch (err: any) {
            alert(err.message);
        }
    });

    // Navigation helpers
    function showStep(num: number) {
        ["step1", "step2", "step3"].forEach((id, i) => {
            const el = document.getElementById(id);
            if (el) el.style.display = i + 1 === num ? "block" : "none";
        });

        document.querySelectorAll(".booking__step").forEach((s) => {
            const sNum = Number((s as HTMLElement).dataset.step);
            s.classList.remove("active", "done");
            if (sNum === num) s.classList.add("active");
            else if (sNum < num) s.classList.add("done");
        });
    }

    function showPanel(id: string) {
        ["step1", "step2", "step3", "stepSuccess"].forEach((pid) => {
            const el = document.getElementById(pid);
            if (el) el.style.display = pid === id ? "block" : "none";
        });
    }
</script>

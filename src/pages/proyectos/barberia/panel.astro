---
import DemoLayout from "../../../layouts/DemoLayout.astro";
import "./styles/global.css";
---

<DemoLayout title="Panel Admin — BarberShop">
    <main class="panel">
        <div class="container">
            <a href="/proyectos/barberia" class="panel__back">← Inicio</a>
            <h1 class="panel__title">Panel Barbería</h1>
            <p class="panel__sub">
                Gestiona tu barbería: estado, horarios y citas del día.
            </p>

            <!-- Nota informativa de la Demo en Panel Admin -->
            <div class="panel__demo-notice glass-card" style="margin-bottom: 2rem; padding: 1.25rem; border-radius: 8px; border: 1px solid rgba(0, 107, 255, 0.2); background: rgba(0, 107, 255, 0.05); font-size: 0.88rem; line-height: 1.6;">
                <span style="font-weight: 700; color: #ffffff; display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem; font-family: var(--font-heading);">
                    💡 Información de la Demo:
                </span>
                <p style="color: var(--text-secondary); margin-bottom: 0.75rem;">
                    Este panel te permite monitorear tu agenda y actualizar los estados de las citas del día. En producción, al registrar el número de teléfono del cliente, la gestión inicia de forma 100% automática. Cuando un cliente abre el chat de WhatsApp del bot oficial (**+52 55 1684 9340**) y confirma o reagenda su cita de <strong>Barbería Kalifa</strong>, la información se procesa y se refleja de inmediato en esta vista de administración, almacenando métricas y citas clave para el control de tu negocio.
                </p>
                <p style="font-size: 0.78rem; color: rgba(255, 255, 255, 0.5); margin: 0; padding-top: 0.5rem; border-top: 1px solid var(--color-mist-border);">
                    ℹ️ <strong>Flexibilidad de Canales:</strong> En el plan básico, los clientes interactúan a través de nuestro número central compartido. En planes avanzados, puedes vincular tu propio número telefónico exclusivo de tu negocio o contar con un bot personalizado adaptado a la identidad de tu marca.
                </p>
            </div>

            <!-- Config -->
            <div class="glass-card panel__section">
                <h2 class="panel__h2">Estado de la Barbería</h2>
                <div class="panel__toggle-row">
                    <span class="panel__toggle-label" id="toggleLabel"
                        >Abierto</span
                    >
                    <button
                        class="panel__toggle-btn"
                        id="toggleBtn"
                        aria-label="Toggle"
                    >
                        <span class="panel__toggle-knob"></span>
                    </button>
                </div>
                <div class="panel__hours-row">
                    <div class="panel__field">
                        <label>Apertura</label>
                        <input type="time" id="openTime" class="panel__time" />
                    </div>
                    <div class="panel__field">
                        <label>Cierre</label>
                        <input type="time" id="closeTime" class="panel__time" />
                    </div>
                    <button class="btn-primary panel__save-hrs" id="saveHours"
                        >Guardar</button
                    >
                </div>
            </div>

            <!-- Today's appointments -->
            <div class="glass-card panel__section">
                <div class="panel__appts-header">
                    <h2 class="panel__h2">Citas de Hoy</h2>
                    <span class="badge badge--green" id="apptCount">0</span>
                </div>
                <div id="apptsList" class="panel__appts-list">
                    <p class="panel__empty">No hay citas registradas hoy.</p>
                </div>
            </div>
        </div>
    </main>
</DemoLayout>

<style>
    .panel {
        padding: 5.5rem 1.5rem 3rem;
        min-height: 100vh;
    }
    .panel__back {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        font-size: 0.85rem;
        color: var(--text-secondary);
        margin-bottom: 1.5rem;
    }
    .panel__back:hover {
        color: var(--color-signal-blue);
    }
    .panel__title {
        font-family: var(--font-heading);
        font-size: 2rem;
        font-weight: 800;
        margin-bottom: 0.3rem;
    }
    .panel__sub {
        color: var(--text-secondary);
        font-size: 0.95rem;
        margin-bottom: 2rem;
    }
    .panel__section {
        padding: 1.5rem;
        border-radius: var(--radius-lg);
        margin-bottom: 1.5rem;
    }
    .panel__h2 {
        font-family: var(--font-heading);
        font-size: 1.1rem;
        font-weight: 700;
        margin-bottom: 1rem;
    }

    /* Toggle */
    .panel__toggle-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.5rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid var(--color-mist-border);
    }
    .panel__toggle-label {
        font-family: var(--font-heading);
        font-weight: 700;
        font-size: 1rem;
    }
    .panel__toggle-btn {
        width: 56px;
        height: 30px;
        border-radius: var(--radius-full);
        background: var(--accent-green);
        position: relative;
        transition: background var(--transition-fast);
        padding: 0;
        cursor: pointer;
        border: none;
    }
    .panel__toggle-btn.off {
        background: var(--accent-red);
    }
    .panel__toggle-knob {
        position: absolute;
        top: 3px;
        left: 3px;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: white;
        transition: transform var(--transition-fast);
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
    }
    .panel__toggle-btn.off .panel__toggle-knob {
        transform: translateX(0);
    }
    .panel__toggle-btn:not(.off) .panel__toggle-knob {
        transform: translateX(26px);
    }

    /* Hours */
    .panel__hours-row {
        display: flex;
        align-items: flex-end;
        gap: 1rem;
        flex-wrap: wrap;
    }
    .panel__field {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        flex: 1;
        min-width: 120px;
    }
    .panel__field label {
        font-size: 0.75rem;
        color: var(--text-muted);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }
    .panel__time {
        background: var(--bg-surface);
        border: 1.5px solid var(--color-mist-border);
        border-radius: var(--radius-sm);
        padding: 0.6rem 0.8rem;
        color: var(--text-primary);
        font-size: 0.95rem;
        font-family: var(--font-body);
        outline: none;
        transition: border-color var(--transition-fast);
    }
    .panel__time:focus {
        border-color: var(--color-signal-blue);
    }
    .panel__save-hrs {
        padding: 0.6rem 1.3rem;
        font-size: 0.85rem;
        white-space: nowrap;
    }

    /* Appointments */
    .panel__appts-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1rem;
    }
    .panel__appts-list {
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
    }
    .panel__empty {
        color: var(--text-muted);
        font-size: 0.9rem;
        text-align: center;
        padding: 2rem;
    }
</style>

<script>
    import {
        getConfig,
        toggleOpen,
        setHours,
        getTodayAppointments,
        updateAppointmentStatus,
        STATUS_LABELS,
        STATUS_COLORS,
    } from "./lib/store.js";

    const config = getConfig();

    // Toggle
    const toggleBtn = document.getElementById("toggleBtn");
    const toggleLabel = document.getElementById("toggleLabel");

    function setToggleUI(isOpen: boolean) {
        if (isOpen) {
            toggleBtn?.classList.remove("off");
            if (toggleLabel) {
                toggleLabel.textContent = "Abierto";
                toggleLabel.style.color = "var(--accent-green)";
            }
        } else {
            toggleBtn?.classList.add("off");
            if (toggleLabel) {
                toggleLabel.textContent = "Cerrado";
                toggleLabel.style.color = "var(--accent-red)";
            }
        }
    }
    setToggleUI(config.isOpen);

    toggleBtn?.addEventListener("click", () => {
        const newConfig = toggleOpen(!getConfig().isOpen);
        setToggleUI(newConfig.isOpen);
    });

    // Hours
    const openInput = document.getElementById(
        "openTime",
    ) as HTMLInputElement | null;
    const closeInput = document.getElementById(
        "closeTime",
    ) as HTMLInputElement | null;
    if (openInput) openInput.value = config.openTime;
    if (closeInput) closeInput.value = config.closeTime;

    document.getElementById("saveHours")?.addEventListener("click", () => {
        const o = openInput?.value || "09:00";
        const c = closeInput?.value || "20:00";
        setHours(o, c);
        alert("Horario guardado: " + o + " a " + c);
    });

    // Appointments
    function renderAppointments() {
        const appts = getTodayAppointments();
        const list = document.getElementById("apptsList");
        const count = document.getElementById("apptCount");
        if (count) count.textContent = String(appts.length);
        if (!list) return;
        if (appts.length === 0) {
            list.innerHTML =
                '<p class="panel__empty">No hay citas registradas hoy.</p>';
            return;
        }

        const statuses = ["en_proceso", "finalizada", "no_asistio"];
        list.innerHTML = appts
            .sort((a: any, b: any) => a.time.localeCompare(b.time))
            .map((a: any) => {
                const btns = statuses
                    .map(
                        (s) =>
                            `<button class="panel__status-btn ${a.status === s ? "active" : ""}" data-id="${a.id}" data-status="${s}" style="padding:0.3rem 0.6rem;border-radius:var(--radius-sm);font-size:0.7rem;font-weight:600;border:1px solid var(--color-mist-border);background:${a.status === s ? "var(--color-signal-blue)" : "var(--bg-surface)"};color:${a.status === s ? "#ffffff" : "var(--text-secondary)"};cursor:pointer;">${(STATUS_LABELS as Record<string, string>)[s]}</button>`,
                    )
                    .join("");

                const photoHtml = a.referencePhoto
                    ? `<div style="margin-top:0.8rem;padding-top:0.8rem;border-top:1px solid var(--color-mist-border);">
                         <p style="font-size:0.75rem;color:var(--text-secondary);margin-bottom:0.4rem;font-weight:600;">Foto de Referencia (Cliente):</p>
                         <img src="${a.referencePhoto}" alt="Referencia" style="max-width:100px;border-radius:var(--radius-sm);border:1px solid var(--color-mist-border);" />
                       </div>`
                    : "";

                return `<div style="padding:1rem;background:var(--bg-surface);border-radius:var(--radius-md);border:1px solid var(--color-mist-border);">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.6rem;">
          <div><strong style="font-family:var(--font-heading);">${a.time}</strong> — ${a.serviceName}</div>
          <span class="badge badge--${(STATUS_COLORS as Record<string, string>)[a.status] || "green"}" style="font-size:0.65rem;">${(STATUS_LABELS as Record<string, string>)[a.status]}</span>
        </div>
        <div style="font-size:0.8rem;color:var(--text-muted);margin-bottom:0.8rem;">📞 ${a.phone} · $${a.price} · ${a.duration}min</div>
        <div style="display:flex;gap:0.4rem;flex-wrap:wrap;">${btns}</div>
        ${photoHtml}
      </div>`;
            })
            .join("");

        list.querySelectorAll(".panel__status-btn").forEach((btn) => {
            btn.addEventListener("click", () => {
                const b = btn as HTMLElement;
                updateAppointmentStatus(b.dataset.id, b.dataset.status);
                renderAppointments();
            });
        });
    }

    renderAppointments();
</script>

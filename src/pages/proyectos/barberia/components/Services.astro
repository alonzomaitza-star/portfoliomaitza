---
const services = [
    {
        icon: "✂️",
        name: "Corte Clásico",
        desc: "Corte tradicional con tijera y máquina, incluye lavado.",
        price: "$150",
        duration: "30 min",
    },
    {
        icon: "💈",
        name: "Corte + Barba",
        desc: "Combo completo de corte y perfilado de barba con navaja.",
        price: "$250",
        duration: "50 min",
    },
    {
        icon: "🪒",
        name: "Afeitado Clásico",
        desc: "Afeitado con navaja, toalla caliente y bálsamo.",
        price: "$120",
        duration: "25 min",
    },
    {
        icon: "🧴",
        name: "Tratamiento Capilar",
        desc: "Hidratación profunda, mascarilla y masaje capilar.",
        price: "$200",
        duration: "40 min",
    },
    {
        icon: "🎨",
        name: "Color & Tinte",
        desc: "Tinte personalizado con productos premium.",
        price: "$350",
        duration: "60 min",
    },
    {
        icon: "👑",
        name: "VIP Total",
        desc: "Corte, barba, tratamiento y bebida de cortesía.",
        price: "$450",
        duration: "90 min",
    },
];
---

<section class="services" id="servicios">
    <div class="container">
        <h2 class="section-title">Nuestros Servicios</h2>
        <p class="section-subtitle">
            Cada servicio está diseñado para darte la mejor experiencia de
            barbería.
        </p>

        <div class="services__grid">
            {
                services.map((s, i) => (
                    <div
                        class="services__card glass-card"
                        style={`animation-delay: ${i * 0.08}s`}
                    >
                        <div class="services__card-icon">{s.icon}</div>
                        <h3 class="services__card-name">{s.name}</h3>
                        <p class="services__card-desc">{s.desc}</p>
                        <div class="services__card-meta">
                            <span class="services__card-price">{s.price}</span>
                            <span class="services__card-duration">
                                <svg
                                    width="14"
                                    height="14"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                >
                                    <>
                                        <circle cx="12" cy="12" r="10" />
                                        <polyline points="12 6 12 12 16 14" />
                                    </>
                                </svg>
                                {s.duration}
                            </span>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style>
    .services {
        padding: var(--section-padding);
        background: var(--bg-secondary);
        position: relative;
    }

    .services::before {
        content: "";
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 120px;
        height: 1px;
        background: var(--color-mist-border);
    }

    .services__grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1.5rem;
    }

    .services__card {
        padding: 2rem;
        display: flex;
        flex-direction: column;
        animation: fadeInUp 0.6s var(--ease-out) both;
    }

    .services__card-icon {
        font-size: 2.2rem;
        margin-bottom: 1rem;
        filter: drop-shadow(0 0 6px rgba(0, 107, 255, 0.25));
    }

    .services__card-name {
        font-family: var(--font-heading);
        font-size: 1.2rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }

    .services__card-desc {
        color: var(--text-secondary);
        font-size: 0.9rem;
        line-height: 1.6;
        flex: 1;
        margin-bottom: 1.2rem;
    }

    .services__card-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 1rem;
        border-top: 1px solid var(--color-mist-border);
    }

    .services__card-price {
        font-family: var(--font-heading);
        font-size: 1.3rem;
        font-weight: 800;
        color: var(--color-signal-blue);
    }

    .services__card-duration {
        display: flex;
        align-items: center;
        gap: 0.3rem;
        font-size: 0.8rem;
        color: var(--text-muted);
    }

    @media (max-width: 640px) {
        .services__grid {
            grid-template-columns: 1fr;
        }
    }
</style>

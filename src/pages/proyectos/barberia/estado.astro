---
import DemoLayout from "../../../layouts/DemoLayout.astro";
import "./styles/global.css";
---

<DemoLayout title="Estado de tu Cita — BarberShop">
    <main class="status-page">
        <div class="container">
            <a href="/proyectos/barberia" class="sp__back">← Inicio</a>
            <h1 class="sp__title">Consultar mi Cita</h1>
            <p class="sp__sub">
                Ingresa tu número de teléfono para ver el estado de tus citas.
            </p>

            <div class="glass-card sp__search">
                <div class="sp__input-wrap">
                    <input
                        type="tel"
                        id="phoneSearch"
                        class="sp__input"
                        placeholder="10 dígitos"
                        maxlength="10"
                    />
                </div>
                <button class="btn-primary sp__btn" id="btnSearch" disabled
                    >Buscar</button
                >
            </div>

            <div id="resultsArea" style="display:none;">
                <div id="noResults" class="sp__empty" style="display:none;">
                    <span style="font-size:3rem;">📋</span>
                    <h3>Sin citas registradas</h3>
                    <p>No encontramos citas con ese número.</p>
                    <a
                        href="/proyectos/barberia/reservar"
                        class="btn-primary"
                        style="margin-top:1rem;">Reservar Ahora</a
                    >
                </div>
                <div id="resultsList" class="sp__list"></div>
            </div>
        </div>
    </main>
</DemoLayout>

<style>
    .status-page {
        padding: 5.5rem 1.5rem 3rem;
        min-height: 100vh;
    }
    .sp__back {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        font-size: 0.85rem;
        color: var(--text-secondary);
        margin-bottom: 1.5rem;
    }
    .sp__back:hover {
        color: var(--color-signal-blue);
    }
    .sp__title {
        font-family: var(--font-heading);
        font-size: 2rem;
        font-weight: 800;
        margin-bottom: 0.3rem;
    }
    .sp__sub {
        color: var(--text-secondary);
        font-size: 0.95rem;
        margin-bottom: 2rem;
    }
    .sp__search {
        padding: 1.5rem;
        border-radius: var(--radius-lg);
        margin-bottom: 2rem;
    }
    .sp__input-wrap {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.8rem 1rem;
        background: var(--bg-surface);
        border: 1.5px solid var(--color-mist-border);
        border-radius: var(--radius-md);
        transition: border-color var(--transition-fast);
    }
    .sp__input-wrap:focus-within {
        border-color: var(--color-signal-blue);
    }
    .sp__input {
        flex: 1;
        background: transparent;
        border: none;
        outline: none;
        color: var(--text-primary);
        font-size: 1.1rem;
        font-family: var(--font-body);
        letter-spacing: 0.08em;
    }
    .sp__input::placeholder {
        color: var(--text-muted);
    }
    .sp__btn {
        width: 100%;
        margin-top: 1rem;
        justify-content: center;
    }
    .sp__btn:disabled {
        opacity: 0.4;
        pointer-events: none;
    }
    .sp__empty {
        text-align: center;
        padding: 3rem 1.5rem;
    }
    .sp__empty h3 {
        font-family: var(--font-heading);
        font-size: 1.3rem;
        margin-bottom: 0.5rem;
    }
    .sp__empty p {
        color: var(--text-secondary);
        font-size: 0.9rem;
    }
    .sp__list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
</style>

<script>
    import {
        getAppointmentsByPhone,
        getEstimatedWait,
        STATUS_LABELS,
        STATUS_COLORS,
    } from "./lib/store.js";

    const phoneInput = document.getElementById(
        "phoneSearch",
    ) as HTMLInputElement | null;
    const btnSearch = document.getElementById(
        "btnSearch",
    ) as HTMLButtonElement | null;

    phoneInput?.addEventListener("input", (e) => {
        const target = e.target as HTMLInputElement;
        const val = target.value.replace(/\D/g, "");
        target.value = val;
        if (btnSearch) btnSearch.disabled = val.length < 10;
    });

    phoneInput?.addEventListener("keydown", (e) => {
        if (e.key === "Enter") btnSearch?.click();
    });

    btnSearch?.addEventListener("click", () => {
        const phone = phoneInput?.value || "";
        if (phone.length < 10) return;
        const appointments = getAppointmentsByPhone(phone);
        const resultsArea = document.getElementById("resultsArea");
        const noResults = document.getElementById("noResults");
        const resultsList = document.getElementById("resultsList");
        if (resultsArea) resultsArea.style.display = "block";
        if (appointments.length === 0) {
            if (noResults) noResults.style.display = "block";
            if (resultsList) resultsList.style.display = "none";
            return;
        }
        if (noResults) noResults.style.display = "none";
        if (resultsList) {
            resultsList.style.display = "flex";
            resultsList.innerHTML = appointments
                .map((a: any) => {
                    const wait = getEstimatedWait(a);
                    const waitHtml =
                        wait !== null && wait > 0
                            ? `<div style="margin-top:1rem;padding-top:1rem;border-top:1px solid var(--color-mist-border);font-size:0.85rem;color:var(--color-signal-blue);font-weight:600;">⏳ Tu cita es en ~${wait} min</div>`
                            : "";

                    const photoHtml = a.referencePhoto
                        ? `<div style="margin-top:1rem;padding-top:1rem;border-top:1px solid var(--color-mist-border);">
                            <p style="font-size:0.85rem;color:var(--text-secondary);margin-bottom:0.5rem;font-family:var(--font-heading);font-weight:600;">Foto de Referencia:</p>
                            <img src="${a.referencePhoto}" alt="Referencia" style="max-width:120px;border-radius:var(--radius-sm);border:1px solid var(--color-mist-border);" />
                        </div>`
                        : "";

                    return `<div class="glass-card" style="padding:1.5rem;"><div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;"><span style="font-family:var(--font-heading);font-weight:700;font-size:1.1rem;">${a.serviceName}</span><span class="badge badge--${(STATUS_COLORS as Record<string, string>)[a.status] || "green"}">${(STATUS_LABELS as Record<string, string>)[a.status] || a.status}</span></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:0.6rem;font-size:0.85rem;color:var(--text-secondary);">
        <div>📅 <strong style="color:var(--text-primary)">${a.date}</strong></div><div>🕐 <strong style="color:var(--text-primary)">${a.time}</strong></div><div>⏱ <strong style="color:var(--text-primary)">${a.duration} min</strong></div><div>💰 <strong style="color:var(--text-primary)">$${a.price}</strong></div></div>${photoHtml}${waitHtml}</div>`;
                })
                .join("");
        }
    });
</script>

---
import DemoLayout from "../../../layouts/DemoLayout.astro";
import Services from "./components/Services.astro";
import "./styles/global.css";
---

<DemoLayout title="BarberShop — Tu Barbería">
	<main class="home">
		<!-- Hero Section in Calendly split layout -->
		<section class="home__hero">
			<div class="container home__hero-inner">
				<div class="home__hero-left animate-fade-in-up">
					<div class="home__status-badge" id="statusBadge">
						<span class="home__status-dot" id="statusDot"></span>
						<span id="statusText">Cargando...</span>
						<span class="home__hours-text" id="hoursText">--:-- a --:--</span>
					</div>
					<h1 class="home__title">
						Maestría en <span class="home__highlight">Estilo</span><br />& Afeitado
					</h1>
					<p class="home__desc">
						Redefinimos el arte de la barbería clásica con un toque moderno. Agenda tus citas de forma automática e interactiva en segundos.
					</p>
					<div class="home__actions">
						<a
							href="/proyectos/barberia/reservar"
							class="btn-primary home__btn"
							id="btnReservar"
						>
							<svg
								width="18"
								height="18"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2.5"
								stroke-linecap="round"
								stroke-linejoin="round"
								><rect
									x="3"
									y="4"
									width="18"
									height="18"
									rx="2"
									ry="2"></rect><line
									x1="16"
									y1="2"
									x2="16"
									y2="6"></line><line x1="8" y1="2" x2="8" y2="6"
								></line><line x1="3" y1="10" x2="21" y2="10"
								></line></svg
							>
							Reservar Ahora
						</a>
						<a href="/proyectos/barberia/estado" class="btn-secondary home__btn">
							Consultar mi cita
						</a>
					</div>
					<a href="/proyectos/barberia/panel" class="home__admin-link animate-fade-in-up" style="animation-delay: 0.2s;">
						📅 Ver todas las citas (vista admin demo)
					</a>
				</div>

				<div class="home__hero-right">
					<!-- Atmospheric Gradient Blobs (Calendly Visual Signature) -->
					<div class="hero-blob hero-blob--magenta"></div>
					<div class="hero-blob hero-blob--cyan"></div>
					<div class="hero-blob hero-blob--ultraviolet"></div>
					<div class="hero-blob hero-blob--amber"></div>

					<!-- Product UI Mockup Card representing scheduling interface -->
					<div class="mockup-card glass-card">
						<div class="mockup-card__header">
							<span class="mockup-card__icon">✂</span>
							<div>
								<h4 class="mockup-card__title">Barbería Kalifa</h4>
								<p class="mockup-card__sub">Selecciona un servicio</p>
							</div>
						</div>
						<div class="mockup-card__body">
							<div class="mockup-card__services">
								<div class="mockup-card__item active">
									<div>
										<span class="mockup-card__item-name">Corte Clásico + Barba</span>
										<span class="mockup-card__item-time">⏱ 50 min</span>
									</div>
									<span class="mockup-card__item-price">$250</span>
								</div>
								<div class="mockup-card__item">
									<div>
										<span class="mockup-card__item-name">Afeitado Navaja Express</span>
										<span class="mockup-card__item-time">⏱ 25 min</span>
									</div>
									<span class="mockup-card__item-price">$120</span>
								</div>
							</div>
							<div class="mockup-card__slots-label">Horarios disponibles para hoy</div>
							<div class="mockup-card__slots">
								<span class="mockup-card__slot">09:30 AM</span>
								<span class="mockup-card__slot selected">11:00 AM</span>
								<span class="mockup-card__slot">01:30 PM</span>
								<span class="mockup-card__slot">04:00 PM</span>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Services Section -->
		<Services />

		<!-- WhatsApp Integration Section -->
		<section class="home__whatsapp">
			<div class="container">
				<h2 class="section-title">Notificaciones y Chatbot de WhatsApp</h2>
				<p class="section-subtitle">
					El sistema se vincula con un bot inteligente de WhatsApp para simplificar la gestión.
				</p>
				<div class="whatsapp__grid">
					<!-- Left Info -->
					<div class="whatsapp__info-cards">
						<div class="whatsapp__info-card glass-card">
							<span class="whatsapp__info-icon">🔔</span>
							<h4>Alertas Instantáneas</h4>
							<p>Confirmaciones automáticas y alertas en tiempo real al programar o cambiar una cita.</p>
						</div>
						<div class="whatsapp__info-card glass-card">
							<span class="whatsapp__info-icon">⏳</span>
							<h4>Recordatorios de Citas</h4>
							<p>Envío de avisos automáticos previos para reducir el ausentismo de clientes.</p>
						</div>
						<div class="whatsapp__info-card glass-card">
							<span class="whatsapp__info-icon">💬</span>
							<h4>Consulta por Chat</h4>
							<p>El bot reconoce el número del cliente al recibir un mensaje y busca sus citas activas al instante.</p>
						</div>
					</div>

					<!-- Right Mock Chat -->
					<div class="whatsapp__chat glass-card">
						<div class="chat__header">
							<div class="chat__avatar">🤖</div>
							<div>
								<h5 class="chat__name">Asistente Barbería Kalifa</h5>
								<span class="chat__status">En línea (Bot de WhatsApp)</span>
							</div>
						</div>
						<div class="chat__body">
							<div class="chat__message chat__message--user">
								Hola, ¿tengo alguna cita pendiente hoy?
							</div>
							<div class="chat__message chat__message--bot">
								¡Hola! Buscando con tu número de teléfono... 🔍
							</div>
							<div class="chat__message chat__message--bot">
								Sí, tienes una cita hoy:
								<br />✂️ <strong>Corte + Barba</strong>
								<br />🕐 <strong>11:00 AM</strong>
								<br />💰 <strong>$250 MXN</strong>
								<br /><br />
								¿Deseas confirmar tu asistencia?
							</div>
							<div class="chat__message chat__message--user">
								Sí, confirmar por favor
							</div>
							<div class="chat__message chat__message--bot">
								¡Excelente! Tu asistencia está confirmada. Te esperamos a las 11:00 AM. 💈
							</div>
						</div>
					</div>
				</div>

				<!-- Demo CTA Banner -->
				<div class="whatsapp__cta-banner glass-card">
					<div class="cta-banner__content">
						<h3>¿Quieres automatizar las citas de tu negocio?</h3>
						<p>Este sistema es una demo interactiva. Desarrollamos y configuramos tu propio software de reservaciones con bot de WhatsApp a la medida de tu marca.</p>
					</div>
					<a href="/contact-form?ref=barberia-demo" class="btn-primary">Cotizar mi Sistema</a>
				</div>
			</div>
		</section>

		<!-- Gallery / Tipos de Corte -->
		<section class="home__gallery">
			<div class="container">
				<h2 class="section-title">Modelos y Tipos de Corte</h2>
				<p class="section-subtitle">
					Inspírate para tu próximo cambio de look con nuestros estilos más populares.
				</p>
				<div class="gallery__grid">
					<div class="gallery__item">
						<img
							src="https://images.unsplash.com/photo-1622286342621-4bd786c2447c?auto=format&fit=crop&q=80&w=800"
							alt="Corte Clásico"
							loading="lazy"
						/>
						<div class="gallery__overlay">
							<h3>Corte Clásico</h3>
							<p>Elegancia atemporal</p>
						</div>
					</div>
					<div class="gallery__item">
						<img
							src="https://images.unsplash.com/photo-1599351431202-1e0f0137899a?auto=format&fit=crop&q=80&w=800"
							alt="Fade Moderno"
							loading="lazy"
						/>
						<div class="gallery__overlay">
							<h3>Fade Moderno</h3>
							<p>Transiciones perfectas</p>
						</div>
					</div>
					<div class="gallery__item">
						<img
							src="https://images.unsplash.com/photo-1593702275687-f8b402bf1fb5?auto=format&fit=crop&q=80&w=800"
							alt="Arreglo de Barba"
							loading="lazy"
						/>
						<div class="gallery__overlay">
							<h3>Diseño de Barba</h3>
							<p>Perfilado impecable</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Location Section -->
		<section class="home__location">
			<div class="container">
				<h2 class="section-title">Ven a Visitarnos</h2>
				<div class="location__grid">
					<div class="location__map-wrapper glass-card">
						<!-- Map Placeholder with blue icon theme -->
						<div class="location__map-placeholder">
							<svg
								width="48"
								height="48"
								viewBox="0 0 24 24"
								fill="none"
								stroke="var(--color-signal-blue)"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								class="location__map-icon"
								><path
									d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
								></path><circle cx="12" cy="10" r="3"
								></circle></svg
							>
							<p style="color: var(--text-secondary); margin-top: 0.5rem;">Mapa de Ubicación</p>
						</div>
					</div>
					<div class="location__info">
						<div class="location__item">
							<div class="location__icon">📍</div>
							<div>
								<h4>Dirección</h4>
								<p>
									Calle de la Elegancia 123, Centro Histórico
								</p>
							</div>
						</div>
						<div class="location__item">
							<div class="location__icon">📞</div>
							<div>
								<h4>Teléfono</h4>
								<p>+34 912 345 678</p>
							</div>
						</div>
						<div class="location__item">
							<div class="location__icon">⌚</div>
							<div>
								<h4>Horario Semanal</h4>
								<p id="locationHoursText">
									Lun - Sáb: 09:00 AM - 08:00 PM
								</p>
								<p class="location__closed">Dom: Cerrado</p>
							</div>
						</div>
						<a href="/proyectos/barberia/reservar" class="btn-secondary location__btn"
							>Cómo llegar</a
						>
					</div>
				</div>
			</div>
		</section>
	</main>
</DemoLayout>

<style>
	.home {
		padding-top: 0;
	}

	/* ── Hero Split Layout ── */
	.home__hero {
		position: relative;
		min-height: 90vh;
		display: flex;
		align-items: center;
		padding: 7rem 1.5rem 4rem;
		background: radial-gradient(circle at 10% 20%, rgba(13, 27, 42, 0.4) 0%, transparent 80%);
		overflow: hidden;
	}

	.home__hero-inner {
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: 4rem;
		align-items: center;
		position: relative;
		z-index: 2;
	}

	.home__hero-left {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	.home__hero-right {
		position: relative;
		display: flex;
		justify-content: center;
		align-items: center;
		min-height: 400px;
	}

	.home__status-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.4rem 1rem;
		background: rgba(13, 27, 42, 0.6);
		border: 1px solid var(--color-mist-border);
		backdrop-filter: blur(8px);
		border-radius: var(--radius-full);
		margin-bottom: 1.5rem;
		font-size: 0.85rem;
		font-weight: 600;
	}

	.home__status-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--accent-green);
		animation: breathe 2s ease-in-out infinite;
	}

	.home__status-dot.closed {
		background: var(--accent-red);
		animation: none;
	}

	.home__hours-text {
		color: var(--text-secondary);
		border-left: 1px solid var(--color-mist-border);
		padding-left: 0.6rem;
		font-weight: 500;
	}

	.home__title {
		font-family: var(--font-heading);
		font-size: clamp(2.5rem, 6vw, 4rem);
		font-weight: 800;
		line-height: 1.1;
		letter-spacing: -0.02em;
		margin-bottom: 1.5rem;
		color: #ffffff;
	}

	.home__highlight {
		color: var(--color-signal-blue);
		font-weight: 900;
	}

	.home__desc {
		font-size: 1.05rem;
		color: var(--text-secondary);
		max-width: 520px;
		margin-bottom: 2.5rem;
		line-height: 1.65;
	}

	.home__actions {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		width: 100%;
		max-width: 400px;
	}

	.home__btn {
		justify-content: center;
		width: 100%;
	}

	.home__admin-link {
		margin-top: 1.25rem;
		font-size: 0.88rem;
		color: var(--color-slate-blue);
		text-decoration: none;
		font-weight: 600;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		transition: color var(--transition-fast), border-color var(--transition-fast), background var(--transition-fast);
		border: 1px solid var(--color-mist-border);
		padding: 0.6rem 1.2rem;
		border-radius: var(--radius-sm);
		background: rgba(13, 27, 42, 0.4);
		backdrop-filter: blur(4px);
	}

	.home__admin-link:hover {
		color: var(--color-signal-blue);
		border-color: rgba(0, 107, 255, 0.4);
		background: rgba(13, 27, 42, 0.6);
	}

	/* ── Ambient Gradient Blobs (Watercolor effect) ── */
	.hero-blob {
		position: absolute;
		border-radius: 50%;
		filter: blur(80px);
		opacity: 0.25;
		z-index: 1;
		pointer-events: none;
	}

	.hero-blob--magenta {
		width: 250px;
		height: 250px;
		background: var(--color-magenta-bloom);
		top: -10%;
		left: 10%;
		animation: float 8s ease-in-out infinite alternate;
	}

	.hero-blob--cyan {
		width: 300px;
		height: 300px;
		background: var(--color-cyan-pop);
		bottom: 5%;
		right: 15%;
		animation: float 12s ease-in-out infinite alternate-reverse;
	}

	.hero-blob--ultraviolet {
		width: 220px;
		height: 220px;
		background: var(--color-ultraviolet);
		top: 30%;
		right: 5%;
		animation: float 10s ease-in-out infinite alternate;
	}

	.hero-blob--amber {
		width: 150px;
		height: 150px;
		background: var(--color-amber-spark);
		bottom: 40%;
		left: 0%;
		opacity: 0.15;
		animation: float 7s ease-in-out infinite alternate;
	}

	/* ── Product UI Scheduling Mockup ── */
	.mockup-card {
		width: 100%;
		max-width: 360px;
		position: relative;
		z-index: 2;
		border-radius: var(--radius-2xl); /* 16px radius */
		overflow: hidden;
		animation: float 6s ease-in-out infinite;
	}

	.mockup-card__header {
		padding: 1.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-bottom: 1px solid var(--color-mist-border);
		background: rgba(11, 24, 36, 0.4);
	}

	.mockup-card__icon {
		font-size: 1.75rem;
		background: rgba(0, 107, 255, 0.1);
		width: 48px;
		height: 48px;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		color: var(--color-signal-blue);
	}

	.mockup-card__title {
		font-family: var(--font-heading);
		font-size: 0.95rem;
		font-weight: 700;
		color: #ffffff;
	}

	.mockup-card__sub {
		font-size: 0.75rem;
		color: var(--text-secondary);
		margin-top: 0.1rem;
	}

	.mockup-card__price {
		font-family: var(--font-heading);
		font-size: 1.2rem;
		font-weight: 800;
		color: var(--color-signal-blue);
	}

	.mockup-card__body {
		padding: 1.5rem;
	}

	.mockup-card__services {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		margin-bottom: 1.25rem;
	}

	.mockup-card__item {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.75rem 1rem;
		background: rgba(11, 24, 36, 0.5);
		border: 1px solid var(--color-mist-border);
		border-radius: var(--radius-lg);
	}

	.mockup-card__item.active {
		border-color: var(--color-signal-blue);
		background: rgba(0, 107, 255, 0.05);
	}

	.mockup-card__item-name {
		font-size: 0.8rem;
		font-weight: 600;
		display: block;
		color: #ffffff;
	}

	.mockup-card__item-time {
		font-size: 0.7rem;
		color: var(--text-secondary);
		display: block;
		margin-top: 0.1rem;
	}

	.mockup-card__item-price {
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--text-primary);
	}

	.mockup-card__slots-label {
		font-size: 0.75rem;
		color: var(--text-secondary);
		margin-bottom: 0.6rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.mockup-card__slots {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.5rem;
	}

	.mockup-card__slot {
		padding: 0.5rem;
		text-align: center;
		font-size: 0.75rem;
		font-weight: 600;
		border: 1px solid var(--color-mist-border);
		background: rgba(11, 24, 36, 0.3);
		border-radius: var(--radius-sm);
	}

	.mockup-card__slot.selected {
		background: var(--color-signal-blue);
		color: #ffffff;
		border-color: transparent;
	}

	/* ── Gallery Section ── */
	.home__gallery {
		padding: var(--section-padding);
		background: var(--bg-primary);
	}

	.gallery__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.5rem;
		margin-top: 3rem;
	}

	.gallery__item {
		position: relative;
		border-radius: var(--radius-lg);
		overflow: hidden;
		aspect-ratio: 4/5;
		cursor: pointer;
		border: 1px solid var(--color-mist-border);
	}

	.gallery__item img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s var(--ease-out);
	}

	.gallery__item:hover img {
		transform: scale(1.04);
	}

	.gallery__overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			to top,
			rgba(5, 12, 20, 0.95) 0%,
			rgba(5, 12, 20, 0.3) 50%,
			transparent 100%
		);
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		padding: 1.5rem;
	}

	.gallery__overlay h3 {
		font-family: var(--font-heading);
		font-size: 1.25rem;
		font-weight: 700;
		margin-bottom: 0.3rem;
		color: #ffffff;
	}

	.gallery__overlay p {
		font-size: 0.85rem;
		color: var(--text-secondary);
	}

	/* ── Location Section ── */
	.home__location {
		padding: var(--section-padding);
		background: var(--bg-secondary);
		border-top: 1px solid var(--color-mist-border);
	}

	.location__grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 3rem;
		margin-top: 3rem;
	}

	.location__map-wrapper {
		width: 100%;
		height: 400px;
		border-radius: var(--radius-lg);
		overflow: hidden;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.location__map-placeholder {
		text-align: center;
	}

	.location__map-icon {
		margin-bottom: 1rem;
		opacity: 0.8;
	}

	.location__info {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		justify-content: center;
	}

	.location__item {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
	}

	.location__icon {
		font-size: 1.4rem;
		color: var(--color-signal-blue);
		background: rgba(0, 107, 255, 0.1);
		width: 48px;
		height: 48px;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: var(--radius-full);
	}

	.location__item h4 {
		font-family: var(--font-heading);
		font-size: 1.05rem;
		margin-bottom: 0.3rem;
		color: #ffffff;
	}

	.location__item p {
		color: var(--text-secondary);
		font-size: 0.9rem;
	}

	.location__closed {
		color: var(--accent-red) !important;
	}

	.location__btn {
		margin-top: 1rem;
		align-self: flex-start;
	}

	/* ── WhatsApp Integration ── */
	.home__whatsapp {
		padding: var(--section-padding);
		background: var(--bg-primary);
		border-top: 1px solid var(--color-mist-border);
	}

	.whatsapp__grid {

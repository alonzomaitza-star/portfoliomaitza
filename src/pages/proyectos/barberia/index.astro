<script>
	import { getConfig } from "./lib/store.js";

	function updateHomeConfig() {
		const config = getConfig();

		// Status Badge
		const dot = document.getElementById("statusDot");
		const text = document.getElementById("statusText");
		const hours = document.getElementById("hoursText");
		const btn = document.getElementById("btnReservar");
		const locationHours = document.getElementById("locationHoursText");

		if (config.isOpen) {
			dot?.classList.remove("closed");
			if (text) text.textContent = "Abierto Ahora";
			if (text) text.style.color = "var(--accent-green)";
		} else {
			dot?.classList.add("closed");
			if (text) text.textContent = "Cerrado";
			if (text) text.style.color = "var(--text-muted)";
			if (btn) {
				btn.style.opacity = "0.5";
				btn.style.pointerEvents = "none";
			}
		}

		if (hours)
			hours.textContent = `Hoy: ${config.openTime} - ${config.closeTime}`;
		if (locationHours)
			locationHours.textContent = `Lun - Sáb: ${config.openTime} - ${config.closeTime}`;
	}

	// Wait for DOM to be ready
	document.addEventListener("DOMContentLoaded", updateHomeConfig);
</script>

  <!-- Wizard & Customizer JavaScript Logic -->
  <script is:inline>
    // State management for wizard steps
    let currentStep = 1;
    const totalSteps = 5;

    const btnBack = document.getElementById("btn-back");
    const btnNext = document.getElementById("btn-next");
    const progressBar = document.getElementById("progress-bar");
    const successModal = document.getElementById("success-modal");

    function updateStepUI() {
      // Hide all step forms
      for (let i = 1; i <= totalSteps; i++) {
        const form = document.getElementById("form-step-" + i);
        const label = document.querySelector(`.step-label[data-step="${i}"]`);
        
        if (form) form.classList.add("hidden");
        if (label) label.classList.remove("text-violet-400");
      }

      // Show current step form and color step indicator
      const activeForm = document.getElementById("form-step-" + currentStep);
      const activeLabel = document.querySelector(`.step-label[data-step="${currentStep}"]`);
      
      if (activeForm) activeForm.classList.remove("hidden");
      if (activeLabel) activeLabel.classList.add("text-violet-400");

      // Update progress bar width
      const progressPercentage = (currentStep / totalSteps) * 100;
      progressBar.style.width = progressPercentage + "%";

      // Hide or show Back button
      if (currentStep === 1) {
        btnBack.classList.add("invisible");
      } else {
        btnBack.classList.remove("invisible");
      }

      // Change next button styling/text on step 3 (Generation trigger)
      if (currentStep === 3) {
        btnNext.textContent = "Generar Invitación";
        btnNext.className = "bg-gradient-to-r from-emerald-600 to-teal-600 hover:shadow-lg hover:shadow-emerald-650/10 text-white font-bold px-6 py-3 rounded-xl transition-all text-sm hover:scale-[1.02] active:scale-[0.98]";
      } else if (currentStep === totalSteps) {
        btnNext.textContent = "Generar Invitación";
        btnNext.className = "bg-gradient-to-r from-emerald-600 to-teal-600 hover:shadow-lg hover:shadow-emerald-650/10 text-white font-bold px-6 py-3 rounded-xl transition-all text-sm hover:scale-[1.02] active:scale-[0.98]";
      } else {
        btnNext.textContent = "Siguiente";
        btnNext.className = "bg-gradient-to-r from-violet-600 to-indigo-600 hover:shadow-lg hover:shadow-violet-600/10 text-white font-bold px-6 py-3 rounded-xl transition-all text-sm hover:scale-[1.02] active:scale-[0.98]";
      }
    }

    // Next step / Generation trigger
    btnNext.addEventListener("click", () => {
      if (currentStep === 3 || currentStep === totalSteps) {
        // Trigger modal pop out at Step 3 or Step 5
        const nameInput = document.getElementById("input-name").value;
        const normalized = nameInput.toLowerCase().trim().replace(/[^a-z0-9]/g, "-").replace(/-+/g, "-");
        const customUrl = `https://insano.network/invitacion/${normalized || "ruby-alvarado"}`;
        document.getElementById("generated-link").textContent = customUrl;
        
        const step4Link = document.getElementById("step-4-generated-link");
        if (step4Link) step4Link.textContent = customUrl;

        successModal.classList.remove("hidden");

        // Automatically advance the customizer to Step 4 (Adicionales) in the background
        if (currentStep === 3) {
          currentStep = 4;
          updateStepUI();
        }
      } else if (currentStep < totalSteps) {
        currentStep++;
        updateStepUI();
      }
    });

    // Back step navigation
    btnBack.addEventListener("click", () => {
      if (currentStep > 1) {
        currentStep--;
        updateStepUI();
      }
    });

    // Success Modal Close
    document.getElementById("btn-close-modal").addEventListener("click", () => {
      successModal.classList.add("hidden");
    });

    // Success Modal Redirect to Step 4 (Adicionales)
    document.getElementById("btn-add-premium-services").addEventListener("click", () => {
      successModal.classList.add("hidden");
      currentStep = 4;
      updateStepUI();
    });

    // Copy URL to clipboard
    document.getElementById("btn-copy").addEventListener("click", function() {
      const linkText = document.getElementById("generated-link").textContent.trim();
      navigator.clipboard.writeText(linkText).then(() => {
        const btnSpan = this.querySelector("span");
        btnSpan.textContent = "¡Copiado!";
        setTimeout(() => {
          btnSpan.textContent = "Copiar";
        }, 2000);
      });
    });

    // Copy URL from Step 4 persistent link box
    document.getElementById("btn-step-4-copy")?.addEventListener("click", function() {
      const linkText = document.getElementById("step-4-generated-link").textContent.trim();
      navigator.clipboard.writeText(linkText).then(() => {
        const btnSpan = this.querySelector("span");
        btnSpan.textContent = "¡Copiado!";
        setTimeout(() => {
          btnSpan.textContent = "Copiar";
        }, 2000);
      });
    });

    // Make step labels clickable to navigate freely
    document.querySelectorAll(".step-label").forEach(label => {
      label.addEventListener("click", () => {
        const targetStep = parseInt(label.dataset.step);
        if (targetStep >= 1 && targetStep <= totalSteps) {
          currentStep = targetStep;
          updateStepUI();
        }
      });
    });

    // ---- LIVE UPDATE HANDLERS ----
    // Simple helper to register live binder
    function bindInputToText(inputId, previewId, transformer = (val) => val) {
      const input = document.getElementById(inputId);
      const preview = document.getElementById(previewId);
      if (!input || !preview) return;

      const update = () => {
        preview.textContent = transformer(input.value);
      };
      input.addEventListener("input", update);
      input.addEventListener("change", update);
      update(); // initial
    }

    // Bind Event Type
    bindInputToText("input-event-type", "preview-event-type", (val) => val);

    // Bind Name and update Footer Name & Hashtag
    const inputName = document.getElementById("input-name");
    const previewName = document.getElementById("preview-name");
    const previewFooter = document.getElementById("preview-footer-name");
    const previewHashtag = document.getElementById("preview-hashtag");

    if (inputName) {
      const updateNames = () => {
        const val = inputName.value || "Ruby Alvarado";
        if (previewName) previewName.textContent = val;
        if (previewFooter) previewFooter.textContent = val;
        if (previewHashtag) {
          const hashtags = val.split("&").map(s => s.trim().replace(/\s+/g, ""));
          previewHashtag.textContent = "#" + (hashtags.join("_") || "Evento");
        }
      };
      inputName.addEventListener("input", updateNames);
      updateNames();
    }

    // Helper for formatting date in Spanish
    function formatDateSpanish(dateStr) {
      if (!dateStr) return "";
      const date = new Date(dateStr + "T00:00:00");
      const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
      const formatted = date.toLocaleDateString('es-MX', options);
      // Capitalize first letter
      return formatted.charAt(0).toUpperCase() + formatted.slice(1);
    }

    // Bind Dates and Time
    const inputDate = document.getElementById("input-date");
    const inputTime = document.getElementById("input-time");
    const previewDateText = document.getElementById("preview-date-text");
    const previewFullDate = document.getElementById("preview-full-date");
    const previewFullTime = document.getElementById("preview-full-time");

    function updateDateAndCountdown() {
      const dateVal = inputDate?.value;
      const timeVal = inputTime?.value || "18:00";
      
      if (dateVal) {
        const formatted = formatDateSpanish(dateVal);
        if (previewDateText) previewDateText.textContent = formatted;
        if (previewFullDate) previewFullDate.textContent = formatted;
      }
      
      if (timeVal) {
        const [hours, minutes] = timeVal.split(":");
        const isPM = parseInt(hours) >= 12;
        const formattedTime = `${(parseInt(hours) % 12) || 12}:${minutes} ${isPM ? 'PM' : 'AM'}`;
        if (previewFullTime) previewFullTime.textContent = formattedTime;
      }
    }
    
    inputDate?.addEventListener("change", updateDateAndCountdown);
    inputTime?.addEventListener("input", updateDateAndCountdown);
    updateDateAndCountdown();

    // Countdown active simulation based on input-date
    let countdownInterval;
    function startCountdownSimulation() {
      if (countdownInterval) clearInterval(countdownInterval);

      const target = () => {
        const dateVal = inputDate?.value || "2026-05-30";
        const timeVal = inputTime?.value || "18:00";
        return new Date(`${dateVal}T${timeVal}:00`).getTime();
      };

      const update = () => {
        const distance = target() - new Date().getTime();
        
        if (distance < 0) {
          document.getElementById("prev-days").textContent = "00";
          document.getElementById("prev-hours").textContent = "00";
          document.getElementById("prev-min").textContent = "00";
          document.getElementById("prev-sec").textContent = "00";
          return;
        }

        const d = Math.floor(distance / (1000 * 60 * 60 * 24));
        const h = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const m = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
        const s = Math.floor((distance % (1000 * 60)) / 1000);

        document.getElementById("prev-days").textContent = d.toString().padStart(2, '0');
        document.getElementById("prev-hours").textContent = h.toString().padStart(2, '0');
        document.getElementById("prev-min").textContent = m.toString().padStart(2, '0');
        document.getElementById("prev-sec").textContent = s.toString().padStart(2, '0');
      };

      countdownInterval = setInterval(update, 1000);
      update();
    }
    startCountdownSimulation();
    inputDate?.addEventListener("change", startCountdownSimulation);
    inputTime?.addEventListener("change", startCountdownSimulation);
    
    // Wishlist initial state
    let wishList = [
      { id: 1, name: "Cafetera Nespresso Vertuo", store: "Amazon", link: "https://www.amazon.com.mx/dp/B08DFG", image: "https://images.unsplash.com/photo-1517701604599-bb29b565090c?q=80&w=150&auto=format&fit=crop", reserved: false },
      { id: 2, name: "Licuadora Ninja Professional", store: "Mercado Libre", link: "https://articulo.mercadolibre.com.mx/MLM-12345", image: "https://images.unsplash.com/photo-1578643463396-0997cb5328c1?q=80&w=150&auto=format&fit=crop", reserved: true },
      { id: 3, name: "Juego de Sábanas Algodón Egipcio", store: "Liverpool", link: "", image: "https://images.unsplash.com/photo-1522771739844-6a9f6d5f14af?q=80&w=150&auto=format&fit=crop", reserved: false }
    ];

    // Dom elements for Wishlist
    const wishlistLinkInput = document.getElementById("wishlist-link-input");
    const detectedStoreBadge = document.getElementById("detected-store-badge");
    const wishlistLoadingMsg = document.getElementById("wishlist-loading-msg");
    const wishlistManualForm = document.getElementById("wishlist-manual-form");
    const wishlistProductName = document.getElementById("wishlist-product-name");
    const wishlistProductStore = document.getElementById("wishlist-product-store");
    const wishlistProductFile = document.getElementById("wishlist-product-file");
    const wishlistProductFilename = document.getElementById("wishlist-product-filename");
    const btnAddWishlistItem = document.getElementById("btn-add-wishlist-item");
    const btnToggleManualAddition = document.getElementById("btn-toggle-manual-addition");
    const wishlistItemsContainer = document.getElementById("wishlist-items-container");
    const wishlistItemsCount = document.getElementById("wishlist-items-count");
    
    // Store detected image URL/Blob state
    let uploadedImageBlob = null;
    let storeThemes = {
      "Amazon": { bg: "bg-orange-500/10 text-orange-400 border-orange-500/20", img: "https://images.unsplash.com/photo-1523474253046-8cd2748b5fd2?q=80&w=150&auto=format&fit=crop" },
      "Mercado Libre": { bg: "bg-yellow-500/10 text-yellow-400 border-yellow-500/20", img: "https://images.unsplash.com/photo-1563013544-824ae1d704d3?q=80&w=150&auto=format&fit=crop" },
      "Liverpool": { bg: "bg-pink-500/10 text-pink-400 border-pink-500/20", img: "https://images.unsplash.com/photo-1607082348824-0a96f2a4b9da?q=80&w=150&auto=format&fit=crop" },
      "Palacio de Hierro": { bg: "bg-amber-500/10 text-amber-400 border-amber-500/20", img: "https://images.unsplash.com/photo-1441986300917-64674bd600d8?q=80&w=150&auto=format&fit=crop" },
      "Otro": { bg: "bg-slate-500/10 text-slate-400 border-slate-500/20", img: "https://images.unsplash.com/photo-1549417229-aa67d3263c09?q=80&w=150&auto=format&fit=crop" }
    };

    // Auto-detect store from URL input
    wishlistLinkInput?.addEventListener("input", function() {
      const url = this.value.trim();
      if (!url) {
        detectedStoreBadge.classList.add("hidden");
        return;
      }
      
      let detectedStore = null;
      if (/amazon|amzn/i.test(url)) {
        detectedStore = "Amazon";
      } else if (/mercadolibre|ml\.com|meli/i.test(url)) {
        detectedStore = "Mercado Libre";
      } else if (/liverpool/i.test(url)) {
        detectedStore = "Liverpool";
      } else if (/palaciodehierro|elpalacio/i.test(url)) {
        detectedStore = "Palacio de Hierro";
      }
      
      if (detectedStore) {
        // Show detected badge
        detectedStoreBadge.className = `text-[9px] py-0.5 px-2 rounded-md font-bold uppercase tracking-wider border ${storeThemes[detectedStore].bg}`;
        detectedStoreBadge.textContent = detectedStore;
        detectedStoreBadge.classList.remove("hidden");
        
        // Select it in store dropdown
        wishlistProductStore.value = detectedStore;
        
        // Trigger simulated scraping loading animation
        wishlistLoadingMsg.classList.remove("hidden");
        wishlistLinkInput.disabled = true;
        btnAddWishlistItem.disabled = true;
        
        setTimeout(() => {
          wishlistLoadingMsg.classList.add("hidden");
          wishlistLinkInput.disabled = false;
          btnAddWishlistItem.disabled = false;
          
          // Autofill a mock name based on store
          wishlistProductName.value = `Regalo desde ${detectedStore}`;
          wishlistManualForm.classList.remove("hidden");
        }, 1200);
      } else {
        detectedStoreBadge.classList.add("hidden");
      }
    });

    // Toggle manual addition
    btnToggleManualAddition?.addEventListener("click", () => {
      wishlistProductName.value = "";
      wishlistProductStore.value = "Otro";
      wishlistProductFilename.textContent = "Sin captura cargada";
      uploadedImageBlob = null;
      wishlistManualForm.classList.toggle("hidden");
    });

    // File upload
    wishlistProductFile?.addEventListener("change", function(e) {
      const file = this.files?.[0];
      if (file) {
        wishlistProductFilename.textContent = file.name;
        uploadedImageBlob = URL.createObjectURL(file);
      }
    });

    // Add to wishlist
    btnAddWishlistItem?.addEventListener("click", () => {
      const name = wishlistProductName.value.trim();
      const store = wishlistProductStore.value;
      const link = wishlistLinkInput.value.trim();
      
      if (!name) {
        alert("Por favor ingresa un nombre para el producto.");
        return;
      }
      
      // Image fallback
      const img = uploadedImageBlob || storeThemes[store]?.img || storeThemes["Otro"].img;
      
      wishList.push({
        id: Date.now(),
        name,
        store,
        link,
        image: img,
        reserved: false
      });
      
      // Reset form
      wishlistLinkInput.value = "";
      wishlistProductName.value = "";
      wishlistProductStore.value = "Amazon";
      wishlistProductFilename.textContent = "Sin captura cargada";
      uploadedImageBlob = null;
      detectedStoreBadge.classList.add("hidden");
      
      // Render
      renderHostWishList();
      renderPhoneWishList();
      renderHostReceivedGifts();
    });

    // Render Host Wishlist in Step 3
    function renderHostWishList() {
      if (!wishlistItemsContainer) return;
      wishlistItemsCount.textContent = wishList.length;
      
      if (wishList.length === 0) {
        wishlistItemsContainer.innerHTML = `
          <div class="text-center py-4 bg-slate-950/40 border border-slate-850 rounded-xl text-xs text-slate-500 italic">
            No has añadido ningún producto a tu mesa de regalos.
          </div>
        `;
        return;
      }
      
      wishlistItemsContainer.innerHTML = "";
      wishList.forEach((item, index) => {
        const itemEl = document.createElement("div");
        itemEl.className = "flex items-center justify-between p-2.5 bg-slate-950/80 border border-slate-850 rounded-xl gap-3 text-xs";
        
        const badgeColor = storeThemes[item.store]?.bg || storeThemes["Otro"].bg;
        
        itemEl.innerHTML = `
          <div class="flex items-center gap-2.5 min-w-0">
            <img src="${item.image}" class="w-8 h-8 object-cover rounded-lg border border-slate-800 bg-slate-900 shrink-0" />
            <div class="min-w-0">
              <p class="font-bold text-white truncate">${item.name}</p>
              <span class="inline-block text-[8px] px-1.5 py-0.2 rounded border font-semibold scale-90 origin-left ${badgeColor}">${item.store}</span>
            </div>
          </div>
          <button type="button" class="btn-delete-wishlist text-rose-400 hover:text-rose-300 p-1.5 font-bold" data-id="${item.id}">
            🗑️
          </button>
        `;
        wishlistItemsContainer.appendChild(itemEl);
      });
      
      // Attach delete listeners
      document.querySelectorAll(".btn-delete-wishlist").forEach(btn => {
        btn.addEventListener("click", function() {
          const id = parseInt(this.dataset.id);
          wishList = wishList.filter(item => item.id !== id);
          renderHostWishList();
          renderPhoneWishList();
          renderHostReceivedGifts();
        });
      });
    }

    // Phone Claim dialog state
    let activeClaimItemId = null;
    const phoneClaimModal = document.getElementById("phone-claim-modal");
    const phoneClaimProductName = document.getElementById("phone-claim-product-name");
    const btnPhoneClaimConfirm = document.getElementById("btn-phone-claim-confirm");
    const btnPhoneClaimCancel = document.getElementById("btn-phone-claim-cancel");

    // Render Phone wishlist preview (smartphone side)
    function renderPhoneWishList() {
      const container = document.getElementById("prev-wishlist-container");
      if (!container) return;
      
      if (wishList.length === 0) {
        container.innerHTML = `<p class="text-[9px] text-gray-400 italic text-center py-2">La mesa de regalos está vacía.</p>`;
        return;
      }
      
      container.innerHTML = "";
      wishList.forEach(item => {
        const card = document.createElement("div");
        card.className = "p-2 bg-white rounded-xl border border-violet-100/50 shadow-sm flex items-center gap-2.5 text-xs relative";
        
        let storeLabel = item.store;
        let storeColor = "bg-slate-100 text-slate-700 border-slate-200";
        if (item.store === "Amazon") storeColor = "bg-orange-50 text-orange-700 border-orange-200";
        else if (item.store === "Mercado Libre") storeColor = "bg-yellow-50 text-yellow-700 border-yellow-250";
        else if (item.store === "Liverpool") storeColor = "bg-pink-50 text-pink-700 border-pink-200";
        else if (item.store === "Palacio de Hierro") storeColor = "bg-amber-50 text-amber-800 border-amber-250";
        
        const actionBtn = item.reserved 
          ? `<span class="px-2 py-1 rounded bg-emerald-50 text-emerald-600 font-bold border border-emerald-100 text-[8px] uppercase tracking-wider">Reservado 🔒</span>`
          : `<button type="button" class="btn-claim-gift bg-violet-100 hover:bg-violet-200 text-violet-600 font-bold px-2.5 py-1 rounded text-[8px] uppercase tracking-wide transition-all" data-id="${item.id}">Regalar</button>`;
          
        const storeBadge = `<span class="inline-block text-[8px] px-1.5 py-0.2 rounded border font-semibold mt-0.5 ${storeColor}">${storeLabel}</span>`;
        
        const linkBtn = item.link 
          ? `<a href="${item.link}" target="_blank" class="text-[8px] text-blue-500 hover:underline font-bold mt-1 block">🔗 Comprar</a>`
          : "";
          
        card.innerHTML = `
          <img src="${item.image}" class="w-10 h-10 object-cover rounded-lg border border-violet-100 bg-slate-50 shrink-0" />
          <div class="min-w-0 flex-1">
            <p class="font-bold text-gray-800 truncate">${item.name}</p>
            <div class="flex items-center gap-2">
              ${storeBadge}
              ${linkBtn}
            </div>
          </div>
          <div class="shrink-0">
            ${actionBtn}
          </div>
        `;
        container.appendChild(card);
      });

      // Attach claim listeners
      document.querySelectorAll(".btn-claim-gift").forEach(btn => {
        btn.addEventListener("click", function() {
          const id = parseInt(this.dataset.id);
          const item = wishList.find(w => w.id === id);
          if (item) {
            activeClaimItemId = id;
            phoneClaimProductName.textContent = item.name;
            phoneClaimModal.classList.remove("hidden");
          }
        });
      });
    }

    // Modal Confirmation click listeners
    btnPhoneClaimConfirm?.addEventListener("click", () => {
      if (activeClaimItemId !== null) {
        const item = wishList.find(w => w.id === activeClaimItemId);
        if (item) {
          item.reserved = true;
          alert(`¡Muchas gracias! Has reservado "${item.name}" para el evento. Este regalo ya no se mostrará disponible para otros invitados.`);
          renderPhoneWishList();
          renderHostReceivedGifts();
        }
        activeClaimItemId = null;
        phoneClaimModal.classList.add("hidden");
      }
    });

    btnPhoneClaimCancel?.addEventListener("click", () => {
      activeClaimItemId = null;
      phoneClaimModal.classList.add("hidden");
    });

    // Bind RSVP Limit Date
    const inputLimitDate = document.getElementById("input-limit-date");
    const previewLimitDate = document.getElementById("preview-limit-date");
    if (inputLimitDate && previewLimitDate) {
      const updateLimit = () => {
        previewLimitDate.textContent = formatDateSpanish(inputLimitDate.value);
      };
      inputLimitDate.addEventListener("change", updateLimit);
      updateLimit();
    }

    // Auto-update simulator top bar time from clock
    setInterval(() => {
      const d = new Date();
      const simTimeEl = document.getElementById("simulator-time");
      if (simTimeEl) {
        simTimeEl.textContent = `${d.getHours().toString().padStart(2, '0')}:${d.getMinutes().toString().padStart(2, '0')}`;
      }
    }, 1000);

    // ---- PREMIUM SERVICES & COTIZADOR LOGIC ----
    const addOnList = [
      { id: "srv-aguinaldos", type: "qty", price: 20, wrapId: "qty-aguinaldos-wrap", qtyId: "srv-aguinaldos-qty" },
      { id: "srv-printed", type: "qty", price: 25, wrapId: "qty-printed-wrap", qtyId: "srv-printed-qty" },
      { id: "srv-centerpieces", type: "qty", price: 150, wrapId: "qty-centerpieces-wrap", qtyId: "srv-centerpieces-qty" },
      { id: "srv-souvenirs", type: "qty", price: 45, wrapId: "qty-souvenirs-wrap", qtyId: "srv-souvenirs-qty" },
      { id: "srv-mirror", type: "flat", price: 650 },
      { id: "srv-photo", type: "flat", price: 3500 },
      { id: "srv-drone", type: "flat", price: 2200 },
      { id: "srv-editing", type: "flat", price: 1500 },
      { id: "srv-catering", type: "flat", price: 2800 },
      { id: "srv-retouch", type: "flat", price: 800 }
    ];

    function calculateBudget() {
      let subtotal = 0;
      
      addOnList.forEach(srv => {
        const checkbox = document.getElementById(srv.id);
        const qtyWrap = srv.wrapId ? document.getElementById(srv.wrapId) : null;
        
        if (checkbox && checkbox.checked) {
          if (qtyWrap) qtyWrap.classList.remove("hidden");
          
          if (srv.type === "qty") {
            const qtyInput = document.getElementById(srv.qtyId);
            const qty = qtyInput ? Math.max(0, parseInt(qtyInput.value) || 0) : 0;
            subtotal += srv.price * qty;
          } else {
            subtotal += srv.price;
          }
        } else {
          if (qtyWrap) qtyWrap.classList.add("hidden");
        }
      });

      const discount = Math.round(subtotal * 0.15);
      const total = subtotal - discount;

      // Update UI elements
      document.getElementById("budget-subtotal").textContent = `$${subtotal.toLocaleString("es-MX")}`;
      document.getElementById("budget-discount").textContent = `-$${discount.toLocaleString("es-MX")}`;
      document.getElementById("budget-total").textContent = `$${total.toLocaleString("es-MX")}`;
      
      // Update Step 5 recap
      const recapDiv = document.getElementById("recap-step-5");
      const recapVal = document.getElementById("recap-total-val");
      if (recapDiv && recapVal) {
        if (subtotal > 0) {
          recapDiv.classList.remove("hidden");
          recapVal.textContent = `$${total.toLocaleString("es-MX")} MXN`;
        } else {
          recapDiv.classList.add("hidden");
        }
      }
    }

    // Attach listeners to all inputs
    addOnList.forEach(srv => {
      const checkbox = document.getElementById(srv.id);
      checkbox?.addEventListener("change", calculateBudget);
      
      if (srv.type === "qty") {
        const qtyInput = document.getElementById(srv.qtyId);
        qtyInput?.addEventListener("input", calculateBudget);
        qtyInput?.addEventListener("change", calculateBudget);
      }
    });

    // PLIS Checkboxes Synchronization
    const plisSyncCheckboxes = document.querySelectorAll(".plis-sync-chk");
    
    plisSyncCheckboxes.forEach(plisChk => {
      const targetId = plisChk.dataset.target;
      const targetChk = document.getElementById(targetId);
      
      if (targetChk) {
        // Sync initial state
        plisChk.checked = targetChk.checked;
        
        // Sync changes from PLIS to main checkboxes
        plisChk.addEventListener("change", () => {
          targetChk.checked = plisChk.checked;
          // Trigger change event to fire calculateBudget
          targetChk.dispatchEvent(new Event("change"));
          updatePlisBadge();
        });
        
        // Sync changes from main checkboxes back to PLIS
        targetChk.addEventListener("change", () => {
          plisChk.checked = targetChk.checked;
          updatePlisBadge();
        });
      }
    });

    function updatePlisBadge() {
      const selectedCount = Array.from(plisSyncCheckboxes).filter(chk => chk.checked).length;
      const badge = document.getElementById("plis-selected-count");
      if (badge) {
        badge.textContent = `${selectedCount} seleccionado${selectedCount !== 1 ? 's' : ''}`;
      }
    }
    
    updatePlisBadge();

    // Link "Ver todos los servicios adicionales" button to Step 4
    document.getElementById("btn-plis-go-to-step-4")?.addEventListener("click", () => {
      currentStep = 4;
      updateStepUI();
    });

    calculateBudget(); // initial call
  </script>

  <!-- Guest List Manager & RSVP Submission JavaScript Logic -->
  <script is:inline>
    // State management for Guest List (RSVP Confirmations)
    let guests = [
      { name: "Mamá", phone: "5512345670", passes: 2, status: "Confirmado ✅", message: "¡No puedo faltar!" },
      { name: "Tío Juan", phone: "5598765432", passes: 4, status: "Confirmado ✅", message: "Ahí estaremos con toda la familia." },
      { name: "Sofía Amiga", phone: "5544332211", passes: 1, status: "Pendiente ⏳", message: "" },
      { name: "Carlos Primo", phone: "5566778899", passes: 2, status: "Rechazado ❌", message: "Lo siento, tengo un viaje ese día." },
      { name: "Laura Compañera", phone: "5555112233", passes: 2, status: "Confirmado ✅", message: "Muchas felicidades." },
      { name: "Vecina María", phone: "5522889900", passes: 3, status: "Pendiente ⏳", message: "" }
    ];

    const customizerContainer = document.getElementById("invitation-customizer-container");
    const managerPanel = document.getElementById("event-manager-panel");
    const modal = document.getElementById("success-modal");

    // Modal navigation button to transition to Event Manager
    document.getElementById("btn-go-to-manager").addEventListener("click", () => {
      modal.classList.add("hidden");
      customizerContainer.classList.add("hidden");
      managerPanel.classList.remove("hidden");
      renderGuestsTable();
      renderHostReceivedGifts();
    });

    // Go back from manager to customizer
    document.getElementById("btn-back-to-customizer").addEventListener("click", () => {
      managerPanel.classList.add("hidden");
      customizerContainer.classList.remove("hidden");
    });

    // Event Manager Tabs switching
    const tabGuests = document.getElementById("tab-guests");
    const tabWishlist = document.getElementById("tab-wishlist");
    const viewGuests = document.getElementById("view-guests");
    const viewWishlist = document.getElementById("view-wishlist");

    tabGuests?.addEventListener("click", () => {
      tabGuests.className = "px-5 py-2.5 text-xs font-bold uppercase tracking-wider rounded-t-xl bg-slate-900 border-t border-x border-slate-800 text-violet-400 focus:outline-none transition-all";
      tabWishlist.className = "px-5 py-2.5 text-xs font-bold uppercase tracking-wider rounded-t-xl bg-transparent border-t border-x border-transparent text-slate-400 hover:text-white focus:outline-none transition-all";
      viewGuests.classList.remove("hidden");
      viewWishlist.classList.add("hidden");
      renderGuestsTable();
    });

    tabWishlist?.addEventListener("click", () => {
      tabWishlist.className = "px-5 py-2.5 text-xs font-bold uppercase tracking-wider rounded-t-xl bg-slate-900 border-t border-x border-slate-800 text-violet-400 focus:outline-none transition-all";
      tabGuests.className = "px-5 py-2.5 text-xs font-bold uppercase tracking-wider rounded-t-xl bg-transparent border-t border-x border-transparent text-slate-400 hover:text-white focus:outline-none transition-all";
      viewGuests.classList.add("hidden");
      viewWishlist.classList.remove("hidden");
      renderHostReceivedGifts();
    });

    // Render table rows and statistics
    function renderGuestsTable() {
      const tbody = document.getElementById("guests-table-body");
      if (!tbody) return;

      tbody.innerHTML = "";

      guests.forEach((guest, index) => {
        const tr = document.createElement("tr");
        tr.className = "border-b border-slate-850 hover:bg-slate-900/35 transition-colors";

        // RSVP status select
        let statusSelectHtml = `
          <select class="select-status bg-slate-950 border border-slate-800 rounded-lg px-2 py-1 text-xs text-white focus:outline-none" data-index="${index}">
            <option value="Confirmado ✅" ${guest.status.includes("Confirmado") ? "selected" : ""}>Confirmado ✅</option>
            <option value="Pendiente ⏳" ${guest.status.includes("Pendiente") ? "selected" : ""}>Pendiente ⏳</option>
            <option value="Rechazado ❌" ${guest.status.includes("Rechazado") ? "selected" : ""}>Rechazado ❌</option>
          </select>
        `;

        // Simulate WhatsApp messaging link
        const celebranteName = document.getElementById("input-name")?.value || "Ruby Alvarado";
        const limitDateText = document.getElementById("preview-limit-date")?.textContent || "15 de Mayo";
        const waMsg = `Hola *${guest.name}*, te recordamos registrar tu asistencia para el evento de *${celebranteName}* antes del *${limitDateText}* en el siguiente link oficial: https://insano.network/invitacion/ruby-alvarado`;
        const waLink = `https://wa.me/${guest.phone.startsWith("52") ? guest.phone : "52" + guest.phone}?text=${encodeURIComponent(waMsg)}`;

        tr.innerHTML = `
          <td class="p-4 text-center text-slate-500 font-mono">${index + 1}</td>
          <td class="p-4 font-semibold text-white">${guest.name}</td>
          <td class="p-4 text-slate-300 font-mono">${guest.phone}</td>
          <td class="p-4 text-center text-slate-300 font-semibold">${guest.passes}</td>
          <td class="p-4">${statusSelectHtml}</td>
          <td class="p-4 text-slate-400 italic truncate max-w-[200px]" title="${guest.message || "Sin mensaje"}">${guest.message || "-"}</td>
          <td class="p-4 flex items-center justify-center gap-2">
            <a href="${waLink}" target="_blank" class="p-1.5 bg-emerald-500/10 hover:bg-emerald-500/25 border border-emerald-500/25 text-emerald-400 rounded-lg transition-all" title="Simular recordatorio por WhatsApp">
              💬
            </a>
            <button class="btn-delete p-1.5 bg-rose-500/10 hover:bg-rose-500/25 border border-rose-500/25 text-rose-400 rounded-lg transition-all" data-index="${index}" title="Eliminar Invitado">
              🗑️
            </button>
          </td>
        `;

        tbody.appendChild(tr);
      });

      // Add status change listeners
      document.querySelectorAll(".select-status").forEach(select => {
        select.addEventListener("change", (e) => {
          const idx = parseInt(e.target.dataset.index);
          guests[idx].status = e.target.value;
          updateStats();
        });
      });

      // Add delete guest listeners
      document.querySelectorAll(".btn-delete").forEach(btn => {
        btn.addEventListener("click", (e) => {
          const idx = parseInt(e.currentTarget.dataset.index);
          guests.splice(idx, 1);
          renderGuestsTable();
        });
      });

      updateStats();
    }

    // Render Host Received Gifts status grid
    function renderHostReceivedGifts() {
      const grid = document.getElementById("host-wishlist-status-grid");
      if (!grid) return;
      
      if (wishList.length === 0) {
        grid.innerHTML = `
          <div class="col-span-full text-center py-8 bg-slate-950/40 border border-slate-850 rounded-2xl text-xs text-slate-500 italic">
            Aún no has añadido regalos a tu mesa. Vuelve al Paso 3 para configurar tu lista de deseos.
          </div>
        `;
        return;
      }
      
      grid.innerHTML = "";
      wishList.forEach(item => {
        const card = document.createElement("div");
        card.className = "p-4 bg-slate-950/60 border border-slate-850 rounded-2xl flex items-center gap-3.5 text-xs shadow-inner";
        
        const statusBadge = item.reserved
          ? `<span class="px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-bold uppercase tracking-wider text-[9px]">Aportado / Reservado 🔒</span>`
          : `<span class="px-2.5 py-0.5 rounded-full bg-slate-800 text-slate-400 border border-slate-700 font-semibold text-[9px]">Disponible 🟢</span>`;
          
        const badgeColor = storeThemes[item.store]?.bg || storeThemes["Otro"].bg;
        
        const linkHtml = item.link 
          ? `<a href="${item.link}" target="_blank" class="text-[9px] text-indigo-400 hover:text-indigo-300 hover:underline font-bold mt-1 inline-block">🔗 Ver Enlace de Tienda</a>`
          : `<span class="text-[9px] text-slate-500 italic mt-1 block">Sin enlace de compra</span>`;
          
        card.innerHTML = `
          <img src="${item.image}" class="w-12 h-12 object-cover rounded-xl border border-slate-800 bg-slate-900 shrink-0" />
          <div class="min-w-0 flex-1 space-y-1">
            <div class="flex justify-between items-start gap-1">
              <p class="font-bold text-white truncate leading-tight">${item.name}</p>
              <span class="inline-block text-[8px] px-1.5 py-0.2 rounded border font-semibold shrink-0 scale-90 ${badgeColor}">${item.store}</span>
            </div>
            ${linkHtml}
            <div class="pt-1.5 border-t border-slate-900/60 flex items-center justify-between">
              <span class="text-[9px] text-slate-400 font-semibold">Estado:</span>
              ${statusBadge}
            </div>
          </div>
        `;
        grid.appendChild(card);
      });
    }

    // Update guest list statistics
    function updateStats() {
      const statsTotal = document.getElementById("stats-total");
      const statsConfirmed = document.getElementById("stats-confirmed");

      const totalCount = guests.length;
      const confirmedCount = guests.filter(g => g.status.includes("Confirmado")).length;

      if (statsTotal) statsTotal.textContent = `${totalCount} / 100`;
      if (statsConfirmed) statsConfirmed.textContent = String(confirmedCount);
    }

    // Add manual guest (from host panel)
    const formAdd = document.getElementById("form-add-guest");
    formAdd?.addEventListener("submit", (e) => {
      e.preventDefault();
      
      if (guests.length >= 100) {
        alert("⚠️ Has alcanzado el límite de 100 invitados en la versión demo. Por favor contrata el Plan Premium para añadir más.");
        return;
      }

      const name = document.getElementById("add-guest-name").value.trim();
      const phone = document.getElementById("add-guest-phone").value.trim().replace(/\D/g, "");
      const passes = parseInt(document.getElementById("add-guest-passes").value) || 1;

      if (phone.length < 10) {
        alert("Por favor ingresa un número de teléfono válido de 10 dígitos.");
        return;
      }

      guests.push({
        name,
        phone,
        passes,
        status: "Pendiente ⏳",
        message: ""
      });

      // Reset fields
      document.getElementById("add-guest-name").value = "";
      document.getElementById("add-guest-phone").value = "";
      document.getElementById("add-guest-passes").value = "2";

      renderGuestsTable();
    });

    // RSVP simulator submission inside phone
    const rsvpSimForm = document.getElementById("rsvp-simulator-form");
    rsvpSimForm?.addEventListener("submit", (e) => {
      e.preventDefault();
      
      if (guests.length >= 100) {
        alert("⚠️ El evento ha alcanzado el límite de 100 invitados. No se pueden procesar más confirmaciones.");
        return;
      }

      const rName = document.getElementById("rsvp-sim-name").value.trim();
      const rAttending = document.getElementById("rsvp-sim-attending").value;
      const rPasses = parseInt(document.getElementById("rsvp-sim-passes").value) || 1;
      const rMsg = document.getElementById("rsvp-sim-message").value.trim();

      if (!rName) {
        alert("Por favor ingresa tu nombre completo.");
        return;
      }

      // Add simulated user submission
      guests.push({
        name: rName,
        phone: "Simulado 📱",
        passes: rPasses,
        status: rAttending,
        message: rMsg
      });

      // Reset simulated inputs
      document.getElementById("rsvp-sim-name").value = "";
      document.getElementById("rsvp-sim-message").value = "";

      alert(`¡Gracias ${rName}! Tu confirmación de asistencia se ha registrado correctamente en el panel RSVP del anfitrión.`);
      
      // Update table if they are in the manager view
      renderGuestsTable();
    });

    // Download CSV template (Without gift column)
    document.getElementById("btn-download-template")?.addEventListener("click", () => {
      const headers = "Nombre,Telefono,Asistencia(Confirmado/Pendiente/Rechazado),Pases,Mensaje\n";
      const sample = "Tia Carmen,5588334411,Confirmado,3,Muchas felicidades!\nJuan Amigo,5512341234,Pendiente,1,\n";
      const csvContent = "data:text/csv;charset=utf-8," + encodeURIComponent(headers + sample);
      
      const dlAnchor = document.createElement('a');
      dlAnchor.setAttribute("href", csvContent);
      dlAnchor.setAttribute("download", "plantilla_invitados_insano.csv");
      document.body.appendChild(dlAnchor);
      dlAnchor.click();
      document.body.removeChild(dlAnchor);
    });

    // Upload & parse CSV file (Without gift column)
    document.getElementById("input-upload-csv")?.addEventListener("change", function(e) {
      const file = this.files?.[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(evt) {
        const text = evt.target?.result;
        if (!text) return;

        const lines = text.split("\n");
        let addedCount = 0;
        
        // Skip header at index 0
        for (let i = 1; i < lines.length; i++) {
          const line = lines[i].trim();
          if (!line) continue;

          const cols = line.split(",");
          if (cols.length < 2) continue;

          if (guests.length >= 100) {
            alert("⚠️ Límite de 100 invitados alcanzado durante la carga. Algunas filas no fueron importadas.");
            break;
          }

          const name = cols[0]?.trim();
          const phone = cols[1]?.trim().replace(/\D/g, "");
          let statusText = "Pendiente ⏳";
          
          if (cols[2]) {
            const rawStatus = cols[2].toLowerCase();
            if (rawStatus.includes("confirmado") || rawStatus.includes("si") || rawStatus.includes("sí")) {
              statusText = "Confirmado ✅";
            } else if (rawStatus.includes("rechazado") || rawStatus.includes("no")) {
              statusText = "Rechazado ❌";
            }
          }

          const passes = parseInt(cols[3]) || 2;
          const message = cols[4]?.trim() || "";

          if (name && phone.length >= 10) {
            guests.push({
              name,
              phone,
              passes,
              status: statusText,
              message
            });
            addedCount++;
          }
        }

        alert(`¡Carga completada! Se importaron ${addedCount} invitados con éxito.`);
        renderGuestsTable();
      };

      reader.readAsText(file);
      this.value = ""; // Reset value
    });

    // Initialize customizer elements and wishlist previews
    renderHostWishList();
    renderPhoneWishList();
    renderHostReceivedGifts();
    
    // Initialize customizer steps UI
    updateStepUI();
  </script>
</DemoLayout>


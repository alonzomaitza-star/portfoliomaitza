---
import DemoLayout from "../../../layouts/DemoLayout.astro";
---

<DemoLayout title="Creador Interactivo de Invitaciones & Gestor de Eventos">
  <!-- Google Fonts for Creator and Live Preview -->
  <link href="https://fonts.googleapis.com" rel="preconnect" />
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
  <link
    href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;750&family=Playfair+Display:ital,wght@0,450;0,700;1,400&family=Outfit:wght@400;600;800&display=swap"
    rel="stylesheet"
  />

  <div class="max-w-7xl mx-auto px-4 py-8 lg:py-12">
    
    <!-- CONTAINER 1: INVITATION WIZARD & PHONE PREVIEW -->
    <div id="invitation-customizer-container" class="space-y-10 animate-fade-in">
      <!-- Header of the Customizer -->
      <header class="text-center lg:text-left">
        <span class="text-xs px-3 py-1 font-semibold rounded-full uppercase tracking-wider bg-indigo-500/10 text-indigo-400 border border-indigo-500/20">
          Demo Interactiva • Módulo de Invitaciones
        </span>
        <h1 class="text-3xl md:text-5xl font-extrabold text-white mt-3 tracking-tight font-outfit">
          Creador de <span class="bg-gradient-to-r from-violet-400 via-fuchsia-400 to-pink-400 bg-clip-text text-transparent">Invitaciones Digitales</span>
        </h1>
        <p class="text-slate-400 text-sm md:text-base mt-2 max-w-2xl">
          Completa el formulario en 5 sencillos pasos. Observa cómo cambia el diseño responsivo en tiempo real en el simulador móvil y agrega servicios premium o gestiona tus invitados.
        </p>
      </header>

      <!-- Split view: Form on left, Phone Preview on right -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- LEFT COLUMN: The 5-step Form Wizard -->
        <div class="lg:col-span-7 bg-slate-900/50 backdrop-blur-md border border-slate-800 rounded-3xl p-6 md:p-8 flex flex-col justify-between shadow-2xl relative min-h-[620px]">
          
          <!-- Wizard Progress Bar -->
          <div class="mb-8">
            <div class="flex justify-between text-[9px] md:text-xs font-bold text-slate-400 uppercase tracking-widest mb-3">
              <span class="step-label text-violet-400" data-step="1">1. Datos</span>
              <span class="step-label" data-step="2">2. Ubicación</span>
              <span class="step-label" data-step="3">3. Regalos</span>
              <span class="step-label" data-step="4">4. Adicionales</span>
              <span class="step-label" data-step="5">5. Gestión Extra</span>
            </div>
            <!-- Progress Line -->
            <div class="w-full bg-slate-800 h-2 rounded-full overflow-hidden p-0.5 border border-slate-700/50">
              <div id="progress-bar" class="h-full bg-gradient-to-r from-violet-500 to-fuchsia-500 rounded-full w-1/5 transition-all duration-300"></div>
            </div>
          </div>

          <!-- Wizard Forms container -->
          <div class="flex-1">
            <!-- Step 1 Form: Datos Generales -->
            <div id="form-step-1" class="step-form space-y-5 animate-fade-in">
              <h3 class="text-lg font-bold text-white mb-2 font-outfit">Paso 1: Datos Generales</h3>
              
              <div class="space-y-1.5">
                <label class="block text-xs font-bold text-slate-350 uppercase tracking-wider">Tipo de Evento</label>
                <select id="input-event-type" class="w-full bg-slate-950 border border-slate-800 hover:border-slate-700 focus:border-violet-500 rounded-xl px-4 py-3 text-white focus:outline-none transition-all text-sm">
                  <option value="XV Años" selected>Mis XV Años</option>
                  <option value="Boda">Nuestra Boda</option>
                  <option value="Cumpleaños">Mi Cumpleaños</option>
                  <option value="Graduación">Mi Graduación</option>
                  <option value="Posada Mexicana">Posada Mexicana</option>
                  <option value="Reunión íntima">Reunión íntima (Máx 10 personas)</option>
                </select>
              </div>

              <div class="space-y-1.5">
                <label class="block text-xs font-bold text-slate-350 uppercase tracking-wider">Nombre del Celebrante</label>
                <input id="input-name" type="text" value="Ruby Alvarado" placeholder="Ej. Ana & Carlos" class="w-full bg-slate-950 border border-slate-800 hover:border-slate-700 focus:border-violet-500 rounded-xl px-4 py-3 text-white placeholder-slate-600 focus:outline-none transition-all text-sm" />
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="space-y-1.5">
                  <label class="block text-xs font-bold text-slate-350 uppercase tracking-wider">Fecha del Evento</label>
                  <input id="input-date" type="date" value="2026-05-30" class="w-full bg-slate-950 border border-slate-800 hover:border-slate-700 focus:border-violet-500 rounded-xl px-4 py-3 text-white focus:outline-none transition-all text-sm" />
                </div>
                <div class="space-y-1.5">
                  <label class="block text-xs font-bold text-slate-350 uppercase tracking-wider">Hora</label>
                  <input id="input-time" type="time" value="18:00" class="w-full bg-slate-950 border border-slate-800 hover:border-slate-700 focus:border-violet-500 rounded-xl px-4 py-3 text-white focus:outline-none transition-all text-sm" />
                </div>
              </div>
            </div>

            <!-- Step 2 Form: Ubicación & Horarios -->
            <div id="form-step-2" class="step-form space-y-5 hidden animate-fade-in">
              <h3 class="text-lg font-bold text-white mb-2 font-outfit">Paso 2: Ubicación & Recinto</h3>
              
              <div class="space-y-1.5">
                <label class="block text-xs font-bold text-slate-350 uppercase tracking-wider">Nombre del Recinto</label>
                <input id="input-venue" type="text" value="Hacienda de los Morales" placeholder="Ej. Salón Cristal" class="w-full bg-slate-950 border border-slate-800 hover:border-slate-700 focus:border-violet-500 rounded-xl px-4 py-3 text-white placeholder-slate-600 focus:outline-none transition-all text-sm" />
              </div>

              <div class="space-y-1.5">
                <label class="block text-xs font-bold text-slate-350 uppercase tracking-wider">Dirección Completa</label>
                <input id="input-address" type="text" value="Vázquez de Mella 525, Polanco, CDMX" placeholder="Ej. Av. de la Reforma 123, Juárez, CDMX" class="w-full bg-slate-950 border border-slate-800 hover:border-slate-700 focus:border-violet-500 rounded-xl px-4 py-3 text-white placeholder-slate-600 focus:outline-none transition-all text-sm" />
              </div>

              <div class="space-y-1.5">
                <label class="block text-xs font-bold text-slate-350 uppercase tracking-wider">Enlace de Google Maps (Iframe Src / URL)</label>
                <input id="input-maps-url" type="text" placeholder="URL para ver mapa o enlace de Google Maps" class="w-full bg-slate-950 border border-slate-800 hover:border-slate-700 focus:border-violet-500 rounded-xl px-4 py-3 text-white placeholder-slate-600 focus:outline-none transition-all text-sm" />
                <p class="text-[10px] text-slate-500">Dejar vacío para simular mapa por defecto.</p>
              </div>
            </div>

            <!-- Step 3 Form: Estilo & Mesa de Regalos -->
            <div id="form-step-3" class="step-form space-y-5 hidden animate-fade-in">
              <h3 class="text-lg font-bold text-white mb-2 font-outfit">Paso 3: Estilo & Mesa de Regalos</h3>
              
              <div class="space-y-1.5">
                <label class="block text-xs font-bold text-slate-350 uppercase tracking-wider">Código de Vestimenta</label>
                <select id="input-dress-code" class="w-full bg-slate-950 border border-slate-800 hover:border-slate-700 focus:border-violet-500 rounded-xl px-4 py-3 text-white focus:outline-none transition-all text-sm">
                  <option value="Formal / Gala" selected>Formal / Gala</option>
                  <option value="Formal">Formal</option>
                  <option value="Semiformal">Semiformal</option>
                  <option value="Casual">Casual / Playa</option>
                </select>
              </div>

              <!-- Creador de Lista de Deseos (Mesa de Regalos Inteligente) -->
              <div class="space-y-3.5">
                <label class="block text-xs font-bold text-slate-350 uppercase tracking-wider">Mesa de Regalos (Lista de Deseos)</label>
                
                <div class="p-4 bg-slate-950 rounded-2xl border border-slate-800/80 space-y-4 shadow-inner">
                  <span class="block text-xs font-bold text-indigo-300 uppercase tracking-wider">Añadir Producto a la Lista</span>
                  
                  <!-- Link Input -->
                  <div class="space-y-1.5">
                    <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider">Pegar Enlace del Producto (Amazon, Mercado Libre, Liverpool o Palacio de Hierro)</label>
                    <input type="text" id="wishlist-link-input" placeholder="https://..." class="w-full bg-slate-900 border border-slate-800 focus:border-violet-550 rounded-xl px-3 py-2.5 text-xs text-white placeholder-slate-600 focus:outline-none transition-all" />
                    
                    <!-- Detected Store Badge & Scraper Status -->
                    <div class="flex items-center justify-between gap-2 mt-1">
                      <div id="detected-store-badge" class="hidden text-[9px] py-0.5 px-2 rounded-md font-bold uppercase tracking-wider border"></div>
                      <div id="wishlist-loading-msg" class="hidden text-[9px] text-indigo-400 font-semibold animate-pulse flex items-center gap-1">
                        <span class="animate-spin text-xs">🔄</span> Cargando información del producto...
                      </div>
                    </div>
                  </div>

                  <!-- Manual details (Visible when clicked "agregar manual" or after link detection) -->
                  <div id="wishlist-manual-form" class="space-y-3 pt-2 border-t border-slate-900">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                      <div class="space-y-1">
                        <label class="block text-[9px] font-bold text-slate-400 uppercase tracking-wider">Nombre del Producto</label>
                        <input type="text" id="wishlist-product-name" placeholder="Ej. Cafetera Nespresso Vertuo" class="w-full bg-slate-900 border border-slate-800 focus:border-violet-500 rounded-lg px-3 py-2 text-xs text-white placeholder-slate-600 focus:outline-none transition-colors" />
                      </div>
                      <div class="space-y-1">
                        <label class="block text-[9px] font-bold text-slate-400 uppercase tracking-wider">Tienda de origen</label>
                        <select id="wishlist-product-store" class="w-full bg-slate-900 border border-slate-800 focus:border-violet-500 rounded-lg px-3 py-2 text-xs text-white focus:outline-none transition-all">
                          <option value="Amazon">Amazon</option>
                          <option value="Mercado Libre">Mercado Libre</option>
                          <option value="Liverpool">Liverpool</option>
                          <option value="Palacio de Hierro">El Palacio de Hierro</option>
                          <option value="Otro">Otro / Tienda Física</option>
                        </select>
                      </div>
                    </div>

                    <!-- Capture/Screenshot Upload -->
                    <div class="flex items-center gap-3">
                      <label class="text-[10px] bg-slate-900 hover:bg-slate-800 border border-slate-800 text-slate-300 px-3.5 py-2 rounded-xl cursor-pointer font-bold transition-all shadow-sm">
                        📸 Cargar Captura del Producto
                        <input type="file" id="wishlist-product-file" accept="image/*" class="hidden" />
                      </label>
                      <span id="wishlist-product-filename" class="text-[10px] text-slate-500 italic max-w-[220px] truncate">Sin captura cargada</span>
                    </div>

                    <!-- Action Button to Add -->
                    <button type="button" id="btn-add-wishlist-item" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-bold py-2 rounded-xl text-xs transition-all flex items-center justify-center gap-1 shadow-md mt-2">
                      <span>➕ Añadir a mi Lista de Regalos</span>
                    </button>
                  </div>

                  <!-- Button to bypass link and add manually if they just want to type -->
                  <div class="text-right">
                    <button type="button" id="btn-toggle-manual-addition" class="text-[10px] text-indigo-400 hover:text-indigo-300 font-bold transition-all underline bg-transparent border-none cursor-pointer">
                      Agregar producto sin enlace
                    </button>
                  </div>
                </div>

                <!-- Wish List Items Grid/List -->
                <div class="space-y-2">
                  <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider">Productos en tu Lista (<span id="wishlist-items-count">0</span>):</span>
                  <div id="wishlist-items-container" class="max-h-[160px] overflow-y-auto pr-1 space-y-2 scrollbar-thin">
                    <div class="text-center py-4 bg-slate-950/40 border border-slate-850 rounded-xl text-xs text-slate-500 italic">
                      No has añadido ningún producto a tu mesa de regalos.
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Step 4 Form: Servicios Premium & Adicionales -->
            <div id="form-step-4" class="step-form space-y-6 hidden animate-fade-in">
              <div>
                <h3 class="text-lg font-bold text-white font-outfit">Paso 4: Servicios Premium & Adicionales</h3>
                <p class="text-slate-400 text-xs mt-1">Completa la experiencia de tu evento añadiendo servicios profesionales de Insano Network con precios especiales.</p>
              </div>

              <!-- Persistent Generated Link Box -->
              <div id="step-4-link-container" class="bg-indigo-950/30 border border-indigo-500/20 rounded-2xl p-4 space-y-2.5">
                <span class="block text-xs font-bold text-indigo-300 uppercase tracking-wider">🔗 Enlace de tu Invitación</span>
                <div class="bg-slate-950 border border-slate-800 rounded-xl p-3 flex justify-between items-center text-left">
                  <span id="step-4-generated-link" class="text-xs text-indigo-400 font-mono select-all overflow-x-auto whitespace-nowrap pr-2">
                    https://insano.network/invitacion/ruby-alvarado
                  </span>
                  <button id="btn-step-4-copy" class="text-xs bg-slate-900 border border-slate-800 hover:bg-slate-850 text-white font-semibold py-1.5 px-3 rounded-lg flex items-center gap-1 transition-all shrink-0">
                    <span>Copiar</span>
                  </button>
                </div>
                <p class="text-[10px] text-slate-500">Este enlace está activo y listo para ser compartido con tus invitados.</p>
              </div>

              <!-- Services list grouped -->
              <div class="space-y-4 max-h-[260px] overflow-y-auto pr-2 scrollbar-thin">
                
                <!-- Category 1: Físicos e Impresión -->
                <div class="space-y-2.5">
                  <h4 class="text-[10px] font-extrabold text-slate-400 uppercase tracking-widest border-b border-slate-800 pb-1">Decoración e Impresos</h4>
                  
                  <!-- Option: Aguinaldos (sugar bags) -->
                  <div class="bg-slate-950 border border-slate-850 p-3.5 rounded-xl flex items-start gap-3 transition-colors hover:border-slate-750">
                    <input type="checkbox" id="srv-aguinaldos" class="mt-1 rounded border-slate-800 bg-slate-950 text-violet-500 focus:ring-violet-500" />
                    <div class="flex-1 min-w-0">
                      <div class="flex justify-between items-center">
                        <label for="srv-aguinaldos" class="text-xs font-bold text-white cursor-pointer">🍬 Aguinaldos (Fiestas)</label>
                        <span class="text-xs text-[#ffd600] font-bold">$20 c/u</span>
                      </div>
                      <p class="text-[10px] text-slate-400 mt-0.5">Bolsas de dulces personalizadas de alta calidad. Mínimo 15 pz.</p>
                      
                      <!-- Qty Input -->
                      <div id="qty-aguinaldos-wrap" class="mt-2.5 flex items-center gap-2 hidden animate-fade-in">
                        <span class="text-[10px] text-slate-500 font-semibold">Cantidad:</span>
                        <input type="number" id="srv-aguinaldos-qty" value="15" min="15" class="w-16 bg-slate-900 border border-slate-800 rounded-lg px-2 py-1 text-xs text-white focus:outline-none" />
                      </div>
                    </div>
                  </div>

                  <!-- Option: Printed Invitations -->
                  <div class="bg-slate-950 border border-slate-850 p-3.5 rounded-xl flex items-start gap-3 transition-colors hover:border-slate-750">
                    <input type="checkbox" id="srv-printed" class="mt-1 rounded border-slate-800 bg-slate-950 text-violet-500 focus:ring-violet-500" />
                    <div class="flex-1 min-w-0">
                      <div class="flex justify-between items-center">
                        <label for="srv-printed" class="text-xs font-bold text-white cursor-pointer">💌 Invitaciones Físicas</label>
                        <span class="text-xs text-[#ffd600] font-bold">$25 c/u</span>
                      </div>
                      <p class="text-[10px] text-slate-400 mt-0.5">Opalina texturizada premium, corte fino y sobre.</p>
                      
                      <!-- Qty Input -->
                      <div id="qty-printed-wrap" class="mt-2.5 flex items-center gap-2 hidden animate-fade-in">
                        <span class="text-[10px] text-slate-500 font-semibold">Cantidad:</span>
                        <input type="number" id="srv-printed-qty" value="50" min="10" class="w-16 bg-slate-900 border border-slate-800 rounded-lg px-2 py-1 text-xs text-white focus:outline-none" />
                      </div>
                    </div>
                  </div>

                  <!-- Option: Centerpieces -->
                  <div class="bg-slate-950 border border-slate-850 p-3.5 rounded-xl flex items-start gap-3 transition-colors hover:border-slate-750">
                    <input type="checkbox" id="srv-centerpieces" class="mt-1 rounded border-slate-800 bg-slate-950 text-violet-500 focus:ring-violet-500" />
                    <div class="flex-1 min-w-0">
                      <div class="flex justify-between items-center">
                        <label for="srv-centerpieces" class="text-xs font-bold text-white cursor-pointer">🌸 Centros de Mesa</label>
                        <span class="text-xs text-[#ffd600] font-bold">$150 c/u</span>
                      </div>
                      <p class="text-[10px] text-slate-400 mt-0.5">Diseño floral personalizado y base decorativa.</p>
                      
                      <!-- Qty Input -->
                      <div id="qty-centerpieces-wrap" class="mt-2.5 flex items-center gap-2 hidden animate-fade-in">
                        <span class="text-[10px] text-slate-500 font-semibold">Cantidad:</span>
                        <input type="number" id="srv-centerpieces-qty" value="10" min="5" class="w-16 bg-slate-900 border border-slate-800 rounded-lg px-2 py-1 text-xs text-white focus:outline-none" />
                      </div>
                    </div>
                  </div>

                  <!-- Option: Recuerdos -->
                  <div class="bg-slate-950 border border-slate-850 p-3.5 rounded-xl flex items-start gap-3 transition-colors hover:border-slate-750">
                    <input type="checkbox" id="srv-souvenirs" class="mt-1 rounded border-slate-800 bg-slate-950 text-violet-500 focus:ring-violet-500" />
                    <div class="flex-1 min-w-0">
                      <div class="flex justify-between items-center">
                        <label for="srv-souvenirs" class="text-xs font-bold text-white cursor-pointer">🎁 Recuerdos / Souvenirs</label>
                        <span class="text-xs text-[#ffd600] font-bold">$45 c/u</span>
                      </div>
                      <p class="text-[10px] text-slate-400 mt-0.5">Velas aromáticas o botellas miniatura decoradas.</p>
                      
                      <!-- Qty Input -->
                      <div id="qty-souvenirs-wrap" class="mt-2.5 flex items-center gap-2 hidden animate-fade-in">
                        <span class="text-[10px] text-slate-500 font-semibold">Cantidad:</span>
                        <input type="number" id="srv-souvenirs-qty" value="50" min="10" class="w-16 bg-slate-900 border border-slate-800 rounded-lg px-2 py-1 text-xs text-white focus:outline-none" />
                      </div>
                    </div>
                  </div>

                  <!-- Option: Vinil Espejo Selfie -->
                  <div class="bg-slate-950 border border-slate-850 p-3.5 rounded-xl flex items-start gap-3 transition-colors hover:border-slate-750">
                    <input type="checkbox" id="srv-mirror" class="mt-1 rounded border-slate-800 bg-slate-950 text-violet-500 focus:ring-violet-500" />
                    <div class="flex-1 min-w-0">
                      <div class="flex justify-between items-center">
                        <label for="srv-mirror" class="text-xs font-bold text-white cursor-pointer">🪞 Vinil Adhesivo para Espejo</label>
                        <span class="text-xs text-[#ffd600] font-bold">$650</span>
                      </div>
                      <p class="text-[10px] text-slate-400 mt-0.5">Letrero personalizado en vinil blanco/dorado para selfies.</p>
                    </div>
                  </div>
                </div>

                <!-- Category 2: Multimedia & Producción -->
                <div class="space-y-2.5 pt-2">
                  <h4 class="text-[10px] font-extrabold text-slate-400 uppercase tracking-widest border-b border-slate-800 pb-1">Multimedia y Producción</h4>
                  
                  <!-- Option: Photography -->
                  <div class="bg-slate-950 border border-slate-850 p-3.5 rounded-xl flex items-start gap-3 transition-colors hover:border-slate-750">
                    <input type="checkbox" id="srv-photo" class="mt-1 rounded border-slate-800 bg-slate-950 text-violet-500 focus:ring-violet-500" />
                    <div class="flex-1 min-w-0">
                      <div class="flex justify-between items-center">
                        <label for="srv-photo" class="text-xs font-bold text-white cursor-pointer">📸 Fotografía Profesional</label>
                        <span class="text-xs text-[#ffd600] font-bold">$3,500</span>
                      </div>
                      <p class="text-[10px] text-slate-400 mt-0.5">Sesión de fotos y cobertura del evento (entrega digital).</p>
                    </div>
                  </div>

                  <!-- Option: Drone Video -->
                  <div class="bg-slate-950 border border-slate-850 p-3.5 rounded-xl flex items-start gap-3 transition-colors hover:border-slate-750">
                    <input type="checkbox" id="srv-drone" class="mt-1 rounded border-slate-800 bg-slate-950 text-violet-500 focus:ring-violet-500" />
                    <div class="flex-1 min-w-0">
                      <div class="flex justify-between items-center">
                        <label for="srv-drone" class="text-xs font-bold text-white cursor-pointer">🛸 Grabación de Dron</label>
                        <span class="text-xs text-[#ffd600] font-bold">$2,200</span>
                      </div>
                      <p class="text-[10px] text-slate-400 mt-0.5">Tomas aéreas del recinto y de la ceremonia en alta definición.</p>
                    </div>
                  </div>

                  <!-- Option: Video Editing -->
                  <div class="bg-slate-950 border border-slate-850 p-3.5 rounded-xl flex items-start gap-3 transition-colors hover:border-slate-750">
                    <input type="checkbox" id="srv-editing" class="mt-1 rounded border-slate-800 bg-slate-950 text-violet-500 focus:ring-violet-500" />
                    <div class="flex-1 min-w-0">
                      <div class="flex justify-between items-center">
                        <label for="srv-editing" class="text-xs font-bold text-white cursor-pointer">🎬 Edición de Video Profesional</label>
                        <span class="text-xs text-[#ffd600] font-bold">$1,500</span>
                      </div>
                      <p class="text-[10px] text-slate-400 mt-0.5">Montaje del video del evento y teaser resumen para redes sociales.</p>
                    </div>
                  </div>
                </div>

                <!-- Category 3: Catering & Extras -->
                <div class="space-y-2.5 pt-2">
                  <h4 class="text-[10px] font-extrabold text-slate-400 uppercase tracking-widest border-b border-slate-800 pb-1">Catering & Extras</h4>
                  
                  <!-- Option: Snacks and desserts -->
                  <div class="bg-slate-950 border border-slate-850 p-3.5 rounded-xl flex items-start gap-3 transition-colors hover:border-slate-750">
                    <input type="checkbox" id="srv-catering" class="mt-1 rounded border-slate-800 bg-slate-950 text-violet-500 focus:ring-violet-500" />
                    <div class="flex-1 min-w-0">
                      <div class="flex justify-between items-center">
                        <label for="srv-catering" class="text-xs font-bold text-white cursor-pointer">🍿 Mesa de Botanas y Postres</label>

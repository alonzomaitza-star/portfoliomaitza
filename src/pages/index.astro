---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import HomeExperiencia from "../components/home/1homeExperiencia/HomeExperiencia.astro";
import ImgSlider from "../assets/SlideImages/Insano Network-Slider 1.jpg";
import ImgSlider2 from "../assets/SlideImages/Insano Network-Slider 2.jpg";
import ImgSlider3 from "../assets/SlideImages/Insano Network-Slider 3.jpg";
import SliderImg from "../components/SliderImg.astro";
import HeaderTitleIndex from "../components/home/HeaderTitleIndex.astro";
import YouTubeEducation from "../components/home/YouTubeEducation.astro";
import SocialMediaSlider from "../components/home/SocialMediaSlider.astro";
import ShopMinimal from "../components/home/ShopMinimal.astro";
import PortafolioCard from "../components/portfolio-cv/PortafolioCard.astro";
import EmbedFrame from "../components/home/EmbedFrame.astro";
import ProjectGallery from "../components/portfolio-cv/ProjectGallery.astro";

export const prerender = false;

const equipo = [
  {
    nombre: "Fernando J",
    apellido: "Mtz",
    username: "MrDUFYGY",
    redes: {
      instagram: "https://instagram.com/mrdufygy",
      facebook: "https://facebook.com/mrdufygy",
      whatsapp: "+52 55 4296 5463",
      web: "/portafolio/mrdufygy",
    },
  },
];
---

<style>
  /* Estructura header responsiva */
  header {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    position: relative;
  }

  @media (min-width: 601px) {
    header {
      flex-direction: row;
      align-items: center;
      justify-content: center;
    }
  }

  .header-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .header-title h1 {
    font-size: 2.5rem;
    color: #fff;
    font-weight: bold;
    margin: 0;
    text-align: center;
  }
  .header-title p {
    font-size: 1.2rem;
    color: #ffd600;
    margin: 0.5rem 0 0 0;
    text-align: center;
  }

  /* Slider estilos previos */
  .slider {
    aspect-ratio: 10 / 16;
    width: 100%;
    max-height: 100%;
    position: relative;
    display: flex;
    overflow: scroll;
    scroll-snap-type: x mandatory;
    margin-top: -119px;
    scroll-behavior: smooth;
    overflow-y: hidden;
    scrollbar-width: thin;
  }
  .slider img {
    width: 100%;
    left: 0;
    position: sticky;
    object-fit: cover;
    /* border-radius: 5px; */
    scroll-snap-align: center;
    max-height: 10-fit-content;
  }
  @media (min-width: 601px) {
    .slider {
      width: 400px;
      margin-top: 0;
      border-radius: 5px;
    }
  }
  @media (max-width: 600px) {
    .slider {
      width: 100%;
    }
    .header-title {
      position: absolute;
      top: 30px;
      left: 0;
      right: 0;
      z-index: 2;
      pointer-events: none;
    }
  }

  /* Modal flotante inferior */
  .modal-bottom {
    position: fixed;
    left: 50%;
    bottom: 32px;
    transform: translateX(-50%);
    background: rgba(30, 30, 30, 0.98);
    color: #fff;
    border-radius: 20px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
    padding: 1.25rem 2.5rem;
    font-size: 1.2rem;
    font-weight: bold;
    z-index: 1000;
    border: 2px solid #ffd600;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    animation: modalAppear 0.7s cubic-bezier(0.42, 0, 0.58, 1);
  }
  @keyframes modalAppear {
    from {
      opacity: 0;
      bottom: 0;
    }
    to {
      opacity: 1;
      bottom: 32px;
    }
  }

  /* Estilos para el footer */
  footer {
    margin-top: 4rem;
    position: relative;
    z-index: 10;
  }
</style>

<Layout>
  <main>
    <header>
      <div class="container-slider lg:scale-200">
        <SliderImg imagenes={[ImgSlider, ImgSlider2, ImgSlider3]} />
      </div>
      <!-- Header Title Section - Giant & Fixed -->
      <HeaderTitleIndex />
    </header>

    <!-- Seccion de Experiencia de Usuario -->
    <HomeExperiencia />

    <!-- Seccion de Portafolio -->
    <section class="py-12 px-4">
      <div class="max-w-7xl mx-auto">
        <h2
          class="text-4xl font-bold text-center mb-12 text-gray-900 dark:text-white"
        >
          Nuestro Equipo
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {equipo.map((miembro) => <PortafolioCard miembro={miembro} />)}
        </div>
      </div>
    </section>

    <!-- Section Herramientas Gallery -->
    <ProjectGallery />

    <!-- Seccion de Shop Minimal -->
    <ShopMinimal />

    <!-- YouTube Education Section -->
    <YouTubeEducation />

    <!-- Social Media Slider Section -->
    <SocialMediaSlider />
  </main>
  <!-- <div class="modal-bottom">Página en construcción 🚧</div -->

  <!-- Iframe Section -->
  <!-- <EmbedFrame /> -->
</Layout>

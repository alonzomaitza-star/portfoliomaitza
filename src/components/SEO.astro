---
import { SITE_URL } from '../consts';

interface Props {
  schemaType?: 'Organization' | 'Service' | 'LocalBusiness' | 'WebPage';
  serviceName?: string;
  serviceDescription?: string;
  servicePrice?: string;
}

const {
  schemaType = 'WebPage',
  serviceName,
  serviceDescription,
  servicePrice
} = Astro.props;

// Schema.org Organization (siempre presente)
// Nota: sameAs comentado temporalmente para compatibilidad con Brave
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Insano Network",
  "url": SITE_URL,
  "logo": `${SITE_URL}/logo.png`,
  "description": "Soluciones digitales integrales: diseño, desarrollo, e-commerce, marketing y servicios contables",
  // "sameAs": [
  //   "https://www.youtube.com/@insanocodes",
  //   "https://www.twitch.tv/insanocodes",
  //   "https://www.instagram.com/insanonetwork",
  //   "https://www.facebook.com/insanonetwork",
  //   "https://twitter.com/insanonetwork"
  // ],
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "customer service",
    "email": "contacto@insanonetwork.com"
  }
};

// Schema.org Service (para páginas de servicios)
const serviceSchema = serviceName ? {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": serviceName,
  "description": serviceDescription,
  "provider": {
    "@type": "Organization",
    "name": "Insano Network"
  },
  ...(servicePrice && { "offers": {
    "@type": "Offer",
    "price": servicePrice,
    "priceCurrency": "MXN"
  }})
} : null;

// Schema.org LocalBusiness (para servicios contables)
const localBusinessSchema = schemaType === 'LocalBusiness' ? {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "E&V Contadores Públicos Independientes - Insano Network",
  "description": "Servicios contables y fiscales profesionales",
  "url": `${SITE_URL}/contable`,
  "telephone": "+52-XXX-XXX-XXXX",
  "email": "contacto@insanonetwork.com",
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "MX"
  }
} : null;

// Breadcrumb Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": SITE_URL
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": serviceName || "Página",
      "item": Astro.url.href
    }
  ]
};
---

<!-- Schema.org JSON-LD - Compatible con Brave -->
<script type="application/ld+json" is:inline>
  {JSON.stringify(organizationSchema)}
</script>

{serviceSchema && (
  <script type="application/ld+json" is:inline>
    {JSON.stringify(serviceSchema)}
  </script>
)}

{localBusinessSchema && (
  <script type="application/ld+json" is:inline>
    {JSON.stringify(localBusinessSchema)}
  </script>
)}

{serviceName && (
  <script type="application/ld+json" is:inline>
    {JSON.stringify(breadcrumbSchema)}
  </script>
)}

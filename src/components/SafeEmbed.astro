---
/**
 * SafeEmbed - Componente para embeds de terceros compatible con Brave
 * Usa facade pattern para cargar iframes bajo demanda
 */

interface Props {
  type: 'youtube' | 'twitch' | 'instagram';
  videoId?: string;
  channel?: string;
  title?: string;
  thumbnail?: string;
}

const { type, videoId, channel, title = 'Video', thumbnail } = Astro.props;

// Generar thumbnail automático para YouTube
const youtubeThumbnail = videoId ? `https://img.youtube.com/vi/${videoId}/maxresdefault.jpg` : '';
const displayThumbnail = thumbnail || youtubeThumbnail;
---

<div class="safe-embed" data-type={type} data-video-id={videoId} data-channel={channel}>
  <div class="embed-placeholder">
    {displayThumbnail && (
      <img 
        src={displayThumbnail} 
        alt={title}
        class="embed-thumbnail"
        loading="lazy"
      />
    )}
    <div class="embed-overlay">
      <button class="embed-play-button" aria-label={`Cargar ${title}`}>
        <svg class="w-16 h-16" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z"/>
        </svg>
      </button>
      <p class="embed-notice">
        Click para cargar contenido de {type === 'youtube' ? 'YouTube' : type === 'twitch' ? 'Twitch' : 'Instagram'}
      </p>
    </div>
  </div>
  <div class="embed-container" style="display: none;"></div>
</div>

<style>
  .safe-embed {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
    border-radius: 8px;
    overflow: hidden;
  }

  .embed-placeholder {
    position: relative;
    width: 100%;
    height: 100%;
    cursor: pointer;
  }

  .embed-thumbnail {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .embed-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.6);
    transition: background 0.3s ease;
  }

  .embed-placeholder:hover .embed-overlay {
    background: rgba(0, 0, 0, 0.4);
  }

  .embed-play-button {
    background: rgba(255, 255, 255, 0.9);
    border: none;
    border-radius: 50%;
    padding: 1rem;
    cursor: pointer;
    transition: all 0.3s ease;
    color: #000;
  }

  .embed-play-button:hover {
    transform: scale(1.1);
    background: #fff;
  }

  .embed-notice {
    margin-top: 1rem;
    color: #fff;
    font-size: 0.875rem;
    text-align: center;
  }

  .embed-container {
    width: 100%;
    height: 100%;
  }

  .embed-container iframe {
    width: 100%;
    height: 100%;
    border: none;
  }
</style>

<script>
  // Cargar embeds solo cuando el usuario hace click
  document.querySelectorAll('.safe-embed').forEach((embed) => {
    const placeholder = embed.querySelector('.embed-placeholder');
    const container = embed.querySelector('.embed-container');
    const type = embed.getAttribute('data-type');
    const videoId = embed.getAttribute('data-video-id');
    const channel = embed.getAttribute('data-channel');

    if (!placeholder || !container) return;

    placeholder.addEventListener('click', () => {
      let iframeSrc = '';

      switch (type) {
        case 'youtube':
          iframeSrc = `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0`;
          break;
        case 'twitch':
          const hostname = window.location.hostname;
          iframeSrc = `https://player.twitch.tv/?channel=${channel}&parent=${hostname}&autoplay=true`;
          break;
        case 'instagram':
          iframeSrc = `https://www.instagram.com/p/${videoId}/embed`;
          break;
      }

      if (iframeSrc) {
        const iframe = document.createElement('iframe');
        iframe.src = iframeSrc;
        iframe.allowFullscreen = true;
        iframe.loading = 'lazy';
        
        // Atributos específicos por plataforma
        if (type === 'youtube') {
          iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
        } else if (type === 'twitch') {
          iframe.allow = 'autoplay; fullscreen';
        }

        container.appendChild(iframe);
        container.style.display = 'block';
        placeholder.style.display = 'none';
      }
    });
  });
</script>

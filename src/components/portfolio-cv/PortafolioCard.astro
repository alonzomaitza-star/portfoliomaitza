---
export interface Props {
  miembro: {
    nombre: string;
    apellido: string;
    username: string;
    puesto: string;
    rol: string;
    añosExperiencia: number;
    abiertoPropuestas: boolean;
    herramientas: string[];
    redes: {
      instagram?: string;
      facebook?: string;
      whatsapp?: string;
      web?: string;
    };
  };
}

const { miembro } = Astro.props;

const whatsappUrl = miembro.redes.whatsapp
  ? `https://wa.me/${miembro.redes.whatsapp.replace(/\D/g, "")}`
  : null;

const initials = `${miembro.nombre.charAt(0)}${miembro.apellido.charAt(0)}`;
---

<div class="team-card">
  <!-- Glow top accent -->
  <div class="card-glow"></div>

  <!-- Header gradient -->
  <div class="card-header">
    <div class="avatar-ring">
      <div class="avatar">
        <span>{initials}</span>
      </div>
    </div>

    <div class="header-info">
      <h3 class="member-name">{miembro.nombre} {miembro.apellido}</h3>
      <span class="username">@{miembro.username}</span>
    </div>

    <!-- Disponibilidad badge -->
    <div class={`disponibilidad-badge ${miembro.abiertoPropuestas ? "open" : "closed"}`}>
      <span class="pulse-dot"></span>
      {miembro.abiertoPropuestas ? "Disponible" : "No Disponible"}
    </div>
  </div>

  <!-- Body -->
  <div class="card-body">

    <!-- Puesto y Rol -->
    <div class="role-section">
      <div class="puesto-tag">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M20 7H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/>
          <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
        </svg>
        {miembro.puesto}
      </div>
      <p class="rol-text">{miembro.rol}</p>
    </div>

    <div class="divider"></div>

    <!-- Años de experiencia -->
    <div class="exp-section">
      <div class="exp-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <polyline points="12 6 12 12 16 14"/>
        </svg>
      </div>
      <div class="exp-info">
        <span class="exp-number">{miembro.añosExperiencia}</span>
        <span class="exp-label">años de experiencia</span>
      </div>
    </div>

    <div class="divider"></div>

    <!-- Herramientas -->
    <div class="tools-section">
      <p class="section-label">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
        </svg>
        Herramientas
      </p>
      <div class="tools-grid">
        {miembro.herramientas.map((tool) => (
          <span class="tool-chip">{tool}</span>
        ))}
      </div>
    </div>

    <div class="divider"></div>

    <!-- Redes sociales -->
    <div class="social-section">
      <p class="section-label">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
        </svg>
        Contacto
      </p>
      <div class="social-icons">
        {miembro.redes.instagram && (
          <a href={miembro.redes.instagram} target="_blank" rel="noopener noreferrer" class="social-btn instagram" aria-label="Instagram">
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.162 6.162 6.162 6.162-2.759 6.162-6.162c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.79-4 4-4s4 1.79 4 4c0 2.209-1.79 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
        )}
        {miembro.redes.facebook && (
          <a href={miembro.redes.facebook} target="_blank" rel="noopener noreferrer" class="social-btn facebook" aria-label="Facebook">
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
        )}
        {whatsappUrl && (
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="social-btn whatsapp" aria-label="WhatsApp">
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.149-.67.149-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414-.074-.123-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 9.885-5.335 9.885-11.893a11.842 11.842 0 00-3.48-8.413Z"/>
            </svg>
          </a>
        )}
      </div>
    </div>

    <!-- CTA Button -->
    {miembro.redes.web && (
      <a href={miembro.redes.web} class="cta-btn">
        Ver Portafolio
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    )}
  </div>
</div>

<style>
  .team-card {
    position: relative;
    background: linear-gradient(135deg, rgba(255,255,255,0.07) 0%, rgba(255,255,255,0.02) 100%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    overflow: hidden;
    backdrop-filter: blur(12px);
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.35s ease;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.18);
  }

  :global(.dark) .team-card {
    background: linear-gradient(135deg, rgba(30, 20, 60, 0.85) 0%, rgba(15, 10, 40, 0.9) 100%);
    border-color: rgba(139, 92, 246, 0.2);
  }

  :global(:not(.dark)) .team-card {
    background: linear-gradient(135deg, rgba(255,255,255,0.95) 0%, rgba(245,243,255,0.98) 100%);
    border-color: rgba(139, 92, 246, 0.15);
    box-shadow: 0 4px 32px rgba(99, 60, 220, 0.1);
  }

  .team-card:hover {
    transform: translateY(-6px) scale(1.015);
    box-shadow: 0 20px 60px rgba(139, 92, 246, 0.25);
  }

  /* Top glow accent */
  .card-glow {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #6366f1, #8b5cf6, #a78bfa, #6366f1);
    background-size: 200% 100%;
    animation: shimmer 3s linear infinite;
  }

  @keyframes shimmer {
    0% { background-position: 0% 0%; }
    100% { background-position: 200% 0%; }
  }

  /* Header */
  .card-header {
    padding: 1.5rem 1.5rem 1.2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    position: relative;
  }

  .avatar-ring {
    width: 76px;
    height: 76px;
    border-radius: 50%;
    padding: 3px;
    background: linear-gradient(135deg, #6366f1, #a78bfa, #7c3aed);
    margin-bottom: 0.4rem;
  }

  .avatar {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: linear-gradient(135deg, #4f46e5, #7c3aed);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  :global(:not(.dark)) .avatar {
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
  }

  .avatar span {
    color: #fff;
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .header-info {
    text-align: center;
  }

  .member-name {
    font-size: 1.15rem;
    font-weight: 700;
    color: #1e1b4b;
    margin: 0;
    line-height: 1.2;
  }

  :global(.dark) .member-name {
    color: #f0f0ff;
  }

  .username {
    font-size: 0.82rem;
    color: #8b5cf6;
    font-weight: 500;
  }

  /* Disponibilidad badge */
  .disponibilidad-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    letter-spacing: 0.03em;
    margin-top: 0.2rem;
  }

  .disponibilidad-badge.open {
    background: rgba(16, 185, 129, 0.12);
    color: #10b981;
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  .disponibilidad-badge.closed {
    background: rgba(239, 68, 68, 0.1);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.25);
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    display: inline-block;
  }

  .open .pulse-dot {
    background: #10b981;
    animation: pulse-green 1.8s ease-in-out infinite;
  }

  .closed .pulse-dot {
    background: #ef4444;
  }

  @keyframes pulse-green {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.4); }
  }

  /* Body */
  .card-body {
    padding: 0 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .divider {
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(139, 92, 246, 0.2), transparent);
    margin: 0.9rem 0;
  }

  /* Puesto y Rol */
  .role-section {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .puesto-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: #7c3aed;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0;
  }

  :global(.dark) .puesto-tag {
    color: #a78bfa;
  }

  .rol-text {
    font-size: 0.95rem;
    font-weight: 600;
    color: #312e81;
    margin: 0;
  }

  :global(.dark) .rol-text {
    color: #c4b5fd;
  }

  /* Experiencia */
  .exp-section {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .exp-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.15), rgba(139, 92, 246, 0.1));
    display: flex;
    align-items: center;
    justify-content: center;
    color: #6366f1;
    flex-shrink: 0;
  }

  :global(.dark) .exp-icon {
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.25), rgba(139, 92, 246, 0.2));
    color: #a78bfa;
  }

  .exp-info {
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
  }

  .exp-number {
    font-size: 1.4rem;
    font-weight: 800;
    color: #4f46e5;
    line-height: 1;
  }

  :global(.dark) .exp-number {
    color: #818cf8;
  }

  .exp-label {
    font-size: 0.78rem;
    color: #6b7280;
    font-weight: 500;
  }

  :global(.dark) .exp-label {
    color: #9ca3af;
  }

  /* Herramientas */
  .tools-section {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #9ca3af;
    margin: 0;
  }

  .tools-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tool-chip {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.1), rgba(139, 92, 246, 0.08));
    color: #6366f1;
    border: 1px solid rgba(99, 102, 241, 0.2);
    transition: all 0.2s ease;
    cursor: default;
  }

  :global(.dark) .tool-chip {
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.2), rgba(139, 92, 246, 0.15));
    color: #a5b4fc;
    border-color: rgba(139, 92, 246, 0.3);
  }

  .tool-chip:hover {
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.22), rgba(139, 92, 246, 0.18));
    transform: translateY(-1px);
  }

  /* Social section */
  .social-section {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .social-icons {
    display: flex;
    gap: 0.5rem;
  }

  .social-btn {
    width: 34px;
    height: 34px;
    border-radius: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.22s ease;
    border: 1px solid transparent;
  }

  .social-btn.instagram {
    background: rgba(225, 48, 108, 0.1);
    color: #e1306c;
    border-color: rgba(225, 48, 108, 0.2);
  }
  .social-btn.instagram:hover {
    background: #e1306c;
    color: #fff;
    transform: translateY(-2px);
  }

  .social-btn.facebook {
    background: rgba(24, 119, 242, 0.1);
    color: #1877f2;
    border-color: rgba(24, 119, 242, 0.2);
  }
  .social-btn.facebook:hover {
    background: #1877f2;
    color: #fff;
    transform: translateY(-2px);
  }

  .social-btn.whatsapp {
    background: rgba(37, 211, 102, 0.1);
    color: #25d366;
    border-color: rgba(37, 211, 102, 0.2);
  }
  .social-btn.whatsapp:hover {
    background: #25d366;
    color: #fff;
    transform: translateY(-2px);
  }

  /* CTA Button */
  .cta-btn {
    margin-top: 0.3rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    width: 100%;
    padding: 0.75rem 1.25rem;
    border-radius: 12px;
    font-size: 0.875rem;
    font-weight: 700;
    color: #fff;
    background: linear-gradient(135deg, #4f46e5, #7c3aed);
    text-decoration: none;
    transition: all 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
    letter-spacing: 0.01em;
    box-shadow: 0 4px 16px rgba(79, 70, 229, 0.35);
  }

  .cta-btn:hover {
    background: linear-gradient(135deg, #4338ca, #6d28d9);
    box-shadow: 0 8px 28px rgba(79, 70, 229, 0.5);
    transform: translateY(-2px);
  }

  .cta-btn svg {
    transition: transform 0.2s ease;
  }

  .cta-btn:hover svg {
    transform: translateX(3px);
  }
</style>

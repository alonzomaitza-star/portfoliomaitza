---
interface Props {
    title?: string;
    pdfUrl?: string;
}

const { title = "Maitza Alonzo - Portfolio", pdfUrl = "/cvs/Mait-CV.pdf" } =
    Astro.props;
import ProjectModal from './ProjectModal.astro';
---

<div
    class="font-sans antialiased text-gray-900  bg-[#fdfbf7]  selection:bg-purple-200 selection:text-purple-900"
>
    <!-- Navbar/Header (Simple) -->
    <nav class="flex items-center justify-between px-6 py-6 max-w-7xl mx-auto">
        <div class="flex items-center gap-2">
            <div
                class="bg-purple-600 text-white p-1 rounded-sm font-bold text-xs"
            >
                MA
            </div>
            <span class="font-bold tracking-tight text-lg">PORTFOLIO.</span>
        </div>
        <div class="hidden md:flex gap-8 text-sm font-medium text-gray-500 ">
            <a href="#proyectos" class="hover:text-purple-600 transition-colors"
                >Portfolio</a
            >
            <a
                href="#experiencia"
                class="hover:text-purple-600 transition-colors">Trayectoria</a
            >
            <a
                href="#contacto"
                class="px-5 py-2 bg-purple-600 text-white rounded-full hover:bg-purple-700 transition-colors"
                >Contacto</a
            >
        </div>
    </nav>

    <!-- Hero Section -->
    <header
        class="relative px-6 py-12 md:py-20 max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-center"
    >
        <div class="space-y-8 z-10">
            <span
                class="inline-block px-3 py-1 bg-purple-100 text-purple-700 rounded-full text-xs font-bold tracking-wider uppercase mb-2"
            >
                Diseño Gráfico & UX/UI
            </span>
            <h1
                class="text-5xl md:text-7xl font-black leading-tight tracking-tighter"
            >
                CREANDO <br />
                <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-purple-600 to-indigo-600 italic pr-2"
                    >IDEAS</span
                >
                <br />
                QUE <br />
                TRASCIENDEN.
            </h1>
            <div
                class="text-gray-500  text-lg md:text-xl max-w-lg leading-relaxed space-y-4"
            >
                <p>
                    Hola soy Diseñadora con amplia experiencia en proyectos creativos para redes sociales, haciendo uso de la identidad visual y convirtiéndolo en material gráfico.
                </p>
                <p>
                    Agregando mis conocimientos en gestión de proyectos y desarrollo web.
                </p>
                <p>
                    Tecnica en Producción Gráfica y Operación de Plotters de Impresión
                </p>
            </div>

            <div class="flex flex-wrap items-center gap-4 pt-4">
                <a
                    href="mailto:alonzomaitza@gmail.com"
                    class="px-8 py-4 bg-white  text-gray-900  font-bold rounded-lg hover:bg-gray-200  transition-all flex items-center gap-3 group border border-teal-400/60 shadow-[0_0_15px_rgba(45,212,191,0.5)] hover:shadow-[0_0_25px_rgba(45,212,191,0.7)]"
                >
                    <div class="relative flex items-center justify-center">
                        <div class="absolute w-8 h-8 bg-teal-400/40 blur-md rounded-full group-hover:bg-teal-400/60 transition-colors"></div>
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5 text-teal-500 relative z-10"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                        </svg>
                    </div>
                    alonzomaitza@gmail.com
                </a>

                <a
                    href={pdfUrl}
                    download
                    class="px-8 py-4 bg-white  text-gray-900  font-bold rounded-lg hover:bg-gray-200  transition-all flex items-center gap-2 border border-teal-400/60 shadow-[0_0_15px_rgba(45,212,191,0.5)] hover:shadow-[0_0_25px_rgba(45,212,191,0.7)]"
                >
                    Descargar CV
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-4 w-4"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
                        ></path>
                    </svg>
                </a>
            </div>
        </div>

        <div class="relative">
            <div
                class="aspect-[4/5] rounded-3xl overflow-hidden shadow-2xl bg-white  relative z-10 mx-auto max-w-md lg:max-w-full rotate-3 transition-transform hover:rotate-0 duration-500"
            >
                <!-- Placeholder for Profile Image -->
                <div
                    class="absolute inset-0 bg-gradient-to-br from-gray-200  to-gray-300 flex items-center justify-center text-gray-500 "
                >
                    <img
                        src="/images/Mariposas.png"
                        alt="Mait Alonso"
                        class="w-full h-full object-cover grayscale contrast-125 hover:grayscale-0 transition-all duration-700"
                        onerror="this.src='https://placehold.co/600x800/e2e8f0/475569?text=Mait+Alonso'"
                    />
                </div>

                <!-- Floating Card -->
                <div
                    class="absolute bottom-8 left-8 bg-white  p-4 rounded-xl shadow-lg max-w-[200px] animate-fade-in-up"
                >
                    <div class="flex items-center gap-3 mb-2">
                        <div
                            class="bg-purple-100 p-2 rounded-full text-purple-600"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-5 w-5"
                                viewBox="0 0 20 20"
                                fill="currentColor"
                            >
                                <path
                                    fill-rule="evenodd"
                                    d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z"
                                    clip-rule="evenodd"></path>
                            </svg>
                        </div>
                        <div>
                            <p class="text-xs text-gray-500  font-semibold">
                                Area de enfoque
                            </p>
                            <p class="font-bold text-sm">Disruptive Design</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Decorative Elements -->
            <div
                class="absolute top-10 -right-10 w-32 h-32 bg-purple-300 rounded-full blur-3xl opacity-50 mix-blend-multiply filter"
            >
            </div>
            <div
                class="absolute -bottom-10 -left-10 w-48 h-48 bg-indigo-300 rounded-full blur-3xl opacity-50 mix-blend-multiply filter"
            >
            </div>
        </div>
    </header>

    <!-- Portfolio Section -->
    <section id="proyectos" class="py-20">
        <div class="max-w-7xl mx-auto px-6">
            <div
                class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6"
            >
                <div>
                    <h2
                        class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-purple-200 text-6xl md:text-8xl font-black outline-text text-stroke-2"
                    >
                        PORTAFOLIO
                    </h2>
                    <p
                        class="text-3xl font-bold text-gray-900  -mt-4 md:-mt-8 ml-2"
                    >
                        Proyectos de Impacto
                    </p>
                </div>
            </div>

            <div
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 auto-rows-[300px] lg:auto-rows-[400px]"
            >
                <!-- Project 1 (Large) -->
                <article
                    class="project-card lg:col-span-8 group relative rounded-3xl overflow-hidden bg-white  shadow-sm hover:shadow-xl transition-all duration-300 cursor-pointer"
                    data-project-info='{"title": "Identidad Visual", "subtitle": ""}'
                >
                    <div class="absolute inset-0 bg-gray-200 ">
                        <img
                            src="https://placehold.co/800x600/f3e8e8/333333?text=Identidad+Visual"
                            alt="Identidad Visual"
                            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                        />
                    </div>
                </article>

                <!-- Project 2 (Small) -->
                <article
                    class="project-card lg:col-span-4 group relative rounded-3xl overflow-hidden bg-white  shadow-sm hover:shadow-xl transition-all duration-300 cursor-pointer"
                    data-project-info='{"title": "Producción Gráfica", "subtitle": ""}'
                >
                    <div class="absolute inset-0 bg-[#b8e4dc]">
                        <img
                            src="https://placehold.co/400x600/b8e4dc/ffffff?text=Producci%C3%B3n+Gr%C3%A1fica"
                            alt="Producción Gráfica"
                            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                        />
                    </div>
                </article>



                <!-- Project 4 (Large) -->
                <article
                    class="project-card lg:col-span-7 group relative rounded-3xl overflow-hidden bg-white  shadow-sm hover:shadow-xl transition-all duration-300 cursor-pointer"
                    data-project-info='{"title": "Ilustración Digital", "subtitle": "Abstracción Digital"}'
                >
                    <div class="absolute inset-0 bg-black">
                        <img
                            src="https://placehold.co/700x400/000000/e2e8f0?text=Ilustraci%C3%B3n+Digital"
                            alt="Ilustración Digital"
                            class="w-full h-full object-cover opacity-80 transition-transform duration-700 group-hover:scale-105"
                        />
                    </div>
                </article>

                <!-- Project 7 (Marketing) -->
                <article
                    class="project-card lg:col-span-5 group relative rounded-3xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 cursor-pointer"
                    data-project-info='{"title": "Marketing", "subtitle": "Estrategia Digital"}'
                >
                    <div class="absolute inset-0 bg-white">
                        <img
                            src="https://placehold.co/500x400/bde0fe/000000?text=Marketing"
                            alt="Marketing"
                            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                        />
                    </div>
                </article>

                <!-- Project 5 (Small) -->
                <article
                    class="project-card lg:col-span-5 group relative rounded-3xl overflow-hidden bg-white shadow-sm hover:shadow-xl transition-all duration-300 cursor-pointer"
                    data-project-info='{"title": "Editorial", "subtitle": "Revista y Maquetación"}'
                >
                    <div class="absolute inset-0 bg-white">
                        <img
                            src="https://placehold.co/400x600/ffffff/718096?text=Dise%C3%B1o+Editorial"
                            alt="Diseño Editorial"
                            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                        />
                    </div>
                </article>

                <!-- Project 6 (Fotografía) -->
                <article
                    class="project-card lg:col-span-7 group relative rounded-3xl overflow-hidden bg-white shadow-sm hover:shadow-xl transition-all duration-300 cursor-pointer"
                    data-project-info='{"title": "Fotografía", "subtitle": "Sesiones y Edición"}'
                >
                    <div class="absolute inset-0 bg-[#d8b4e2]">
                        <img
                            src="https://placehold.co/800x600/d8b4e2/ffffff?text=Fotograf%C3%ADa"
                            alt="Fotografía"
                            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                        />
                    </div>
                </article>

                <!-- Project 8 (UX/UI) -->
                <article
                    class="project-card lg:col-span-6 group relative rounded-3xl overflow-hidden bg-white shadow-sm hover:shadow-xl transition-all duration-300 cursor-pointer"
                    data-project-info='{"title": "Diseño UX/UI", "subtitle": "Experiencia de Usuario"}'
                >
                    <div class="absolute inset-0 bg-[#e8dff5]">
                        <img
                            src="https://placehold.co/800x600/e8dff5/4a4a4a?text=Dise%C3%B1o+UX/UI"
                            alt="Diseño UX/UI"
                            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                        />
                    </div>
                </article>

                <!-- Project 9 (Videos y Animación) -->
                <article
                    class="project-card lg:col-span-6 group relative rounded-3xl overflow-hidden bg-white shadow-sm hover:shadow-xl transition-all duration-300 cursor-pointer"
                    data-project-info='{"title": "Videos y Animación", "subtitle": "Contenido Audiovisual"}'
                >
                    <div class="absolute inset-0 bg-[#fdf2e9]">
                        <img
                            src="https://placehold.co/800x600/fdf2e9/4a4a4a?text=Videos+y+Animaci%C3%B3n"
                            alt="Videos y Animación"
                            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                        />
                    </div>
                </article>
            </div>
        </div>
    </section>

    <!-- Skills Section -->
    <section
        class="py-20 bg-gradient-to-b from-purple-50  to-[#fdfbf7]  relative overflow-hidden"
    >
        <!-- Background element -->
        <div
            class="absolute top-0 right-0 w-[50vw] h-full bg-gradient-to-l from-purple-100/50  to-transparent -z-10 bg-blend-overlay"
        >
        </div>

        <div
            class="max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center"
        >
            <div>
                <h2 class="text-4xl md:text-5xl font-black text-gray-900  mb-6">
                    Aptitudes
                </h2>

                <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-8">
                    {
                        [
                            "Líder de grupo.",
                            "Fuerte orientación y estética.",
                            "Atención al detalle.",
                            "Uso de creatividad y conocimientos técnicos.",
                            "Soluciones visuales efectivas e impactantes.",
                            "Adaptabilidad.",
                            "Iniciativa.",
                            "Creatividad."
                        ].map((aptitud) => (
                            <li class="flex items-start gap-3 p-4 rounded-2xl hover:bg-teal-50/80   transition-all duration-300 border border-transparent hover:border-teal-100  bg-white  shadow-sm group hover:shadow-md">
                                <div class="flex-shrink-0 w-8 h-8 rounded-full bg-teal-100  text-teal-600 flex items-center justify-center group-hover:scale-110 transition-transform shadow-sm group-hover:bg-teal-500 group-hover:text-white mt-0.5">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                                    </svg>
                                </div>
                                <span class="font-bold text-sm text-gray-700  leading-snug">{aptitud}</span>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <div>
                <h3 class="text-3xl font-black text-gray-900  mb-8 text-center lg:text-left">Programas</h3>
                <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-5 gap-4">
                    <div class="bg-white  p-3 rounded-2xl text-center transform hover:-translate-y-1 transition-all duration-300 flex flex-col items-center justify-center aspect-square border border-gray-100/50">
                        <img src="https://upload.wikimedia.org/wikipedia/commons/a/af/Adobe_Photoshop_CC_icon.svg" alt="Photoshop" class="w-10 h-10 mb-2" />
                        <span class="font-bold text-[0.65rem] text-gray-700  leading-tight block w-full truncate">Photoshop</span>
                    </div>
                    <div class="bg-white  p-3 rounded-2xl text-center transform hover:-translate-y-1 transition-all duration-300 flex flex-col items-center justify-center aspect-square border border-gray-100/50">
                        <img src="https://upload.wikimedia.org/wikipedia/commons/f/fb/Adobe_Illustrator_CC_icon.svg" alt="Illustrator" class="w-10 h-10 mb-2" />
                        <span class="font-bold text-[0.65rem] text-gray-700  leading-tight block w-full truncate">Illustrator</span>
                    </div>
                    <a href="https://www.canva.com/" target="_blank" class="canva-btn bg-white  p-3 rounded-2xl text-center transform hover:-translate-y-1 transition-all duration-300 flex flex-col items-center justify-center aspect-square border border-gray-100/50 group cursor-pointer block">
                        <img src="/images/canva.svg" alt="Canva" class="w-10 h-10 mb-2 p-[2px]" />
                        <span class="font-bold text-[0.65rem] text-gray-700  leading-tight block w-full truncate group-hover:text-black">Canva</span>
                    </a>
                    <div class="bg-white  p-3 rounded-2xl text-center transform hover:-translate-y-1 transition-all duration-300 flex flex-col items-center justify-center aspect-square border border-gray-100/50">
                        <img src="https://upload.wikimedia.org/wikipedia/commons/4/48/Adobe_InDesign_CC_icon.svg" alt="InDesign" class="w-10 h-10 mb-2" />
                        <span class="font-bold text-[0.65rem] text-gray-700  leading-tight block w-full truncate">InDesign</span>
                    </div>
                    <div class="bg-white  p-3 rounded-2xl text-center transform hover:-translate-y-1 transition-all duration-300 flex flex-col items-center justify-center aspect-square border border-gray-100/50">
                        <img src="https://upload.wikimedia.org/wikipedia/commons/c/cb/Adobe_After_Effects_CC_icon.svg" alt="After Effects" class="w-10 h-10 mb-2" />
                        <span class="font-bold text-[0.65rem] text-gray-700  leading-tight block w-full truncate">After Effects</span>
                    </div>
                    <div class="bg-white  p-3 rounded-2xl text-center transform hover:-translate-y-1 transition-all duration-300 flex flex-col items-center justify-center aspect-square border border-gray-100/50">
                        <img src="https://upload.wikimedia.org/wikipedia/commons/4/40/Adobe_Premiere_Pro_CC_icon.svg" alt="Premiere Pro" class="w-10 h-10 mb-2" />
                        <span class="font-bold text-[0.65rem] text-gray-700  leading-tight block w-full truncate">Premiere Pro</span>
                    </div>
                    <div class="bg-white  p-3 rounded-2xl text-center transform hover:-translate-y-1 transition-all duration-300 flex flex-col items-center justify-center aspect-square border border-gray-100/50">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 25 24" fill="currentColor" fill-rule="evenodd" class="w-10 h-10 mb-2 text-gray-800 ">
                          <title>CapCut</title>
                          <path d="M24.189 6.442V2.671l-4.535 2.383V4.91c.002-1.505-1.078-2.411-2.638-2.411H2.64C.993 2.5 0 3.407 0 4.91V8.72L6.354 12 0 15.316v3.8C0 20.595 1 21.5 2.64 21.5h14.373c1.56 0 2.639-.907 2.639-2.382v-.197l4.536 2.409v-3.828L13.64 12 24.19 6.443zM9.982 13.873l7.797 4.083H2.157l7.825-4.083zm7.741-7.828l-7.742 4.057-7.825-4.057h15.567z" />
                        </svg>
                        <span class="font-bold text-[0.65rem] text-gray-700  leading-tight block w-full truncate">CapCut</span>
                    </div>
                    <div class="bg-white  p-3 rounded-2xl text-center transform hover:-translate-y-1 transition-all duration-300 flex flex-col items-center justify-center aspect-square border border-gray-100/50">
                        <svg class="w-10 h-10 mb-2 drop-shadow-sm"
                             viewBox="0 0 512 512"
                             xmlns="http://www.w3.org/2000/svg">

                            <!-- Degradados -->
                            <defs>

                                <linearGradient id="bordeDVR" x1="0%" y1="0%" x2="100%" y2="100%">
                                    <stop offset="0%" stop-color="#20d9d0"/>
                                    <stop offset="25%" stop-color="#25b8e8"/>
                                    <stop offset="50%" stop-color="#b8e900"/>
                                    <stop offset="75%" stop-color="#ffca00"/>
                                    <stop offset="100%" stop-color="#ef263d"/>
                                </linearGradient>

                                <linearGradient id="azulDVR" x1="20%" y1="0%" x2="80%" y2="100%">
                                    <stop offset="0%" stop-color="#00e7ff"/>
                                    <stop offset="55%" stop-color="#27cde4"/>
                                    <stop offset="100%" stop-color="#ffd6d6"/>
                                </linearGradient>

                                <linearGradient id="amarilloDVR" x1="20%" y1="0%" x2="80%" y2="100%">
                                    <stop offset="0%" stop-color="#d7ff72"/>
                                    <stop offset="55%" stop-color="#d9ef00"/>
                                    <stop offset="100%" stop-color="#ffca27"/>
                                </linearGradient>

                                <linearGradient id="rojoDVR" x1="20%" y1="0%" x2="80%" y2="100%">
                                    <stop offset="0%" stop-color="#ffd5c8"/>
                                    <stop offset="45%" stop-color="#f35c82"/>
                                    <stop offset="100%" stop-color="#ff8b25"/>
                                </linearGradient>

                                <filter id="sombraDVR">
                                    <feDropShadow
                                        dx="0"
                                        dy="7"
                                        stdDeviation="7"
                                        flood-opacity="0.35"/>
                                </filter>

                            </defs>

                            <!-- Marco exterior -->
                            <rect
                                x="8"
                                y="8"
                                width="496"
                                height="496"
                                rx="75"
                                fill="url(#bordeDVR)"
                                filter="url(#sombraDVR)"
                            />

                            <!-- Fondo -->
                            <rect
                                x="22"
                                y="22"
                                width="468"
                                height="468"
                                rx="62"
                                fill="#20364c"
                            />

                            <!-- Forma superior -->
                            <path
                                d="M256 95
                                   C230 95 190 129 188 163
                                   C186 195 217 231 256 267
                                   C295 231 326 195 324 163
                                   C322 129 282 95 256 95Z"
                                fill="url(#azulDVR)"
                                filter="url(#sombraDVR)"
                            />

                            <!-- Forma inferior izquierda -->
                            <path
                                d="M105 278
                                   C113 250 147 250 181 256
                                   C210 261 239 270 246 286
                                   C253 302 239 347 224 375
                                   C208 405 184 420 151 415
                                   C115 410 91 383 87 348
                                   C84 325 94 297 105 278Z"
                                fill="url(#amarilloDVR)"
                                filter="url(#sombraDVR)"
                            />

                            <!-- Forma inferior derecha -->
                            <path
                                d="M407 278
                                   C399 250 365 250 331 256
                                   C302 261 273 270 266 286
                                   C259 302 273 347 288 375
                                   C304 405 328 420 361 415
                                   C397 410 421 383 425 348
                                   C428 325 418 297 407 278Z"
                                fill="url(#rojoDVR)"
                                filter="url(#sombraDVR)"
                            />

                        </svg>
                        <span class="font-bold text-[0.65rem] text-gray-700 leading-tight block w-full truncate">DaVinci Resolve</span>
                    </div>
                    <div class="bg-white  p-3 rounded-2xl text-center transform hover:-translate-y-1 transition-all duration-300 flex flex-col items-center justify-center aspect-square border border-gray-100/50">
                        <img src="https://upload.wikimedia.org/wikipedia/commons/3/33/Figma-logo.svg" alt="Figma" class="w-10 h-10 mb-2" />
                        <span class="font-bold text-[0.65rem] text-gray-700  leading-tight block w-full truncate">Figma</span>
                    </div>
                    <div class="bg-white  p-3 rounded-2xl text-center transform hover:-translate-y-1 transition-all duration-300 flex flex-col items-center justify-center aspect-square border border-gray-100/50">
                        <img src="https://upload.wikimedia.org/wikipedia/commons/6/61/HTML5_logo_and_wordmark.svg" alt="HTML" class="w-10 h-10 mb-2" />
                        <span class="font-bold text-[0.65rem] text-gray-700  leading-tight block w-full truncate">HTML</span>

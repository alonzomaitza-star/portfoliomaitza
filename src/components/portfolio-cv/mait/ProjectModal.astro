---
// Project Modal component - Vintage & Elegant
---

<div id="project-modal" class="fixed inset-0 z-[9999] flex items-center justify-center p-4 md:p-8 bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-700 hidden">
  <!-- Content Window (The "Window") -->
  <div id="modal-window" class="relative w-full max-w-6xl max-h-full bg-[#Faf7f2] text-[#42382c] rounded-[2rem] md:rounded-[3rem] shadow-2xl overflow-hidden flex flex-col transform scale-95 transition-transform duration-700">
    <!-- Vintage Noise Texture Background -->
    <div class="absolute inset-0 z-0 opacity-[0.25] pointer-events-none" style="background-image: url('data:image/svg+xml;utf8,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noise%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.8%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noise)%22/%3E%3C/svg%3E'); mix-blend-mode: multiply;"></div>
    
    <!-- Close Button relative to the window -->
    <button id="close-modal" class="absolute top-6 right-6 z-50 text-[#302a24] bg-white/80 hover:bg-white shadow-sm border border-[#42382c]/10 hover:scale-105 p-3 rounded-full transition-all backdrop-blur-md cursor-pointer">
       <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </button>
     
    <!-- Scrollable Content -->
    <div class="relative z-10 w-full overflow-y-auto" id="modal-scroll-container">
       <div id="modal-content" class="py-12 md:py-16 px-6 md:px-12 relative z-10 min-h-[80vh]">
         <!-- Dynamic content here -->
       </div>
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById('project-modal');
  const closeBtn = document.getElementById('close-modal');
  const contentContainer = document.getElementById('modal-content');
  
  window.addEventListener('open-project-modal', ((e: CustomEvent) => {
    const data = e.detail;
    
    // Determine specific styling based on project title (optional, just adds flavor)
    const titleLower = (data.title || '').toLowerCase();
    
    // Theme colors: default to warm brown/beige vintage
    let mainColor = '#8c5220'; 
    let bgAccentColor = '#613A1C';
    let brandSubtext = 'Identidad Visual';
    
    let projectBrief = `Necesito desarrollar <strong>${data.title}</strong>, enfocado en transmitir la esencia fundamental de <em>${data.subtitle || brandSubtext}</em>. Busco transmitir identidad y modernidad con un estilo claro, elegante y vintage. El concepto debe ser minimalista pero cargado de historia y pertenencia.`;
    
    let projectIdea = `Concepto visual basado en líneas puras y armónicas, conectadas intrínsecamente con la identidad del proyecto. Se busca un símbolo y estructura que perdure en el tiempo, manteniendo claridad, y elegancia en distintos soportes.`;

    let projectTypographyName = 'Tipografía Sans-Serif';
    let projectTypographyConcept = '"Se utilizó una tipografía pesada y geométrica, con trazos rectos y cortes definidos aportando modernidad y coherencia visual con el isotipo para lograr un diseño sólido y confiable."';
    let projectFontFamily = 'sans-serif';
    let typMainClasses = 'font-sans font-black tracking-tighter';
    let typSubClasses = 'font-bold uppercase tracking-widest text-sm';

    let projectPaletteTitleClass = "text-white/40";
    let finalMockup = '';
    let projectIconographyHTML = `
                    <div class="absolute inset-0 opacity-[0.2]" style="background-image: url('data:image/svg+xml;utf8,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noise%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%221%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noise)%22/%3E%3C/svg%3E'); mix-blend-mode: overlay;"></div>
                    <svg viewBox="0 0 24 24" fill="none" class="w-24 h-24 text-white/50 group-hover:scale-110 transition-transform duration-500 relative z-10" stroke="currentColor" stroke-width="1"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><path d="M22 6l-10 7L2 6"></path></svg>
                    <span class="text-white/60 font-bold uppercase tracking-widest text-xs mt-4 relative z-10">Iconografía</span>
    `;

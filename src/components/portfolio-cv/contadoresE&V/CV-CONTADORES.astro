                </div>
            </div>

            <!-- Main Content (Right) -->
            <div
                class="lg:col-span-8 p-8 lg:p-12 bg-white dark:bg-gray-100 text-gray-800"
            >
                <!-- Header -->
                <div class="mb-8 border-b-4 border-blue-600 pb-6">
                    <h2
                        class="text-lg font-bold text-blue-600 tracking-widest uppercase mb-2"
                    >
                        Soluciones Integrales
                    </h2>
                    <h1
                        class="text-4xl lg:text-5xl font-black text-gray-900 leading-tight mb-2"
                    >
                        E&V CONTADORES
                    </h1>
                    <h1
                        class="text-3xl lg:text-4xl font-black text-gray-500 leading-tight mb-6"
                    >
                        PÚBLICOS INDEPENDIENTES
                    </h1>

                    <div
                        class="bg-gray-50 p-4 rounded-lg border-l-4 border-blue-500"
                    >
                        <p class="text-xl font-semibold text-gray-700 italic">
                            "Profesionalismo, Confianza y Precisión"
                        </p>
                    </div>
                </div>

                <!-- Profile/About -->
                <div class="mb-10">
                    <p
                        class="text-gray-600 text-lg leading-relaxed text-justify"
                    >
                        En <strong
                            >E & V Contadores Públicos Independientes</strong
                        > nos especializamos en brindar soluciones contables y fiscales
                        a personas físicas y morales, con un enfoque personalizado
                        y profesional. Nuestro objetivo es facilitar el cumplimiento
                        de sus obligaciones fiscales, optimizar sus recursos y generar
                        información financiera confiable.
                    </p>
                </div>

                <!-- Detailed Services Section -->
                <div class="space-y-8">
                    <h3
                        class="text-xl font-bold text-gray-900 mb-6 uppercase tracking-widest flex items-center gap-3"
                    >
                        <span class="w-8 h-1 bg-blue-600"></span> Nuestros Servicios
                    </h3>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Declaraciones Fiscales -->
                        <div
                            class="group p-6 bg-white rounded-xl border border-gray-200 shadow-sm hover:shadow-md hover:border-blue-300 transition-all"
                        >
                            <h4
                                class="text-lg font-bold text-gray-800 mb-3 flex items-center gap-2 group-hover:text-blue-600 transition-colors"
                            >
                                <span
                                    class="bg-blue-100 p-2 rounded-lg text-blue-600 text-xl"
                                    >�</span

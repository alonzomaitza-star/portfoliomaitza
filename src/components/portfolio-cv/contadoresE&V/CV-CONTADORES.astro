                                </li>
                            </ul>
                        </div>

                        <!-- Trámites ante el SAT -->
                        <div
                            class="group p-6 bg-white rounded-xl border border-gray-200 shadow-sm hover:shadow-md hover:border-blue-300 transition-all"
                        >
                            <h4
                                class="text-lg font-bold text-gray-800 mb-3 flex items-center gap-2 group-hover:text-blue-600 transition-colors"
                            >
                                <span
                                    class="bg-blue-100 p-2 rounded-lg text-blue-600 text-xl"
                                    >🏛️</span
                                > Trámites ante el SAT
                            </h4>
                            <ul
                                class="text-gray-600 text-sm space-y-1 list-disc list-inside"
                            >
                                <li>Inscripción y actualización en el RFC</li>
                                <li>Trámites de firma electrónica (e.firma)</li>
                                <li>Activación y renovación de contraseña</li>
                                <li>Aclaraciones y solicitudes diversas</li>
                            </ul>
                        </div>

                        <!-- Contabilidad e Impuestos -->
                        <div
                            class="group p-6 bg-white rounded-xl border border-gray-200 shadow-sm hover:shadow-md hover:border-blue-300 transition-all"
                        >
                            <h4
                                class="text-lg font-bold text-gray-800 mb-3 flex items-center gap-2 group-hover:text-blue-600 transition-colors"
                            >
                                <span
                                    class="bg-blue-100 p-2 rounded-lg text-blue-600 text-xl"
                                    >�</span
                                > Contabilidad e Impuestos
                            </h4>
                            <ul
                                class="text-gray-600 text-sm space-y-1 list-disc list-inside"
                            >
                                <li>Registro contable mensual</li>
                                <li>Elaboración de estados financieros</li>
                                <li>Cálculo y determinación de impuestos</li>
                                <li>
                                    Revisión y análisis de obligaciones fiscales
                                </li>
                            </ul>
                        </div>

                        <!-- Asesorías Financieras -->
                        <div
                            class="group p-6 bg-white rounded-xl border border-gray-200 shadow-sm hover:shadow-md hover:border-blue-300 transition-all"
                        >
                            <h4
                                class="text-lg font-bold text-gray-800 mb-3 flex items-center gap-2 group-hover:text-blue-600 transition-colors"
                            >
                                <span
                                    class="bg-blue-100 p-2 rounded-lg text-blue-600 text-xl"
                                    >💼</span
                                > Asesorías Financieras
                            </h4>
                            <ul
                                class="text-gray-600 text-sm space-y-1 list-disc list-inside"
                            >
                                <li>Planeación fiscal</li>
                                <li>Análisis financiero personalizado</li>
                                <li>Estrategias de optimización fiscal</li>
                                <li>Acompañamiento en auditorías</li>
                            </ul>
                        </div>

                        <!-- Servicios de Facturación -->
                        <div
                            class="group p-6 bg-white rounded-xl border border-gray-200 shadow-sm hover:shadow-md hover:border-blue-300 transition-all md:col-span-2"
                        >
                            <h4
                                class="text-lg font-bold text-gray-800 mb-3 flex items-center gap-2 group-hover:text-blue-600 transition-colors"
                            >
                                <span
                                    class="bg-blue-100 p-2 rounded-lg text-blue-600 text-xl"
                                    >🧾</span
                                > Servicios de Facturación
                            </h4>
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                <span
                                    class="flex items-center gap-2 text-sm text-gray-600"
                                    ><span class="text-blue-500">✓</span> Emisión
                                    de facturas</span
                                >
                                <span
                                    class="flex items-center gap-2 text-sm text-gray-600"
                                    ><span class="text-blue-500">✓</span> Control
                                    de CFDI's</span
                                >
                                <span
                                    class="flex items-center gap-2 text-sm text-gray-600"
                                    ><span class="text-blue-500">✓</span> Gestión
                                    de catálogos</span
                                >
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Call to Action -->
                <div
                    class="mt-12 p-8 bg-blue-50 rounded-2xl text-center border border-blue-100"
                >
                    <h3 class="text-2xl font-bold text-gray-900 mb-2">
                        ¿Listo para optimizar sus finanzas?
                    </h3>
                    <p class="text-gray-600 mb-6">
                        Contáctanos hoy mismo para comenzar.
                    </p>
                    <a
                        href="mailto:contadorvictorgomez@gmail.com"
                        class="inline-block bg-blue-600 text-white font-bold py-3 px-8 rounded-full shadow-lg hover:bg-blue-700 hover:shadow-xl transition-all hover:-translate-y-1"
                    >
                        Solicitar Asesoría
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- CV Modal (PDF Viewer) -->
    <div
        id="cv-modal"
        class="fixed hidden z-[100] pointer-events-none transition-opacity duration-300"
        style="top: 50px; left: 50px;"
    >
        <div
            class="pointer-events-auto w-[1000px] h-[800px] max-w-[95vw] max-h-[90vh] flex flex-col bg-white dark:bg-gray-900 rounded-lg shadow-2xl overflow-hidden border border-gray-200 dark:border-gray-700 cv-modal-content"
            style="box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);"
        >
            <!-- Toolbar -->
            <div
                id="cv-modal-header"
                class="h-10 bg-gray-100 dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700 flex items-center justify-between px-4 cursor-move select-none"
            >
                <div class="flex gap-2">
                    <div class="w-3 h-3 rounded-full bg-red-500"></div>
                    <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
                    <div class="w-3 h-3 rounded-full bg-green-500"></div>
                </div>
                <span
                    class="text-sm font-medium text-gray-600 dark:text-gray-300"
                    >{title} - PDF Preview</span
                >
                <button
                    id="close-cv-modal"
                    class="text-gray-500 hover:text-red-500 transition-colors"
                >
                    <svg
                        class="w-5 h-5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>

            <!-- Iframe Container -->
            <div class="flex-1 bg-gray-800 relative">
                <iframe
                    src={`${pdfUrl}#toolbar=0`}
                    class="w-full h-full border-0"
                    title="PDF Viewer"></iframe>
            </div>
        </div>
    </div>
</section>

<script>
    console.log("CV-CONTADORES script initializing...");

    // --- PDF Modal Logic ---
    const viewPdfBtn = document.getElementById("view-pdf-btn");
    const cvModal = document.getElementById("cv-modal");
    const cvModalContent = document.querySelector(".cv-modal-content");
    const cvModalHeader = document.getElementById("cv-modal-header");
    const closeCvModalBtn = document.getElementById("close-cv-modal");

    if (viewPdfBtn && cvModal && cvModalContent) {
        viewPdfBtn.addEventListener("click", () => {
            cvModal.style.top = "50px";
            cvModal.style.left = "50px";
            cvModal.classList.remove("hidden");

            // Center modal (calculate but also constrain to window)
            const x = (window.innerWidth - cvModalContent.offsetWidth) / 2;
            const y = 50;
            cvModal.style.left = `${Math.max(0, x)}px`;
            cvModal.style.top = `${Math.max(0, y)}px`;
        });
    }

    if (closeCvModalBtn && cvModal) {
        closeCvModalBtn.addEventListener("click", () => {
            cvModal.classList.add("hidden");
        });
    }

    // Drag Logic
    let isDragging = false;
    let currentX;
    let currentY;
    let initialX;
    let initialY;

    if (cvModalHeader && cvModal) {
        cvModalHeader.addEventListener("mousedown", dragStart);
        document.addEventListener("mousemove", drag);
        document.addEventListener("mouseup", dragEnd);
    }

    function dragStart(e) {
        if (cvModal) {
            const rect = cvModal.getBoundingClientRect();
            initialX = e.clientX - rect.left;
            initialY = e.clientY - rect.top;

            if (
                e.target === cvModalHeader ||
                (cvModalHeader && cvModalHeader.contains(e.target))
            ) {
                isDragging = true;
            }
        }
    }

    function drag(e) {
        if (isDragging && cvModal && cvModalContent) {
            e.preventDefault();
            currentX = e.clientX - initialX;
            currentY = e.clientY - initialY;
            const maxX = window.innerWidth - cvModalContent.offsetWidth;
            const maxY = window.innerHeight - cvModalContent.offsetHeight;
            currentX = Math.min(Math.max(0, currentX), maxX);
            currentY = Math.min(Math.max(0, currentY), maxY);
            cvModal.style.left = `${currentX}px`;
            cvModal.style.top = `${currentY}px`;
        }
    }

    function dragEnd() {
        isDragging = false;
    }

    // --- PNG Download Logic ---
    const downloadBtn = document.getElementById("download-png-btn");
    const cvContent = document.getElementById("cv-content");

    if (downloadBtn && cvContent) {
        downloadBtn.addEventListener("click", async () => {
            const originalIcon = downloadBtn.innerHTML;
            downloadBtn.innerHTML = `<svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>`;

            try {
                const html2canvas = (await import("html2canvas")).default;
                const canvas = await html2canvas(cvContent, {
                    scale: 2,
                    useCORS: true,
                    logging: false,
                    backgroundColor: null,
                });

                const image = canvas.toDataURL("image/png");
                const link = document.createElement("a");
                link.href = image;
                link.download = "CV-Contadores-EV.png";
                link.click();
            } catch (err) {
                console.error("Error generating PNG:", err);
                alert("Error al generar la imagen.");
            } finally {
                downloadBtn.innerHTML = originalIcon;
            }
        });
    }
</script>

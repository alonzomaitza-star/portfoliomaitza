---
import CardDiseno from "../common/CardDiseno.astro";
---
<section class="py-12 bg-gray-900/50">
  <div class="container mx-auto px-4">
    <h2 class="text-3xl md:text-4xl font-extrabold text-white text-center">2D: Diseño Digital</h2>
    <p class="text-base md:text-lg text-gray-200 text-center mt-2 max-w-3xl mx-auto">Logos, invitaciones, sellos, mockups y material para redes.</p>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
      <CardDiseno titulo="Identidad" descripcion="Logo, paleta, tipografías y sistema visual." />
      <CardDiseno titulo="Editorial" descripcion="Invitaciones, certificados, sellos y material impreso." />
      <CardDiseno titulo="Social y Mockups" descripcion="Creatividades optimizadas y presentaciones." />
    </div>
  </div>
</section>

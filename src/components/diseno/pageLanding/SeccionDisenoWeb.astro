---
import CardDiseno from "../common/CardDiseno.astro";
---
<section class="py-12">
  <div class="container mx-auto px-4">
    <h2 class="text-3xl md:text-4xl font-extrabold text-white text-center">Diseño Web</h2>
    <p class="text-base md:text-lg text-gray-200 text-center mt-2 max-w-3xl mx-auto">Arquitectura de información, UX/UI, landings, tiendas y herramientas internas.</p>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
      <CardDiseno titulo="Arquitectura" descripcion="Mapeado de contenidos y flujos clave." />
      <CardDiseno titulo="UX/UI" descripcion="Patrones usables, accesibilidad y consistencia visual." />
      <CardDiseno titulo="Design Specs" descripcion="Guías de implementación y assets exportables." />
    </div>
  </div>
</section>

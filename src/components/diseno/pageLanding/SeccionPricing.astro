---
type ColorType = 'bronze' | 'silver' | 'gold';

interface PricingPlan {
  id: number;
  titulo: string;
  descripcion: string;
  precio: number;
  features: string[];
  esPopular?: boolean;
  color: ColorType;
}

interface Props {
  servicios?: PricingPlan[];
}

const { servicios = [] } = Astro.props;

const colorMap: Record<ColorType, Record<string, string>> = {
  bronze: {
    bg: 'bg-white',
    border: 'border-gray-300',
    text: 'text-gray-800',
    price: 'text-gray-700',
    button: 'from-gray-400 to-gray-600 hover:from-gray-500 hover:to-gray-700'
  },
  silver: {
    bg: 'bg-gradient-to-br from-blue-900 to-purple-900',
    border: 'border-2 border-purple-500',
    text: 'text-white',
    price: 'text-purple-300',
    button: 'from-purple-500 to-indigo-500 hover:from-purple-600 hover:to-indigo-600',
    badge: 'bg-purple-600'
  },
  gold: {
    bg: 'bg-yellow-400',
    border: 'border-yellow-500',
    text: 'text-gray-800',
    price: 'text-gray-800',
    button: 'from-yellow-500 to-yellow-600 hover:from-yellow-600 hover:to-yellow-700'
  }
};

// Servicios por defecto si no se proporcionan
const pricingPlans: PricingPlan[] = servicios.length > 0 ? servicios : [
  {
    id: 1,
    titulo: "Paquete Bronze",
    descripcion: "Explorando el mundo digital.",
    precio: 2000,
    features: [
      "4 Publicaciones mensuales",
      "Lunes a Viernes",
      "$100 en Publicidad incluida"
    ],
    color: 'bronze'
  },
  {
    id: 2,
    titulo: "Paquete Plata",
    descripcion: "Para iniciar en el mundo digital.",
    precio: 3500,
    features: [
      "Hasta 2 Redes Sociales",
      "7 Publicaciones mensuales",
      "Lunes a Viernes",
      "3 Stories mensuales",
      "Lunes a Viernes",
      "Informes y análisis trimestral",
      "$200 en Publicidad incluida"
    ],
    esPopular: true,
    color: 'silver'
  },
  {
    id: 3,
    titulo: "Paquete Oro",
    descripcion: "Ideal para empresas pequeñas.",
    precio: 5000,
    features: [
      "Hasta 2 Redes Sociales",
      "8 artes gráficos mensuales",
      "Lunes a Viernes",
      "4 Stories por mes",
      "Lunes a Sábado",
      "Informes y análisis mensuales",
      "$200 en Publicidad incluida"
    ],
    color: 'gold'
  }
];
---

<div id="pricing" class="py-20 md:px-20 lg:px-20 bg-black">
  <div class="container mx-auto px-4">
    <!-- Header -->
    <div class="mb-12 text-center">
      <h3 class="text-purple-400 text-sm md:text-base font-semibold" data-aos="fade-down">
        Planes de Diseño
      </h3>
      <h2 class="text-white text-3xl md:text-4xl font-bold mt-2" data-aos="fade-down">
        Elige tu Paquete Perfecto
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-gray-400 text-sm md:text-base" data-aos="fade-down">
        Selecciona entre nuestros paquetes de diseño cuidadosamente diseñados para adaptarse a tus necesidades y presupuesto.
      </p>
    </div>

    <!-- Pricing Cards Grid -->
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {pricingPlans.map((plan) => {
        const colors = colorMap[plan.color];
        const isPopular = plan.esPopular;
        
        return (
          <div 
            class={`relative rounded-2xl p-6 md:p-8 transition-all duration-300 ${
              isPopular 
                ? `${colors.bg} ${colors.border} hover:transform hover:-translate-y-2` 
                : `${colors.bg} border ${colors.border}`
            }`}
          >
            {/* Popular Badge */}
            {isPopular && (
              <div class="absolute -top-4 left-1/2 -translate-x-1/2 rounded-full bg-purple-600 px-4 py-1 text-white text-sm font-semibold">
                Más Popular
              </div>
            )}

            {/* Card Content */}
            <div class="text-center">
              <h3 class={`text-2xl md:text-3xl font-bold ${colors.text}`}>
                {plan.titulo}
              </h3>
              <p class={`text-sm md:text-base mt-2 ${colors.text} opacity-75`}>
                {plan.descripcion}
              </p>
              
              {/* Price */}
              <div class="mt-6 text-center">
                <span class={`text-4xl md:text-5xl font-bold ${colors.price}`}>
                  ${plan.precio.toLocaleString()}
                </span>
                <span class={`text-sm md:text-base ${colors.text} opacity-75 ml-2`}>
                  /mes
                </span>
              </div>
            </div>

            {/* Features List */}
            <div class={`mt-8 ${isPopular ? 'px-4 pb-8' : ''}`}>
              <ul class="mb-8 space-y-4">
                {plan.features.map((feature) => (
                  <li class="flex items-start">
                    <svg 
                      class={`mr-3 h-5 w-5 flex-shrink-0 mt-0.5 ${
                        plan.color === 'gold' ? 'text-yellow-600' : 'text-purple-400'
                      }`} 
                      xmlns="http://www.w3.org/2000/svg" 
                      viewBox="0 0 20 20" 
                      fill="currentColor" 
                      aria-hidden="true"
                    >
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                    <span class={`text-sm md:text-base ${colors.text}`}>
                      {feature}
                    </span>
                  </li>
                ))}
              </ul>

              {/* CTA Button */}
              <button
                class={`w-full py-3 px-6 text-center text-white font-semibold rounded-full bg-gradient-to-r ${colors.button} shadow-lg transition duration-300 ease-in-out transform hover:scale-105`}
              >
                Elegir Plan
              </button>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</div>

<style>
  [data-aos] {
    opacity: 0;
    animation: fadeDown 0.6s ease-out forwards;
  }

  @keyframes fadeDown {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

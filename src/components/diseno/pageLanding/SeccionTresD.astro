---
import CardDiseno from "../common/CardDiseno.astro";
---
<section class="py-12">
  <div class="container mx-auto px-4">
    <h2 class="text-3xl md:text-4xl font-extrabold text-white text-center">3D: Modelado y Proyectos</h2>
    <p class="text-base md:text-lg text-gray-200 text-center mt-2 max-w-3xl mx-auto">Modelado para impresión 3D, proyectos a escala, fachadas, arcotechos y viviendas.</p>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
      <CardDiseno titulo="Impresión 3D" descripcion="Modelos listos (STL/OBJ) y tolerancias para manufactura aditiva." />
      <CardDiseno titulo="Fachadas y Arcotechos" descripcion="Visualizaciones y propuestas de estructura y acabados." />
      <CardDiseno titulo="Proyectos a Escala" descripcion="Modelos conceptuales y de detalle para comunicación de ideas." />
    </div>
  </div>
</section>

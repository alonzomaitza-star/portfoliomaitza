---
// Lazy-loadable Figma embed card
interface Props {
  url: string;
  titulo?: string;
  descripcion?: string;
}
const { url, titulo = 'Proyecto Figma', descripcion = 'Vista previa en Figma' } = Astro.props as Props;
const normalizedUrl = url.includes('/design/') ? url.replace('/design/', '/file/') : url;
const embedUrl = `https://www.figma.com/embed?embed_host=share&url=${encodeURIComponent(normalizedUrl)}`;
---
<div class="bg-gray-900/60 border border-gray-700 rounded-xl overflow-hidden" data-figma-card data-embed={embedUrl}>
  <div class="p-4 border-b border-gray-700">
    <h3 class="text-white font-semibold">{titulo}</h3>
    <p class="text-gray-300 text-sm">{descripcion}</p>
  </div>
  <div class="p-4">
    <div class="relative w-full aspect-video bg-gray-800/70 border border-gray-700 rounded-lg flex items-center justify-center" data-container>
      <div data-placeholder class="flex flex-col items-center justify-center gap-3">
        <div class="w-14 h-14 rounded-full bg-gray-700 animate-pulse"></div>
        <p class="text-gray-400 text-sm text-center max-w-[80%]">Este visor puede consumir más recursos. Pulsa "Ver" para cargarlo.</p>
        <div class="flex items-center gap-3">
          <button type="button" class="px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white rounded-lg text-sm transition" data-action="ver">
            Ver
          </button>
          <a href={url} target="_blank" rel="noopener noreferrer" class="text-sm text-blue-300 hover:text-blue-200 underline">Abrir en Figma</a>
        </div>
      </div>
      <iframe data-iframe src="about:blank" title="Figma embed" class="hidden w-full h-full rounded-lg"
        allow="fullscreen; clipboard-write"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen></iframe>
    </div>
  </div>
  <script is:inline>
    (function(){
      const scriptEl = document.currentScript;
      const root = scriptEl && scriptEl.closest ? scriptEl.closest('[data-figma-card]') : null;
      if (!root) return;
      const embed = root.getAttribute('data-embed');
      const btn = root.querySelector('[data-action="ver"]');
      const iframe = root.querySelector('[data-iframe]');
      const placeholder = root.querySelector('[data-placeholder]');
      if (!embed || !btn || !iframe || !placeholder) return;
      btn.addEventListener('click', function(){
        iframe.setAttribute('src', embed);
        iframe.classList.remove('hidden');
        placeholder.classList.add('hidden');
      }, { once: true });
    })();
  </script>
</div>

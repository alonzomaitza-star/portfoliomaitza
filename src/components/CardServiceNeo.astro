---
// Recibe un objeto servicio por prop
const { servicio } = Astro.props;
---

<!-- Tarjeta con diseño neomórfico moderno -->
<li class="relative bg-white rounded-2xl p-6 flex flex-col items-center shadow-[2px_2px_6px_#d1d1d1,-2px_-2px_6px_#ffffff] hover:shadow-[2px_2px_6px_#d1d1d1,-2px_-2px_6px_#ffffff] transition-all duration-300 group">

  
  <!-- Contenido de la tarjeta -->
  <div class="w-full flex flex-col items-center">
    <!-- Icono del servicio con efecto neomórfico -->
    <div class="mb-5 p-4 rounded-full bg-gray-100 shadow-[inset_4px_4px_8px_#d1d1d1,inset_-4px_-4px_8px_#ffffff] group-hover:shadow-[inset_6px_6px_12px_#d1d1d1,inset_-6px_-6px_12px_#ffffff] transition-all duration-300">
      <img 
        src={servicio.icono} 
        alt={servicio.titulo} 
        class="w-16 h-16 object-contain" 
      />
    </div>
    
    <!-- Información del servicio -->
    <h3 class="text-xl font-bold mb-3 text-center text-gray-800">
      {servicio.titulo}
    </h3>
    
    <p class="text-sm text-center mb-5 text-gray-600 line-clamp-3">
      {servicio.descripcion}
    </p>
    
    <!-- Características del servicio -->
    {servicio.caracteristicas && (
      <ul class="w-full space-y-2 mb-6">
        {servicio.caracteristicas.map((caracteristica) => (
          <li class="flex items-center text-sm text-gray-700">
            <span class="mr-2 text-blue-500">✓</span>
            {caracteristica}
          </li>
        ))}
      </ul>
    )}
    
    <!-- Precio con estilo neomórfico -->
    {servicio.precio && (
      <div class="mb-5 px-5 py-2 rounded-xl bg-gray-100 shadow-[inset_4px_4px_8px_#d1d1d1,inset_-4px_-4px_8px_#ffffff]">
        <span class="text-blue-600 font-bold text-lg">{servicio.desde ? 'Desde ' : ''}${servicio.precio}</span>
        {servicio.periodo && <span class="text-gray-500 text-sm">/{servicio.periodo}</span>}
      </div>
    )}
    
    <!-- Acción -->
    {servicio.link ? (
      <a href={servicio.link} class="mt-2 px-6 py-3 bg-gray-100 text-blue-600 font-medium rounded-full shadow-[4px_4px_8px_#d1d1d1,-4px_-4px_8px_#ffffff] hover:shadow-[inset_4px_4px_8px_#d1d1d1,inset_-4px_-4px_8px_#ffffff] transition-all duration-300 transform hover:scale-95">
        {servicio.boton ? servicio.boton : 'Solicitar servicio'}
      </a>
    ) : (
      <button class="mt-2 px-6 py-3 bg-gray-100 text-blue-600 font-medium rounded-full shadow-[4px_4px_8px_#d1d1d1,-4px_-4px_8px_#ffffff] hover:shadow-[inset_4px_4px_8px_#d1d1d1,inset_-4px_-4px_8px_#ffffff] transition-all duration-300 transform hover:scale-95">
        {servicio.boton ? servicio.boton : 'Solicitar servicio'}
      </button>
    )}
  </div>
</li>
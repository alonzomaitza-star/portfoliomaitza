---
// Componente Global de Botón de Contacto con Modal
---

<!-- Botón Flotante de Contacto -->
<div class="fixed bottom-6 right-6 z-50">
  <div class="bg-white rounded-full shadow-2xl p-2 flex flex-col gap-2">
    <!-- Botón Principal -->
    <button
      id="contact-main-btn"
      class="relative w-14 h-14 bg-gradient-to-r from-blue-600 to-purple-600 text-white rounded-full shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-110 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
      aria-label="Opciones de contacto"
    >
      <svg class="w-6 h-6 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
      </svg>
      <span class="absolute -top-1 -right-1 w-3 h-3 bg-red-500 rounded-full animate-pulse"></span>
    </button>
    
    <!-- Botones Expandidos (inicialmente ocultos) -->
    <div id="contact-options" class="hidden">
      <div class="flex flex-col gap-2">
      <!-- Botón de Formulario -->
      <button
        id="form-btn"
        class="w-12 h-12 bg-green-500 text-white rounded-full shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-110 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2"
        aria-label="Dejanos tus datos"
        title="Dejanos tus datos"
      >
        <svg class="w-5 h-5 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
      </button>
      
      <!-- Botón de Chat -->
      <button
        id="chat-btn"
        class="w-12 h-12 bg-blue-500 text-white rounded-full shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-110 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
        aria-label="Unete al chat"
        title="Unete al chat"
      >
        <svg class="w-5 h-5 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
        </svg>
      </button>
    </div>
    </div>
  </div>
</div>

<!-- Modal de Contacto -->
<dialog id="contact-modal" class="backdrop:bg-black/50 border-0 rounded-xl shadow-2xl max-w-4xl w-full mx-4 max-h-[90vh] overflow-hidden">
  <div class="bg-white rounded-xl">
    <!-- Header del Modal -->
    <div class="bg-gradient-to-r from-blue-600 to-purple-600 text-white p-6 flex justify-between items-center">
      <div>
        <h2 class="text-2xl font-bold">Contacta con Nosotros</h2>
        <p class="text-blue-100">Estamos listos para ayudarte con tu proyecto</p>
      </div>
      <button
        id="close-modal-btn"
        class="text-white hover:bg-white/20 rounded-full p-2 transition-colors duration-200"
        aria-label="Cerrar modal"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
    
    <!-- Contenido del Modal con iframe -->
    <div class="relative" style="height: 600px;">
      <iframe
        id="contact-iframe"
        src="/contact-form?modal=true"
        class="w-full h-full border-0"
        title="Formulario de contacto"
      ></iframe>
    </div>
  </div>
</dialog>

<!-- Chatbot Container (inicialmente oculto) -->
<div id="chatbot-container" class="hidden fixed bottom-24 right-6 z-40">
  <div class="bg-white rounded-lg shadow-2xl w-80 h-96 flex flex-col">
    <!-- Header del Chatbot -->
    <div class="bg-gradient-to-r from-blue-600 to-purple-600 text-white p-4 rounded-t-lg flex justify-between items-center">
      <div>
        <h3 class="font-bold">Asistente Insano</h3>
        <p class="text-xs text-blue-100">¿En qué puedo ayudarte?</p>
      </div>
      <button
        id="close-chatbot-btn"
        class="text-white hover:bg-white/20 rounded-full p-1 transition-colors duration-200"
        aria-label="Cerrar chatbot"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
    
    <!-- Mensajes del Chatbot -->
    <div id="chatbot-messages" class="flex-1 p-4 overflow-y-auto bg-gray-50">
      <div class="bg-blue-100 rounded-lg p-3 mb-3 max-w-[80%]">
        <p class="text-sm">¡Hola! 👋 Soy el asistente de Insano Network. Puedo ayudarte a:</p>
        <ul class="text-sm mt-2 space-y-1">
          <li>• Informarte sobre nuestros servicios</li>
          <li>• Responder preguntas frecuentes</li>
          <li>• Agendar una consulta</li>
          <li>• Conectarte con un experto</li>
        </ul>
        <p class="text-sm mt-2">¿En qué te interesa?</p>
      </div>
    </div>
    
    <!-- Input del Chatbot -->
    <div class="p-4 border-t">
      <div class="flex gap-2">
        <input
          type="text"
          id="chatbot-input"
          placeholder="Escribe tu mensaje..."
          class="flex-1 px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
        <button
          id="send-chat-btn"
          class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition-colors duration-200"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Notas informativas -->
<div class="fixed bottom-6 left-6 z-40 max-w-xs">
  <div id="contact-notes" class="bg-white rounded-lg shadow-lg p-4 text-xs text-gray-600 hidden">
    <h4 class="font-semibold text-gray-900 mb-2">📋 ¿Cómo funciona?</h4>
    <ul class="space-y-1">
      <li><strong>📝 Dejanos tus datos:</strong> Completa el formulario y te contactaremos en 24-48 horas.</li>
      <li><strong>💬 Unete al chat:</strong> Chatea con nuestro asistente para respuestas inmediatas.</li>
    </ul>
    <button
      id="hide-notes-btn"
      class="mt-2 text-blue-600 hover:text-blue-700 underline"
    >
      Ocultar notas
    </button>
  </div>
</div>

<script>
  // Estado del botón
  let isExpanded = false;
  
  // Elementos del DOM
  const mainBtn = document.getElementById('contact-main-btn');
  const contactOptions = document.getElementById('contact-options');
  const formBtn = document.getElementById('form-btn');
  const chatBtn = document.getElementById('chat-btn');
  const modal = document.getElementById('contact-modal');
  const closeModalBtn = document.getElementById('close-modal-btn');
  const chatbotContainer = document.getElementById('chatbot-container');
  const closeChatbotBtn = document.getElementById('close-chatbot-btn');
  const contactNotes = document.getElementById('contact-notes');
  const hideNotesBtn = document.getElementById('hide-notes-btn');
  const chatbotInput = document.getElementById('chatbot-input');
  const sendChatBtn = document.getElementById('send-chat-btn');
  const chatbotMessages = document.getElementById('chatbot-messages');
  
  // Toggle del menú de opciones
  mainBtn.addEventListener('click', function() {
    isExpanded = !isExpanded;
    
    if (isExpanded) {
      contactOptions.classList.remove('hidden');
      contactOptions.querySelector('div').classList.add('flex', 'animate-fade-in');
      mainBtn.style.transform = 'rotate(45deg)';
      
      // Mostrar notas después de un breve retraso
      setTimeout(() => {
        contactNotes.classList.remove('hidden');
      }, 500);
    } else {
      contactOptions.classList.add('hidden');
      contactOptions.querySelector('div').classList.remove('flex', 'animate-fade-in');
      mainBtn.style.transform = 'rotate(0deg)';
      contactNotes.classList.add('hidden');
    }
  });
  
  // Abrir modal de formulario
  formBtn.addEventListener('click', function() {
    modal.showModal();
    // Cerrar menú
    isExpanded = false;
    contactOptions.classList.add('hidden');
    mainBtn.style.transform = 'rotate(0deg)';
    contactNotes.classList.add('hidden');
  });
  
  // Cerrar modal
  closeModalBtn.addEventListener('click', function() {
    modal.close();
  });
  
  // Cerrar modal al hacer clic fuera
  modal.addEventListener('click', function(e) {
    if (e.target === modal) {
      modal.close();
    }
  });
  
  // Abrir chatbot
  chatBtn.addEventListener('click', function() {
    chatbotContainer.classList.remove('hidden');
    chatbotContainer.classList.add('animate-fade-in');
    // Cerrar menú
    isExpanded = false;
    contactOptions.classList.add('hidden');
    mainBtn.style.transform = 'rotate(0deg)';
    contactNotes.classList.add('hidden');
  });
  
  // Cerrar chatbot
  closeChatbotBtn.addEventListener('click', function() {
    chatbotContainer.classList.add('hidden');
  });
  
  // Ocultar notas
  hideNotesBtn.addEventListener('click', function() {
    contactNotes.classList.add('hidden');
  });
  
  // Funcionalidad del chatbot
  const chatbotResponses = {
    'hola': '¡Hola! 👋 ¿En qué puedo ayudarte hoy?',
    'servicios': 'Ofrecemos desarrollo web, software a medida, marketing digital, diseño gráfico y consultoría TI. ¿Cuál te interesa?',
    'precio': 'Nuestros precios varían según el proyecto. ¿Podrías contarme más sobre lo que necesitas?',
    'tiempo': 'El tiempo de entrega depende de la complejidad. Proyectos pequeños: 1-2 semanas, medianos: 1-2 meses, grandes: 3-6 meses.',
    'contacto': 'Puedes dejarnos tus datos en el formulario o escribir a contacto@insanonetwork.com',
    'default': 'Entiendo tu pregunta. ¿Prefieres que te conecte con un experto o puedes darme más detalles?'
  };
  
  function addChatMessage(message, isUser = false) {
    const messageDiv = document.createElement('div');
    messageDiv.className = `rounded-lg p-3 mb-3 max-w-[80%] ${isUser ? 'bg-blue-600 text-white ml-auto' : 'bg-blue-100'}`;
    messageDiv.innerHTML = `<p class="text-sm">${message}</p>`;
    chatbotMessages.appendChild(messageDiv);
    chatbotMessages.scrollTop = chatbotMessages.scrollHeight;
  }
  
  function getChatbotResponse(message) {
    const lowerMessage = message.toLowerCase();
    
    for (const [key, response] of Object.entries(chatbotResponses)) {
      if (lowerMessage.includes(key)) {
        return response;
      }
    }
    
    return chatbotResponses.default;
  }
  
  function sendMessage() {
    const message = chatbotInput.value.trim();
    if (message) {
      addChatMessage(message, true);
      chatbotInput.value = '';
      
      // Simular respuesta del bot
      setTimeout(() => {
        const response = getChatbotResponse(message);
        addChatMessage(response);
      }, 1000);
    }
  }
  
  sendChatBtn.addEventListener('click', sendMessage);
  
  chatbotInput.addEventListener('keypress', function(e) {
    if (e.key === 'Enter') {
      sendMessage();
    }
  });
  
  // Escuchar mensajes del iframe para cerrar el modal
  window.addEventListener('message', function(event) {
    if (event.data === 'close-modal') {
      modal.close();
    }
  });
  
  // Animación CSS
  const style = document.createElement('style');
  style.textContent = `
    @keyframes fade-in {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    
    .animate-fade-in {
      animation: fade-in 0.3s ease-out;
    }
  `;
  document.head.appendChild(style);
</script>

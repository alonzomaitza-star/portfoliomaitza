---
import type { CollectionEntry } from 'astro:content';

export interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;

const categoryColors: Record<string, string> = {
  'Merchandising':  'bg-violet-500/20 text-violet-300 border-violet-400/30',
  'Branding':       'bg-amber-500/20  text-amber-300  border-amber-400/30',
  'Desarrollo':     'bg-blue-500/20   text-blue-300   border-blue-400/30',
  'E-Commerce':     'bg-emerald-500/20 text-emerald-300 border-emerald-400/30',
  'Contabilidad':   'bg-rose-500/20   text-rose-300   border-rose-400/30',
  'Marketing':      'bg-orange-500/20 text-orange-300 border-orange-400/30',
};
const defaultColor = 'bg-white/10 text-white/50 border-white/15';
---

<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
  {posts.map((post) => {
    const img = post.data.heroImage || post.data.image || null;
    const catColor = categoryColors[post.data.category] ?? defaultColor;
    return (
      <article class="group relative rounded-2xl border border-white/10 bg-white/5 backdrop-blur-sm overflow-hidden transition-all duration-300 hover:border-white/25 hover:bg-white/8 hover:shadow-xl hover:shadow-black/30 hover:-translate-y-0.5">
        <a href={`/blog/${post.slug}`} class="block h-full">

          {img ? (
            <div class="relative h-48 overflow-hidden">
              <img
                src={img}
                alt={post.data.title}
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
              {post.data.category && (
                <span class={`absolute bottom-3 left-3 inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold ${catColor}`}>
                  {post.data.category}
                </span>
              )}
            </div>
          ) : (
            <div class="relative h-32 bg-gradient-to-br from-white/5 to-white/10 flex items-center justify-center">
              <svg class="h-10 w-10 text-white/15" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
              </svg>
              {post.data.category && (
                <span class={`absolute bottom-3 left-3 inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold ${catColor}`}>
                  {post.data.category}
                </span>
              )}
            </div>
          )}

          <div class="p-5 flex flex-col gap-3">
            <h2 class="text-base font-bold text-white leading-snug line-clamp-2 group-hover:text-blue-200 transition-colors">
              {post.data.title}
            </h2>
            <p class="text-sm text-white/55 leading-relaxed line-clamp-2">
              {post.data.description}
            </p>
            <div class="flex items-center gap-2 text-xs text-white/35 mt-auto pt-2 border-t border-white/8">
              <time datetime={post.data.pubDate.toISOString()}>
                {new Date(post.data.pubDate).toLocaleDateString('es-ES', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                })}
              </time>
              <span class="text-white/20">•</span>
              <span>{post.data.readingTime} min</span>
            </div>
          </div>

        </a>
      </article>
    );
  })}
</div>

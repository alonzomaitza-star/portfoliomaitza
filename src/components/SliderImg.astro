---
const { imagenes } = Astro.props;
---

<div class="slider">
  {
    imagenes && imagenes.length > 0 ? (
      imagenes.map((img: { src: string }, index: number) => (
        <img src={img.src} alt={`Slider ${index + 1}`} />
      ))
    ) : (
      <p>No images</p>
    )
  }
</div>

<script>
  // Script para manejar el scroll automático
  const sliders = document.querySelectorAll(".slider");

  sliders.forEach((slider) => {
    setInterval(() => {
      const { scrollLeft, scrollWidth, clientWidth } = slider;
      // Si llegamos al final (con un pequeño margen de error), volvemos al inicio
      if (scrollLeft + clientWidth >= scrollWidth - 5) {
        slider.scrollTo({ left: 0, behavior: "smooth" });
      } else {
        // Si no, avanzamos una "página" (ancho del contenedor)
        slider.scrollBy({ left: clientWidth, behavior: "smooth" });
      }
    }, 3000); // Cambia cada 3 segundos
  });
</script>

<style>
  /* Slider estilos previos */
  .slider {
    aspect-ratio: 9 / 16;
    width: 100%;
    max-height: 100%;
    position: relative;
    display: flex;
    /* Ocultamos el scrollbar y deshabilitamos el scroll manual del usuario */
    overflow: hidden;
    scroll-snap-type: x mandatory;
    margin-top: -119px;
    scroll-behavior: smooth;
    /* overflow-y: hidden;  <-- Redundante con overflow: hidden global */
  }
  .slider img {
    width: 100%;
    min-width: 100%; /* Asegura que cada imagen ocupe todo el ancho */
    left: 0;
    position: sticky; /* position sticky puede ser innecesario con flex normal, pero lo dejamos por compatibilidad si es requerido */
    object-fit: cover;
    scroll-snap-align: center;
    max-height: 10-fit-content;
  }
  @media (min-width: 601px) {
    .slider {
      width: 400px;
      margin-top: 0;
      border-radius: 5px;
    }
  }
  @media (max-width: 600px) {
    .slider {
      width: 100%;
    }
  }
</style>

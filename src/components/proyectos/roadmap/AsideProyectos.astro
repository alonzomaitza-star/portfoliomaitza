---
interface Props {
  activeId?: string;
}

const { activeId = "" } = Astro.props;

// Lista de proyectos catalogados para el sidebar
const proyectosMenu = [
  {
    id: "invitaciones",
    nombre: "Invitaciones Digitales",
    icon: "mail",
    url: "/proyectos/proy?proyecto=invitaciones",
    demoUrl: "/proyectos/invitacionRuby",
    demoLabel: "Demo Ruby"
  },
  {
    id: "citas",
    nombre: "Gestor de Citas & WhatsApp",
    icon: "event",
    url: "/proyectos/proy?proyecto=citas",
    demoUrl: "/proyectos/barberia",
    demoLabel: "Demo Barbería"
  },
  {
    id: "escolar",
    nombre: "Control Escolar & App",
    icon: "school",
    url: "/proyectos/escolar"
  },
  {
    id: "lms",
    nombre: "Portal LMS",
    icon: "local_library",
    url: "/proyectos/proy?proyecto=lms"
  },
  {
    id: "ia",
    nombre: "IA & Agentes Virtuales",
    icon: "smart_toy",
    url: "/proyectos/proy?proyecto=ia"
  },
  {
    id: "saas",
    nombre: "DevOps & QA",
    icon: "settings_suggest",
    url: "/proyectos/proy?proyecto=saas"
  }
];
---

<aside
  class="w-full lg:w-64 shrink-0 lg:sticky lg:top-32 h-fit bg-slate-900/80 backdrop-blur-lg flex flex-col p-6 gap-2 z-10 rounded-2xl border border-slate-800"
>
  <!-- Header/Logo Area -->
  <div class="mb-6 px-3">
    <div class="flex items-center gap-2 mb-1">
      <span
        class="material-symbols-outlined text-blue-400 text-2xl"
        style="font-variation-settings: 'FILL' 1;">explore</span
      >
      <span
        class="font-manrope font-extrabold text-lg tracking-tight text-white"
        >Insano.</span
      >
    </div>
    <p
      class="text-[10px] text-slate-400 font-bold uppercase tracking-widest"
    >
      Proyectos & Demos
    </p>
  </div>

  <!-- Navigation Tabs -->
  <nav class="flex-1 flex flex-col gap-1">
    <div
      class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2 px-3"
    >
      Directorio
    </div>

    <!-- Active General View -->
    <div class="mb-4">
      <a
        class={`rounded-lg shadow-sm font-semibold flex items-center gap-3 p-3 transition-all duration-200 ease-out border ${
          activeId === "roadmap"
            ? "bg-slate-800 text-white border-slate-700"
            : "bg-slate-950/40 text-slate-350 border-slate-900 hover:text-white hover:bg-slate-900/50"
        }`}
        href="/proyectos/roadMap"
      >
        <span class="material-symbols-outlined text-sm text-blue-400">grid_view</span>
        <span class="font-inter text-sm font-bold">Catálogo General</span>
      </a>

      <!-- Sub-navigation for active project -->
      <div
        class="ml-4 mt-2 flex flex-col gap-1 border-l-2 border-slate-800/80 pl-4"
      >
        <a
          class="text-slate-400 hover:text-white flex items-center gap-2 p-2 text-xs rounded hover:bg-slate-800/50 transition-colors"
          href="/"
        >
          <span class="material-symbols-outlined text-[16px]">home</span>
          Volver al Home
        </a>
      </div>
    </div>

    <div
      class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2 px-3"
    >
      Proyectos
    </div>

    <div class="flex flex-col gap-2">
      {proyectosMenu.map((proj) => (
        <div class="flex flex-col">
          <a
            href={proj.url}
            class={`text-slate-300 hover:text-white hover:bg-slate-900/50 rounded-lg flex items-center gap-3 p-2.5 transition-all duration-200 ease-out ${
              activeId === proj.id ? "bg-slate-800/80 text-white border-l-4 border-blue-500 font-semibold" : "font-medium"
            }`}
          >
            <span class="material-symbols-outlined text-sm">{proj.icon}</span>
            <span class="font-inter text-xs truncate">{proj.nombre}</span>
          </a>
          
          {proj.demoUrl && (
            <div class="ml-8 mt-1 flex flex-col gap-0.5 border-l border-slate-800 pl-4">
              <a
                href={proj.demoUrl}
                class={`text-[11px] font-medium flex items-center gap-1.5 py-1 px-2 rounded transition-colors ${
                  activeId === proj.id + "-demo"
                    ? "text-emerald-400 font-bold bg-emerald-500/10"
                    : "text-slate-400 hover:text-emerald-300 hover:bg-slate-800/50"
                }`}
              >
                <span class="material-symbols-outlined text-[12px] text-emerald-400">play_circle</span>
                {proj.demoLabel}
              </a>
            </div>
          )}
        </div>
      ))}
    </div>
  </nav>

  <!-- Footer -->
  <div class="mt-6 pt-6 border-t border-slate-800">
    <a
      class="text-slate-300 hover:text-white hover:bg-slate-900/50 rounded-lg flex items-center gap-3 p-3 transition-all duration-200 ease-out hover:translate-x-1"
      href="#"
    >
      <span class="material-symbols-outlined">info</span>
      <span class="font-inter text-sm font-medium">Info de Galería</span>
    </a>
  </div>
</aside>

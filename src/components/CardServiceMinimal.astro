---
// Recibe un objeto servicio por prop
const { servicio } = Astro.props;
---

<!-- Tarjeta con diseño minimalista moderno -->
<li class="relative overflow-hidden bg-[#F5F5DC] border-l-4 border-blue-500 rounded-lg shadow-md hover:shadow-xl transition-all duration-300 group">
  <!-- Contenido de la tarjeta -->
  <div class="p-5 sm:p-6">
    <!-- Encabezado con icono y título -->
    <div class="flex items-center mb-4">
      <div class="p-2 mr-3 bg-blue-50 rounded-lg">
        <img 
          src={servicio.icono} 
          alt="" 
          class="w-8 h-8 object-contain" 
        />
      </div>
      <h3 class="text-lg sm:text-xl font-bold text-gray-800 group-hover:text-blue-600 transition-colors duration-300">
        {servicio.titulo}
      </h3>
    </div>
    
    <!-- Descripción -->
    <p class="text-sm text-gray-600 mb-5 line-clamp-3">
      {servicio.descripcion}
    </p>
    
    <!-- Línea divisoria con gradiente -->
    <div class="h-px w-full bg-gradient-to-r from-blue-500 to-purple-500 mb-5 opacity-70"></div>
    
    <!-- Características del servicio -->
    {servicio.caracteristicas && (
      <ul class="space-y-2 mb-6">
        {servicio.caracteristicas.map((caracteristica) => (
          <li class="flex items-start text-sm text-gray-700">
            <span class="text-blue-500 mr-2 mt-0.5">•</span>
            <span>{caracteristica}</span>
          </li>
        ))}
      </ul>
    )}
    
    <!-- Pie de tarjeta con precio y botón -->
    <div class="flex items-center justify-between mt-auto pt-4">
      {servicio.precio && (
        <div>
          <span class="text-blue-600 font-bold text-lg">${servicio.precio}</span>
          {servicio.periodo && <span class="text-gray-500 text-sm">/{servicio.periodo}</span>}
        </div>
      )}
      
      <button class="px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700 transition-colors duration-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
        Más info
      </button>
    </div>
  </div>
  
  <!-- Decoración de esquina -->
  <div class="absolute top-0 right-0 w-16 h-16 overflow-hidden">
    <div class="absolute top-0 right-0 w-16 h-16 bg-blue-500 transform rotate-45 translate-x-8 -translate-y-8"></div>
  </div>
</li>
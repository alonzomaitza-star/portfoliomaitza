</style>
<script>
  import { auth } from "../lib/firebase";
  import {
    GoogleAuthProvider,
    signInWithPopup,
    onAuthStateChanged,
    signOut,
  } from "firebase/auth";

  // DOM Elements
  const serviciosLink = document.getElementById("navbarmain-servicios-link");
  const serviciosMenu = document.getElementById("navbarmain-servicios-menu");

  // Servicios Menu functionality
  if (serviciosLink && serviciosMenu) {
    // Toggle on click (for mobile or sticky open)
    serviciosLink.addEventListener("click", (e) => {
      e.preventDefault();
      serviciosMenu.classList.toggle("hidden");
      const isExpanded = !serviciosMenu.classList.contains("hidden");
      serviciosLink.setAttribute("aria-expanded", isExpanded.toString());
    });

    // Close when clicking outside
    document.addEventListener("click", (e) => {
      const target = e.target as Node;
      if (
        !serviciosMenu.classList.contains("hidden") &&
        !serviciosMenu.contains(target) &&
        !serviciosLink.contains(target)
      ) {
        serviciosMenu.classList.add("hidden");
        serviciosLink.setAttribute("aria-expanded", "false");
      }
    });

    // Sync ARIA state on hover (optional, handled by CSS mostly)
    serviciosLink.addEventListener("mouseenter", () => {
      serviciosLink.setAttribute("aria-expanded", "true");
    });
    serviciosMenu.addEventListener("mouseleave", () => {
      // Only set false if we haven't clicked to open (checked by hidden class presence)
      if (serviciosMenu.classList.contains("hidden")) {
        serviciosLink.setAttribute("aria-expanded", "false");
      }
    });
  }

  // Tienda button — dispatch custom event to toggle WindowShop iframe
  const tiendaBtn = document.getElementById("tienda-btn");
  if (tiendaBtn) {
    tiendaBtn.addEventListener("click", (e) => {
      e.preventDefault();
      document.dispatchEvent(new CustomEvent("toggle-window-shop"));
    });
  }

  // Authentication Elements
  const authNotLogged = document.getElementById("auth-not-logged");
  const authLogged = document.getElementById("auth-logged");
  const googleLoginBtnDesktop = document.getElementById(
    "google-login-btn-desktop",
  );
  const googleLoginBtnMobile = document.getElementById(
    "google-login-btn-mobile",
  );
  const userAvatarBtn = document.getElementById("user-avatar-btn");
  const userLoggedDropdown = document.getElementById("user-logged-dropdown");
  const logoutBtn = document.getElementById("logout-btn");

  // User info elements
  const userAvatarImg = document.getElementById(
    "user-avatar-img",
  ) as HTMLImageElement | null;
  const userDisplayName = document.getElementById("user-display-name");
  const dropdownAvatar = document.getElementById(
    "dropdown-avatar",
  ) as HTMLImageElement | null;
  const dropdownName = document.getElementById("dropdown-name");
  const dropdownEmail = document.getElementById("dropdown-email");

  // Default avatar for users without photo
  const defaultAvatar =
    "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%23ffd600'%3E%3Cpath d='M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z'/%3E%3C/svg%3E";

  // Update UI based on user state
  function updateAuthUI(user: any) {
    if (user) {
      // User is signed in
      if (authNotLogged) authNotLogged.style.display = "none";
      if (authLogged) authLogged.style.display = "flex";

      const photoURL = user.photoURL || defaultAvatar;
      const displayName = user.displayName || "Usuario";
      const email = user.email || "";

      if (userAvatarImg) userAvatarImg.src = photoURL;
      if (userDisplayName)
        userDisplayName.textContent = displayName.split(" ")[0];
      if (dropdownAvatar) dropdownAvatar.src = photoURL;
      if (dropdownName) dropdownName.textContent = displayName;
      if (dropdownEmail) dropdownEmail.textContent = email;
    } else {
      // User is signed out
      if (authNotLogged) authNotLogged.style.display = "flex";
      if (authLogged) authLogged.style.display = "none";
    }
  }

  // Listen for auth state changes
  onAuthStateChanged(auth, (user) => {
    updateAuthUI(user);
  });

  // Google Sign In handler
  async function handleGoogleSignIn() {
    const provider = new GoogleAuthProvider();
    try {
      const result = await signInWithPopup(auth, provider);
      // Auth state observer will update the UI
    } catch (error: any) {
      console.error("Login error:", error);
      if (error.code !== "auth/popup-closed-by-user") {
        alert("Error al iniciar sesión. Por favor intenta de nuevo.");
      }
    }
  }

  // Attach login handlers
  if (googleLoginBtnDesktop) {
    googleLoginBtnDesktop.addEventListener("click", handleGoogleSignIn);
  }
  if (googleLoginBtnMobile) {
    googleLoginBtnMobile.addEventListener("click", handleGoogleSignIn);
  }

  // User avatar dropdown toggle
  if (userAvatarBtn && userLoggedDropdown) {
    userAvatarBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      const isExpanded = userAvatarBtn.getAttribute("aria-expanded") === "true";

      if (isExpanded) {
        userLoggedDropdown.classList.remove("active");
        userAvatarBtn.setAttribute("aria-expanded", "false");
      } else {
        userLoggedDropdown.classList.add("active");
        userAvatarBtn.setAttribute("aria-expanded", "true");
      }
    });

    // Close dropdown when clicking outside
    document.addEventListener("click", (e) => {
      const target = e.target as Node;
      if (
        userLoggedDropdown.classList.contains("active") &&
        !userLoggedDropdown.contains(target) &&
        target !== userAvatarBtn &&
        !userAvatarBtn.contains(target)
      ) {
        userLoggedDropdown.classList.remove("active");
        userAvatarBtn.setAttribute("aria-expanded", "false");
      }
    });
  }

  // Logout handler
  if (logoutBtn) {
    logoutBtn.addEventListener("click", async () => {
      try {
        await signOut(auth);
        // Auth state observer will update the UI
        // Close dropdown
        if (userLoggedDropdown) {
          userLoggedDropdown.classList.remove("active");
        }
        if (userAvatarBtn) {
          userAvatarBtn.setAttribute("aria-expanded", "false");
        }
      } catch (error) {
        console.error("Logout error:", error);
        alert("Error al cerrar sesión.");
      }
    });
  }

  // Mobile Menu Functionality
  const mobileMenuBtn = document.getElementById("mobile-menu-btn");
  const mobileMenuPanel = document.getElementById("mobile-menu-panel");
  const mobileMenuOverlay = document.getElementById("mobile-menu-overlay");
  const mobileMenuClose = document.getElementById("mobile-menu-close");
  const mobileServiciosBtn = document.getElementById("mobile-servicios-btn");
  const mobileServiciosSubmenu = document.getElementById("mobile-servicios-submenu");
  const mobileTiendaBtn = document.getElementById("mobile-tienda-btn");
  const mobileGoogleLoginBtn = document.getElementById("mobile-google-login-btn");

  function openMobileMenu() {
    if (mobileMenuPanel && mobileMenuOverlay) {
      mobileMenuPanel.classList.add("active");
      mobileMenuOverlay.classList.add("active");
      document.body.style.overflow = "hidden";
      if (mobileMenuBtn) {
        mobileMenuBtn.setAttribute("aria-expanded", "true");
      }
    }
  }

  function closeMobileMenu() {
    if (mobileMenuPanel && mobileMenuOverlay) {
      mobileMenuPanel.classList.remove("active");
      mobileMenuOverlay.classList.remove("active");
      document.body.style.overflow = "";
      if (mobileMenuBtn) {
        mobileMenuBtn.setAttribute("aria-expanded", "false");
      }
    }
  }

  if (mobileMenuBtn) {
    mobileMenuBtn.addEventListener("click", openMobileMenu);
  }

  if (mobileMenuClose) {
    mobileMenuClose.addEventListener("click", closeMobileMenu);
  }

  if (mobileMenuOverlay) {
    mobileMenuOverlay.addEventListener("click", closeMobileMenu);
  }

  // Mobile Servicios dropdown
  if (mobileServiciosBtn && mobileServiciosSubmenu) {
    mobileServiciosBtn.addEventListener("click", (e) => {
      e.preventDefault();
      const isExpanded = mobileServiciosBtn.getAttribute("aria-expanded") === "true";
      
      if (isExpanded) {
        mobileServiciosSubmenu.classList.remove("open");
        mobileServiciosBtn.setAttribute("aria-expanded", "false");
      } else {
        mobileServiciosSubmenu.classList.add("open");
        mobileServiciosBtn.setAttribute("aria-expanded", "true");
      }
    });
  }

  // Mobile Tienda button
  if (mobileTiendaBtn) {
    mobileTiendaBtn.addEventListener("click", (e) => {
      e.preventDefault();
      closeMobileMenu();
      document.dispatchEvent(new CustomEvent("toggle-window-shop"));
    });
  }

  // Mobile Google Login
  if (mobileGoogleLoginBtn) {
    mobileGoogleLoginBtn.addEventListener("click", () => {
      closeMobileMenu();
      handleGoogleSignIn();
    });
  }

  // Close mobile menu on link click
  const mobileNavLinks = document.querySelectorAll(".mobile-nav-link:not(.mobile-dropdown-btn)");
  mobileNavLinks.forEach((link) => {
    link.addEventListener("click", closeMobileMenu);
  });

  // Navbar Modal Close Button - Connect with WindowShop and Dashboard modals
  const navbarModalClose = document.getElementById("navbar-modal-close");
  const navbarModalOpenNewTab = document.getElementById("navbar-modal-open-new-tab");

  // Store current modal URL for opening in new tab
  let currentModalUrl = "";

  // Listen for WindowShop toggle events
  document.addEventListener("toggle-window-shop", () => {
    // Show/hide navbar buttons based on shop state
    setTimeout(() => {
      const shopOverlay = document.getElementById("window-shop-overlay");
      const shopIframe = document.getElementById("window-shop-iframe") as HTMLIFrameElement | null;
      if (shopOverlay && shopOverlay.classList.contains("active")) {
        if (navbarModalClose) navbarModalClose.style.display = "flex";
        if (navbarModalOpenNewTab) {
          currentModalUrl = shopIframe?.src || "";
          navbarModalOpenNewTab.style.display = "flex";
        }
      } else {
        if (navbarModalClose) navbarModalClose.style.display = "none";
        if (navbarModalOpenNewTab) navbarModalOpenNewTab.style.display = "none";
      }
    }, 100);
  });

  // Listen for dashboard admin overlay events
  const adminOverlay = document.getElementById("window-admin-overlay");
  const observer = new MutationObserver(() => {
    if (adminOverlay) {
      const adminIframe = document.getElementById("window-admin-iframe") as HTMLIFrameElement | null;
      if (adminOverlay.classList.contains("active")) {
        if (navbarModalClose) navbarModalClose.style.display = "flex";
        if (navbarModalOpenNewTab) {
          currentModalUrl = adminIframe?.src || "";
          navbarModalOpenNewTab.style.display = "flex";
        }
      } else {
        if (navbarModalClose) navbarModalClose.style.display = "none";
        if (navbarModalOpenNewTab) navbarModalOpenNewTab.style.display = "none";
      }
    }
  });

  if (adminOverlay) {
    observer.observe(adminOverlay, { attributes: true, attributeFilter: ["class"] });
  }

  // Close modals when navbar close button is clicked
  if (navbarModalClose) {
    navbarModalClose.addEventListener("click", () => {
      // Close WindowShop
      const shopOverlay = document.getElementById("window-shop-overlay");
      const shopIframe = document.getElementById("window-shop-iframe") as HTMLIFrameElement | null;
      if (shopOverlay?.classList.contains("active")) {
        shopOverlay.classList.remove("active");
        if (shopIframe) shopIframe.src = "";
        navbarModalClose.style.display = "none";
      }

      // Close Dashboard Admin
      const dashAdminOverlay = document.getElementById("window-admin-overlay");
      const dashAdminIframe = document.getElementById("window-admin-iframe") as HTMLIFrameElement | null;
      if (dashAdminOverlay?.classList.contains("active")) {
        dashAdminOverlay.classList.remove("active");
        if (dashAdminIframe) dashAdminIframe.src = "";
        navbarModalClose.style.display = "none";
      }

      // Hide open new tab button
      if (navbarModalOpenNewTab) navbarModalOpenNewTab.style.display = "none";
    });
  }

  // Open in new tab functionality
  if (navbarModalOpenNewTab) {
    navbarModalOpenNewTab.addEventListener("click", (e) => {
      e.preventDefault();
      if (currentModalUrl) {
        window.open(currentModalUrl, "_blank");
      }
    });
  }

  // Also listen for Escape key to hide navbar buttons
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      const shopOverlay = document.getElementById("window-shop-overlay");
      const adminOverlay2 = document.getElementById("window-admin-overlay");
      if ((!shopOverlay?.classList.contains("active")) && (!adminOverlay2?.classList.contains("active"))) {
        if (navbarModalClose) navbarModalClose.style.display = "none";
        if (navbarModalOpenNewTab) navbarModalOpenNewTab.style.display = "none";
      }
    }
  });
</script>

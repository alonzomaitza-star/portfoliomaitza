---
import Logo from "../assets/Logo.png";
import WindowShop from "./shop/WindowShop.astro";
---

<div class="nav-wrapper">
  <div class="nav-line nav-line-top"></div>
  <div class="wrapper-vertical">
    <div class="vertical-line left"></div>
    <div class="nav-vertical-content">
      <nav class="main-nav" aria-label="Navegación principal">
        <div class="nav-content">
          <!-- Logo + Hamburger container -->
          <div class="logo-hamburger-container">
            <a href="/" class="logo-area" aria-label="Inicio">
              <img src={Logo.src} alt="Insano Network Logo" class="logo" />
              <span class="sr-only">Insano Network</span>
            </a>

            <!-- Mobile Menu Button (Hamburger) -->
            <button
              id="mobile-menu-btn"
              class="mobile-menu-btn"
              aria-label="Abrir menú"
              aria-expanded="false"
              type="button"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="hamburger-icon"
              >
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
              </svg>
            </button>
          </div>
          <ul class="nav-links">
            <li><a href="/" class="inicio-link">Inicio</a></li>
            <li class="group relative">
              <a
                href="#"
                id="navbarmain-servicios-link"
                class="flex items-center gap-1 transition-colors hover:text-[#ffd600]"
                aria-haspopup="true"
                aria-expanded="false"
                >Servicios <span class="sr-only">Abrir menú</span></a
              >

              <!-- Dropdown Menu using Tailwind -->
              <div
                id="navbarmain-servicios-menu"
                class="absolute left-[-100px] z-50 hidden w-[100vw] max-w-[700px] transform rounded-[7px] bg-[#163233]/90 p-8 text-white shadow-[0_2px_16px_0_rgba(0,0,0,0.1)] backdrop-blur-[140px] hover:block group-hover:block"
              >
                <div class="w-full">
                  <h4 class="mb-6 text-xl font-bold text-white">
                    Nuestros Servicios
                  </h4>
                  <div class="flex flex-wrap justify-center gap-5">
                    <!-- Card: Emprender -->
                    <a
                      href="/emprender"
                      class="group/card flex h-[100px] w-[140px] flex-col items-center justify-center gap-2 rounded-[7px] border-[1.5px] border-white/10 bg-white/5 p-4 text-center shadow-lg transition-all duration-300 hover:-translate-y-1 hover:border-[#ffd600]/50 hover:bg-[#232728]/90 hover:shadow-xl"
                    >
                      <h5
                        class="m-0 text-[1.1rem] font-semibold text-white transition-colors group-hover/card:text-[#ffd600]"
                      >
                        Emprender
                      </h5>
                      <h6
                        class="m-0 mt-[-2px] text-[0.7rem] text-[#b0bfc0] transition-colors group-hover/card:text-white"
                      >
                        Emprende con nosotros
                      </h6>
                    </a>

                    <!-- Card: Diseño -->
                    <a
                      href="/diseno"
                      class="group/card flex h-[100px] w-[140px] flex-col items-center justify-center gap-2 rounded-[7px] border-[1.5px] border-white/10 bg-white/5 p-4 text-center shadow-lg transition-all duration-300 hover:-translate-y-1 hover:border-[#ffd600]/50 hover:bg-[#232728]/90 hover:shadow-xl"
                    >
                      <h5
                        class="m-0 text-[1.1rem] font-semibold text-white transition-colors group-hover/card:text-[#ffd600]"
                      >
                        Diseño
                      </h5>
                      <h6
                        class="m-0 mt-[-2px] text-[0.7rem] text-[#b0bfc0] transition-colors group-hover/card:text-white"
                      >
                        Diseño web y gráfico
                      </h6>
                    </a>

                    <!-- Card: Desarrollo -->
                    <a
                      href="/desarrollo"
                      class="group/card flex h-[100px] w-[140px] flex-col items-center justify-center gap-2 rounded-[7px] border-[1.5px] border-white/10 bg-white/5 p-4 text-center shadow-lg transition-all duration-300 hover:-translate-y-1 hover:border-[#ffd600]/50 hover:bg-[#232728]/90 hover:shadow-xl"
                    >
                      <h5
                        class="m-0 text-[1.1rem] font-semibold text-white transition-colors group-hover/card:text-[#ffd600]"
                      >
                        Desarrollo
                      </h5>
                      <h6
                        class="m-0 mt-[-2px] text-[0.7rem] text-[#b0bfc0] transition-colors group-hover/card:text-white"
                      >
                        Desarrollo web y móvil
                      </h6>
                    </a>

                    <!-- Card: Marketing -->
                    <a
                      href="/marketing"
                      class="group/card flex h-[100px] w-[140px] flex-col items-center justify-center gap-2 rounded-[7px] border-[1.5px] border-white/10 bg-white/5 p-4 text-center shadow-lg transition-all duration-300 hover:-translate-y-1 hover:border-[#ffd600]/50 hover:bg-[#232728]/90 hover:shadow-xl"
                    >
                      <h5
                        class="m-0 text-[1.1rem] font-semibold text-white transition-colors group-hover/card:text-[#ffd600]"
                      >
                        Marketing
                      </h5>
                      <h6
                        class="m-0 mt-[-2px] text-[0.7rem] text-[#b0bfc0] transition-colors group-hover/card:text-white"
                      >
                        Marketing digital y SEO
                      </h6>
                    </a>

                    <!-- Card: Contable -->
                    <a
                      href="/contable"
                      class="group/card flex h-[100px] w-[140px] flex-col items-center justify-center gap-2 rounded-[7px] border-[1.5px] border-white/10 bg-white/5 p-4 text-center shadow-lg transition-all duration-300 hover:-translate-y-1 hover:border-[#ffd600]/50 hover:bg-[#232728]/90 hover:shadow-xl"
                    >
                      <h5
                        class="m-0 text-[1.1rem] font-semibold text-white transition-colors group-hover/card:text-[#ffd600]"
                      >
                        Contable
                      </h5>
                      <h6
                        class="m-0 mt-[-2px] text-[0.7rem] text-[#b0bfc0] transition-colors group-hover/card:text-white"
                      >
                        Contable digital y virtual
                      </h6>
                    </a>

                    <!-- Card: E-commerce -->
                    <a
                      href="/ecommerce"
                      class="group/card flex h-[100px] w-[140px] flex-col items-center justify-center gap-2 rounded-[7px] border-[1.5px] border-white/10 bg-white/5 p-4 text-center shadow-lg transition-all duration-300 hover:-translate-y-1 hover:border-[#ffd600]/50 hover:bg-[#232728]/90 hover:shadow-xl"
                    >
                      <h5
                        class="m-0 text-[1.1rem] font-semibold text-white transition-colors group-hover/card:text-[#ffd600]"
                      >
                        E-commerce
                      </h5>
                      <h6
                        class="m-0 mt-[-2px] text-[0.7rem] text-[#b0bfc0] transition-colors group-hover/card:text-white"
                      >
                        E-commerce digital y móvil
                      </h6>
                    </a>

                    <!-- Card: Cursos -->
                    <a
                      href="/cursos"
                      class="group/card flex h-[100px] w-[140px] flex-col items-center justify-center gap-2 rounded-[7px] border-[1.5px] border-white/10 bg-white/5 p-4 text-center shadow-lg transition-all duration-300 hover:-translate-y-1 hover:border-[#ffd600]/50 hover:bg-[#232728]/90 hover:shadow-xl"
                    >
                      <h5
                        class="m-0 text-[1.1rem] font-semibold text-white transition-colors group-hover/card:text-[#ffd600]"
                      >
                        Cursos
                      </h5>
                      <h6
                        class="m-0 mt-[-2px] text-[0.7rem] text-[#b0bfc0] transition-colors group-hover/card:text-white"
                      >
                        Cursos online y presenciales
                      </h6>
                    </a>

                    <!-- Card: Capacitación -->
                    <a
                      href="/capacitacion"
                      class="group/card flex h-[100px] w-[140px] flex-col items-center justify-center gap-2 rounded-[7px] border-[1.5px] border-white/10 bg-white/5 p-4 text-center shadow-lg transition-all duration-300 hover:-translate-y-1 hover:border-[#ffd600]/50 hover:bg-[#232728]/90 hover:shadow-xl"
                    >
                      <h5
                        class="m-0 text-[1.1rem] font-semibold text-white transition-colors group-hover/card:text-[#ffd600]"
                      >
                        Capacitación
                      </h5>
                      <h6
                        class="m-0 mt-[-2px] text-[0.7rem] text-[#b0bfc0] transition-colors group-hover/card:text-white"
                      >
                        Capacitación online y presencial
                      </h6>
                    </a>
                  </div>
                </div>
              </div>
            </li>
            <li><a href="/nosotros">Conócenos</a></li>
            <li><a href="/fundaciones">Fundaciones</a></li>
            <li><a href="/herramientas">Herramientas</a></li>
            <li><a href="/blog">Blog</a></li>
            <li>
              <a href="/beneficios" class="beneficios-link">Beneficios</a>
            </li>
            <li
              class="bg-yellow-500 text-black hover:bg-yellow-600 hover:text-white py-1 px-2 rounded-[7px]"
            >
              <button
                id="tienda-btn"
                class="tienda-link inline-flex items-center gap-2"
                aria-label="Abrir Tienda"
                type="button"
                ><svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="feather feather-shopping-cart"
                  ><circle cx="9" cy="21" r="1"></circle><circle
                    cx="20"
                    cy="21"
                    r="1"></circle><path
                    d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"
                  ></path></svg
                >Tienda
              </button>
            </li>
          </ul>
          <div class="nav-actions" aria-label="Acciones de usuario">
            <!-- Estado: No autenticado -->
            <div id="auth-not-logged" class="auth-state">
              <div class="desktop-auth-buttons">
                <button
                  id="google-login-btn-desktop"
                  class="google-login-btn"
                  role="button"
                >
                  <svg
                    class="google-icon"
                    viewBox="0 0 24 24"
                    width="18"
                    height="18"
                  >
                    <path
                      d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
                      fill="#4285F4"></path>
                    <path
                      d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                      fill="#34A853"></path>
                    <path
                      d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
                      fill="#FBBC05"></path>
                    <path
                      d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
                      fill="#EA4335"></path>
                  </svg>
                  Iniciar Sesión
                </button>
              </div>
              <div class="mobile-auth-button">
                <button
                  id="google-login-btn-mobile"
                  class="user-button"
                  aria-label="Iniciar sesión"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="feather feather-user"
                    ><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"
                    ></path><circle cx="12" cy="7" r="4"></circle></svg
                  >
                </button>
              </div>
            </div>

            <!-- Estado: Autenticado -->
            <div id="auth-logged" class="auth-state" style="display: none;">
              <div class="user-logged-container">
                <button
                  id="user-avatar-btn"
                  class="user-avatar-btn"
                  aria-haspopup="menu"
                  aria-expanded="false"
                >
                  <img
                    id="user-avatar-img"
                    src=""
                    alt="Avatar"
                    class="user-avatar-img"
                  />
                  <span id="user-display-name" class="user-display-name"></span>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="chevron-icon"
                    ><polyline points="6 9 12 15 18 9"></polyline></svg
                  >
                </button>
                <div id="user-logged-dropdown" class="user-menu-dropdown">
                  <div class="user-menu-header">
                    <img
                      id="dropdown-avatar"
                      src=""
                      alt="Avatar"
                      class="dropdown-avatar"
                    />
                    <div class="dropdown-user-info">
                      <span id="dropdown-name" class="dropdown-name"></span>
                      <span id="dropdown-email" class="dropdown-email"></span>
                    </div>
                  </div>
                  <div class="user-menu-divider"></div>
                  <div class="user-menu-options">
                    <a href="/dashboard" class="user-menu-option">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><rect x="3" y="3" width="7" height="7"></rect><rect
                          x="14"
                          y="3"
                          width="7"
                          height="7"></rect><rect
                          x="14"
                          y="14"
                          width="7"
                          height="7"></rect><rect
                          x="3"
                          y="14"
                          width="7"
                          height="7"></rect></svg
                      >
                      Mi Dashboard
                    </a>
                    <button
                      id="logout-btn"
                      class="user-menu-option logout-option"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"
                        ></path><polyline points="16 17 21 12 16 7"
                        ></polyline><line x1="21" y1="12" x2="9" y2="12"
                        ></line></svg
                      >
                      Cerrar Sesión
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Modal Close Button (for iframe modals) -->
          <button
            id="navbar-modal-close"
            class="navbar-modal-close"
            aria-label="Cerrar"
            type="button"
            style="display: none;"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>

          <!-- Modal Open New Tab Button -->
          <a
            id="navbar-modal-open-new-tab"
            class="navbar-modal-open-new-tab"
            aria-label="Abrir en nueva pestaña"
            style="display: none;"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
          </a>
        </div>
      </nav>
    </div>
    <div class="vertical-line right"></div>
  </div>
  <div class="nav-line nav-line-bottom"></div>
</div>
<WindowShop />

<!-- Mobile Slide Menu Overlay -->
<div id="mobile-menu-overlay" class="mobile-menu-overlay"></div>

<!-- Mobile Slide Menu Panel -->
<div id="mobile-menu-panel" class="mobile-menu-panel">
  <div class="mobile-menu-header">
    <span class="mobile-menu-title">Menú</span>
    <button
      id="mobile-menu-close"
      class="mobile-menu-close"
      aria-label="Cerrar menú"
      type="button"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>
  <ul class="mobile-nav-links">
    <li>
      <a href="/" class="mobile-nav-link">Inicio</a>
    </li>
    <li class="mobile-nav-item">
      <button
        id="mobile-servicios-btn"
        class="mobile-nav-link mobile-dropdown-btn"
        aria-expanded="false"
        type="button"
      >
        Servicios
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="dropdown-arrow"
        >
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </button>
      <ul id="mobile-servicios-submenu" class="mobile-submenu">
        <li><a href="/emprender" class="mobile-submenu-link">Emprender</a></li>
        <li><a href="/diseno" class="mobile-submenu-link">Diseño</a></li>
        <li><a href="/desarrollo" class="mobile-submenu-link">Desarrollo</a></li>
        <li><a href="/marketing" class="mobile-submenu-link">Marketing</a></li>
        <li><a href="/contable" class="mobile-submenu-link">Contable</a></li>
        <li><a href="/ecommerce" class="mobile-submenu-link">E-commerce</a></li>
        <li><a href="/cursos" class="mobile-submenu-link">Cursos</a></li>
        <li><a href="/capacitacion" class="mobile-submenu-link">Capacitación</a></li>
      </ul>
    </li>
    <li>
      <a href="/nosotros" class="mobile-nav-link">Conócenos</a>
    </li>
    <li>
      <a href="/fundaciones" class="mobile-nav-link">Fundaciones</a>
    </li>
    <li>
      <a href="/herramientas" class="mobile-nav-link">Herramientas</a>
    </li>
    <li>
      <a href="/blog" class="mobile-nav-link">Blog</a>
    </li>
    <li>
      <a href="/beneficios" class="mobile-nav-link">Beneficios</a>
    </li>
    <li>
      <button id="mobile-tienda-btn" class="mobile-nav-link mobile-tienda-btn" type="button">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
        Tienda
      </button>
    </li>
  </ul>
  <div class="mobile-menu-auth">
    <button id="mobile-google-login-btn" class="mobile-google-login-btn">
      <svg class="google-icon" viewBox="0 0 24 24" width="18" height="18">
        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"></path>
        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"></path>
        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"></path>
        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"></path>
      </svg>
      Iniciar Sesión
    </button>
  </div>
</div>
<style>
  .navbarmain-card-descripcion {
    font-size: 0.7rem;
    margin-top: -10px;
  }

  .nav-wrapper {
    width: 80vw;
    max-width: 1100px;
    margin: 0 auto;
    z-index: 100;
    position: sticky;
    top: 25px;
    transition:
      border-radius 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      background 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .main-nav {
    margin: 0 auto;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 101;
    background: rgba(22, 50, 51, 0.5);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 2px 16px 0 rgba(0, 0, 0, 0.1);
    border-radius: 0;
    display: flex;
    justify-content: center;
    font-family: "Atkinson", sans-serif;
    box-sizing: border-box;
    transition:
      border-radius 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      background 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .nav-content {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.25rem 1.5rem;
    margin: 0 auto;

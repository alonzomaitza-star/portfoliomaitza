---
import { getTwitchEmbedData } from '../../lib/twitch';
import { getTwitchVODs } from '../../lib/twitch';
import { getKickLiveStatus } from '../../lib/kick';
import { getYouTubeLiveStatus } from '../../lib/youtube';
import { getYouTubePlaylistData } from '../../lib/youtube-playlist';
import SafeEmbed from '../SafeEmbed.astro';

// Fetch data
const twitchData = await getTwitchEmbedData();
const twitchVODs = await getTwitchVODs(10);
const kickData = await getKickLiveStatus();
const youtubeData = await getYouTubeLiveStatus();
const playlistData = await getYouTubePlaylistData();

// Determine initial video
const initialVideoId = youtubeData.isLive
    ? youtubeData.liveVideoId
    : playlistData.courseVideos[0]?.id || "4Ojg5y6Oq3Y";

const isLiveInitially = youtubeData.isLive || false;
---

<!-- Navigation Hub - Componente Unificado -->
<section id="navigation-hub" class="py-16 relative">
  <div class="container mx-auto px-4">
    <div class="text-center mb-10">
      <h2 class="text-3xl md:text-4xl font-bold mb-4 text-white">
        Conecta con Insano Network
      </h2>
      <p class="text-xl text-slate-300">Streaming, redes sociales y equipo en un solo lugar</p>
    </div>

    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-12">
      <!-- Streaming Section -->
      <div class="lg:col-span-2">
        <div class="bg-slate-800/50 backdrop-blur-md border border-slate-700 rounded-2xl p-6">
          <h3 class="text-2xl font-bold text-white mb-6 flex items-center gap-3">
            <div class="w-10 h-10 bg-gradient-to-r from-purple-500 to-blue-500 rounded-lg flex items-center justify-center">
              <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/>
              </svg>
            </div>
            Streaming en Vivo
          </h3>

          <!-- Stream Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- Twitch Stream -->
            <div class="bg-slate-900/50 rounded-xl overflow-hidden">
              <div class="relative aspect-video bg-black">
                {twitchData.isLive ? (
                  <iframe
                    height="100%"
                    width="100%"
                    allowfullscreen
                    class="absolute inset-0 w-full h-full"
                    src={`https://player.twitch.tv/?channel=${twitchData.channelName}&parent=localhost&parent=127.0.0.1&parent=insano.network&parent=insanonetwork.com&muted=false&autoplay=true`}
                  ></iframe>
                ) : (
                  <div class="absolute inset-0 bg-slate-900 flex items-center justify-center">
                    <div class="text-center">
                      <div class="w-12 h-12 bg-[#9146FF]/20 rounded-full flex items-center justify-center mx-auto mb-3">
                        <svg class="w-6 h-6 text-[#9146FF]" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M11.571 4.714h1.715v5.143H11.57zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h2.998L22.285 11.571V0zm14.571 11.143l-3.428 3.428h-3.429l-3 3v-3H6.857V1.714h13.714Z"/>
                        </svg>
                      </div>
                      <p class="text-white text-sm font-semibold">No estamos en vivo</p>
                    </div>
                  </div>
                )}
              </div>
              <div class="p-3">
                <h4 class="text-white font-semibold mb-1">Twitch</h4>
                <p class="text-slate-400 text-sm mb-2">{twitchData.isLive ? 'En vivo ahora' : 'Últimos VODs'}</p>
                <a 
                  href={twitchData.isLive ? `https://www.twitch.tv/${twitchData.channelName}` : `https://www.twitch.tv/videos/${twitchData.latestVideoId}`}
                  target="_blank"
                  rel="noopener"
                  class="inline-block px-3 py-1 bg-[#9146FF] text-white text-sm rounded-lg hover:bg-[#772ce8] transition-colors"
                >
                  {twitchData.isLive ? 'Ver en Twitch' : 'Ver Último Video'}
                </a>
              </div>
            </div>

            <!-- YouTube Stream -->
            <div class="bg-slate-900/50 rounded-xl overflow-hidden">
              <div class="relative aspect-video bg-black">
                <SafeEmbed
                  videoId={initialVideoId}
                  title="Insano Network YouTube"
                  class="absolute inset-0 w-full h-full"
                />
              </div>
              <div class="p-3">
                <h4 class="text-white font-semibold mb-1">YouTube</h4>
                <p class="text-slate-400 text-sm mb-2">{isLiveInitially ? 'En vivo ahora' : 'Capacitaciones y cursos'}</p>
                <a 
                  href="https://www.youtube.com/@insanonetwork"
                  target="_blank"
                  rel="noopener"
                  class="inline-block px-3 py-1 bg-red-600 text-white text-sm rounded-lg hover:bg-red-500 transition-colors"
                >
                  Ver en YouTube
                </a>
              </div>
            </div>
          </div>

          <!-- Premium Button -->
          <div class="mt-6 text-center">
            <a 
              href="/beneficios"
              class="inline-block px-6 py-3 bg-gradient-to-r from-purple-600 to-blue-600 text-white rounded-lg font-semibold hover:from-purple-500 hover:to-blue-500 transition-all transform hover:scale-105 shadow-lg hover:shadow-purple-500/25"
            >
              🎯 Obtener Beneficios Premium
            </a>
          </div>
        </div>
      </div>

      <!-- Team & Contact Section -->
      <div class="space-y-6">
        <!-- Team Card -->
        <div class="bg-slate-800/50 backdrop-blur-md border border-slate-700 rounded-2xl p-6">
          <h3 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
            <div class="w-8 h-8 bg-gradient-to-r from-green-500 to-teal-500 rounded-lg flex items-center justify-center">
              <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                <path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-3a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v3h-3zM4.75 12.094A5.973 5.973 0 004 15v3H1v-3a3 3 0 013.75-2.906z"/>
              </svg>
            </div>
            Nuestro Equipo
          </h3>
          
          <div class="space-y-3">
            <div class="bg-slate-900/50 rounded-lg p-3">
              <h4 class="text-white font-semibold text-sm">Desarrollo & Diseño</h4>
              <p class="text-slate-400 text-xs mt-1">Portafolios y proyectos del equipo</p>
              <a href="#" class="inline-block mt-2 text-blue-400 text-xs hover:text-blue-300">Ver portafolios →</a>
            </div>
            
            <div class="bg-slate-900/50 rounded-lg p-3">
              <h4 class="text-white font-semibold text-sm">Marketing & Contenido</h4>
              <p class="text-slate-400 text-xs mt-1">Estrategias y creación de contenido</p>
              <a href="#" class="inline-block mt-2 text-purple-400 text-xs hover:text-purple-300">Ver proyectos →</a>
            </div>
          </div>
        </div>

        <!-- Contact Card -->
        <div class="bg-slate-800/50 backdrop-blur-md border border-slate-700 rounded-2xl p-6">
          <h3 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
            <div class="w-8 h-8 bg-gradient-to-r from-blue-500 to-cyan-500 rounded-lg flex items-center justify-center">
              <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"/>
                <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"/>
              </svg>
            </div>
            Contacto
          </h3>
          
          <div class="space-y-3 text-sm">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
              </svg>
              <span class="text-slate-300">(+52) 55 1684 9340</span>
            </div>
            
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
                <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"/>
                <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"/>
              </svg>
              <span class="text-slate-300">insanonetworking@gmail.com</span>
            </div>
            
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-purple-400" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.372-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              <span class="text-slate-300">@InsanoNetwork</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Floating Navigation Menu -->
<div class="fixed right-6 top-1/2 -translate-y-1/2 z-40 hidden lg:block">
  <div class="bg-slate-900/90 backdrop-blur-md border border-slate-700 rounded-2xl p-4 shadow-2xl">
    <h4 class="text-white text-sm font-semibold mb-4 text-center">Navegación Rápida</h4>
    
    <div class="space-y-3">
      <!-- GitHub -->
      <a 
        href="https://github.com/insanonetwork" 
        target="_blank"
        rel="noopener"
        class="block w-10 h-10 bg-slate-800 hover:bg-slate-700 rounded-lg flex items-center justify-center text-white transition-all hover:scale-110 group"
        title="GitHub"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
      </a>

      <!-- Discord -->
      <a 
        href="#" 
        class="block w-10 h-10 bg-slate-800 hover:bg-slate-700 rounded-lg flex items-center justify-center text-white transition-all hover:scale-110 group"
        title="Discord"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515a.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0a12.64 12.64 0 0 0-.617-1.25a.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057a19.9 19.9 0 0 0 5.993 3.03a.078.078 0 0 0 .084-.028a14.09 14.09 0 0 0 1.226-1.994a.076.076 0 0 0-.041-.106a13.107 13.107 0 0 1-1.872-.892a.077.077 0 0 1-.008-.128a10.2 10.2 0 0 0 .372-.292a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127a12.299 12.299 0 0 1-1.873.892a.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028a19.839 19.839 0 0 0 6.002-3.03a.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.956-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.955-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.946 2.418-2.157 2.418z"/>
        </svg>
      </a>

      <!-- Team Portfolios -->
      <a 
        href="#team" 
        class="block w-10 h-10 bg-slate-800 hover:bg-slate-700 rounded-lg flex items-center justify-center text-white transition-all hover:scale-110 group"
        title="Equipo"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
          <path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-3a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v3h-3zM4.75 12.094A5.973 5.973 0 004 15v3H1v-3a3 3 0 013.75-2.906z"/>
        </svg>
      </a>

      <!-- Contact -->
      <a 
        href="#contact" 
        class="block w-10 h-10 bg-slate-800 hover:bg-slate-700 rounded-lg flex items-center justify-center text-white transition-all hover:scale-110 group"
        title="Contacto"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
          <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"/>
          <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"/>
        </svg>
      </a>

      <!-- WhatsApp -->
      <a 
        href="https://wa.me/525516849340" 
        target="_blank"
        rel="noopener"
        class="block w-10 h-10 bg-green-600 hover:bg-green-500 rounded-lg flex items-center justify-center text-white transition-all hover:scale-110 group"
        title="WhatsApp"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.149-.67.149-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414-.074-.123-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
      </a>
    </div>
  </div>
</div>

<style>
  /* Animaciones para el menú flotante */
  .fixed.right-6.top-1\/2 div a:hover {
    transform: scale(1.1);
  }
  
  /* Responsive */
  @media (max-width: 1023px) {
    .fixed.right-6.top-1\/2 {
      display: none;
    }
  }
</style>
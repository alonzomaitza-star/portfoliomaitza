---
// Componente de ChatBot Flotante y Agente de Recolección de Datos
---

<!-- ChatBot Flotante -->
<div class="chatbot-container fixed bottom-6 left-6 z-[9999]">
  <!-- Botón Flotante (Círculo de Conversación) -->
  <button
    id="chatbot-toggle"
    class="chatbot-toggle w-14 h-14 bg-gradient-to-r from-blue-600 to-purple-600 rounded-full flex items-center justify-center text-white shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-110 group"
    aria-label="Abrir chat"
    aria-expanded="false"
  >
    <!-- Icono de Chat -->
    <svg
      class="w-7 h-7 transition-transform duration-300 group-hover:rotate-12"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
      ></path>
    </svg>

    <!-- Indicador de Notificación -->
    <span
      class="absolute -top-1 -right-1 w-3.5 h-3.5 bg-green-500 rounded-full border-2 border-[#09090b] animate-pulse"
    ></span>
  </button>

  <!-- Dialog Modal del Chat -->
  <dialog
    id="chatbot-dialog"
    class="chatbot-dialog fixed bottom-24 left-6 w-80 h-[450px] md:w-96 md:h-[550px] bg-[#09090b]/95 backdrop-blur-xl border border-white/10 rounded-2xl shadow-2xl p-0 opacity-0 scale-95 transition-all duration-300 z-[9999] overflow-hidden"
  >
    <!-- Header del Chat -->
    <div
      class="bg-white/5 px-4 py-3 border-b border-white/10 flex items-center justify-between"
    >
      <div class="flex items-center gap-3">
        <div
          class="w-9 h-9 rounded-full bg-gradient-to-tr from-blue-600 to-purple-600 flex items-center justify-center shadow-inner"
        >
          <svg
            class="w-5 h-5 text-white"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path d="M2 10a8 8 0 018-8v8h8a8 8 0 11-16 0z"></path>
            <path d="M12 2.252A8.014 8.014 0 0117.748 8H12V2.252z"></path>
          </svg>
        </div>
        <div>
          <h4 class="font-bold text-white text-sm tracking-wide">
            Insano Assistant
          </h4>
          <p
            class="text-[10px] text-green-400 flex items-center gap-1.5 font-medium uppercase tracking-wider"
          >
            <span
              class="w-1.5 h-1.5 rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.5)]"
            ></span> Online
          </p>
        </div>
      </div>

      <!-- Botón Cerrar -->
      <button
        id="chatbot-close"
        class="w-8 h-8 rounded-full hover:bg-white/10 flex items-center justify-center text-slate-400 hover:text-white transition-colors"
        aria-label="Cerrar chat"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Body del Chat -->
    <div
      id="chat-body"
      class="flex-1 p-4 h-[330px] md:h-[430px] overflow-y-auto scrollbar-thin scrollbar-thumb-white/10 scrollbar-track-transparent"
    >
      <!-- Los mensajes se inyectan dinámicamente aquí -->
      <div id="chat-messages" class="space-y-4"></div>

      <!-- Indicador de escribiendo (oculto por defecto) -->
      <div id="typing-indicator" class="hidden mt-4 pl-2">
        <div class="flex gap-1">
          <span
            class="w-2 h-2 bg-slate-500 rounded-full animate-bounce [animation-delay:-0.3s]"
          ></span>
          <span
            class="w-2 h-2 bg-slate-500 rounded-full animate-bounce [animation-delay:-0.15s]"
          ></span>
          <span class="w-2 h-2 bg-slate-500 rounded-full animate-bounce"></span>
        </div>
      </div>
    </div>

    <!-- Input del Chat -->
    <div class="p-3 border-t border-white/10 bg-white/5">
      <div class="relative flex items-center gap-2">
        <input
          type="text"
          id="chat-input"
          placeholder="Escribe tu mensaje..."
          class="w-full bg-[#09090b] border border-white/10 rounded-full py-2.5 px-4 text-slate-200 text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500/50 transition-all placeholder:text-slate-600 disabled:opacity-50 disabled:cursor-not-allowed"
        />
        <button
          id="chat-send"
          class="w-10 h-10 bg-blue-600 hover:bg-blue-500 rounded-full flex items-center justify-center text-white transition-all shadow-lg hover:scale-105 disabled:opacity-50 disabled:scale-100 disabled:cursor-not-allowed"
        >
          <svg
            class="w-4 h-4 translate-x-0.5"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z"
            ></path>
          </svg>
        </button>
      </div>
      <p class="text-center text-[10px] text-slate-500 mt-2 font-medium">
        Powered by Insano AI
      </p>
    </div>
  </dialog>
</div>

<style>
  /* Animación de entrada/salida para el Dialog */
  .chatbot-dialog {
    display: flex;
    flex-direction: column;
  }

  .chatbot-dialog[open] {
    opacity: 1;
    scale: 1;
  }

  /* Responsive Positioning */
  @media (max-width: 767px) {
    .chatbot-dialog {
      bottom: 0;
      left: 0;
      right: 0;
      width: 100vw !important;
      height: 100dvh !important;
      border-radius: 0;
      border: none;
    }

    .chatbot-toggle {
      bottom: 20px;
      right: 20px;
      left: auto;
    }
  }

  /* Custom Scrollbar */
  .scrollbar-thin::-webkit-scrollbar {
    width: 4px;
  }
  .scrollbar-thin::-webkit-scrollbar-thumb {
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
  }
</style>

<script>
  // -- Lógica del ChatBot / Agente --

  // Tipos para el estado del agente
  type AgentState = "INIT" | "ASK_NAME" | "ASK_DETAILS" | "CLOSING" | "DONE";

  interface UserData {
    name?: string;
    interest?: string;
    details?: string;
  }

  // --- Element References ---
  let dialog: HTMLDialogElement | null = null;
  let chatMessages: HTMLElement | null = null;
  let chatInput: HTMLInputElement | null = null;
  let sendBtn: HTMLButtonElement | null = null;
  let typingIndicator: HTMLElement | null = null;
  let chatBody: HTMLElement | null = null;

  // --- State ---
  let currentState: AgentState = "INIT";
  let userData: UserData = {};
  let isTyping = false;
  let hasGreeted = false;

  console.log("[ChatBot] Script Loaded");

  // Inicialización
  function init() {
    console.log("[ChatBot] Init sequence started");
    initChatElements();
    setupEventListeners();
  }

  // Support for ViewTransitions
  document.addEventListener("astro:page-load", () => {
    console.log("[ChatBot] astro:page-load detected");
    init();
  });

  // Fallback for standard load
  if (
    document.readyState === "complete" ||
    document.readyState === "interactive"
  ) {
    console.log("[ChatBot] document already ready, initializing");
    init();
  } else {
    window.addEventListener("load", () => {
      console.log("[ChatBot] window.load event");
      init();
    });
    document.addEventListener("DOMContentLoaded", () => {
      console.log("[ChatBot] DOMContentLoaded event");
      init();
    });
  }

  function initChatElements() {
    dialog = document.getElementById("chatbot-dialog") as HTMLDialogElement;
    chatMessages = document.getElementById("chat-messages");
    chatInput = document.getElementById("chat-input") as HTMLInputElement;
    sendBtn = document.getElementById("chat-send") as HTMLButtonElement;
    typingIndicator = document.getElementById("typing-indicator");
    chatBody = document.getElementById("chat-body");

    console.log("[ChatBot] Elements initialized:", {
      hasDialog: !!dialog,
      hasMessages: !!chatMessages,
      hasToggle: !!document.getElementById("chatbot-toggle"),
    });
  }

  function setupEventListeners() {
    const toggleBtn = document.getElementById("chatbot-toggle");
    const closeBtn = document.getElementById("chatbot-close");

    if (!toggleBtn || !dialog) {
      console.warn(
        "[ChatBot] Critical elements missing, cannot setup listeners",
      );
      return;
    }

    // Toggle Chat
    // Remove old listeners to prevent duplicates if hot reload happens (basic attempt)
    const newToggle = toggleBtn.cloneNode(true) as HTMLElement;
    toggleBtn.parentNode?.replaceChild(newToggle, toggleBtn);

    newToggle.addEventListener("click", (e) => {
      console.log("[ChatBot] Toggle clicked");
      if (dialog?.open) {
        closeChat();
      } else {
        openChat();
      }
    });

    if (closeBtn) {
      closeBtn.addEventListener("click", () => {
        console.log("[ChatBot] Close clicked");
        closeChat();
      });
    }

    // Send Message Logic
    const handleSend = () => {
      if (!chatInput) return;
      const text = chatInput.value.trim();
      if (text) {
        addUserMessage(text);
        chatInput.value = "";
        processUserInput(text);
      }
    };

    if (sendBtn) sendBtn.addEventListener("click", handleSend);

    if (chatInput) {
      chatInput.addEventListener("keypress", (e) => {
        if (e.key === "Enter") handleSend();
      });
    }
  }

  function openChat() {
    if (!dialog) return;
    try {
      dialog.showModal();
      const toggleBtn = document.getElementById("chatbot-toggle");
      toggleBtn?.setAttribute("aria-expanded", "true");

      console.log("[ChatBot] Dialog opened");

      // Si es la primera vez que abre, iniciar conversación
      if (!hasGreeted) {
        hasGreeted = true;
        currentState = "INIT";
        runAgentFlow();
      }

      setTimeout(() => chatInput?.focus(), 100);
    } catch (e) {
      console.error("[ChatBot] Error opening dialog:", e);
    }
  }

  function closeChat() {
    if (!dialog) return;
    try {
      dialog.close();
      const toggleBtn = document.getElementById("chatbot-toggle");
      toggleBtn?.setAttribute("aria-expanded", "false");
    } catch (e) {
      console.error("[ChatBot] Error closing dialog:", e);
    }
  }

  function scrollToBottom() {
    if (chatBody) {
      chatBody.scrollTop = chatBody.scrollHeight;
    }
  }

  // --- UI Helpers ---

  function addBotMessage(htmlContent: string) {
    if (!chatMessages) return;

    const msgDiv = document.createElement("div");
    msgDiv.className =
      "flex gap-3 animate-in fade-in slide-in-from-left-2 duration-300";
    msgDiv.innerHTML = `
        <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-blue-600 to-purple-600 flex-shrink-0 flex items-center justify-center shadow-lg mt-1">
          <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
            <path d="M2 10a8 8 0 018-8v8h8a8 8 0 11-16 0z"></path>
          </svg>
        </div>
        <div class="bg-white/10 rounded-2xl rounded-tl-none p-3 max-w-[85%] border border-white/5 text-slate-200 text-sm shadow-sm">
          ${htmlContent}
        </div>
    `;

    chatMessages.appendChild(msgDiv);
    scrollToBottom();
  }

  function addUserMessage(text: string) {
    if (!chatMessages) return;

    const msgDiv = document.createElement("div");
    msgDiv.className =
      "flex justify-end animate-in fade-in slide-in-from-right-2 duration-300";
    msgDiv.innerHTML = `
        <div class="bg-blue-600 rounded-2xl rounded-tr-none p-3 max-w-[85%] text-white text-sm shadow-md">
          <p>${text}</p>
        </div>
    `;
    chatMessages.appendChild(msgDiv);
    scrollToBottom();
  }

  function showTyping() {
    if (typingIndicator) typingIndicator.classList.remove("hidden");
    isTyping = true;
    scrollToBottom();
  }

  function hideTyping() {
    if (typingIndicator) typingIndicator.classList.add("hidden");
    isTyping = false;
  }

  // --- Agent Core Logic ---

  async function botSpeak(message: string, delay = 800) {
    showTyping();
    // Disable input while bot thinks? Optional.
    await new Promise((r) => setTimeout(r, delay));
    hideTyping();
    addBotMessage(message);
  }

  async function runAgentFlow() {
    console.log("[ChatBot] Running flow step:", currentState);
    if (currentState === "INIT") {
      await botSpeak(
        `
            <p class="mb-2">¡Hola! 👋 Soy el asistente virtual de <strong>Insano Network</strong>.</p>
            <p>Estoy aquí para ayudarte a impulsar tus proyectos. ¿Cómo te llamas?</p>
          `,
        600,
      );
      currentState = "ASK_NAME";
    }
  }

  async function processUserInput(text: string) {
    console.log("[ChatBot] Processing input:", text, "State:", currentState);
    if (currentState === "ASK_NAME") {
      userData.name = text;
      await botSpeak(`¡Un gusto saludarte, <strong>${text}</strong>! 😊`);
      await botSpeak(`
            <p class="mb-2">Cuéntame un poco más...</p>
            <p>¿Qué estás buscando hoy? (Ej: Diseño Web, Marketing, Cursos...)</p>
          `);
      currentState = "ASK_DETAILS";
    } else if (currentState === "ASK_DETAILS") {
      userData.details = text;
      currentState = "CLOSING";
      await botSpeak(`Perfecto, entiendo que te interesa: <em>"${text}"</em>.`);
      await botSpeak(
        `He tomado nota de tus datos. Uno de nuestros especialistas te contactará pronto para darte la mejor solución. 🚀`,
      );

      console.log("Lead Collected:", userData);
      currentState = "DONE";
    } else if (currentState === "DONE") {
      await botSpeak(`Si necesitas algo más, aquí sigo. 😉`);
    }
  }

  // Exponer función para opciones rápidas (si decidimos volver a agregarlas)
  // @ts-ignore
  window.sendQuickOption = (text) => {
    addUserMessage(text);
    processUserInput(text);
  };
</script>

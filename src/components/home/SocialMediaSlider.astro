---
import InstagramFeed from "./SocialMedia/instagram/InstagramFeed.astro";
import FacebookPanel from "./SocialMedia/facebook/FacebookPanel.astro";
import TwitterUpdates from "./SocialMedia/twitter/TwitterUpdates.astro";
import TikTokFeed from "./SocialMedia/tiktok/TikTokFeed.astro";
---

<!-- Social Media Slider Section -->
<section id="social-media-slider-section" class="py-12 mb-10">
  <div class="container mx-auto p-4 max-w-7xl">
    <div class="text-center mb-10">
      <h2 class="text-3xl md:text-4xl font-bold mb-4 text-white">
        Síguenos en Redes Sociales
      </h2>
      <p class="text-xl text-slate-300">Conecta con nosotros en todas nuestras plataformas</p>
    </div>

    <!-- Social Media Platform Selector -->
    <div class="flex flex-wrap justify-center gap-3 mb-8">
      <button 
        id="instagram-slider-tab" 
        class="social-tab active px-4 py-2 bg-gradient-to-r from-purple-600 to-pink-600 text-white rounded-lg font-semibold transition-all hover:shadow-lg"
        onclick="showSocialPlatform('instagram')"
      >
        <svg class="w-4 h-4 inline mr-2" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
        </svg>
        Instagram
      </button>
      
      <button 
        id="facebook-slider-tab" 
        class="social-tab px-4 py-2 bg-slate-700 text-white rounded-lg font-semibold transition-all hover:bg-blue-600"
        onclick="showSocialPlatform('facebook')"
      >
        <svg class="w-4 h-4 inline mr-2" fill="currentColor" viewBox="0 0 24 24">
          <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/>
        </svg>
        Facebook
      </button>
      
      <button 
        id="tiktok-slider-tab" 
        class="social-tab px-4 py-2 bg-slate-700 text-white rounded-lg font-semibold transition-all hover:bg-black"
        onclick="showSocialPlatform('tiktok')"
      >
        <svg class="w-4 h-4 inline mr-2" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93v6.16c0 2.52-1.12 4.88-2.91 6.31-1.48 1.18-3.3 1.73-5.16 1.63-2.14-.16-4.11-1.04-5.62-2.39-1.51-1.36-2.5-3.35-2.61-5.38-.17-3.13 1.41-6.19 3.96-8.08.31-.23.63-.44.97-.61.64-.32 1.35-.55 2.07-.63v4.08c-.75.14-1.48.51-2.03 1.05-.63.63-.94 1.54-.86 2.45.1 1.02.66 1.95 1.5 2.55.77.55 1.77.78 2.72.63.92-.15 1.75-.63 2.3-1.37.56-.75.86-1.67.86-2.61V.02z"/>
        </svg>
        TikTok
      </button>
      
      <button 
        id="twitter-slider-tab" 
        class="social-tab px-4 py-2 bg-slate-700 text-white rounded-lg font-semibold transition-all hover:bg-sky-600"
        onclick="showSocialPlatform('twitter')"
      >
        <svg class="w-4 h-4 inline mr-2" fill="currentColor" viewBox="0 0 24 24">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
        X/Twitter
      </button>
    </div>

    <!-- Social Media Content Slider -->
    <div class="relative bg-slate-800/50 backdrop-blur-md border border-slate-700 rounded-3xl overflow-hidden">
      <!-- Background Gradients -->
      <div class="absolute top-0 right-0 w-[50%] h-[50%] bg-gradient-to-r from-purple-600/10 to-pink-600/10 rounded-full blur-[100px] pointer-events-none"></div>
      <div class="absolute bottom-0 left-0 w-[50%] h-[50%] bg-gradient-to-r from-blue-600/10 to-sky-600/10 rounded-full blur-[100px] pointer-events-none"></div>

      <div class="relative z-10 p-6 md:p-8">
        <!-- Instagram Content -->
        <div id="instagram-slider-content" class="social-slider-content">
          <InstagramFeed />
        </div>
        
        <!-- Facebook Content -->
        <div id="facebook-slider-content" class="social-slider-content hidden">
          <FacebookPanel />
        </div>
        
        <!-- TikTok Content -->
        <div id="tiktok-slider-content" class="social-slider-content hidden">
          <TikTokFeed />
        </div>
        
        <!-- Twitter Content -->
        <div id="twitter-slider-content" class="social-slider-content hidden">
          <TwitterUpdates />
        </div>
      </div>

      <!-- Slider Navigation -->
      <div class="absolute bottom-4 left-1/2 transform -translate-x-1/2 flex gap-2 z-20">
        <button 
          onclick="previousSocialPlatform()" 
          class="w-8 h-8 bg-slate-700/80 hover:bg-slate-600/80 text-white rounded-full flex items-center justify-center transition-all backdrop-blur-sm"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
        </button>
        
        <button 
          onclick="nextSocialPlatform()" 
          class="w-8 h-8 bg-slate-700/80 hover:bg-slate-600/80 text-white rounded-full flex items-center justify-center transition-all backdrop-blur-sm"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Platform Links -->
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a 
        href="https://www.instagram.com/insanonetwork" 
        target="_blank"
        class="inline-flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-500 hover:to-pink-500 text-white text-sm rounded-lg transition-all"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
        </svg>
        @insanonetwork
      </a>
      
      <a 
        href="https://www.facebook.com/insanonetwork" 
        target="_blank"
        class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white text-sm rounded-lg transition-colors"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/>
        </svg>
        insanonetwork
      </a>
      
      <a 
        href="https://www.tiktok.com/@insanonetwork" 
        target="_blank"
        class="inline-flex items-center gap-2 px-4 py-2 bg-black hover:bg-gray-800 text-white text-sm rounded-lg transition-colors"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93v6.16c0 2.52-1.12 4.88-2.91 6.31-1.48 1.18-3.3 1.73-5.16 1.63-2.14-.16-4.11-1.04-5.62-2.39-1.51-1.36-2.5-3.35-2.61-5.38-.17-3.13 1.41-6.19 3.96-8.08.31-.23.63-.44.97-.61.64-.32 1.35-.55 2.07-.63v4.08c-.75.14-1.48.51-2.03 1.05-.63.63-.94 1.54-.86 2.45.1 1.02.66 1.95 1.5 2.55.77.55 1.77.78 2.72.63.92-.15 1.75-.63 2.3-1.37.56-.75.86-1.67.86-2.61V.02z"/>
        </svg>
        @insanonetwork
      </a>
      
      <a 
        href="https://twitter.com/insanonetwork" 
        target="_blank"
        class="inline-flex items-center gap-2 px-4 py-2 bg-sky-600 hover:bg-sky-500 text-white text-sm rounded-lg transition-colors"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
        @insanonetwork
      </a>
    </div>
  </div>
</section>

<script>
  // Social media platform switching
  let currentSocialPlatform = 0;
  const socialPlatforms = ['instagram', 'facebook', 'tiktok', 'twitter'];
  
  function showSocialPlatform(platform) {
    // Hide all content
    document.querySelectorAll('.social-slider-content').forEach(content => {
      content.classList.add('hidden');
    });
    
    // Remove active class from all tabs
    document.querySelectorAll('.social-tab').forEach(tab => {
      tab.classList.remove('bg-gradient-to-r', 'from-purple-600', 'to-pink-600', 'bg-blue-600', 'bg-black', 'bg-sky-600');
      tab.classList.add('bg-slate-700');
    });
    
    // Show selected content and activate tab
    const content = document.getElementById(`${platform}-slider-content`);
    const tab = document.getElementById(`${platform}-slider-tab`);
    
    if (content) {
      content.classList.remove('hidden');
    }
    
    if (tab) {
      tab.classList.remove('bg-slate-700');
      if (platform === 'instagram') {
        tab.classList.add('bg-gradient-to-r', 'from-purple-600', 'to-pink-600');
      } else if (platform === 'facebook') {
        tab.classList.add('bg-blue-600');
      } else if (platform === 'tiktok') {
        tab.classList.add('bg-black');
      } else if (platform === 'twitter') {
        tab.classList.add('bg-sky-600');
      }
    }
    
    // Update current platform index
    currentSocialPlatform = socialPlatforms.indexOf(platform);
  }
  
  function nextSocialPlatform() {
    currentSocialPlatform = (currentSocialPlatform + 1) % socialPlatforms.length;
    showSocialPlatform(socialPlatforms[currentSocialPlatform]);
  }
  
  function previousSocialPlatform() {
    currentSocialPlatform = (currentSocialPlatform - 1 + socialPlatforms.length) % socialPlatforms.length;
    showSocialPlatform(socialPlatforms[currentSocialPlatform]);
  }
  
  // Auto-rotate platforms every 10 seconds
  setInterval(nextSocialPlatform, 10000);
  
  // Make functions globally available
  window.showSocialPlatform = showSocialPlatform;
  window.nextSocialPlatform = nextSocialPlatform;
  window.previousSocialPlatform = previousSocialPlatform;
</script>

<style>
  .social-slider-content {
    transition: opacity 0.3s ease-in-out;
  }
  
  .social-slider-content.hidden {
    opacity: 0;
    position: absolute;
    pointer-events: none;
  }
  
  .social-slider-content:not(.hidden) {
    opacity: 1;
    position: relative;
  }
</style>

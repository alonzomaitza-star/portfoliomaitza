---
import SafeEmbed from "../../../SafeEmbed.astro";
---

<section id="seccionYoutube" class="py-8 scroll-mt-24">
    <div class="container mx-auto p-4 max-w-7xl">
        <h3 class="text-3xl font-bold text-center mb-6 text-white">
            Nuestro Canal de YouTube
        </h3>
        <div
            class="bg-gradient-to-r from-red-600 to-red-800 p-1 rounded-lg shadow-xl"
        >
            <div
                class="grid grid-cols-1 md:grid-cols-3 gap-0 bg-gray-900 rounded-lg overflow-hidden"
            >
                <!-- Video Player Column (Larger) -->
                <div class="p-4 md:col-span-2">
                    <h3
                        class="text-2xl font-bold text-white mb-3 flex items-center"
                    >
                        <svg
                            class="w-8 h-8 mr-2 text-red-600"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"
                            ></path></svg
                        >
                        Último video
                    </h3>
                    <div
                        class="rounded-lg overflow-hidden shadow-lg aspect-video"
                    >
                        <!-- Using 'SafeEmbed' if available or direct iframe. Reusing existing SafeEmbed pattern from index.astro -->
                        <SafeEmbed
                            type="youtube"
                            videoId="4Ojg5y6Oq3Y"
                            title="Último video de Insano Network"
                        />
                    </div>
                </div>

                <!-- Right Column: Playlist/Comments -->
                <div
                    class="p-4 border-l border-red-600/30 md:col-span-1 bg-gray-900/50"
                >
                    <h3
                        class="text-xl font-bold text-white mb-3 flex items-center"
                    >
                        <svg
                            class="w-6 h-6 mr-2 text-red-600"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                d="M4 10h12v2H4zm0-4h12v2H4zm0 8h8v2H4zm10 0v6l5-3zM2 20h20V4H2v16z"
                            ></path></svg
                        >
                        Lista de Reproducción
                    </h3>
                    <div
                        class="bg-gray-800 rounded-lg p-2 max-h-[350px] overflow-y-auto custom-scrollbar"
                    >
                        <!-- Mock Playlist Items -->
                        <div class="space-y-2">
                            <a
                                href="#"
                                class="block p-2 rounded hover:bg-gray-700 transition-colors group"
                            >
                                <div class="flex gap-3">
                                    <div
                                        class="w-20 h-14 bg-gray-600 rounded flex-shrink-0 relative overflow-hidden"
                                    >
                                        <img
                                            src="https://img.youtube.com/vi/4Ojg5y6Oq3Y/0.jpg"
                                            alt="Video thumbnail"
                                            class="absolute inset-0 w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity"
                                        />
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p
                                            class="text-white text-sm font-medium truncate group-hover:text-red-400"
                                        >
                                            Tutorial de React Avanzado
                                        </p>
                                        <p class="text-xs text-gray-400">
                                            12:45 • Hace 2 días
                                        </p>
                                    </div>
                                </div>
                            </a>
                            <a
                                href="#"
                                class="block p-2 rounded hover:bg-gray-700 transition-colors group"
                            >
                                <div class="flex gap-3">
                                    <div
                                        class="w-20 h-14 bg-gray-600 rounded flex-shrink-0 relative overflow-hidden"
                                    >
                                        <!-- Using a placeholder/mock ID for now as requested 'frontend panel' -->
                                        <div
                                            class="absolute inset-0 flex items-center justify-center bg-gray-700"
                                        >
                                            <svg
                                                class="w-6 h-6 text-gray-500"
                                                fill="currentColor"
                                                viewBox="0 0 24 24"
                                                ><path d="M8 5v14l11-7z"
                                                ></path></svg
                                            >
                                        </div>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p
                                            class="text-white text-sm font-medium truncate group-hover:text-red-400"
                                        >
                                            Node.js para Principiantes
                                        </p>
                                        <p class="text-xs text-gray-400">
                                            15:20 • Hace 1 semana
                                        </p>
                                    </div>
                                </div>
                            </a>
                            <a
                                href="#"
                                class="block p-2 rounded hover:bg-gray-700 transition-colors group"
                            >
                                <div class="flex gap-3">
                                    <div
                                        class="w-20 h-14 bg-gray-600 rounded flex-shrink-0 relative overflow-hidden"
                                    >
                                        <div
                                            class="absolute inset-0 flex items-center justify-center bg-gray-700"
                                        >
                                            <svg
                                                class="w-6 h-6 text-gray-500"
                                                fill="currentColor"
                                                viewBox="0 0 24 24"
                                                ><path d="M8 5v14l11-7z"
                                                ></path></svg
                                            >
                                        </div>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p
                                            class="text-white text-sm font-medium truncate group-hover:text-red-400"
                                        >
                                            Astro v4: Novedades
                                        </p>
                                        <p class="text-xs text-gray-400">
                                            08:30 • Hace 2 semanas
                                        </p>
                                    </div>
                                </div>
                            </a>
                        </div>
                    </div>

                    <div class="mt-4 pt-4 border-t border-gray-700">
                        <a
                            href="https://www.youtube.com/@InsanoCodes"
                            target="_blank"
                            rel="noopener"
                            class="w-full block text-center py-2 bg-red-600 hover:bg-red-500 text-white rounded text-sm font-bold transition-colors"
                        >
                            Ver todo el canal
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: rgba(31, 41, 55, 0.5);
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: rgba(75, 85, 99, 0.8);
        border-radius: 3px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: rgba(156, 163, 175, 0.8);
    }
</style>

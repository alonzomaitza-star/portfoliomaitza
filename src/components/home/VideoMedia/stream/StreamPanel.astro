---
import SafeEmbed from "../../../SafeEmbed.astro";
import type { TwitchVOD, TwitchEmbedData } from "../../../../lib/twitch";
import type { KickData } from "../../../../lib/kick";

interface Props {
    twitchData: TwitchEmbedData;
    twitchVODs: TwitchVOD[];
    kickData: KickData;
}

const { twitchData, twitchVODs, kickData } = Astro.props;

// Determine what to show: live stream or first VOD
const isTwitchLive = twitchData.isLive;
const defaultVideoId =
    twitchData.latestVideoId || twitchVODs[0]?.id || "2643470685";
const firstVOD = twitchVODs[0];
---

<section id="seccionTwitch" class="py-8 scroll-mt-24">
    <div class="container mx-auto p-4 max-w-7xl">
        <h3 class="text-3xl font-bold text-center mb-6 text-white">
            En Vivo / Streams
        </h3>

        <!-- Tab Controls -->
        <div class="flex justify-center mb-4 gap-4">
            <button
                id="tab-btn-kick"
                class="px-6 py-2 rounded-full font-bold transition-all duration-300 flex items-center gap-2 tab-active bg-[#53FC18] text-black shadow-[0_0_15px_rgba(83,252,24,0.4)]"
                onclick="switchTab('kick')"
            >
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                    <path
                        d="M3 3h4v18H3V3zm15 0h-4v7l-4-4H6.5l5 5-5 5H10l4-4v7h4V3z"
                    ></path>
                </svg>
                Kick
                {
                    kickData.isLive && (
                        <span
                            class="w-2 h-2 bg-black rounded-full animate-pulse"
                            title="Live"
                        />
                    )
                }
            </button>
            <button
                id="tab-btn-twitch"
                class="px-6 py-2 rounded-full font-bold transition-all duration-300 flex items-center gap-2 bg-gray-800 text-gray-400 hover:text-white"
                onclick="switchTab('twitch')"
            >
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                    <path
                        d="M11.571 4.714h1.715v5.143H11.57zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h2.998L22.285 11.571V0zm14.571 11.143l-3.428 3.428h-3.429l-3 3v-3H6.857V1.714h13.714Z"
                    ></path>
                </svg>
                Twitch
                {
                    isTwitchLive && (
                        <span
                            class="w-2 h-2 bg-red-500 rounded-full animate-pulse"
                            title="Live"
                        />
                    )
                }
            </button>
        </div>

        <!-- Main Container -->
        <div
            class="bg-gradient-to-r from-gray-800 to-gray-900 p-1 rounded-lg shadow-xl transition-colors duration-500"
            id="stream-border"
        >
            <div
                class="grid grid-cols-1 lg:grid-cols-4 gap-0 bg-gray-950 rounded-lg overflow-hidden"
            >
                <!-- Stream Column (3/4 width on desktop) -->
                <div class="p-0 lg:col-span-3 aspect-video bg-black relative">
                    <!-- Kick Player -->
                    <div
                        id="player-kick"
                        class="absolute inset-0 w-full h-full"
                    >
                        <iframe
                            src={`https://player.kick.com/${kickData.channelSlug}`}
                            height="100%"
                            width="100%"
                            allowfullscreen="true"
                            class="w-full h-full"></iframe>
                    </div>

                    <!-- Twitch Player (Hidden by default) -->
                    <div
                        id="player-twitch"
                        class="absolute inset-0 w-full h-full hidden"
                    >
                        <iframe
                            id="twitch-embed-frame"
                            height="100%"
                            width="100%"
                            allowfullscreen
                            class="w-full h-full"></iframe>
                    </div>
                </div>

                <!-- Sidebar Column (1/4 width on desktop) -->
                <div
                    class="border-l border-gray-800 lg:col-span-1 bg-gray-900 flex flex-col h-auto lg:h-auto"
                >
                    <div
                        class="p-3 bg-gray-800 border-b border-gray-700 flex justify-between items-center"
                    >
                        <h3
                            class="font-bold text-white flex items-center gap-2"
                            id="sidebar-title"
                        >
                            {kickData.isLive ? "En Vivo" : "Streams"}
                        </h3>
                        <span
                            class="w-2.5 h-2.5 rounded-full bg-red-500 animate-pulse"
                            title="Live"
                            id="sidebar-live-indicator"
                            style={kickData.isLive ? "" : "display: none;"}
                        ></span>
                    </div>

                    <!-- Kick Sidebar (shown by default) -->
                    <div
                        id="sidebar-kick"
                        class="flex-grow bg-gray-900 relative overflow-hidden"
                    >
                        <div
                            class="absolute inset-0 flex items-center justify-center p-6 text-center"
                        >
                            <div>
                                {
                                    kickData.isLive ? (
                                        <div>
                                            <p class="text-green-400 mb-2 text-sm font-bold">
                                                🔴 Transmitiendo en Kick
                                            </p>
                                            <p class="text-white text-lg font-semibold mb-2">
                                                {kickData.liveTitle}
                                            </p>
                                            {kickData.viewerCount && (
                                                <p class="text-gray-400 text-sm">
                                                    👁 {kickData.viewerCount}{" "}
                                                    espectadores
                                                </p>
                                            )}
                                        </div>
                                    ) : (
                                        <div>
                                            <p class="text-gray-400 mb-4 text-sm">
                                                No hay transmisión en vivo
                                                actualmente
                                            </p>
                                            <p class="text-xs text-gray-600">
                                                Revisa Twitch para streams
                                                grabados
                                            </p>
                                        </div>
                                    )
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Twitch VODs Sidebar (hidden by default) -->
                    <div
                        id="sidebar-twitch"
                        class="flex-grow bg-gray-900 relative overflow-hidden hidden"
                    >
                        {
                            twitchVODs.length > 0 ? (
                                <div class="p-2 max-h-[500px] overflow-y-auto custom-scrollbar">
                                    <p class="text-xs text-gray-500 mb-2 px-2">
                                        Últimos streams
                                    </p>
                                    <div class="space-y-2">
                                        {twitchVODs.map((vod) => (
                                            <button
                                                class="vod-item block w-full p-2 rounded hover:bg-gray-800 transition-colors group text-left"
                                                data-video-id={vod.id}
                                                data-video-title={vod.title}
                                                onclick="playTwitchVOD(this)"
                                            >
                                                <div class="flex gap-2">
                                                    <div class="w-20 h-12 bg-gray-700 rounded flex-shrink-0 relative overflow-hidden">
                                                        <img
                                                            src={vod.thumbnail}
                                                            alt={vod.title}
                                                            class="absolute inset-0 w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity"
                                                        />
                                                        <div class="absolute bottom-1 right-1 bg-black/80 text-white text-[9px] px-1 rounded">
                                                            {vod.duration}
                                                        </div>
                                                    </div>
                                                    <div class="flex-1 min-w-0">
                                                        <p class="text-white text-xs font-medium truncate group-hover:text-purple-400 leading-tight">
                                                            {vod.title}
                                                        </p>
                                                        <p class="text-[10px] text-gray-500 mt-0.5">
                                                            {vod.viewCount.toLocaleString()}{" "}
                                                            vistas
                                                        </p>
                                                    </div>
                                                </div>
                                            </button>
                                        ))}
                                    </div>
                                </div>
                            ) : (
                                <div class="absolute inset-0 flex items-center justify-center p-6 text-center">
                                    <p class="text-gray-400 text-sm">
                                        No hay VODs disponibles
                                    </p>
                                </div>
                            )
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .custom-scrollbar::-webkit-scrollbar {
        width: 5px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: rgba(31, 41, 55, 0.5);
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: rgba(75, 85, 99, 0.8);
        border-radius: 3px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: rgba(156, 163, 175, 0.8);
    }
</style>

<script
    is:inline
    define:vars={{
        defaultVideoId,
        firstVODId: firstVOD?.id,
        isTwitchLive,
        twitchChannelName: twitchData.channelName,
    }}
>
    function switchTab(platform) {
        const btnKick = document.getElementById("tab-btn-kick");
        const btnTwitch = document.getElementById("tab-btn-twitch");
        const playerKick = document.getElementById("player-kick");
        const playerTwitch = document.getElementById("player-twitch");
        const sidebarKick = document.getElementById("sidebar-kick");
        const sidebarTwitch = document.getElementById("sidebar-twitch");
        const border = document.getElementById("stream-border");
        const sidebarTitle = document.getElementById("sidebar-title");
        const liveIndicator = document.getElementById("sidebar-live-indicator");

        // Setup Twitch iframe if not already set (lazy load)
        const twitchIframe = document.getElementById("twitch-embed-frame");
        if (platform === "twitch" && twitchIframe && !twitchIframe.src) {
            const hostname = window.location.hostname;
            let parentParams = `&parent=${hostname}`;
            if (hostname !== "localhost" && hostname !== "127.0.0.1") {
                parentParams += `&parent=localhost&parent=127.0.0.1`;
            }
            parentParams += `&parent=insano.network&parent=insanonetwork.com`;

            // If live, show live channel; otherwise show latest VOD
            if (isTwitchLive) {
                twitchIframe.src = `https://player.twitch.tv/?channel=${twitchChannelName}${parentParams}&muted=false&autoplay=true`;
            } else {
                const videoId = firstVODId || defaultVideoId;
                twitchIframe.src = `https://player.twitch.tv/?video=${videoId}${parentParams}&muted=false&autoplay=false`;
            }
        }

        if (platform === "kick") {
            // UI Updates - Kick
            btnKick.classList.add(
                "bg-[#53FC18]",
                "text-black",
                "shadow-[0_0_15px_rgba(83,252,24,0.4)]",
                "tab-active",
            );
            btnKick.classList.remove("bg-gray-800", "text-gray-400");

            btnTwitch.classList.remove(
                "bg-[#9146FF]",
                "text-white",
                "shadow-[0_0_15px_rgba(145,70,255,0.4)]",
                "tab-active",
            );
            btnTwitch.classList.add("bg-gray-800", "text-gray-400");

            // Toggle Players
            playerKick.classList.remove("hidden");
            playerTwitch.classList.add("hidden");

            // Toggle Sidebars
            sidebarKick.classList.remove("hidden");
            sidebarTwitch.classList.add("hidden");

            // Styling
            border.classList.remove("from-purple-600", "to-purple-900");
            border.classList.add("from-green-600", "to-gray-900");

            sidebarTitle.textContent = "En Vivo";
        } else {
            // Twitch selected
            btnTwitch.classList.add(
                "bg-[#9146FF]",
                "text-white",
                "shadow-[0_0_15px_rgba(145,70,255,0.4)]",
                "tab-active",
            );
            btnTwitch.classList.remove("bg-gray-800", "text-gray-400");

            btnKick.classList.remove(
                "bg-[#53FC18]",
                "text-black",
                "shadow-[0_0_15px_rgba(83,252,24,0.4)]",
                "tab-active",
            );
            btnKick.classList.add("bg-gray-800", "text-gray-400");

            // Toggle Players
            playerTwitch.classList.remove("hidden");
            playerKick.classList.add("hidden");

            // Toggle Sidebars
            sidebarTwitch.classList.remove("hidden");
            sidebarKick.classList.add("hidden");

            // Styling
            border.classList.remove("from-green-600", "to-gray-900");
            border.classList.add("from-purple-600", "to-purple-900");

            sidebarTitle.textContent = "VODs";
            liveIndicator.style.display = "none";
        }
    }

    function playTwitchVOD(button) {
        const videoId = button.getAttribute("data-video-id");
        const videoTitle = button.getAttribute("data-video-title");
        const twitchIframe = document.getElementById("twitch-embed-frame");

        if (twitchIframe && videoId) {
            const hostname = window.location.hostname;
            let parentParams = `&parent=${hostname}`;
            if (hostname !== "localhost" && hostname !== "127.0.0.1") {
                parentParams += `&parent=localhost&parent=127.0.0.1`;
            }
            parentParams += `&parent=insano.network&parent=insanonetwork.com`;

            twitchIframe.src = `https://player.twitch.tv/?video=${videoId}${parentParams}&muted=false&autoplay=true`;
        }
    }

    // Expose functions to global scope for onclick handlers
    window.switchTab = switchTab;
    window.playTwitchVOD = playTwitchVOD;
</script>

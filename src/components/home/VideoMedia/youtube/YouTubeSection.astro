---
import { getYouTubeLiveStatus } from "../../../../lib/youtube";
import { getYouTubePlaylistData } from "../../../../lib/youtube-playlist";
import SafeEmbed from "../../../SafeEmbed.astro";

// Fetch data
const youtubeData = await getYouTubeLiveStatus();
const playlistData = await getYouTubePlaylistData();

// Determine initial video
const initialVideoId = youtubeData.isLive
    ? youtubeData.liveVideoId
    : playlistData.courseVideos[0]?.id || "4Ojg5y6Oq3Y";

const isLiveInitially = youtubeData.isLive || false;
---

<section id="seccionYoutube" class="py-8 scroll-mt-24">
    <div class="container mx-auto p-4 max-w-7xl">
        <h3 class="text-3xl font-bold text-center mb-6 text-white">
            Nuestro Canal de YouTube
        </h3>
        <div
            class="bg-gradient-to-r from-red-600 to-red-800 p-1 rounded-lg shadow-xl"
        >
            <div
                class="grid grid-cols-1 lg:grid-cols-3 gap-0 bg-gray-900 rounded-lg overflow-hidden"
            >
                <!-- Main Video Player Column (2/3 width on desktop) -->
                <div class="p-4 lg:col-span-2">
                    <div class="flex items-center justify-between mb-3">
                        <h3
                            class="text-2xl font-bold text-white flex items-center"
                        >
                            <svg
                                class="w-8 h-8 mr-2 text-red-600"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"
                                ></path></svg
                            >
                            <span id="video-title">Video Principal</span>
                        </h3>

                        <!-- Live Badge -->
                        {
                            isLiveInitially && (
                                <div
                                    id="live-badge"
                                    class="flex items-center gap-2 bg-red-600 text-white text-xs font-bold px-3 py-1 rounded-full"
                                >
                                    <span class="w-2 h-2 bg-white rounded-full animate-pulse" />
                                    EN VIVO
                                </div>
                            )
                        }
                    </div>

                    <div
                        class="rounded-lg overflow-hidden shadow-lg aspect-video"
                        id="main-player-container"
                    >
                        <SafeEmbed
                            type="youtube"
                            videoId={initialVideoId}
                            title="Video de Insano Network"
                        />
                    </div>
                </div>

                <!-- Sidebar: Playlist Tabs & Video List (1/3 width on desktop) -->
                <div
                    class="p-4 border-l border-red-600/30 lg:col-span-1 bg-gray-900/50"
                >
                    <!-- Tab Controls -->
                    <div class="flex gap-2 mb-4">
                        <button
                            id="tab-btn-course"
                            class="tab-button flex-1 py-2 px-3 rounded-lg text-sm font-bold transition-all bg-red-600 text-white"
                            onclick="switchPlaylistTab('course')"
                        >
                            Curso Gratuito
                        </button>
                        <button
                            id="tab-btn-more"
                            class="tab-button flex-1 py-2 px-3 rounded-lg text-sm font-bold transition-all bg-gray-800 text-gray-400 hover:text-white"
                            onclick="switchPlaylistTab('more')"
                        >
                            Más Videos
                        </button>
                    </div>

                    <!-- Course Videos List -->
                    <div
                        id="playlist-course"
                        class="video-list bg-gray-800 rounded-lg p-2 max-h-[450px] overflow-y-auto custom-scrollbar"
                    >
                        <div class="space-y-2">
                            {
                                playlistData.courseVideos.length > 0 ? (
                                    playlistData.courseVideos.map(
                                        (video, index) => (
                                            <button
                                                class="video-item block w-full p-2 rounded hover:bg-gray-700 transition-colors group text-left"
                                                data-video-id={video.id}
                                                data-video-title={video.title}
                                                data-is-live="false"
                                                onclick="playVideo(this)"
                                            >
                                                <div class="flex gap-3">
                                                    <div class="w-20 h-14 bg-gray-600 rounded flex-shrink-0 relative overflow-hidden">
                                                        <img
                                                            src={
                                                                video.thumbnail
                                                            }
                                                            alt={video.title}
                                                            class="absolute inset-0 w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity"
                                                        />
                                                        <div class="absolute bottom-1 right-1 bg-black/80 text-white text-[10px] px-1 rounded">
                                                            {index + 1}
                                                        </div>
                                                    </div>
                                                    <div class="flex-1 min-w-0">
                                                        <p class="text-white text-sm font-medium truncate group-hover:text-red-400 leading-tight">
                                                            {video.title}
                                                        </p>
                                                        <p class="text-xs text-gray-400 mt-0.5">
                                                            Curso
                                                        </p>
                                                    </div>
                                                </div>
                                            </button>
                                        ),
                                    )
                                ) : (
                                    <p class="text-gray-500 text-sm text-center py-4">
                                        No hay videos de playlist disponibles
                                    </p>
                                )
                            }
                        </div>
                    </div>

                    <!-- More Videos List (Hidden by default) -->
                    <div
                        id="playlist-more"
                        class="video-list hidden bg-gray-800 rounded-lg p-2 max-h-[450px] overflow-y-auto custom-scrollbar"
                    >
                        <div class="space-y-2">
                            {
                                playlistData.moreVideos.length > 0 ? (
                                    playlistData.moreVideos.map((video) => (
                                        <button
                                            class="video-item block w-full p-2 rounded hover:bg-gray-700 transition-colors group text-left"
                                            data-video-id={video.id}
                                            data-video-title={video.title}
                                            data-is-live="false"
                                            onclick="playVideo(this)"
                                        >
                                            <div class="flex gap-3">
                                                <div class="w-20 h-14 bg-gray-600 rounded flex-shrink-0 relative overflow-hidden">
                                                    <img
                                                        src={video.thumbnail}
                                                        alt={video.title}
                                                        class="absolute inset-0 w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity"
                                                    />
                                                </div>
                                                <div class="flex-1 min-w-0">
                                                    <p class="text-white text-sm font-medium truncate group-hover:text-red-400 leading-tight">
                                                        {video.title}
                                                    </p>
                                                    <p class="text-xs text-gray-400 mt-0.5">
                                                        Canal
                                                    </p>
                                                </div>
                                            </div>
                                        </button>
                                    ))
                                ) : (
                                    <p class="text-gray-500 text-sm text-center py-4">
                                        No hay videos adicionales disponibles
                                    </p>
                                )
                            }
                        </div>
                    </div>

                    <div class="mt-4 pt-4 border-t border-gray-700">
                        <a
                            href="https://www.youtube.com/@InsanoCodes"
                            target="_blank"
                            rel="noopener"
                            class="w-full block text-center py-2 bg-red-600 hover:bg-red-500 text-white rounded text-sm font-bold transition-colors"
                        >
                            Ver todo el canal
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: rgba(31, 41, 55, 0.5);
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: rgba(75, 85, 99, 0.8);
        border-radius: 3px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: rgba(156, 163, 175, 0.8);
    }
</style>

<script is:inline>
    // Switch between tabs
    function switchPlaylistTab(tab) {
        const courseBtn = document.getElementById("tab-btn-course");
        const moreBtn = document.getElementById("tab-btn-more");
        const courseList = document.getElementById("playlist-course");
        const moreList = document.getElementById("playlist-more");

        if (tab === "course") {
            courseBtn.classList.add("bg-red-600", "text-white");
            courseBtn.classList.remove("bg-gray-800", "text-gray-400");
            moreBtn.classList.remove("bg-red-600", "text-white");
            moreBtn.classList.add("bg-gray-800", "text-gray-400");

            courseList.classList.remove("hidden");
            moreList.classList.add("hidden");
        } else {
            moreBtn.classList.add("bg-red-600", "text-white");
            moreBtn.classList.remove("bg-gray-800", "text-gray-400");
            courseBtn.classList.remove("bg-red-600", "text-white");
            courseBtn.classList.add("bg-gray-800", "text-gray-400");

            moreList.classList.remove("hidden");
            courseList.classList.add("hidden");
        }
    }

    // Play selected video
    function playVideo(button) {
        const videoId = button.getAttribute("data-video-id");
        const videoTitle = button.getAttribute("data-video-title");
        const isLive = button.getAttribute("data-is-live") === "true";

        // Update player
        const container = document.getElementById("main-player-container");
        const titleElement = document.getElementById("video-title");
        const liveBadge = document.getElementById("live-badge");

        // Update title
        if (titleElement) {
            titleElement.textContent = videoTitle || "Video Principal";
        }

        // Update live badge
        if (liveBadge) {
            if (isLive) {
                liveBadge.classList.remove("hidden");
            } else {
                liveBadge.classList.add("hidden");
            }
        }

        // Replace iframe
        container.innerHTML = `
      <iframe
        class="w-full h-full"
        src="https://www.youtube.com/embed/${videoId}?autoplay=1"
        title="${videoTitle || "YouTube video player"}"
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>
    `;
    }
</script>

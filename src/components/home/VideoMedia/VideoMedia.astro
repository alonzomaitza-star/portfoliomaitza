---
import YouTubeSection from "./youtube/YouTubeSection.astro";
import StreamPanel from "./stream/StreamPanel.astro";
import { getTwitchVODs, getTwitchEmbedData } from "../../../lib/twitch";
import { getKickLiveStatus } from "../../../lib/kick";

// Fetch data for StreamPanel
const twitchData = await getTwitchEmbedData();
const twitchVODs = await getTwitchVODs(10);
const kickData = await getKickLiveStatus();
---

<div class="video-media-container space-y-12 mb-20">
    <!-- Stream Panel (Kick / Twitch En Vivo) -->
    <StreamPanel
        twitchData={twitchData}
        twitchVODs={twitchVODs}
        kickData={kickData}
    />

    <!-- YouTube Section (Playlist + More Videos) -->
    <YouTubeSection />
</div>

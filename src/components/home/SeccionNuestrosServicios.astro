---
import CardServiceMinimal from "../../components/CardServiceMinimal.astro";
import CardServiceNeo from "../../components/CardServiceNeo.astro";
import CardDobleCapacitacion from "./CardDobleCapacitacion.astro";

interface ServicioItem {
  titulo: string;
  descripcion: string;
  imagen?: string;
}

interface Props {
  tarjetas: ServicioItem[];
}

const { tarjetas } = Astro.props as Props;
---
<section class="py-12 ">
  <div class="container mx-auto px-4">
    <h2 class="text-3xl font-bold mb-8 text-center text-gray-100">Nuestros Servicios</h2>
    <p class="text-center text-gray-200 max-w-3xl mx-auto mb-10">Ofrecemos soluciones integrales para tu negocio, desde el diseño hasta la implementación y comercialización.</p>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      {tarjetas.slice(0, 3).map((tarjeta, i) => (
        <CardServiceMinimal servicio={{
          icono: `/img/iconos/${i === 0 ? 'web' : i === 1 ? 'app' : 'shop'}.svg`,
          titulo: tarjeta.titulo,
          descripcion: tarjeta.descripcion,
          caracteristicas: [
            i === 0 ? 'Diseño personalizado' : i === 1 ? 'Desarrollo a medida' : 'Plataforma e-commerce',
            i === 0 ? 'Optimización SEO' : i === 1 ? 'Soporte técnico' : 'Gestión de inventario',
            i === 0 ? 'Responsive design' : i === 1 ? 'Actualizaciones' : 'Pasarela de pagos'
          ],
          precio: i === 0 ? '800' : i === 1 ? '1200' : '650',
          periodo: 'mes',
          desde: true,
          boton: 'Inicia gratis',
          link: i === 0 ? '/diseno' : i === 1 ? '/desarrollo' : '/ecommerce'
        }} />
      ))}
    </div>
    
    <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
      {tarjetas.slice(3, 5).map((tarjeta, i) => (
        <CardServiceNeo servicio={{
          icono: `/img/iconos/${i === 0 ? 'finance' : 'marketing'}.svg`,
          titulo: tarjeta.titulo,
          descripcion: tarjeta.descripcion,
          caracteristicas: [
            i === 0 ? 'Asesoría contable' : 'Estrategias de marketing',
            i === 0 ? 'Planificación fiscal' : 'Campañas publicitarias',
            i === 0 ? 'Gestión financiera' : 'Análisis de mercado'
          ],
          precio: i === 0 ? '600' : '850',
          periodo: 'mes',
          desde: true,
          boton: 'Inicia gratis',
          link: i === 0 ? '/contable' : '/marketing'
        }} />
      ))}
    </div>
    
    <!-- Tarjeta doble: Aprende y Capacita a tu equipo -->
    <div class="mt-12 grid grid-cols-1">
      <CardDobleCapacitacion titulo="Aprende y Capacita a tu equipo" boton="Inicia gratis" />
    </div>
    
    
  </div>
</section>

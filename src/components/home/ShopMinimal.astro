---
import shopData from "../../data/shop-data.json";

// Obtener datos del JSON
const { products, categories } = shopData;

// Función para formatear el precio
const displayPrice = (price) => {
  if (price === "Cotizar" || price === "Varios" || price === "Gratis") {
    return price;
  }
  return `$${price}`;
};

// Clases dinámicas de grid para centrar las últimas tarjetas en md y lg
const gridClasses = [
  "col-span-1 md:col-span-2 lg:col-span-2", // Card 1: Marketing
  "col-span-1 md:col-span-2 lg:col-span-2", // Card 2: Diseño
  "col-span-1 md:col-span-2 lg:col-span-2", // Card 3: Desarrollo
  "col-span-1 md:col-span-2 lg:col-span-2 lg:col-start-2", // Card 4: Contabilidad
  "col-span-1 md:col-span-2 md:col-start-2 lg:col-span-2 lg:col-start-auto", // Card 5: Especiales
];
---

<!-- Shop Minimal Section -->
<section id="shop-minimal-section" class="py-12 mb-10">
  <div class="container mx-auto p-4 max-w-7xl">
    <div class="text-center mb-10">
      <h2 class="text-3xl md:text-4xl font-bold mb-4 text-white">
        Nuestros Servicios
      </h2>
      <p class="text-xl text-slate-300">
        Soluciones completas para tu negocio o emprendimiento
      </p>
    </div>

    <!-- Main Service Blocks Grid -->
    <div class="grid grid-cols-1 md:grid-cols-4 lg:grid-cols-6 gap-8">
      {
        categories.map((category, index) => {
          const categoryProduct = products.find(
            (product) => product.category === category.id,
          );
          const cardClass = gridClasses[index] || "col-span-1 md:col-span-2 lg:col-span-2";
          
          return (
            <div class={`bg-slate-800/50 backdrop-blur-md border border-slate-700 rounded-2xl p-8 hover:border-slate-600 transition-all group flex flex-col justify-between ${cardClass}`}>
              <div>
                <div class="flex items-center gap-4 mb-6">
                  <div class="w-16 h-16 bg-gradient-to-br from-blue-600 to-purple-600 rounded-xl flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform flex-shrink-0">
                    {category.icon === "brush" && (
                      <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                        <path d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 14.7255 3.09032 17.1962 4.85857 19C5.03458 19.176 5.28254 19.243 5.5193 19.172C5.75607 19.172 5.94273 18.905 5.99849 18.667C6.18437 17.873 6.95362 17.3 7.85714 17.3H8.57143C9.91269 17.3 11 18.3873 11 19.7286V20.4286C11 21.2964 11.7036 22 12 22Z" />
                        <circle cx="7.5" cy="10.5" r="1" fill="currentColor" />
                        <circle cx="11.5" cy="7.5" r="1" fill="currentColor" />
                        <circle cx="16.5" cy="9.5" r="1" fill="currentColor" />
                      </svg>
                    )}
                    {category.icon === "laptop" && (
                      <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                        <rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
                        <line x1="2" y1="20" x2="22" y2="20" />
                        <line x1="12" y1="17" x2="12" y2="20" />
                      </svg>
                    )}
                    {category.icon === "megaphone" && (
                      <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                        <path d="M11 5L6 9H2V15H6L11 19V5Z" />
                        <path d="M15.5 8.5C16.8 9.8 16.8 12.2 15.5 13.5" />
                        <path d="M18.5 5.5C21 8 21 14 18.5 16.5" />
                      </svg>
                    )}
                    {category.icon === "calculator" && (
                      <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                        <rect x="4" y="2" width="16" height="20" rx="2" />
                        <line x1="8" y1="6" x2="16" y2="6" />
                        <rect x="8" y="10" width="2" height="2" />
                        <rect x="14" y="10" width="2" height="2" />
                        <rect x="8" y="14" width="2" height="2" />
                        <rect x="14" y="14" width="2" height="2" />
                        <rect x="8" y="18" width="8" height="2" />
                      </svg>
                    )}
                    {category.icon === "tools" && (
                      <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                        <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
                      </svg>
                    )}
                  </div>
                  <div>
                    <h3 class="text-2xl font-bold text-white mb-2">
                      {category.name}
                    </h3>
                    <p class="text-slate-400 text-sm leading-relaxed">{category.description}</p>
                  </div>
                </div>

                {categoryProduct && (
                  <div class="bg-slate-900/50 rounded-xl p-6 border border-slate-700 flex flex-col justify-between min-h-[340px]">
                    <div>
                      <div class="flex justify-between items-start mb-4 gap-2">
                        <h4 class="text-lg font-bold text-white leading-snug">
                          {categoryProduct.name}
                        </h4>
                        <span class="text-xl font-bold text-green-400 whitespace-nowrap">
                          {displayPrice(categoryProduct.price)}
                        </span>
                      </div>
                      <p class="text-slate-300 text-sm mb-4 leading-relaxed">
                        {categoryProduct.description}
                      </p>

                      <div class="space-y-3 mb-6">
                        {categoryProduct.features?.map((feature) => (
                          <div class="flex items-start gap-3">
                            <div class="w-5 h-5 bg-green-600/20 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                              <svg
                                class="w-3 h-3 text-green-400"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="3"
                                viewBox="0 0 24 24"
                              >
                                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                              </svg>
                            </div>
                            <span class="text-slate-300 text-sm leading-tight">{feature}</span>
                          </div>
                        ))}
                      </div>
                    </div>

                    <div class="flex flex-col sm:flex-row justify-between items-stretch sm:items-center gap-4 pt-4 border-t border-slate-800">
                      <div class="flex items-center gap-2">
                        <span
                          class={`text-xs px-2.5 py-1 rounded-full ${
                            categoryProduct.stock
                              ? "bg-green-600/20 text-green-400"
                              : "bg-red-600/20 text-red-400"
                          }`}
                        >
                          {categoryProduct.stock ? "Disponible" : "Agotado"}
                        </span>
                        <span class="text-slate-400 text-xs">
                          Soporte Incluido
                        </span>
                      </div>
                      <a 
                        href={category.link} 
                        class="px-5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white text-sm font-semibold rounded-xl transition-all hover:shadow-lg hover:shadow-blue-500/25 text-center flex-shrink-0"
                      >
                        Saber Más
                      </a>
                    </div>
                  </div>
                )}
              </div>
            </div>
          );
        })
      }
    </div>

    <!-- Bottom CTA -->
    <div class="text-center mt-12">
      <a
        href="/shop"
        class="inline-flex items-center gap-3 px-8 py-4 bg-gradient-to-r from-purple-600 to-blue-600 hover:from-purple-500 hover:to-blue-500 text-white font-bold rounded-xl transition-all transform hover:scale-105 shadow-lg hover:shadow-purple-500/25"
      >
        <span>Ver Tienda Completa</span>
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M13 7l5 5-5 5M5 12l5 5m0 0l-5-5m0 0l-5 5"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  /* Animaciones y efectos */
  .group-hover\:scale-110:hover {
    transform: scale(1.1);
  }

  .hover\:shadow-blue-500\/25:hover {
    box-shadow: 0 10px 25px rgba(59, 130, 246, 0.25);
  }
</style>

---
import ScrollPrompt from "./ScrollPrompt.astro";
---

<div
  id="hero-title"
  class="bg-black/40 backdrop-blur-sm border-t border-white/20 shadow-2xl fixed bottom-0 left-0 w-full h-[33vh] min-h-[220px] md:min-h-[320px] lg:min-h-[360px] p-4 md:p-8 pt-12 md:pt-16 z-45 text-right pointer-events-none transition-opacity duration-500 flex flex-col justify-center items-end"
>
  <!-- Botones divididos por diagonal en el borde superior (línea amarilla de 33px de altura con texto visible) -->
  <div
    class="absolute top-0 -left-[10px] w-[calc(100%+20px)] h-[33px] flex overflow-hidden pointer-events-auto z-50"
  >
    <button
      id="btn-nav-90"
      class="group relative flex-1 bg-[#ffd600] hover:bg-white active:bg-yellow-400 -skew-x-[30deg] border-r border-black/40 transition-colors duration-250 cursor-pointer flex items-center justify-center"
      title="Navegar"
    >
      <span
        class="skew-x-[30deg] text-slate-950 text-[11px] md:text-xs lg:text-sm font-black uppercase tracking-wider leading-none"
      >
        Navegar
      </span>
    </button>
    <button
      id="btn-nav-proyectos"
      class="group relative flex-1 bg-[#ffd600] hover:bg-white active:bg-yellow-400 -skew-x-[30deg] border-r border-black/40 transition-colors duration-250 cursor-pointer flex items-center justify-center"
      title="Proyecto"
    >
      <span
        class="skew-x-[30deg] text-slate-950 text-[11px] md:text-xs lg:text-sm font-black uppercase tracking-wider leading-none"
      >
        Proyecto
      </span>
    </button>
    <button
      id="btn-nav-equipo"
      class="group relative flex-1 bg-[#ffd600] hover:bg-white active:bg-yellow-400 -skew-x-[30deg] border-r border-black/40 transition-colors duration-250 cursor-pointer flex items-center justify-center"
      title="Equipo"
    >
      <span
        class="skew-x-[30deg] text-slate-950 text-[11px] md:text-xs lg:text-sm font-black uppercase tracking-wider leading-none"
      >
        Equipo
      </span>
    </button>
    <button
      id="btn-nav-servicios"
      class="group relative flex-1 bg-[#ffd600] hover:bg-white active:bg-yellow-400 -skew-x-[30deg] transition-colors duration-250 cursor-pointer flex items-center justify-center"
      title="Servicios $"
    >
      <span
        class="skew-x-[30deg] text-slate-950 text-[11px] md:text-xs lg:text-sm font-black uppercase tracking-wider leading-none"
      >
        Servicios $
      </span>
    </button>
  </div>

  <h1
    class="text-6xl md:text-8xl lg:text-9xl font-black text-white leading-none uppercase tracking-tighter drop-shadow-lg"
  >
    Insano<br />Network
  </h1>
  <h2
    class="text-2xl md:text-4xl text-[#ffd600] font-bold mt-2 md:mt-4 max-w-4xl ml-auto drop-shadow-md"
  >
    Diseña, Desarrolla y Vende tus Ideas.
  </h2>
  <ScrollPrompt />
</div>
<script is:inline>
  function handleHeroScrollInline() {
    const heroTitle = document.getElementById("hero-title");
    if (!heroTitle) return;

    const scrollPosition =
      window.scrollY ||
      document.documentElement.scrollTop ||
      document.body.scrollTop ||
      0;

    const windowHeight = window.innerHeight;
    // Fade out quickly - completely gone by 30% of viewport height scroll
    const fadeThreshold = windowHeight * 0.45;
    const opacity = Math.max(0, 1 - scrollPosition / fadeThreshold);

    heroTitle.style.opacity = opacity.toString();

    if (opacity <= 0.05) {
      heroTitle.style.visibility = "hidden";
    } else {
      heroTitle.style.visibility = "visible";
    }
  }

  function initHeroNavigation() {
    const btnNav90 = document.getElementById("btn-nav-90");
    const btnNavProyectos = document.getElementById("btn-nav-proyectos");
    const btnNavEquipo = document.getElementById("btn-nav-equipo");
    const btnNavServicios = document.getElementById("btn-nav-servicios");

    if (btnNav90) {
      btnNav90.onclick = () => {
        window.scrollTo({
          top: window.innerHeight * 0.8,
          behavior: "smooth",
        });
      };
    }

    const scrollToSection = (id) => {
      const el = document.getElementById(id);
      if (el) {
        el.scrollIntoView({ behavior: "smooth" });
      }
    };

    if (btnNavProyectos) {
      btnNavProyectos.onclick = () =>
        scrollToSection("desarrollos-gallery-section");
    }
    if (btnNavEquipo) {
      btnNavEquipo.onclick = () => scrollToSection("equipo-section");
    }
    if (btnNavServicios) {
      btnNavServicios.onclick = () => scrollToSection("shop-minimal-section");
    }
  }

  window.addEventListener("scroll", handleHeroScrollInline);
  window.addEventListener("resize", handleHeroScrollInline);
  window.addEventListener("DOMContentLoaded", () => {
    handleHeroScrollInline();
    initHeroNavigation();
  });

  // Also interval check for safety in case of layout shifts
  setInterval(handleHeroScrollInline, 500);

  // Immediate check
  handleHeroScrollInline();
  initHeroNavigation();
</script>

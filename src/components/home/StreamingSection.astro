---
import { getTwitchEmbedData } from '../../lib/twitch';
import { getYouTubeLiveStatus } from '../../lib/youtube';

// Fetch Twitch data (live status or latest VOD)
const twitchData = await getTwitchEmbedData();

// Fetch YouTube live status
const youtubeData = await getYouTubeLiveStatus();
---

<!-- Section: Aprende y Capacita -->
<div class="mb-20">
  <div class="text-center mb-10">
    <h2 class="text-3xl md:text-4xl font-bold mb-4 text-white">
      ¿No sabes por donde empezar o quieres aprender?
    </h2>
    <p class="text-xl text-slate-300">Les enseñamos.</p>
  </div>

  <div class="w-full">
    <div
      class="relative overflow-hidden bg-slate-800/50 backdrop-blur-md border border-slate-700 rounded-3xl shadow-2xl"
    >
      <!-- Background Gradients -->
      <div
        class="absolute top-0 right-0 w-[50%] h-[50%] bg-indigo-600/10 rounded-full blur-[100px] pointer-events-none"
      >
      </div>
      <div
        class="absolute bottom-0 left-0 w-[50%] h-[50%] bg-emerald-600/10 rounded-full blur-[100px] pointer-events-none"
      >
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 relative z-10">
        <!-- Columna Cursos (Twitch) -->
        <div class="p-6 md:p-10 lg:border-r border-slate-700/50 flex flex-col">
          <div class="flex items-center gap-4 mb-6">
            <div
              class="w-12 h-12 rounded-xl bg-[#9146FF]/20 flex items-center justify-center text-[#9146FF] font-bold text-xl border border-[#9146FF]/30"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M11.571 4.714h1.715v5.143H11.57zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h2.998L22.285 11.571V0zm14.571 11.143l-3.428 3.428h-3.429l-3 3v-3H6.857V1.714h13.714Z"/>
              </svg>
            </div>
            <div>
              <h4 class="text-2xl font-bold text-white">
                Cursos & Comunidad
              </h4>
              <p class="text-sm text-slate-400">
                Únete a nuestra comunidad en Twitch
              </p>
            </div>
          </div>

          <!-- Twitch Preview -->
          <div class="relative w-full aspect-video bg-black rounded-xl overflow-hidden mb-6 border border-slate-700 shadow-lg group">
            <!-- Live indicator badge -->
            {twitchData.isLive && (
              <div class="absolute top-3 left-3 z-20 flex items-center gap-2 bg-red-600 text-white text-xs font-bold px-2 py-1 rounded-md">
                <span class="w-2 h-2 bg-white rounded-full animate-pulse"></span>
                EN VIVO
              </div>
            )}
            
            <!-- Contenido del Stream o Placeholder -->
            {twitchData.isLive ? (
              <iframe
                id="twitch-embed-player"
                height="100%"
                width="100%"
                allowfullscreen
                class="absolute inset-0 w-full h-full"
              ></iframe>
            ) : (
              <div class="absolute inset-0 bg-slate-900 flex items-center justify-center">
                <div class="text-center">
                  <div class="w-16 h-16 bg-[#9146FF]/20 rounded-full flex items-center justify-center mx-auto mb-4">
                    <svg class="w-8 h-8 text-[#9146FF]" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M11.571 4.714h1.715v5.143H11.57zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h2.998L22.285 11.571V0zm14.571 11.143l-3.428 3.428h-3.429l-3 3v-3H6.857V1.714h13.714Z"/>
                    </svg>
                  </div>
                  <p class="text-white text-lg font-semibold mb-2">No estamos en vivo</p>
                  <p class="text-slate-400 text-sm">Pronto volvemos con más contenido</p>
                </div>
              </div>
            )}
            
            <script is:inline define:vars={{ isLive: twitchData.isLive, channelName: twitchData.channelName, videoId: twitchData.latestVideoId }}>
                (function() {
                    const iframe = document.getElementById('twitch-embed-player');
                    if (iframe && isLive) {
                        const hostname = window.location.hostname;
                        const parents = `parent=${hostname}&parent=localhost&parent=127.0.0.1&parent=insano.network&parent=insanonetwork.com`;
                        
                        // Show live stream
                        iframe.src = `https://player.twitch.tv/?channel=${channelName}&${parents}&muted=false&autoplay=true`;
                    }
                })();
            </script>
          </div>

          <ul class="space-y-4 text-slate-300 mb-8 mt-auto">
            <li class="flex items-start gap-3">
              <span class="text-[#9146FF] mt-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
              </span>
              <span>Cursos gratis en Twitch</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-[#9146FF] mt-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
              </span>
              <span>Cursos personalizados</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-[#9146FF] mt-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
              </span>
              <span>Certificados de finalización</span>
            </li>
          </ul>
          <a
            href={twitchData.isLive ? `https://www.twitch.tv/${twitchData.channelName}` : `https://www.twitch.tv/videos/${twitchData.latestVideoId}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-6 py-3 text-center text-sm font-semibold text-white bg-[#9146FF] rounded-xl hover:bg-[#772ce8] transition-all hover:shadow-[0_0_20px_rgba(145,70,255,0.3)]"
          >
            {twitchData.isLive ? 'Ver Canal en Vivo' : 'Ver Último Video'}
          </a>
        </div>

        <!-- Columna Capacitaciones (YouTube) -->
        <div class="p-6 md:p-10 flex flex-col">
          <div class="flex items-center gap-4 mb-6">
            <div
              class="w-12 h-12 rounded-xl bg-red-500/20 flex items-center justify-center text-red-500 font-bold text-xl border border-red-500/30"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/>
              </svg>
            </div>
            <div class="flex-grow">
              <h4 class="text-2xl font-bold text-white">
                Capacitaciones
              </h4>
              <p class="text-sm text-slate-400">
                Entrenamiento para empresas
              </p>
            </div>
            
            <!-- Live on YouTube Badge -->
            {youtubeData.isLive && (
              <a 
                href={`https://www.youtube.com/watch?v=${youtubeData.liveVideoId}`}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-2 bg-red-600 hover:bg-red-700 text-white text-xs font-bold px-3 py-1.5 rounded-full transition-all hover:scale-105 shadow-lg hover:shadow-red-500/50"
              >
                <span class="w-2 h-2 bg-white rounded-full animate-pulse"></span>
                LIVE EN YT
              </a>
            )}
          </div>

           <!-- Youtube Preview -->
           <div class="relative w-full aspect-video bg-black/40 rounded-xl overflow-hidden mb-6 border border-slate-700 shadow-lg group">
            <!-- Placeholder para video de Excel -->
            <div class="absolute inset-0 bg-slate-800 flex items-center justify-center overflow-hidden">
                <div class="absolute inset-0 opacity-30 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-green-900 via-slate-900 to-slate-900"></div>
                 <span class="w-16 h-16 bg-red-600 rounded-full flex items-center justify-center pl-1 shadow-[0_0_30px_rgba(220,38,38,0.4)] relative z-10 group-hover:scale-110 transition-transform cursor-pointer">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-white" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                </span>
                <div class="absolute bottom-4 left-4 right-4 z-10">
                    <span class="bg-black/60 text-white text-[10px] px-1.5 py-0.5 rounded uppercase font-bold tracking-wider mb-1 inline-block">Demo</span>
                    <p class="text-white font-semibold text-sm leading-tight">Capacitación Express: Excel para Negocios (3 min)</p>
                </div>
            </div>
         </div>

          <ul class="space-y-4 text-slate-300 mb-8 mt-auto">
            <li class="flex items-start gap-3">
              <span class="text-red-500 mt-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
              </span>
              <span>Planeación de proyectos</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-red-500 mt-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
              </span>
              <span>Desarrollo y Diseño de Marca</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-red-500 mt-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
              </span>
              <span>Informática (Excel, Word, etc.)</span>
            </li>
          </ul>
          <a
            href="https://www.youtube.com/@insanonetwork"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-6 py-3 text-center text-sm font-semibold text-white bg-red-600 rounded-xl hover:bg-red-500 transition-all hover:shadow-[0_0_20px_rgba(220,38,38,0.3)]"
          >
            Ver Canal de YouTube
          </a>
        </div>
      </div>
      
       <!-- Leyenda inferior -->
      <div
        class="px-8 py-4 bg-slate-900/50 border-t border-slate-700/50 flex flex-col sm:flex-row items-center justify-between gap-2"
      >
        <div
          class="text-sm text-slate-300 font-medium flex items-center gap-2"
        >
          <span class="w-2 h-2 rounded-full bg-blue-400"></span>
          Asesoramiento empresarial
        </div>
        <div class="text-xs text-slate-500">
          Diagnóstico • Plan de acción • Acompañamiento
        </div>
      </div>
    </div>
  </div>
</div>

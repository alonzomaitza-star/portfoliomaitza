---
import InstagramFeed from "./instagram/InstagramFeed.astro";
import FacebookPanel from "./facebook/FacebookPanel.astro";
import TwitterUpdates from "./twitter/TwitterUpdates.astro";
import TikTokFeed from "./tiktok/TikTokFeed.astro";
---

<section class="py-12 mb-10">
    <div class="container mx-auto p-4 max-w-7xl">
        <h3 class="text-4xl font-bold text-center mb-12 text-white">
            Síguenos en Redes Sociales
        </h3>

        <div
            class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 auto-rows-fr"
        >
            <!-- Instagram (Often visual, takes good space) -->
            <div class="md:col-span-1 lg:col-span-1">
                <InstagramFeed />
            </div>

            <!-- Facebook -->
            <div class="md:col-span-1 lg:col-span-1">
                <FacebookPanel />
            </div>

            <!-- TikTok -->
            <div class="md:col-span-1 lg:col-span-1">
                <TikTokFeed />
            </div>

            <!-- Twitter/X -->
            <div class="md:col-span-1 lg:col-span-1">
                <TwitterUpdates />
            </div>
        </div>
    </div>
</section>

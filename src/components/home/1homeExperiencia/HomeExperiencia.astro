<style>
  /* Mobile Expandable Cards Styles */
  
  /* Prevent browser scroll anchoring */
  .experience-card {
    overflow-anchor: none;
  }

  /* Default: collapsed on mobile */
  @media (max-width: 767px) {
    .card-content {
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      transition: max-height 0.35s ease-out, opacity 0.25s ease-out;
      display: flex;
    }
    
    .experience-card.expanded .card-content {
      max-height: 800px; /* Large enough to fit content */
      opacity: 1;
      transition: max-height 0.4s ease-in, opacity 0.3s ease-in 0.1s;
    }
    
    .experience-card.expanded .chevron-icon {
      transform: rotate(180deg);
    }

    .chevron-icon {
      transition: transform 0.3s ease;
    }
  }

  /* Desktop: always visible */
  @media (min-width: 768px) {
    .card-content {
      display: flex;
      max-height: none;
      opacity: 1;
      overflow: visible;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
     initCards();
  });
  // Initialize on first load as well
  initCards();

  function initCards() {
    const cards = document.querySelectorAll('.experience-card');
    cards.forEach(card => {
        card.onclick = (e) => {
            // Only apply toggle on mobile/tablet (below md breakpoint)
            if (window.innerWidth >= 768) return; 
            
            // Prevent toggle if clicking on a link or button inside the expanded content
            if (e.target.closest('a') || e.target.closest('button')) return;

            // Toggle the expanded state
            card.classList.toggle('expanded');
        };
    });
  }

  // Platform switching functionality (Twitch & Kick only)
  function showPlatform(platform) {
    // Hide all content
    document.querySelectorAll('.stream-content').forEach(content => {
      content.classList.add('hidden');
    });
    
    // Remove active class from all tabs
    document.querySelectorAll('.platform-tab').forEach(tab => {
      tab.classList.remove('bg-[#9146FF]', 'bg-[#53FC18]');
      tab.classList.add('bg-slate-700');
    });
    
    // Show selected content and activate tab
    const content = document.getElementById(`${platform}-content`);
    const tab = document.getElementById(`${platform}-tab`);
    
    if (content) {
      content.classList.remove('hidden');
    }
    
    if (tab) {
      tab.classList.remove('bg-slate-700');
      if (platform === 'twitch') {
        tab.classList.add('bg-[#9146FF]');
      } else if (platform === 'kick') {
        tab.classList.add('bg-[#53FC18]');
      }
    }
  }
  
  // Make functions globally available
  window.showPlatform = showPlatform;
</script>

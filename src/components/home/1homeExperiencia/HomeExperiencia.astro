const COLOR_MAP = {
  purple: {
    borderHover: "md:hover:border-purple-500/50",
    shadowHover: "md:hover:shadow-purple-500/10",
    bgGradient: "from-purple-600/10",
    iconBg: "bg-purple-500/20",
    iconText: "text-purple-400",
    iconGroupHoverText: "md:group-hover:text-purple-300",
    iconGroupHoverBg: "md:group-hover:bg-purple-500/30",
  },
  blue: {
    borderHover: "md:hover:border-blue-500/50",
    shadowHover: "md:hover:shadow-blue-500/10",
    bgGradient: "from-blue-600/10",
    iconBg: "bg-blue-500/20",
    iconText: "text-blue-400",
    iconGroupHoverText: "md:group-hover:text-blue-300",
    iconGroupHoverBg: "md:group-hover:bg-blue-500/30",
  },
  emerald: {
    borderHover: "md:hover:border-emerald-500/50",
    shadowHover: "md:hover:shadow-emerald-500/10",
    bgGradient: "from-emerald-600/10",
    iconBg: "bg-emerald-500/20",
    iconText: "text-emerald-400",
    iconGroupHoverText: "md:group-hover:text-emerald-300",
    iconGroupHoverBg: "md:group-hover:bg-emerald-500/30",
  },
  orange: {
    borderHover: "md:hover:border-orange-500/50",
    shadowHover: "md:hover:shadow-orange-500/10",
    bgGradient: "from-orange-600/10",
    iconBg: "bg-orange-500/20",
    iconText: "text-orange-400",
    iconGroupHoverText: "md:group-hover:text-orange-300",
    iconGroupHoverBg: "md:group-hover:bg-orange-500/30",
  },
  teal: {
    borderHover: "md:hover:border-teal-500/50",
    shadowHover: "md:hover:shadow-teal-500/10",
    bgGradient: "from-teal-600/10",
    iconBg: "bg-teal-500/20",
    iconText: "text-teal-400",
    iconGroupHoverText: "md:group-hover:text-teal-300",
    iconGroupHoverBg: "md:group-hover:bg-teal-500/30",
  },
};
---

<section
  class="h-full py-16 md:py-24 bg-gradient-to-b from-slate-900/10 to-slate-950/10 text-white overflow-hidden relative"
>
  <!-- Decoration background elements -->
  <div
    class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none z-0"
  >
    <div
      class="absolute -top-[20%] -left-[10%] w-[50%] h-[50%] bg-purple-600/20 rounded-full blur-[100px]"
    >
    </div>
    <div
      class="absolute top-[40%] -right-[10%] w-[40%] h-[60%] bg-blue-600/10 rounded-full blur-[100px]"
    >
    </div>
  </div>

  <div class="container mx-auto px-4 relative z-10">
    <!-- Header Question -->
    <div class="text-center mb-12 md:mb-16">
      <h2
        class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight mb-4 bg-clip-text text-transparent bg-gradient-to-r from-blue-400 via-purple-400 to-pink-400"
      >
        ¿En qué te ayudamos hoy?
      </h2>
      <p class="text-lg text-slate-400 max-w-2xl mx-auto">
        Selecciona una opción para comenzar tu experiencia personalizada.
      </p>
    </div>

    <!-- Cards Gallery -->
    <div
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-4 md:gap-6 mb-20"
    >
      {
        EXPERIENCE_CARDS.map((card) => {
          const colors = COLOR_MAP[card.color];
          return (
            <div
              data-card-id={card.id}
              class:list={[
                "experience-card group relative p-6 bg-slate-800/50 backdrop-blur-sm border border-slate-700 rounded-2xl transition-all duration-300 md:hover:-translate-y-1 md:hover:shadow-lg flex flex-col h-full cursor-pointer md:cursor-default",
                colors.borderHover,
                colors.shadowHover,
              ]}
            >
              <div
                class:list={[
                  "absolute inset-0 bg-gradient-to-br to-transparent opacity-0 md:group-hover:opacity-100 transition-opacity rounded-2xl pointer-events-none",
                  colors.bgGradient,
                ]}
              />
              <div class="relative z-10 flex flex-col h-full">
                <!-- Header (Icon + Title + toggle indicator) -->
                <div class="flex items-start justify-between">
                    <div
                      class:list={[
                        "w-12 h-12 rounded-lg flex items-center justify-center mb-4 transition-colors flex-shrink-0",
                        colors.iconBg,
                        colors.iconText,
                        colors.iconGroupHoverText,
                        colors.iconGroupHoverBg,
                      ]}
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-6 h-6"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d={card.iconPath}
                        />
                      </svg>
                    </div>
                    
                    <!-- Mobile Chevron -->
                    <div class="md:hidden text-slate-500 transition-transform duration-300 chevron-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                        </svg>
                    </div>
                </div>

                <!-- Title (Always visible) -->
                <h3 class="text-2xl font-bold mb-3 select-none">{card.title}</h3>

                <!-- Content Body (Collapsible on mobile) -->
                <div class="card-content flex-col flex-grow">
                    <!-- Content -->
                    <p class="text-base text-slate-400 mb-6 flex-grow">
                      {card.description}
                    </p>

                    <!-- Services List (Optional) -->
                    {card.services && card.services.length > 0 && (
                      <div class="mb-5">
                        <p class="text-sm font-semibold uppercase text-slate-500 mb-3 tracking-wider">
                          Servicios
                        </p>
                        <div class="flex flex-wrap gap-2">
                           {card.services.slice(0, 4).map(service => (
                               <span class="text-xs bg-slate-700/50 px-2.5 py-1.5 rounded text-slate-300 border border-slate-600/50">
                                   {service}
                               </span>
                           ))}
                           {card.services.length > 4 && (
                               <span class="text-xs text-slate-500 px-2 py-1">...</span>
                           )}
                        </div>
                      </div>
                    )}

                    <!-- Store Products (Tienda) Section -->
                    {card.storeProducts && card.storeProducts.length > 0 && (
                      <div class="mt-auto pt-5 border-t border-slate-700/50 mb-4">
                        <div class="flex items-center gap-2 mb-3">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400" viewBox="0 0 20 20" fill="currentColor">
                               <path fill-rule="evenodd" d="M10 2a4 4 0 00-4 4v1H5a1 1 0 00-.994.89l-1 9A1 1 0 004 18h12a1 1 0 001-1.11l-1-9A1 1 0 0015 7h-1V6a4 4 0 00-4-4zm2 5V6a2 2 0 10-4 0v1h4zm-6 3a1 1 0 112 0 1 1 0 01-2 0zm7-1a1 1 0 100 2 1 1 0 000-2z" clip-rule="evenodd" />
                            </svg>
                            <span class="text-base font-semibold text-slate-400">Tienda</span>
                        </div>
                        <ul class="grid grid-cols-2 gap-x-2 gap-y-1.5">
                          {card.storeProducts.slice(0, 6).map((product) => (
                            <li class="text-sm text-slate-500 flex items-start gap-2 leading-tight">
                                <span class="w-1.5 h-1.5 rounded-full bg-slate-600 mt-1.5 flex-shrink-0"></span>
                                <span>{product}</span>
                            </li>
                          ))}
                        </ul>
                        <div class="text-xs text-slate-500 mt-3 italic flex items-center gap-1 opacity-70">
                            <span>+ Cursos y servicios...</span>
                        </div>
                      </div>
                    )}
                    
                    <!-- Category-specific Action Button -->
                    {card.id === 'diseno' && (
                        <a href="/diseno" class="w-full mt-2 py-2.5 px-4 bg-slate-700/50 hover:bg-slate-700 text-slate-300 hover:text-white rounded-xl text-sm font-semibold transition-all flex items-center justify-center gap-2 group-hover:shadow-md">
                            <span>Mira nuestra galería y proyectos</span>
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd" />
                            </svg>
                        </a>
                    )}
                    {card.id === 'desarrollo' && (
                        <a href="/desarrollo" class="w-full mt-2 py-2.5 px-4 bg-slate-700/50 hover:bg-slate-700 text-slate-300 hover:text-white rounded-xl text-sm font-semibold transition-all flex items-center justify-center gap-2 group-hover:shadow-md">
                            <span>Stack tech, herramientas open source</span>
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd" />
                            </svg>
                        </a>
                    )}
                    {card.id === 'contabilidad' && (
                        <a href="/contable" class="w-full mt-2 py-2.5 px-4 bg-slate-700/50 hover:bg-slate-700 text-slate-300 hover:text-white rounded-xl text-sm font-semibold transition-all flex items-center justify-center gap-2 group-hover:shadow-md">
                            <span>Servicios fiscales y contables</span>
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd" />
                            </svg>
                        </a>
                    )}
                    {card.id === 'comprar-vender' && (
                        <a href="/ecommerce" class="w-full mt-2 py-2.5 px-4 bg-slate-700/50 hover:bg-slate-700 text-slate-300 hover:text-white rounded-xl text-sm font-semibold transition-all flex items-center justify-center gap-2 group-hover:shadow-md">
                            <span>Tienda y productos personalizados</span>
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd" />
                            </svg>
                        </a>
                    )}
                    {card.id === 'emprender' && (
                        <a href="/marketing" class="w-full mt-2 py-2.5 px-4 bg-slate-700/50 hover:bg-slate-700 text-slate-300 hover:text-white rounded-xl text-sm font-semibold transition-all flex items-center justify-center gap-2 group-hover:shadow-md">
                            <span>Marketing y estrategia de negocio</span>
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd" />
                            </svg>
                        </a>
                    )}
                    {card.id === 'cursos' && (
                        <a href="/cursos" class="w-full mt-2 py-2.5 px-4 bg-slate-700/50 hover:bg-slate-700 text-slate-300 hover:text-white rounded-xl text-sm font-semibold transition-all flex items-center justify-center gap-2 group-hover:shadow-md">
                            <span>Certificaciones y cursos profesionales</span>
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd" />
                            </svg>
                        </a>
                    )}
                    {card.id === 'capacitacion' && (
                        <a href="/capacitacion" class="w-full mt-2 py-2.5 px-4 bg-slate-700/50 hover:bg-slate-700 text-slate-300 hover:text-white rounded-xl text-sm font-semibold transition-all flex items-center justify-center gap-2 group-hover:shadow-md">
                            <span>Capacitación empresarial y de equipos</span>
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd" />
                            </svg>
                        </a>
                    )}
                </div>
              </div>
            </div>
          );
        })
      }
    </div>

    <!-- proyectos -->
    <DesarrollosGallery />

    <!-- Streaming Unificado Panel (Twitch & Kick) -->
    <div class="mb-20">
      <div class="text-center mb-10">
        <h2 class="text-3xl md:text-4xl font-bold mb-4 text-white">
          Streaming en Vivo
        </h2>
        <p class="text-xl text-slate-300">Conéctate con nosotros en tiempo real</p>
      </div>

      <div class="w-full max-w-6xl mx-auto">
        <div class="relative overflow-hidden bg-slate-800/50 backdrop-blur-md border border-slate-700 rounded-3xl shadow-2xl">
          <!-- Background Gradients -->
          <div class="absolute top-0 right-0 w-[50%] h-[50%] bg-indigo-600/10 rounded-full blur-[100px] pointer-events-none"></div>
          <div class="absolute bottom-0 left-0 w-[50%] h-[50%] bg-emerald-600/10 rounded-full blur-[100px] pointer-events-none"></div>

          <div class="relative z-10 p-6 md:p-8">
            <!-- Platform Selector Tabs -->
            <div class="flex flex-wrap gap-2 mb-6 justify-center">
              <button 
                id="twitch-tab" 
                class="platform-tab active px-4 py-2 bg-[#9146FF] text-white rounded-lg font-semibold transition-all hover:shadow-[0_0_20px_rgba(145,70,255,0.3)]"
                onclick="showPlatform('twitch')"
              >
                <svg class="w-4 h-4 inline mr-2" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M11.571 4.714h1.715v5.143H11.57zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h2.998L22.285 11.571V0zm14.571 11.143l-3.428 3.428h-3.429l-3 3v-3H6.857V1.714h13.714Z"/>
                </svg>
                Twitch
              </button>
              
              <button 
                id="kick-tab" 
                class="platform-tab px-4 py-2 bg-slate-700 text-white rounded-lg font-semibold transition-all hover:bg-[#53FC18]"
                onclick="showPlatform('kick')"
              >
                <svg class="w-4 h-4 inline mr-2" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93v6.16c0 2.52-1.12 4.88-2.91 6.31-1.48 1.18-3.3 1.73-5.16 1.63-2.14-.16-4.11-1.04-5.62-2.39-1.51-1.36-2.5-3.35-2.61-5.38-.17-3.13 1.41-6.19 3.96-8.08.31-.23.63-.44.97-.61.64-.32 1.35-.55 2.07-.63v4.08c-.75.14-1.48.51-2.03 1.05-.63.63-.94 1.54-.86 2.45.1 1.02.66 1.95 1.5 2.55.77.55 1.77.78 2.72.63.92-.15 1.75-.63 2.3-1.37.56-.75.86-1.67.86-2.61V.02z"/>
                </svg>
                Kick
              </button>
            </div>

            <!-- Streaming Content Area -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
              <!-- Main Stream Display -->
              <div class="lg:col-span-2">
                <div class="relative aspect-video bg-black rounded-xl overflow-hidden border border-slate-700">
                  <!-- Twitch Stream -->
                  <div id="twitch-content" class="stream-content">
                    <iframe

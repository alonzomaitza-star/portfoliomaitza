   <style>
  /* Prevent browser scroll anchoring */
  .experience-card {
    overflow-anchor: none;
  }

  /* Default: collapsed on all devices, expanded only when active */
  .card-content {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: max-height 0.6s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.4s ease, margin-top 0.4s ease;
    display: flex;
    flex-direction: column;
  }
  
  .experience-card.active-card .card-content {
    max-height: 1000px;
    opacity: 1;
    margin-top: 1.25rem;
  }

  .experience-card.active-card {
    border-color: rgba(99, 102, 241, 0.6) !important;
    box-shadow: 0 0 25px rgba(99, 102, 241, 0.25) !important;
    background-color: rgba(15, 23, 42, 0.75) !important;
    transform: translateY(-2px);
  }

  /* On mobile/tablet, active card spans both columns (covers full width) */
  @media (max-width: 1023px) {
    .experience-card.active-card {
      grid-column: span 2 / span 2;
    }
  }

  /* Pulse line for desktop "pulpo" tentacle connection */
  @media (min-width: 1024px) {
    .experience-card.active-card::before {
      content: '';
      position: absolute;
      left: -20px;
      top: 50%;
      width: 20px;
      height: 2px;
      background: linear-gradient(to right, rgba(99, 102, 241, 0.4), rgba(99, 102, 241, 0));
      z-index: -1;
      animation: pulse-line 2s infinite;
    }
  }

  @keyframes pulse-line {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }
</style>

<script>
  let activeIndex = 0;
  let progress = 0;
  let timerInterval: any = null;
  let isHovered = false;

  document.addEventListener('astro:page-load', () => {
     initCards();
  });
  // Initialize on first load as well
  initCards();

  function initCards() {
    const cards = document.querySelectorAll('.experience-card');
    const coreCircle = document.querySelector('.octopus-core-container');
    
    if (cards.length === 0) return;

    // Clear any existing timer when re-initializing
    if (timerInterval) {
      clearInterval(timerInterval);
      timerInterval = null;
    }

    cards.forEach((card, idx) => {
      // Set the index in click handler
      card.addEventListener('click', (e) => {
        // Prevent toggle if clicking on a link or button
        if ((e.target as HTMLElement).closest('a') || (e.target as HTMLElement).closest('button')) return;
        
        activeIndex = idx;
        progress = 0;
        updateActiveCard(cards);
        updateProgressUI();
      });

      // Hover controls to pause timer
      card.addEventListener('mouseenter', () => { isHovered = true; });
      card.addEventListener('mouseleave', () => { isHovered = false; });
    });

    if (coreCircle) {
      coreCircle.addEventListener('mouseenter', () => { isHovered = true; });
      coreCircle.addEventListener('mouseleave', () => { isHovered = false; });
    }

    // Set first card as active initially
    activeIndex = 0;
    progress = 0;
    updateActiveCard(cards);
    updateProgressUI();
    startTimer(cards);
  }

  function startTimer(cards: NodeListOf<Element>) {
    timerInterval = setInterval(() => {
      if (isHovered) return;

      progress += 1; // Increment 1% every 100ms (100 * 100ms = 10,000ms = 10s)

      if (progress >= 100) {
        progress = 0;
        activeIndex = (activeIndex + 1) % cards.length;
        updateActiveCard(cards);
      }

      updateProgressUI();
    }, 100);
  }

  function updateProgressUI() {
    const progressBar = document.getElementById('core-timer-progress');
    const secondsLabel = document.getElementById('core-seconds');

    if (progressBar) {
      // Circumference is 263.89 ~ 264
      const offset = 264 - (progress / 100) * 264;
      progressBar.style.strokeDashoffset = offset.toString();
    }

    if (secondsLabel) {
      const remainingSeconds = Math.ceil((100 - progress) / 10);
      secondsLabel.textContent = remainingSeconds + 's';
    }
  }

  function updateActiveCard(cards: NodeListOf<Element>) {
    cards.forEach((card, idx) => {
      const activeDot = card.querySelector('.active-dot');
      if (idx === activeIndex) {
        card.classList.add('active-card');
        if (activeDot) {
          activeDot.classList.remove('bg-slate-650');
          activeDot.classList.add('bg-blue-500', 'shadow-[0_0_8px_#3b82f6]');
        }

        // Update core content
        const coreTitle = document.getElementById('core-title');
        const coreIconContainer = document.getElementById('core-icon-container');

        if (coreTitle) {
          coreTitle.textContent = card.getAttribute('data-card-title') || '';
        }

        if (coreIconContainer) {
          const cardIcon = card.querySelector('.card-icon-wrapper');
          if (cardIcon) {
            const svg = cardIcon.querySelector('svg');
            if (svg) {
              coreIconContainer.innerHTML = svg.outerHTML;
            }
            // Sync background/text classes from the active card's icon wrapper
            coreIconContainer.className = cardIcon.className.replace('card-icon-wrapper', 'w-10 h-10 rounded-lg flex items-center justify-center transition-all duration-300');
          }
        }
      } else {
        card.classList.remove('active-card');
        if (activeDot) {
          activeDot.classList.remove('bg-blue-500', 'shadow-[0_0_8px_#3b82f6]');
          activeDot.classList.add('bg-slate-650');
        }
      }
    });
  }

  // Platform switching functionality (Twitch & Kick only)
  function showPlatform(platform: string) {
    // Hide all content
    document.querySelectorAll('.stream-content').forEach(content => {
      content.classList.add('hidden');
    });
    
    // Remove active class from all tabs
    document.querySelectorAll('.platform-tab').forEach(tab => {
      tab.classList.remove('bg-[#9146FF]', 'bg-[#53FC18]');
      tab.classList.add('bg-slate-700');
    });
    
    // Show selected content and activate tab
    const content = document.getElementById(`${platform}-content`);
    const tab = document.getElementById(`${platform}-tab`);
    
    if (content) {
      content.classList.remove('hidden');
    }
    
    if (tab) {
      tab.classList.remove('bg-slate-700');
      if (platform === 'twitch') {
        tab.classList.add('bg-[#9146FF]');
      } else if (platform === 'kick') {
        tab.classList.add('bg-[#53FC18]');
      }
    }
  }
  
  // Make functions globally available
  (window as any).showPlatform = showPlatform;
</script>

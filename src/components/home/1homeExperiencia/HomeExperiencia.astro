const COLOR_MAP = {
  purple: {
    borderHover: "md:hover:border-purple-500/50",
    shadowHover: "md:hover:shadow-purple-500/10",
    bgGradient: "from-purple-600/10",
    iconBg: "bg-purple-500/20",
    iconText: "text-purple-400",
    iconGroupHoverText: "md:group-hover:text-purple-300",
    iconGroupHoverBg: "md:group-hover:bg-purple-500/30",
  },
  blue: {
    borderHover: "md:hover:border-blue-500/50",
    shadowHover: "md:hover:shadow-blue-500/10",
    bgGradient: "from-blue-600/10",
    iconBg: "bg-blue-500/20",
    iconText: "text-blue-400",
    iconGroupHoverText: "md:group-hover:text-blue-300",
    iconGroupHoverBg: "md:group-hover:bg-blue-500/30",
  },
  emerald: {
    borderHover: "md:hover:border-emerald-500/50",
    shadowHover: "md:hover:shadow-emerald-500/10",
    bgGradient: "from-emerald-600/10",
    iconBg: "bg-emerald-500/20",
    iconText: "text-emerald-400",
    iconGroupHoverText: "md:group-hover:text-emerald-300",
    iconGroupHoverBg: "md:group-hover:bg-emerald-500/30",
  },
  orange: {
    borderHover: "md:hover:border-orange-500/50",
    shadowHover: "md:hover:shadow-orange-500/10",
    bgGradient: "from-orange-600/10",
    iconBg: "bg-orange-500/20",
    iconText: "text-orange-400",
    iconGroupHoverText: "md:group-hover:text-orange-300",
    iconGroupHoverBg: "md:group-hover:bg-orange-500/30",
  },
  teal: {
    borderHover: "md:hover:border-teal-500/50",
    shadowHover: "md:hover:shadow-teal-500/10",
    bgGradient: "from-teal-600/10",
    iconBg: "bg-teal-500/20",
    iconText: "text-teal-400",
    iconGroupHoverText: "md:group-hover:text-teal-300",
    iconGroupHoverBg: "md:group-hover:bg-teal-500/30",
  },
};
---

<section
  class="h-full py-16 md:py-24 bg-gradient-to-b from-slate-900/10 to-slate-950/10 text-white overflow-hidden relative"
>
  <!-- Decoration background elements -->
  <div
    class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none z-0"
  >
    <div
      class="absolute -top-[20%] -left-[10%] w-[50%] h-[50%] bg-purple-600/20 rounded-full blur-[100px]"
    >
    </div>
    <div
      class="absolute top-[40%] -right-[10%] w-[40%] h-[60%] bg-blue-600/10 rounded-full blur-[100px]"
    >
    </div>
  </div>

  <div class="container mx-auto px-4 relative z-10">
    <!-- Header Question -->
    <div class="text-center mb-12 md:mb-16 flex flex-col items-center justify-center gap-4">
      <h2
        class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-blue-400 via-purple-400 to-pink-400"
      >
        ¿Qué haremos hoy?
      </h2>
      <a
        href="#desarrollos-gallery-section"
        onclick="event.preventDefault(); document.getElementById('desarrollos-gallery-section')?.scrollIntoView({ behavior: 'smooth' });"
        class="inline-flex items-center gap-2 px-6 py-2.5 bg-slate-900/80 border border-slate-700/80 hover:border-slate-500 text-white hover:text-[#ffd600] font-bold rounded-xl transition-all duration-300 text-sm shadow-lg backdrop-blur-sm cursor-pointer group mt-2"
      >
        <span>Ver Proyectos</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-4 h-4 text-[#ffd600] transform group-hover:translate-y-0.5 transition-transform"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2.5"
            d="M19 9l-7 7-7-7"
          />
        </svg>
      </a>
    </div>

    <!-- Cards Gallery Container with Left Octopus Core -->
    <div class="flex flex-col lg:flex-row gap-8 items-start mb-20 relative h-[1500px] lg:h-[1100px] overflow-hidden">
      <!-- Left Column: Octopus Core (Decorative circle with circular timer) -->
      <div class="w-full lg:w-1/4 flex flex-col items-center justify-center relative py-6 shrink-0 lg:sticky lg:top-28 z-20 octopus-core-container">
          <!-- Central Octopus Core (Discreet sizing: w-20 h-20 md:w-24 md:h-24) -->
          <div class="w-20 h-20 md:w-24 md:h-24 rounded-full bg-slate-900/95 border border-slate-700/80 flex flex-col items-center justify-center shadow-[0_0_30px_rgba(59,130,246,0.15)] relative overflow-hidden group">
              <!-- Radial Glow -->
              <div class="absolute inset-0 bg-gradient-to-b from-blue-500/10 to-transparent pointer-events-none"></div>
              
              <!-- Circular Timer SVG -->
              <svg class="absolute inset-0 w-full h-full transform -rotate-90" viewBox="0 0 100 100">
                  <!-- Background Circle -->
                  <circle cx="50" cy="50" r="42" stroke="rgba(51, 65, 85, 0.3)" stroke-width="4" fill="transparent" />
                  <!-- Progress Circle -->
                  <circle id="core-timer-progress" cx="50" cy="50" r="42" stroke="url(#timer-gradient)" stroke-width="4" fill="transparent" stroke-dasharray="264" stroke-dashoffset="264" stroke-linecap="round" class="transition-all duration-100 ease-linear" />
                  
                  <defs>
                      <linearGradient id="timer-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
                          <stop offset="0%" stop-color="#3b82f6" />
                          <stop offset="50%" stop-color="#6366f1" />
                          <stop offset="100%" stop-color="#ec4899" />
                      </linearGradient>
                  </defs>
              </svg>
              
              <!-- Core Content (Icon + Timer seconds only - title omitted for discreet styling) -->
              <div class="relative z-10 text-center flex flex-col items-center justify-center p-2">
                  <div id="core-icon-container" class="w-8 h-8 md:w-10 md:h-10 rounded-lg bg-blue-50/20 text-blue-400 flex items-center justify-center transition-all duration-300">
                      <!-- Active icon will be injected here -->
                  </div>
                  <span id="core-seconds" class="text-[9px] text-slate-400 font-extrabold tracking-wider mt-0.5">
                      10s
                  </span>
              </div>
          </div>
          
          <!-- Octopus Arms (Decorative concentric circles waves) -->
          <div class="absolute inset-0 pointer-events-none overflow-hidden hidden lg:block">
              <div class="absolute w-20 h-20 border border-blue-500/20 rounded-full top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 animate-[ping_3s_infinite] opacity-50"></div>
              <div class="absolute w-28 h-28 border border-indigo-500/10 rounded-full top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 animate-[ping_4s_infinite_1s] opacity-30"></div>
          </div>
      </div>

      <!-- Right Column: Cards Grid (Minimum 2 per row) -->
      <div class="w-full lg:w-3/4">
        <div class="grid grid-cols-2 xl:grid-cols-3 gap-4 md:gap-6">
          {
            EXPERIENCE_CARDS.map((card) => {
              const colors = COLOR_MAP[card.color];
              return (
                <div
                  data-card-id={card.id}
                  data-card-title={card.title}
                  class:list={[
                    "experience-card group relative p-6 bg-slate-800/50 backdrop-blur-sm border border-slate-700 rounded-2xl transition-all duration-500 hover:-translate-y-0.5 hover:shadow-lg flex flex-col h-full cursor-pointer",
                    colors.borderHover,
                    colors.shadowHover,
                  ]}
                >
                  <div
                    class:list={[
                      "absolute inset-0 bg-gradient-to-br to-transparent opacity-0 md:group-hover:opacity-100 transition-opacity rounded-2xl pointer-events-none",
                      colors.bgGradient,
                    ]}
                  />
                  <div class="relative z-10 flex flex-col h-full">
                    <!-- Header (Icon + Title) -->
                    <div class="flex items-start justify-between">
                        <div
                          class:list={[
                            "w-12 h-12 rounded-lg flex items-center justify-center mb-4 transition-colors flex-shrink-0 card-icon-wrapper",
                            colors.iconBg,
                            colors.iconText,
                            colors.iconGroupHoverText,
                            colors.iconGroupHoverBg,
                          ]}
                        >
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="w-6 h-6"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d={card.iconPath}
                            />
                          </svg>
                        </div>
                        
                        <!-- Pulse dot indicator inside the card -->
                        <div class="active-dot w-2 h-2 rounded-full bg-slate-650 transition-all duration-300"></div>
                    </div>

                    <!-- Title (Always visible) -->
                    <h3 class="text-2xl font-bold mb-1 select-none">{card.title}</h3>

                    <!-- Content Body -->
                    <div class="card-content flex-col flex-grow">
                        <!-- Content -->
                        <p class="text-sm text-slate-400 mb-6 flex-grow">
                          {card.description}
                        </p>

                        <!-- Services List (Optional) -->
                        {card.services && card.services.length > 0 && (
                          <div class="mb-5">
                            <p class="text-[10px] font-bold uppercase text-slate-500 mb-3 tracking-wider">
                              Servicios
                            </p>
                            <div class="flex flex-wrap gap-2">
                               {card.services.slice(0, 4).map(service => (
                                   <span class="text-[11px] bg-slate-700/50 px-2.5 py-1.5 rounded text-slate-350 border border-slate-600/50">
                                       {service}
                                   </span>
                               ))}
                               {card.services.length > 4 && (
                                   <span class="text-[11px] text-slate-500 px-2 py-1">...</span>
                               )}
                            </div>
                          </div>
                        )}

                        <!-- Store Products (Tienda) Section -->
                        {card.storeProducts && card.storeProducts.length > 0 && (
                          <div class="mt-auto pt-5 border-t border-slate-700/50 mb-4">
                            <div class="flex items-center gap-2 mb-3">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400" viewBox="0 0 20 20" fill="currentColor">
                                   <path fill-rule="evenodd" d="M10 2a4 4 0 00-4 4v1H5a1 1 0 00-.994.89l-1 9A1 1 0 004 18h12a1 1 0 001-1.11l-1-9A1 1 0 0015 7h-1V6a4 4 0 00-4-4zm2 5V6a2 2 0 10-4 0v1h4zm-6 3a1 1 0 112 0 1 1 0 01-2 0zm7-1a1 1 0 100 2 1 1 0 000-2z" clip-rule="evenodd" />
                                </svg>
                                <span class="text-sm font-semibold text-slate-400">Tienda</span>
                            </div>
                            <ul class="grid grid-cols-2 gap-x-2 gap-y-1.5">
                              {card.storeProducts.slice(0, 6).map((product) => (
                                <li class="text-xs text-slate-500 flex items-start gap-2 leading-tight">
                                    <span class="w-1.5 h-1.5 rounded-full bg-slate-600 mt-1.5 flex-shrink-0"></span>
                                    <span>{product}</span>
                                </li>
                              ))}
                            </ul>
                            <div class="text-[10px] text-slate-550 mt-3 italic flex items-center gap-1 opacity-70">
                                <span>+ Cursos y servicios...</span>
                            </div>
                          </div>
                        )}
                        
                        <!-- Category-specific Action Button -->
                        {card.id === 'diseno' && (
                            <a href="/diseno" class="w-full mt-2 py-2.5 px-4 bg-slate-700/50 hover:bg-slate-700 text-slate-350 hover:text-white rounded-xl text-sm font-semibold transition-all flex items-center justify-center gap-2 group-hover:shadow-md">
                                <span>Mira nuestra galería y proyectos</span>
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd" />
                                </svg>
                            </a>
                        )}
                        {card.id === 'desarrollo' && (
                            <a href="/desarrollo" class="w-full mt-2 py-2.5 px-4 bg-slate-700/50 hover:bg-slate-700 text-slate-350 hover:text-white rounded-xl text-sm font-semibold transition-all flex items-center justify-center gap-2 group-hover:shadow-md">
                                <span>Stack tech, herramientas open source</span>
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd" />
                                </svg>
                            </a>
                        )}
                        {card.id === 'contabilidad' && (
                            <a href="/contable" class="w-full mt-2 py-2.5 px-4 bg-slate-700/50 hover:bg-slate-700 text-slate-350 hover:text-white rounded-xl text-sm font-semibold transition-all flex items-center justify-center gap-2 group-hover:shadow-md">
                                <span>Servicios fiscales y contables</span>
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd" />
                                </svg>
                            </a>
                        )}
                        {card.id === 'comprar-vender' && (
                            <a href="/ecommerce" class="w-full mt-2 py-2.5 px-4 bg-slate-700/50 hover:bg-slate-700 text-slate-350 hover:text-white rounded-xl text-sm font-semibold transition-all flex items-center justify-center gap-2 group-hover:shadow-md">
                                <span>Tienda y productos personalizados</span>
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd" />
                                </svg>
                            </a>
                        )}
                        {card.id === 'emprender' && (
                            <a href="/marketing" class="w-full mt-2 py-2.5 px-4 bg-slate-700/50 hover:bg-slate-700 text-slate-350 hover:text-white rounded-xl text-sm font-semibold transition-all flex items-center justify-center gap-2 group-hover:shadow-md">
                                <span>Marketing y estrategia de negocio</span>
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd" />
                                </svg>
                            </a>
                        )}
                        {card.id === 'cursos' && (
                            <a href="/cursos" class="w-full mt-2 py-2.5 px-4 bg-slate-700/50 hover:bg-slate-700 text-slate-350 hover:text-white rounded-xl text-sm font-semibold transition-all flex items-center justify-center gap-2 group-hover:shadow-md">
                                <span>Certificaciones y cursos profesionales</span>
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd" />
                                </svg>
                            </a>
                        )}
                        {card.id === 'capacitacion' && (

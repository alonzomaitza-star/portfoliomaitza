---
// Recibe un objeto producto por prop
const { producto } = Astro.props;
---
<li class="bg-white rounded-md shadow-md p-4 flex flex-col items-center hover:shadow-lg transition-shadow cursor-pointer">
  <img src={producto.imagen} alt={producto.titulo} class="max-h-48 w-auto rounded-md mb-2" />
  <h4 class="text-lg font-bold mb-1 text-center">{producto.titulo}</h4>
  <p class="text-base text-center mb-2">{producto.descripcion}</p>
  {producto.precio && (
    <span class="text-green-600 font-semibold mb-2">${producto.precio}</span>
  )}
  {producto.etiqueta && (
    <span class="text-xs bg-yellow-200 text-yellow-800 rounded px-2 py-1 mb-2">{producto.etiqueta}</span>
  )}
  <!-- Aquí puedes agregar botones de acción o iconos de selección si lo necesitas -->
</li>

---
// Recibe propiedades individuales o un objeto producto
const { producto, titulo, descripcion, imagen, precio, etiqueta } = Astro.props;

// Si se pasa un objeto producto, usar sus propiedades
const cardTitulo = producto?.titulo || titulo;
const cardDescripcion = producto?.descripcion || descripcion;
const cardImagen = producto?.imagen || imagen;
const cardPrecio = producto?.precio || precio;
const cardEtiqueta = producto?.etiqueta || etiqueta;
---

<!-- Tarjeta con diseño Calendly Dark glassmorphism -->
<div class="relative overflow-hidden backdrop-blur-md bg-midnight-navy/40 border border-mist-border/15 rounded-lg shadow-sm hover:border-mist-border/30 hover:bg-midnight-navy/60 hover:shadow-sm-2 transition-all duration-300 p-3 sm:p-5 flex flex-col items-center group h-full">
  <!-- Efecto de gradiente sutil en el fondo -->
  <div class="absolute inset-0 bg-gradient-to-br from-midnight-navy/20 to-cyan-pop/5 opacity-40 z-0"></div>
  
  <!-- Contenido de la tarjeta -->
  <div class="relative z-10 w-full flex flex-col items-center flex-1 h-full">
    <!-- Imagen con efecto de elevación al hacer hover -->
    <div class="relative mb-3 sm:mb-4 overflow-hidden rounded-lg w-full flex justify-center transform group-hover:scale-103 transition-transform duration-300">
      <img 
        src={cardImagen} 
        alt={cardTitulo} 
        class="max-h-36 sm:max-h-52 w-auto object-contain" 
      />
      <!-- Overlay al hacer hover -->
      <div class="absolute inset-0 bg-gradient-to-t from-bg-primary/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
    </div>
    
    <!-- Información del producto -->
    <h4 class="text-sm sm:text-lg font-bold mb-2 text-center text-white group-hover:text-signal-blue transition-colors duration-300">
      {cardTitulo}
    </h4>
    
    <p class="text-xs sm:text-sm text-center mb-3 text-slate-blue line-clamp-2 max-w-[90%]">
      {cardDescripcion}
    </p>
    
    <!-- Contenedor inferior alineado abajo -->
    <div class="mt-auto w-full flex flex-col items-center">
      <!-- Precio con estilo mejorado -->
      {cardPrecio && (
        <span class="text-signal-blue font-bold mb-2 sm:mb-3 text-sm sm:text-base bg-signal-blue/10 px-3 py-1 rounded-sm border border-signal-blue/20">
          ${cardPrecio} USD
        </span>
      )}
      
      <!-- Etiqueta con estilo mejorado -->
      {cardEtiqueta && (
        <span class="text-xs bg-fog/10 text-signal-blue border border-signal-blue/20 font-medium rounded-full px-3 py-0.5 mb-2 shadow-sm">
          {cardEtiqueta}
        </span>
      )}
      
      <!-- Botón de acción -->
      <button class="mt-1 sm:mt-2 px-4 py-1.5 sm:py-2 bg-signal-blue hover:bg-blue-700 text-white text-xs sm:text-sm font-semibold rounded-sm w-full transition-all duration-200 shadow-sm">
        Ver detalles
      </button>
    </div>
  </div>
</div>

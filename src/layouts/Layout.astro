---
import "../styles/global.css";
import Nav from '../components/NavBarMain.astro';
import bg from '../assets/BG-material.png'
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Insano Network — Diseña, Desarrolla y Vende tus Ideas</title>

		<!-- Favicon & app icons -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="mask-icon" href="/favicon.svg" color="#0ea5b7" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#0f172a" />

		<!-- Basic SEO -->
		<meta name="application-name" content="Insano Network" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="apple-mobile-web-app-title" content="Insano Network" />
	</head>
	<body>
		<Nav />
		<slot />
		<Footer />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		background-image: url('../assets/BG-material.png');
		overflow-x: hidden;
	}
</style>

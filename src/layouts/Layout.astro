---
import "../styles/global.css";
import Nav from "../components/NavBarMain.astro";
import Footer from "../components/Footer.astro";
import {
	SITE_URL,
	SITE_TITLE,
	SITE_DESCRIPTION,
	DEFAULT_OG_IMAGE,
} from "../consts";
import ChatBot from "../components/home/ChatBot.astro";
import NavigationPanel from "../components/home/NavigationPanel.astro";
// Props para SEO
interface Props {
	title?: string;
	description?: string;
	keywords?: string;
	ogImage?: string;
	ogType?: string;
	canonical?: string;
	noindex?: boolean;
}

const {
	title = SITE_TITLE,
	description = SITE_DESCRIPTION,
	keywords = "diseño web, desarrollo software, e-commerce, marketing digital, servicios contables, agencia digital",
	ogImage = `${SITE_URL}${DEFAULT_OG_IMAGE}`,
	ogType = "website",
	canonical = Astro.url.pathname,
	noindex = false,
} = Astro.props;

const canonicalURL = new URL(canonical, SITE_URL).href;
const fullTitle = title.includes("Insano Network")
	? title
	: `${title} | Insano Network`;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />

		<!-- SEO Básico -->
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<link rel="canonical" href={canonicalURL} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:site_name" content="Insano Network" />
		<meta property="og:locale" content="es_ES" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<!-- Favicon & app icons -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="mask-icon" href="/favicon.svg" color="#0ea5b7" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#0f172a" />

		<!-- App Meta -->
		<meta name="application-name" content="Insano Network" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta
			name="apple-mobile-web-app-status-bar-style"
			content="black-translucent"
		/>
		<meta name="apple-mobile-web-app-title" content="Insano Network" />
	</head>
	<body>
		<Nav />
		<!-- ChatBot -->
		<ChatBot />
		<!-- Navigation Panel -->
		<NavigationPanel />
		<slot />
		<Footer />
	</body>
</html>

<style>
	html {
		margin: 0;
		width: 100%;
	}
	body {
		margin: 0;
		width: 100%;
		min-height: 100vh;
		background-image: url("../assets/BG-material.png");
		overflow-x: hidden;
	}
</style>

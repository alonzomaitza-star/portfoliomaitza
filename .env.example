# Variables de entorno para la integración con Medusa.js

# URL del backend de Medusa (visible en el cliente)
PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Clave API para el backend de Medusa (solo para uso en el servidor)
MEDUSA_API_KEY=your_medusa_api_key

# Configuración de Supabase (ya existente en el proyecto)
PUBLIC_SUPABASE_URL=your_supabase_url
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Configuración de Stripe para pagos (opcional)
PUBLIC_STRIPE_KEY=your_stripe_publishable_key